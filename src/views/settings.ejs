<!-- Settings page -->
<%- include('partials/_stg-styles') %>
<div class="stg-page">

  <h1 class="stg-h1" style="margin-bottom:20px">Settings: <%= ({ profile: 'Profile', roles: 'Roles', ai: 'AI Setup' })[activeTab] || 'Profile' %></h1>

  <% if (saved) { %>
  <div class="stg-banner stg-banner-ok">
    <svg width="16" height="16" style="flex:none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
    Settings saved successfully.
  </div>
  <% } %>
  <% if (notice) { %>
  <div class="stg-banner stg-banner-ok">
    <svg width="16" height="16" style="flex:none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
    <%= notice %>
  </div>
  <% } %>
  <% if (error) { %>
  <div class="stg-banner stg-banner-err">
    <svg width="16" height="16" style="flex:none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    <%= error %>
  </div>
  <% } %>

  <!-- Tab bar (mobile only — desktop navigates via the sidebar sub-items) -->
  <div class="stg-tabs md:hidden">
    <button id="tab-btn-profile" onclick="switchTab('profile')" class="stg-tab <%= activeTab === 'profile' ? 'active' : '' %>">Profile</button>
    <button id="tab-btn-roles" onclick="switchTab('roles')" class="stg-tab <%= activeTab === 'roles' ? 'active' : '' %>">Roles</button>
    <button id="tab-btn-ai" onclick="switchTab('ai')" class="stg-tab <%= activeTab === 'ai' ? 'active' : '' %>">AI Setup</button>
  </div>

  <%- include('settings/_tab-profile') %>
  <%- include('settings/_tab-roles') %>
  <%- include('settings/_tab-ai') %>

</div>

<!-- ==================== GROUP MODAL ==================== -->
<div id="group-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeGroupModal()"></div>
  <div class="stg-modal relative bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] flex flex-col overflow-hidden">

    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
      <h2 id="modal-title" class="font-semibold text-gray-900 text-lg">Add Role</h2>
      <button onclick="closeGroupModal()" class="text-gray-400 hover:text-gray-600 p-1 rounded-lg hover:bg-gray-100 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="overflow-y-auto flex-1 px-6 py-5 space-y-5">

      <div id="modal-error" class="hidden text-sm text-red-600 bg-red-50 border border-red-200 px-3 py-2 rounded-lg"></div>

      <div>
        <div class="flex items-baseline justify-between mb-1.5">
          <label class="block text-sm font-medium text-gray-700">Role Display Name</label>
          <span id="group-name-counter" class="text-xs text-gray-400 hidden">0 / 50</span>
        </div>
        <input id="modal-group-name" type="text" maxlength="50"
               oninput="const c=document.getElementById('group-name-counter');c.textContent=this.value.length+' / 50';c.classList.toggle('hidden',this.value.length===0);"
               class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent"
               placeholder="e.g. UK Remote Senior" />
      </div>

      <div>
        <div class="flex items-center gap-1.5 mb-1.5">
          <label class="block text-sm font-medium text-gray-700">Desired Locations <span class="text-red-500 ml-0.5">*</span></label>
          <div id="location-help-wrap" class="relative inline-flex">
            <button type="button" onclick="toggleLocationHelp()" aria-label="How locations are used"
                    class="stg-help-btn">?</button>
            <div id="location-help-body" class="hidden absolute top-6 left-0 z-20 w-80 max-w-[78vw] rounded-lg border border-gray-200 bg-white shadow-2xl px-3.5 py-3">
              <p class="text-[11px] font-semibold uppercase tracking-wide text-gray-500 mb-2">How locations are used</p>
              <div class="space-y-2 text-xs text-gray-500">
                <div class="flex gap-2.5"><span class="font-medium text-gray-700 flex-none w-28">LinkedIn</span><span>searches your exact areas, unchanged.</span></div>
                <div class="flex gap-2.5"><span class="font-medium text-gray-700 flex-none w-28">Indeed &middot; Greenhouse &middot; Ashby &middot; Lever</span><span>searched by country.</span></div>
                <div class="flex gap-2.5"><span class="font-medium text-gray-700 flex-none w-28">Telegram</span><span>keeps jobs in your target countries plus jobs with no stated location; the AI judges the rest.</span></div>
              </div>
            </div>
          </div>
        </div>
        <textarea id="modal-locations" rows="1"
                  class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm font-mono focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none"
                  placeholder="London, Spain"></textarea>
        <div id="location-warning" class="hidden mt-1.5 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 leading-relaxed"></div>
      </div>

      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 space-y-4">
        <h3 class="text-sm font-semibold text-gray-800">Job Title</h3>
        <div class="space-y-2 text-xs text-gray-500 leading-relaxed">
          <p>Search Keywords are sent to job boards. Broader keywords = more jobs at higher API cost.</p>
          <p>Job-board filters often miss relevant roles. Searching for “Senior Product Manager” may miss some jobs with that exact title. It’s safer to search for “Product Manager,” then use Desired Titles to filter.</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Search Keywords <span class="text-red-500 ml-0.5">*</span></label>
          <textarea id="modal-keywords" rows="1"
                    class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm font-mono focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none"
                    placeholder="Product Manager, Head of Product"></textarea>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Desired Titles</label>
          <textarea id="modal-title-filter" rows="2"
                    class="block w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm font-mono focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none"
                    placeholder="senior product manager, principal product manager, staff product manager"></textarea>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <div class="flex items-center gap-1.5 mb-1.5">
            <label class="block text-sm font-medium text-gray-700">Job Type</label>
            <div id="jobtype-help-wrap" class="relative inline-flex">
              <button type="button" onclick="toggleJobTypeHelp()" aria-label="How job type is used"
                      class="stg-help-btn">?</button>
              <div id="jobtype-help-body" class="hidden absolute top-6 left-0 z-20 w-64 max-w-[78vw] rounded-lg border border-gray-200 bg-white shadow-2xl px-3.5 py-2.5">
                <p class="text-xs text-gray-500">None selected = every type ok.</p>
                <p class="text-xs text-gray-500 mt-1.5">StepStone knows only full/part; Indeed, Greenhouse, Telegram &amp; Lever skip this filter. They are checked via AI.</p>
              </div>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row sm:flex-wrap gap-2 sm:gap-6">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" class="modal-job-type rounded border-gray-300 text-blue-600 focus:ring-blue-500" value="fulltime" />
              <span class="text-sm text-gray-700">Full-time</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" class="modal-job-type rounded border-gray-300 text-blue-600 focus:ring-blue-500" value="parttime" />
              <span class="text-sm text-gray-700">Part-time</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" class="modal-job-type rounded border-gray-300 text-blue-600 focus:ring-blue-500" value="fixedterm" />
              <span class="text-sm text-gray-700">Fix-term</span>
            </label>
          </div>
        </div>
        <div>
          <div class="flex items-center gap-1.5 mb-1.5">
            <label class="block text-sm font-medium text-gray-700">Work Modes</label>
            <div id="workmode-help-wrap" class="relative inline-flex">
              <button type="button" onclick="toggleWorkModeHelp()" aria-label="How work modes are used"
                      class="stg-help-btn">?</button>
              <div id="workmode-help-body" class="hidden absolute top-6 right-0 z-20 w-64 max-w-[78vw] rounded-lg border border-gray-200 bg-white shadow-2xl px-3.5 py-2.5">
                <p class="text-xs text-gray-500">None selected = every mode ok.</p>
                <p class="text-xs text-gray-500 mt-1.5">Indeed, Greenhouse &amp; LinkedIn: valig jobs ignore it — no work-mode data.</p>
              </div>
            </div>
          </div>
          <div class="flex flex-col sm:flex-row sm:flex-wrap gap-2 sm:gap-6">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" class="modal-work-mode rounded border-gray-300 text-blue-600 focus:ring-blue-500" value="remote" />
              <span class="text-sm text-gray-700">Remote</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" class="modal-work-mode rounded border-gray-300 text-blue-600 focus:ring-blue-500" value="hybrid" />
              <span class="text-sm text-gray-700">Hybrid</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" class="modal-work-mode rounded border-gray-300 text-blue-600 focus:ring-blue-500" value="onsite" />
              <span class="text-sm text-gray-700">Onsite</span>
            </label>
          </div>
        </div>
      </div>

      <div>
        <div class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="modal-industries" class="block text-sm font-medium text-gray-700 mb-1.5">Priority industries</label>
              <textarea id="modal-industries" rows="2"
                        placeholder="ride-hailing, food-tech, marketplaces, travel"
                        class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm font-mono focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-y"></textarea>
            </div>
            <div>
              <label for="disq-hate-industries" class="block text-sm font-medium text-gray-700 mb-1.5">100% Rejected Industries</label>
              <textarea id="disq-hate-industries" rows="2"
                        placeholder="gambling, betting"
                        class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm font-mono focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-y"></textarea>
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label class="block text-sm font-medium text-gray-700">Profile Description <span class="text-red-500 ml-0.5">*</span></label>
              <label class="flex items-center gap-2 cursor-pointer select-none">
                <span class="text-xs text-gray-500">Use main profile</span>
                <div class="relative">
                  <input type="checkbox" id="modal-use-main-profile" class="sr-only peer" onchange="toggleMainProfileDesc()" />
                  <div class="relative w-10 h-5 bg-gray-300 peer-checked:bg-[var(--green)] rounded-full transition-colors
                              after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white
                              after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-5"></div>
                </div>
              </label>
            </div>
            <div id="modal-profile-desc-own">
              <textarea id="modal-profile-description" rows="8"
                        placeholder="Senior PM with 13 years in e-commerce and customer service, including 6+ years leading support products at a large classifieds and 3 years heading B2B seller support at a major marketplace. Built help center, CRM, automation, AI, and moderation tools. Set strategy, secured board funding, scaled the team to 9 PMs and 3 Group PMs, and delivered measurable cost savings."
                        class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm font-mono focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-y"></textarea>
            </div>
            <div id="modal-profile-desc-main" class="hidden">
              <div id="modal-main-profile-preview"
                   class="w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2.5 text-sm font-mono text-gray-600 whitespace-pre-wrap min-h-[10rem]"></div>
              <p class="text-xs text-gray-400 mt-1">From Settings → Profile — edit there to change it</p>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Extra Rejection Rules for AI <span class="text-red-500 ml-0.5">*</span></label>
            <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 space-y-3">
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2.5">
                <label class="flex items-center gap-2 flex-none text-sm text-gray-700 cursor-pointer">
                  <input type="checkbox" id="disq-relocation" onchange="checkDisqDependency(this)" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                  No visa or remote
                </label>
                <label class="flex items-center gap-2 flex-none text-sm text-gray-700 cursor-pointer">
                  <input type="checkbox" id="disq-salary" data-field="disq-salary-expectation" class="disq-field-cb rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                  Annual salary &lt;
                </label>
                <input type="text" id="disq-salary-expectation" placeholder="70k euro"
                       class="w-28 flex-none min-w-0 rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-400 disabled:cursor-not-allowed" />
              </div>
              <div class="flex items-center gap-3">
                <label class="flex items-center gap-2 w-32 flex-none text-sm text-gray-700 cursor-pointer">
                  <input type="checkbox" id="disq-other" data-field="disq-other-disqualifiers" class="disq-field-cb rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                  Other
                </label>
                <input type="text" id="disq-other-disqualifiers"
                       class="flex-1 min-w-0 rounded-lg border border-gray-300 px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent disabled:bg-gray-100 disabled:text-gray-400 disabled:cursor-not-allowed" />
              </div>
              <p id="disq-dependency-msg" class="hidden text-xs text-red-600"></p>
            </div>
          </div>
          <div>
            <button type="button" onclick="toggleCollapsible('modal-scoring-criteria-body', 'scoring-criteria-chevron')"
                    class="flex items-center gap-1.5 text-xs font-medium text-gray-600 hover:text-gray-900 w-full text-left">
              <svg id="scoring-criteria-chevron" class="w-3 h-3 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              Role Scoring Rules (0-100) <span class="text-red-500 ml-0.5">*</span>
            </button>
            <div id="modal-scoring-criteria-body" class="hidden mt-1.5 space-y-3">
              <textarea id="modal-scoring-criteria" rows="6"
                        class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm font-mono focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-y"></textarea>
              <div class="grid grid-cols-3 gap-3">
                <div>
                  <label class="block text-xs font-medium text-gray-600 mb-1">
                    <span class="inline-block w-2 h-2 rounded-full bg-red-400 mr-1"></span><%= formatVerdictLabel('NO_MATCH') %> max
                  </label>
                  <input id="modal-no-match-max" type="number" min="0" max="99" value="50"
                         class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono focus:ring-2 focus:ring-blue-500" />
                  <p class="text-xs text-gray-400 mt-0.5">0–this → discarded</p>
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 mb-1">
                    <span class="inline-block w-2 h-2 rounded-full bg-yellow-400 mr-1"></span><%= formatVerdictLabel('WEAK_MATCH') %> max
                  </label>
                  <input id="modal-weak-match-max" type="number" min="1" max="99" value="70"
                         class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono focus:ring-2 focus:ring-blue-500" />
                  <p class="text-xs text-gray-400 mt-0.5">stats only</p>
                </div>
                <div>
                  <label class="block text-xs font-medium text-gray-600 mb-1">
                    <span class="inline-block w-2 h-2 rounded-full bg-[var(--green)] mr-1"></span><%= formatVerdictLabel('STRONG_MATCH') %> min
                  </label>
                  <input id="modal-strong-match-min" type="number" min="1" max="100" value="71"
                         class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm font-mono focus:ring-2 focus:ring-blue-500" />
                  <p class="text-xs text-gray-400 mt-0.5">this+ → stored</p>
                </div>
              </div>
            </div>
          </div>
          <div>
            <button type="button" onclick="togglePromptPreview()"
                    class="flex items-center gap-1.5 text-xs font-medium text-blue-600 hover:text-blue-800">
              <svg id="preview-chevron" class="w-3 h-3 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              Prompt Preview
            </button>
            <div id="prompt-preview-container" class="hidden mt-2">
              <p class="text-xs text-gray-400 mb-1.5">Updated when the Edit Role popup reopens</p>
              <pre id="prompt-preview" class="rounded-lg border border-gray-200 bg-gray-50 px-3 py-2.5 text-xs text-gray-600 font-mono whitespace-pre-wrap leading-relaxed max-h-80 overflow-y-auto"></pre>
            </div>
          </div>
        </div>
      </div>

    </div>

    <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-end gap-3 flex-shrink-0">
      <button type="button" onclick="closeGroupModal()" class="stg-btn stg-btn-secondary">
        Cancel
      </button>
      <button id="modal-save-btn" onclick="saveGroup()" disabled class="stg-btn stg-btn-primary">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span id="modal-save-label">Save Group</span>
      </button>
    </div>

  </div>
</div>

<!-- ==================== BLACKLIST MANAGEMENT MODAL ==================== -->
<div id="blacklist-mgmt-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeBlacklistMgmtModal()"></div>
  <div class="stg-modal relative bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[85vh] flex flex-col overflow-hidden">

    <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
      <h2 class="font-semibold text-gray-900 text-lg">Blacklisted Companies</h2>
      <button onclick="closeBlacklistMgmtModal()" class="text-gray-400 hover:text-gray-600 p-1 rounded-lg hover:bg-gray-100 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="overflow-y-auto flex-1 px-6 py-4">
      <div id="bl-mgmt-error" class="hidden mb-3 text-sm text-red-600 bg-red-50 border border-red-200 px-3 py-2 rounded-lg"></div>
      <div id="bl-mgmt-list">
        <div class="py-6 text-center text-gray-400 text-sm">Loading…</div>
      </div>
    </div>

    <div class="border-t border-gray-100 px-6 py-4 flex-shrink-0 bg-gray-50/50">
      <p id="bl-form-title" class="text-xs font-semibold text-gray-600 uppercase tracking-wide mb-3">Add Company</p>
      <div class="space-y-2.5">
        <input id="bl-form-name" type="text"
               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500 focus:border-transparent"
               placeholder="Company name" />
        <textarea id="bl-form-notes" rows="2"
                  class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-red-500 focus:border-transparent resize-none"
                  placeholder="Reason (optional)"></textarea>
        <div class="flex items-center gap-2">
          <button onclick="saveBlacklistEntry()" class="stg-btn stg-btn-danger stg-btn-sm">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span id="bl-form-save-label">Add to Blacklist</span>
          </button>
          <button id="bl-form-cancel-btn" onclick="cancelBlacklistEdit()" class="hidden stg-btn stg-btn-secondary stg-btn-sm">
            Cancel
          </button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- ==================== UNSAVED CHANGES DIALOG ==================== -->
<div id="unsaved-modal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="unsavedCancel()"></div>
  <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-sm p-6">
    <h3 class="font-semibold text-gray-900 mb-2">Unsaved changes</h3>
    <p class="text-sm text-gray-600 mb-5">You have unsaved changes on the <strong id="unsaved-tab-name"></strong> tab.</p>
    <div class="flex gap-3 justify-end">
      <button onclick="unsavedCancel()" class="stg-btn stg-btn-ghost stg-btn-sm">
        Cancel
      </button>
      <button onclick="unsavedDiscard()" class="stg-btn stg-btn-secondary stg-btn-sm">
        Discard
      </button>
      <button onclick="unsavedSave()" class="stg-btn stg-btn-primary stg-btn-sm">
        Save
      </button>
    </div>
  </div>
</div>

<script>
  window._isAdmin = <%= isAdmin ? 'true' : 'false' %>;
  window._settingsInitialGroups = <%- groupsJson %>;
  window._mainProfileDescription = <%- JSON.stringify(settings.profile_description || '') %>;
  window._currentLocation = <%- JSON.stringify(settings.current_location || '') %>;
  window._languages = <%- JSON.stringify(settings.languages || '') %>;
</script>
<script src="/js/settings.js"></script>
<script>initSettings('<%= activeTab %>', window._settingsInitialGroups);</script>
