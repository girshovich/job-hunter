<%
const tz = timezone || 'UTC';
function formatDate(iso) {
  return formatDateTimeToMinutes(iso, tz);
}
// DS v2 run-status pill tone (local — the shared getRunStatusTone was retired with its last consumer).
function statusTone(s) {
  if (s === 'success' || s === 'partial_error') return 'background:var(--green-soft);color:var(--green2);border:1px solid var(--green-border)';
  if (s === 'stopped') return 'background:#eef1f6;color:#3a4250;border:1px solid var(--line2)';
  if (s === 'running') return 'background:var(--accent-soft);color:var(--accent);border:1px solid var(--accent-border)';
  return 'background:var(--red-soft);color:var(--red-ink);border:1px solid var(--red-border)'; // failed / error
}
%>

<style>
  /* ── Start page (DS v2) — namespaced under .hp to avoid global collisions ── */
  .hp-h1{margin:0;font-size:21px;font-weight:800;letter-spacing:-.02em;color:var(--ink)}
  .hp-date{font-size:13px;color:var(--faint);margin-top:3px;font-weight:600}
  .hp-card{background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow-card)}
  .hp-intro{display:flex;gap:16px;margin-top:22px;align-items:stretch}
  .hp-intro > *{flex:1;min-width:0}
  .hp-card-head{display:flex;align-items:center;justify-content:space-between}
  .hp-card-title{font-size:13.5px;font-weight:800;letter-spacing:-.01em;color:var(--ink)}
  .hp-dismiss{width:24px;height:24px;border-radius:6px;display:grid;place-items:center;border:0;background:transparent;color:#cfd3da;cursor:pointer}
  .hp-dismiss:hover{background:#f4f5f7;color:var(--faint)}
  .hp-letter-body{display:flex;gap:14px;margin-top:12px}
  .hp-letter-av{width:52px;height:52px;border-radius:50%;flex:none;object-fit:cover;margin-top:1px}
  .hp-letter-p{font-size:13px;color:var(--ink2);line-height:1.6;margin:0 0 10px}
  .hp-hiw-list{display:flex;flex-direction:column;gap:11px;margin-top:14px}
  .hp-hiw-item{display:flex;align-items:center;gap:11px}
  .hp-hiw-item.start{align-items:flex-start}
  .hp-hiw-ico{width:32px;height:32px;border-radius:10px;flex:none;display:grid;place-items:center}
  .hp-hiw-t{font-size:12.5px;font-weight:700;color:var(--ink)}
  .hp-hiw-d{font-size:11.5px;color:var(--faint);line-height:1.35;margin-top:1px;font-weight:500}
  .hp-hiw-d a{color:var(--accent);font-weight:600}
  /* search-for-jobs card */
  .hp-run{margin-top:16px;padding:22px 24px}
  .hp-run-top{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
  .hp-run-title{font-size:16px;font-weight:800;letter-spacing:-.01em;color:var(--ink)}
  .hp-run-sub{font-size:13px;color:var(--faint);margin-top:3px;font-weight:500}
  .hp-btn{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:13.5px;border-radius:11px;padding:11px 18px;border:0;white-space:nowrap;color:#fff}
  .hp-btn-sched{background:var(--accent);box-shadow:0 1px 2px rgba(47,107,255,.4)}
  .hp-btn-sched:hover{background:var(--accent-hover)}
  .hp-btn-run{background:var(--green);box-shadow:0 1px 2px rgba(40,177,105,.35)}
  .hp-btn-run:hover{background:var(--green2)}
  .hp-btn-run.stop{background:var(--red);box-shadow:none}
  .hp-btn-run.stop:hover{background:#d13b40}
  .hp-btn-run.stopping{opacity:.6;cursor:not-allowed}
  .hp-btn-lock{background:#eef1f6;color:var(--faintest);box-shadow:none;cursor:not-allowed}
  .hp-preflight{margin-top:16px;background:var(--red-soft);border:1px solid var(--red-border);border-radius:11px;padding:12px 14px}
  .hp-preflight-title{font-size:12px;font-weight:700;color:var(--red-ink);margin:0 0 5px}
  .hp-preflight-list{margin:0;padding-left:18px;font-size:12px;color:var(--red-ink);list-style:disc}
  .hp-preflight-list li{line-height:1.5}
  .hp-preflight-list a{color:var(--red-ink);text-decoration:underline;font-weight:600}
  .hp-progress{margin-top:18px}
  .hp-pbar-row{display:flex;align-items:center;gap:14px;margin-bottom:8px}
  .hp-pbar{flex:1;height:8px;background:#eef0f4;border-radius:999px;overflow:hidden}
  .hp-pbar > span{display:block;height:100%;width:0;background:var(--green);border-radius:999px;transition:width .5s ease-out}
  .hp-pct{font-size:22px;font-weight:800;letter-spacing:-.02em;color:var(--ink);font-variant-numeric:tabular-nums;flex:none}
  .hp-pstatus{font-size:13px;color:var(--faint);font-weight:500;margin:0}
  .hp-result{margin-top:16px;font-size:13px;font-weight:600}
  .hp-result a{text-decoration:underline;font-weight:600}
  /* bottom grid */
  /* minmax(0,…) tracks: a plain 1fr floors at the match rows' min-content, which pushes both
     cards (and the stat tiles inside them) wider than the viewport on mobile. */
  .hp-grid2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:20px;margin-top:20px;align-items:start}
  .hp-sess-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
  .hp-sess-title{font-size:13px;font-weight:800;color:var(--ink2)}
  .hp-status-pill{font-size:11px;font-weight:700;padding:2px 9px;border-radius:999px;text-transform:capitalize}
  .hp-stat3{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;text-align:center}
  .hp-stat{border-radius:11px;padding:12px 4px}
  .hp-stat-fetched{background:#f4f5f8}
  .hp-stat-strong{background:var(--green-soft)}
  .hp-stat-weak{background:var(--amber-soft)}
  .hp-stat-n{font-size:20px;font-weight:800;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
  .hp-stat-l{font-size:11px;color:var(--faint);font-weight:600;margin-top:2px}
  .hp-sess-foot{font-size:11.5px;color:var(--faint);margin-top:14px;font-weight:600}
  .hp-matches-head{padding:16px 20px 12px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}
  .hp-matches-title{font-size:14px;font-weight:800;color:var(--ink)}
  .hp-matches-meta{display:flex;align-items:center;gap:12px}
  .hp-matches-count{font-size:12px;color:var(--faintest);font-weight:600}
  .hp-view-all{font-size:12px;font-weight:700;color:var(--accent)}
  .hp-mrow{display:flex;align-items:center;gap:12px;padding:12px 20px;border-top:1px solid #f3f4f6;cursor:pointer;transition:background .12s}
  .hp-mrow:first-of-type{border-top:0}
  .hp-mrow:hover{background:var(--accent-tint)}
  .hp-mident{flex:1;min-width:0}
  .hp-mtitle{font-size:13.5px;font-weight:700;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .hp-mcompany{font-size:12px;color:var(--muted2);font-weight:600;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .hp-mright{display:flex;align-items:center;gap:9px;flex:none}
  .hp-apply{display:inline-flex;align-items:center;gap:3px;font-size:11.5px;font-weight:700;color:var(--accent)}
  .hp-empty{padding:40px 20px;text-align:center;font-size:13px;color:var(--faint);font-weight:600}
  .hp-empty-err{margin-top:8px}
  .hp-err-sum{font-size:12px;color:var(--red-ink);cursor:pointer}
  .hp-err-pre{font-size:11px;color:var(--red-ink);background:var(--red-soft);padding:8px;border-radius:8px;margin-top:6px;overflow:auto;max-height:96px;white-space:pre-wrap}
  @media (max-width:960px){
    .hp-intro{flex-direction:column}
    .hp-grid2{grid-template-columns:minmax(0,1fr)}
    .hp-mright .hp-apply{display:none}
  }
  @media (max-width:767px){
    /* Phones: give the title two lines (DS §1.5 clamp) instead of one ellipsised line. */
    .hp-mtitle{white-space:normal;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;text-overflow:clip;line-height:1.35}
    .hp-mrow{gap:10px;padding:12px 16px}
    .hp-stat{padding:12px 2px}
  }
</style>

<!-- Page header -->
<div>
  <h1 class="hp-h1">Start</h1>
  <p class="hp-date"><%= new Date().toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
</div>

<!-- ── Welcome + How it works + Modes ── -->
<div id="home-cards-row" class="hp-intro">

  <!-- Letter card -->
  <div id="home-card-letter" class="hp-card" style="padding:20px">
    <div class="hp-card-head">
      <div class="hp-card-title">Hi, glad you made it!</div>
      <button class="hp-dismiss" onclick="dismissHomeCard('letter')" aria-label="Dismiss">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6l-12 12"/></svg>
      </button>
    </div>
    <div class="hp-letter-body">
      <img src="/misha.webp" alt="Misha" class="hp-letter-av">
      <div>
        <p class="hp-letter-p">Please proceed with the onboarding check list in the navigation panel. If you have any questions, reach out to me at <a href="mailto:mikhail@girshovich.me">mikhail@girshovich.me</a>.</p>
        <p class="hp-letter-p" style="margin-bottom:0">And best of luck with your job search!</p>
      </div>
    </div>
  </div>

  <!-- How it works (compact) -->
  <div id="home-card-hiw" class="hp-card" style="padding:18px 20px">
    <div class="hp-card-head">
      <div class="hp-card-title">How it works</div>
      <button class="hp-dismiss" onclick="dismissHomeCard('hiw')" aria-label="Dismiss">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6l-12 12"/></svg>
      </button>
    </div>
    <div class="hp-hiw-list">
      <div class="hp-hiw-item"><div class="hp-hiw-ico" style="background:#f3f0ff"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7c5cfc" stroke-width="1.6" stroke-linecap="round"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.6a1 1 0 0 1 .7.3l5.4 5.4a1 1 0 0 1 .3.7V19a2 2 0 0 1-2 2z"/></svg></div><div><div class="hp-hiw-t">Describe yourself</div><div class="hp-hiw-d">You, roles, locations and what you care about.</div></div></div>
      <div class="hp-hiw-item"><div class="hp-hiw-ico" style="background:#eef6ff"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2f6bff" stroke-width="1.6" stroke-linecap="round"><path d="M15.8 5.3a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7 5.9c-.6-.1-1.2 0-1.6.4l-2.7 2.7H8.3v2.3H6v2.3H2.3v-2.8c0-.6.2-1.2.7-1.6l6.5-6.5c.4-.4.5-1 .4-1.6a6 6 0 1 1 11.8-2.1z"/></svg></div><div><div class="hp-hiw-t">Set API keys</div><div class="hp-hiw-d">Add your Apify and LLM keys, or use mine.</div></div></div>
      <div class="hp-hiw-item"><div class="hp-hiw-ico" style="background:#fff7e8"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M10 8.5 15.5 12 10 15.5v-7z" fill="var(--amber)" stroke="none"/></svg></div><div><div class="hp-hiw-t">Schedule job search</div><div class="hp-hiw-d">Get the latest jobs from top job platforms.</div></div></div>
      <div class="hp-hiw-item"><div class="hp-hiw-ico" style="background:#f5f0ff"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9333ea" stroke-width="1.6" stroke-linecap="round"><path d="M9.8 15.9 9 18.8l-.8-2.9a4.5 4.5 0 0 0-3.1-3.1L2.3 12l2.8-.8a4.5 4.5 0 0 0 3.1-3.1L9 5.3l.8 2.8a4.5 4.5 0 0 0 3.1 3.1l2.8.8-2.8.8a4.5 4.5 0 0 0-3.1 3.1zM18.3 8.7 18 9.8l-.3-1a3.4 3.4 0 0 0-2.4-2.5L14.3 6l1-.3a3.4 3.4 0 0 0 2.4-2.4L18 2.3l.3 1a3.4 3.4 0 0 0 2.4 2.4l1 .3-1 .3a3.4 3.4 0 0 0-2.4 2.4z"/></svg></div><div><div class="hp-hiw-t">Wait for AI scoring</div><div class="hp-hiw-d">Each job scored vs your profile. No duplicates.</div></div></div>
      <div class="hp-hiw-item"><div class="hp-hiw-ico" style="background:var(--green-soft)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="1.6" stroke-linecap="round"><path d="M3 8l7.9 5.3a2 2 0 0 0 2.2 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"/></svg></div><div><div class="hp-hiw-t">Get job matches</div><div class="hp-hiw-d">Email digest with the gems. Open. Apply. Done.</div></div></div>
    </div>
  </div>

  <!-- Usage modes -->
  <div id="home-card-modes" class="hp-card" style="padding:18px 20px">
    <div class="hp-card-head">
      <div class="hp-card-title">Three ways to run it</div>
      <button class="hp-dismiss" onclick="dismissHomeCard('modes')" aria-label="Dismiss">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6l-12 12"/></svg>
      </button>
    </div>
    <div class="hp-hiw-list">
      <div class="hp-hiw-item start"><div class="hp-hiw-ico" style="background:var(--green-soft)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="1.6" stroke-linecap="round"><path d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 0 0 3-3V8a3 3 0 0 0-3-3H6a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3z"/></svg></div><div><div class="hp-hiw-t">Buy credits</div><div class="hp-hiw-d">Use my API keys, pay per use. Top up in <a href="/settings?tab=ai">Settings</a> or navigation panel.</div></div></div>
      <div class="hp-hiw-item start"><div class="hp-hiw-ico" style="background:#eef6ff"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2f6bff" stroke-width="1.6" stroke-linecap="round"><path d="M15 7a2 2 0 0 1 2 2m4 0a6 6 0 0 1-7.7 5.7L11 17H9v2H7v2H4a1 1 0 0 1-1-1v-2.6a1 1 0 0 1 .3-.7l6-6A6 6 0 1 1 21 9z"/></svg></div><div><div class="hp-hiw-t">Use your own API keys</div><div class="hp-hiw-d">Add OpenAI + Apify keys in <a href="/settings?tab=ai">Settings</a>.</div></div></div>
      <div class="hp-hiw-item start"><div class="hp-hiw-ico" style="background:#f1f2f5"><svg width="16" height="16" viewBox="0 0 24 24" fill="#5b6472"><path d="M12 2C6.5 2 2 6.5 2 12c0 4.4 2.9 8.2 6.8 9.5.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.6 0 0 .8-.3 2.7 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.6.6.7 1 1.6 1 2.7 0 3.8-2.3 4.6-4.6 4.9.4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A10 10 0 0 0 22 12c0-5.5-4.5-10-10-10z"/></svg></div><div><div class="hp-hiw-t">Self-host</div><div class="hp-hiw-d"><a href="https://github.com/girshovich/job-hunter" target="_blank" rel="noopener">Fork on GitHub</a> for personal use.</div></div></div>
    </div>
  </div>

</div>

<!-- ── Search for Jobs ── -->
<div id="run-card" class="hp-card hp-run">
  <div class="hp-run-top">
    <div>
      <div class="hp-run-title">Search for Jobs</div>
      <div class="hp-run-sub">Fetch jobs, score with AI, send email digest if you chose to.</div>
    </div>
    <div style="display:flex;align-items:center;gap:10px">
      <% if (canRun) { %>
      <button id="home-schedule-btn" class="hp-btn hp-btn-sched" onclick="homeSchedule()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
        <span data-schedule-label>Schedule</span>
      </button>
      <!-- Morphs into a red "Stop run" button while a run is in progress — see setRunBtnMode(). -->
      <button id="home-run-btn" data-mode="run" class="hp-btn hp-btn-run" onclick="homeRunAction(this)">
        <span id="home-run-icon-wrap"><svg id="home-run-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 3l14 9-14 9V3z"/></svg></span>
        <span id="home-run-label">Run Once</span>
      </button>
      <% } else { %>
      <button id="home-schedule-btn" class="hp-btn hp-btn-lock" onclick="showLockedMessage()" disabled>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 15v2m-6 4h12a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2zm10-10V7a4 4 0 0 0-8 0v4h8z"/></svg>
        <span data-schedule-label>Schedule</span>
      </button>
      <button id="home-run-btn" data-locked="1" class="hp-btn hp-btn-lock" onclick="showLockedMessage()" disabled>
        <svg id="home-run-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 15v2m-6 4h12a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2zm10-10V7a4 4 0 0 0-8 0v4h8z"/></svg>
        <span id="home-run-label">Run Once</span>
      </button>
      <% } %>
    </div>
  </div>
  <div id="preflight-errors" class="hp-preflight hidden">
    <p class="hp-preflight-title">Can't run — fix the following first:</p>
    <ul id="preflight-errors-list" class="hp-preflight-list"></ul>
  </div>
  <div id="home-run-progress" class="hp-progress hidden">
    <div class="hp-pbar-row">
      <div class="hp-pbar"><span id="home-run-bar"></span></div>
      <span id="home-run-pct" class="hp-pct">0%</span>
    </div>
    <p id="home-run-status-text" class="hp-pstatus">Starting…</p>
  </div>
  <div id="home-run-result" class="hp-result hidden"></div>
</div>

<!-- ── Last run + last matches (side by side) ── -->
<div class="hp-grid2">

  <!-- Last run stats (compact) -->
  <div>
    <% if (lastRun) { %>
    <div class="hp-card" style="padding:18px 20px">
      <div class="hp-sess-head">
        <div class="hp-sess-title">Last Session</div>
        <span class="hp-status-pill" style="<%= statusTone(lastRun.status) %>"><%= formatRunStatusLabel(lastRun.status) %></span>
      </div>
      <div class="hp-stat3">
        <div class="hp-stat hp-stat-fetched"><div class="hp-stat-n" style="color:var(--ink)"><%= lastRun.jobs_fetched %></div><div class="hp-stat-l">Fetched</div></div>
        <div class="hp-stat hp-stat-strong"><div class="hp-stat-n" style="color:var(--green2)"><%= liveStrong %></div><div class="hp-stat-l">Strong</div></div>
        <div class="hp-stat hp-stat-weak"><div class="hp-stat-n" style="color:var(--amber-ink)"><%= liveWeak %></div><div class="hp-stat-l">Weak</div></div>
      </div>
      <p class="hp-sess-foot"><%= formatDate(lastRun.ran_at) %><% if (lastRun.duration_ms) { %> · <%= (lastRun.duration_ms / 1000).toFixed(0) %>s<% } %></p>
      <% if (lastRun.error_log) { %>
      <details class="hp-empty-err">
        <summary class="hp-err-sum">Error details</summary>
        <pre class="hp-err-pre"><%= lastRun.error_log %></pre>
      </details>
      <% } %>
    </div>
    <% } else { %>
    <div class="hp-card hp-empty">
      No runs yet. Hit <strong>Run Once</strong> to start.
    </div>
    <% } %>
  </div>

  <!-- Last job matches -->
  <div>
    <div class="hp-card" style="overflow:hidden">
      <div class="hp-matches-head">
        <div class="hp-matches-title">Last Session — Strong Matches</div>
        <div class="hp-matches-meta">
          <% if (lastRunJobs.length > 0) { %><span class="hp-matches-count"><%= Math.min(50, lastRunJobs.length) %><% if (lastRunJobs.length > 50) { %> of <%= lastRunJobs.length %><% } %></span><% } %>
          <a href="/jobs" class="hp-view-all">View all →</a>
        </div>
      </div>
      <% if (lastRunJobs.length === 0) { %>
      <div class="hp-empty">No strong matches from the last run.</div>
      <% } else { %>
      <div>
        <% lastRunJobs.slice(0, 50).forEach(job => {
          const cardVerdict = job.is_duplicate ? 'DUPLICATE' : job.ai_verdict;
          const applyUrl = job.apply_url || job.url;
          const _pick = pickPrimaryLocation(job.locationLabels, job.country, locPref);
          const _primaryLoc = _pick.primary || job.location;
          const _flag = countryToFlag(_pick.flagCountry);
        %>
        <div class="hp-mrow" onclick="if(!event.target.closest('.verdict-btn,a,button')) homeJobClick(<%= job.id %>)">
          <%- renderCompanyLogo(job.company, job.logo_url) %>
          <div class="hp-mident">
            <div class="hp-mtitle"><%= job.title %></div>
            <div class="hp-mcompany"><%= job.company %><% if (_primaryLoc) { %> · <%- _flag ? _flag + ' ' : '' %><%= _primaryLoc %><% if (job.locationLabels && job.locationLabels.length > 1) { %> <span style="color:var(--faintest)">+<%= job.locationLabels.length - 1 %></span><% } %><% } %></div>
          </div>
          <div class="hp-mright">
            <%- renderVerdictSelector(cardVerdict, { 'data-job-id': job.id, 'data-verdict': cardVerdict, 'data-chip-style': 'compact', class: 'cursor-pointer' }) %>
            <%- renderScoreCell(job.ai_score, cardVerdict) %>
            <% if (applyUrl) { %><a href="<%= applyUrl %>" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()" class="hp-apply">Apply<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg></a><% } %>
          </div>
        </div>
        <% }); %>
      </div>
      <% } %>
    </div>
  </div>

</div>

<script>
let homeRunPoller = null;
let homeStopRequested = false;

// ── Dismissible intro cards ──
const HOME_CARDS = ['letter', 'hiw', 'modes'];
function dismissHomeCard(key) {
  try { localStorage.setItem('home-card-' + key, '1'); } catch(_) {}
  document.getElementById('home-card-' + key)?.classList.add('hidden');
  const row = document.getElementById('home-cards-row');
  if (row && HOME_CARDS.every(k => document.getElementById('home-card-' + k)?.classList.contains('hidden'))) {
    row.classList.add('hidden');
  }
}
(function initHomeCards() {
  let allHidden = true;
  HOME_CARDS.forEach(key => {
    try {
      if (localStorage.getItem('home-card-' + key) === '1') {
        document.getElementById('home-card-' + key)?.classList.add('hidden');
      } else { allHidden = false; }
    } catch(_) { allHidden = false; }
  });
  if (allHidden) document.getElementById('home-cards-row')?.classList.add('hidden');
})();

function showLockedMessage() {
  showPreflightErrors(['Add credits or enable your own API keys in <a href="/settings?tab=ai">Settings → AI Setup</a> to run.']);
}

function homeJobClick(id) {
  location.href = '/job/' + id + '?from=home';
}

async function preflight() {
  const res = await fetch('/api/preflight');
  return res.json(); // { ok, errors }
}

function showPreflightErrors(errors) {
  const wrap = document.getElementById('preflight-errors');
  const list = document.getElementById('preflight-errors-list');
  list.innerHTML = errors.map(e => `<li>${escHtml(e)}</li>`).join('');
  wrap.classList.remove('hidden');
}

function clearPreflightErrors() {
  document.getElementById('preflight-errors').classList.add('hidden');
  document.getElementById('preflight-errors-list').innerHTML = '';
}

async function homeSchedule() {
  // If schedule is active, show status modal (no preflight needed)
  if (typeof _scheduleActive !== 'undefined' && _scheduleActive) {
    handleScheduleClick();
    return;
  }
  clearPreflightErrors();
  try {
    const check = await preflight();
    if (!check.ok) { showPreflightErrors(check.errors); return; }
  } catch (e) {
    showPreflightErrors(['Could not verify configuration: ' + e.message]);
    return;
  }
  handleScheduleClick();
}

async function homeRun(btn) {
  clearPreflightErrors();
  try {
    const check = await preflight();
    if (!check.ok) { showPreflightErrors(check.errors); return; }
  } catch (e) {
    showPreflightErrors(['Could not verify configuration: ' + e.message]);
    return;
  }

  // Set callback that will be invoked by submitRun() after a successful API call
  _runCallback = startHomeProgress;

  openRunModal();
}

// ── Run / Stop: one button, three modes ──
// While a run is in progress the Run Once button becomes Stop run, so the header never carries a
// dead "Running…" control. Stopping is cooperative: the server stops at its next checkpoint.
const RUN_ICON_PLAY = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3l14 9-14 9V3z"/>';
const RUN_ICON_STOP = '<rect x="6" y="6" width="12" height="12" rx="1.5" stroke-width="2"/>';

/** mode: 'run' | 'stop' | 'stopping' */
function setRunBtnMode(mode) {
  const btn = document.getElementById('home-run-btn');
  if (!btn || btn.dataset.locked === '1') return;   // no credits / no keys — button stays locked
  btn.dataset.mode = mode;
  btn.disabled = mode === 'stopping';
  btn.className = 'hp-btn hp-btn-run' + (mode === 'run' ? '' : ' stop') + (mode === 'stopping' ? ' stopping' : '');
  document.getElementById('home-run-icon').innerHTML = mode === 'run' ? RUN_ICON_PLAY : RUN_ICON_STOP;
  document.getElementById('home-run-label').textContent =
    mode === 'run' ? 'Run Once' : mode === 'stop' ? 'Stop run' : 'Stopping…';
}

function homeRunAction(btn) {
  if (btn.dataset.mode === 'stop') stopRun();
  else homeRun(btn);
}

function showStopping() {
  homeStopRequested = true;
  setRunBtnMode('stopping');
  document.getElementById('home-run-status-text').innerHTML =
    'Stopping… will stop before the next API request.';
}

async function stopRun() {
  showStopping();
  try {
    await fetch('/api/run/stop', { method: 'POST' });
  } catch (_) { /* the poller will reflect the real state either way */ }
}

function updateProgress(stage) {
  const bar = document.getElementById('home-run-bar');
  const pctEl = document.getElementById('home-run-pct');
  const statusText = document.getElementById('home-run-status-text');
  const pct = stage ? stage.pct : 0;
  bar.style.width = pct + '%';
  pctEl.textContent = pct + '%';
  // A pending stop owns the status line — don't let stage updates overwrite it.
  if (homeStopRequested) return;
  if (!stage) { statusText.innerHTML = 'Starting…'; return; }
  const s = stage;
  const spinner = `<svg class="inline-block w-3.5 h-3.5 animate-spin align-text-bottom" style="color:var(--green)" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>`;
  const parts = [];
  if (s.providerCount > 1) parts.push(`Provider <strong style="color:var(--ink2)">${s.providerIdx}/${s.providerCount}</strong>`);
  if (s.roleIdx != null && s.roleCount != null) parts.push(`Role <strong style="color:var(--ink2)">${s.roleIdx}/${s.roleCount}</strong>`);
  if (s.action) parts.push(`${spinner} <span style="color:var(--green2);font-weight:600">${s.action}</span>`);
  statusText.innerHTML = parts.length ? parts.join(' · ') : (s.text || 'Running…');
}

function startPolling() {
  const progress = document.getElementById('home-run-progress');
  if (homeRunPoller) clearInterval(homeRunPoller);
  homeRunPoller = setInterval(async () => {
    try {
      const res = await fetch('/api/status');
      const data = await res.json();
      if (data.stopRequested) showStopping();
      if (data.stage) updateProgress(data.stage);
      if (!data.isRunning && data.lastRun) {
        clearInterval(homeRunPoller);
        homeStopRequested = false;
        updateProgress({ pct: 100 });
        const r = data.lastRun;
        const stopped = r.status === 'stopped';
        const ok = r.status === 'success' || r.status === 'partial_error';
        const tookSec = r.duration_ms ? ` · ${(r.duration_ms / 1000).toFixed(0)}s` : '';
        const errLine = r.error_log ? r.error_log.split('\n')[0] : 'unknown error';
        if (stopped) {
          // lastRun is the in-memory PipelineResult (camelCase) for a just-finished run,
          // or the aggregated DB row (snake_case) after a reload.
          const kept = r.jobs_scored ?? r.jobsScored ?? 0;
          showRunResult(`Run stopped${tookSec} · ${kept} job${kept === 1 ? '' : 's'} scored and kept · <a href="/">Refresh to see them</a>`, 'neutral');
        } else {
          showRunResult(
            ok ? `Done${tookSec} · <a href="/">Refresh to see new jobs</a>`
               : `Run failed${tookSec} · ${errLine} · <a href="/reports">View log</a>`,
            ok ? 'success' : 'error',
          );
        }
        resetRunBtn(progress);
        if (ok) setTimeout(() => location.reload(), 3000);
      }
    } catch (_) {}
  }, 2000);
}

function startHomeProgress() {
  homeStopRequested = false;
  setRunBtnMode('stop');
  document.getElementById('home-run-progress').classList.remove('hidden');
  document.getElementById('home-run-result').classList.add('hidden');
  updateProgress(null);
  startPolling();
}

function showRunResult(msg, tone) {
  const color = tone === 'success' ? 'var(--green2)' : tone === 'neutral' ? 'var(--muted)' : 'var(--red-ink)';
  const el = document.getElementById('home-run-result');
  el.innerHTML = `<span style="color:${color}">${msg}</span>`;
  el.classList.remove('hidden');
}

function resetRunBtn(progress) {
  setTimeout(() => {
    homeStopRequested = false;
    setRunBtnMode('run');
    progress.classList.add('hidden');
  }, 3000);
}

function escHtml(str) {
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function syncRunState(data) {
  if (!data.isRunning) return;
  homeStopRequested = false;
  setRunBtnMode('stop');
  document.getElementById('home-run-progress').classList.remove('hidden');
  if (data.stage) updateProgress(data.stage);
  // A stop requested before this page load (or in another tab) must still show as Stopping…
  if (data.stopRequested) showStopping();
  startPolling();
}
fetch('/api/status').then(r => r.json()).then(syncRunState).catch(() => {});
document.addEventListener('visibilitychange', () => {
  if (!document.hidden) fetch('/api/status').then(r => r.json()).then(syncRunState).catch(() => {});
});
</script>
