<!-- ── Search for Jobs ── -->
<div id="run-card" class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 mb-6">
  <div class="flex items-center justify-between flex-wrap gap-4">
    <div>
      <h2 class="font-semibold text-gray-900">Search for Jobs</h2>
      <p class="text-sm text-gray-500 mt-0.5">Fetch jobs, score with AI, send email digest if you chose to.</p>
    </div>
    <div class="flex items-center gap-2">
      <% if (canRun) { %>
      <button id="home-schedule-btn" onclick="homeSchedule()"
              class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2.5 rounded-xl text-sm transition-colors shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span data-schedule-label>Schedule</span>
      </button>
      <button id="home-run-btn" onclick="homeRun(this)"
              class="inline-flex items-center gap-2 jh-btn-success text-white font-semibold px-5 py-2.5 rounded-xl text-sm transition-colors shadow-sm">
        <svg id="home-run-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3l14 9-14 9V3z"/>
        </svg>
        <span id="home-run-label">Run Once</span>
      </button>
      <% } else { %>
      <button id="home-schedule-btn" onclick="showLockedMessage()"
              class="inline-flex items-center gap-2 bg-gray-100 text-gray-400 font-semibold px-5 py-2.5 rounded-xl text-sm shadow-sm cursor-not-allowed" disabled>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <span data-schedule-label>Schedule</span>
      </button>
      <button id="home-run-btn" onclick="showLockedMessage()"
              class="inline-flex items-center gap-2 bg-gray-100 text-gray-400 font-semibold px-5 py-2.5 rounded-xl text-sm shadow-sm cursor-not-allowed" disabled>
        <svg id="home-run-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <span id="home-run-label">Run Once</span>
      </button>
      <% } %>
    </div>
  </div>
  <div id="preflight-errors" class="hidden mt-4 bg-red-50 border border-red-200 rounded-xl px-4 py-3">
    <p class="text-xs font-semibold text-red-700 mb-1.5">Can't run — fix the following first:</p>
    <ul id="preflight-errors-list" class="space-y-0.5 text-xs text-red-600 list-disc list-inside"></ul>
  </div>
  <div id="home-run-progress" class="hidden mt-4">
    <div class="flex items-center gap-3 mb-2">
      <div class="flex-1 h-2 bg-gray-100 rounded-full overflow-hidden">
        <div id="home-run-bar" class="h-full bg-emerald-500 rounded-full transition-all duration-500 ease-out" style="width:0%"></div>
      </div>
      <span id="home-run-pct" class="text-2xl font-bold text-gray-900 tabular-nums flex-shrink-0">0%</span>
    </div>
    <p id="home-run-status-text" class="text-sm text-gray-500">Starting…</p>
  </div>
  <div id="home-run-result" class="hidden mt-4 text-sm"></div>
</div>

<!-- ── Last run + last matches (side by side) ── -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- Last run stats (compact) -->
  <div>
    <% if (lastRun) { %>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-sm font-semibold text-gray-700">Last Session</h2>
        <span class="text-xs px-2 py-0.5 rounded-full font-medium <%= statusColor(lastRun.status) %>">
          <%= lastRun.status.replace('_', ' ') %>
        </span>
      </div>
      <div class="grid grid-cols-3 gap-2 text-center">
        <div class="bg-gray-50 rounded-lg p-2">
          <div class="text-base font-bold text-gray-900"><%= lastRun.jobs_fetched %></div>
          <div class="text-xs text-gray-400">Fetched</div>
        </div>
        <div class="bg-emerald-50 rounded-lg p-2">
          <div class="text-base font-bold text-emerald-600"><%= liveStrong %></div>
          <div class="text-xs text-gray-400">Strong</div>
        </div>
        <div class="bg-yellow-50 rounded-lg p-2">
          <div class="text-base font-bold text-yellow-600"><%= liveWeak %></div>
          <div class="text-xs text-gray-400">Weak</div>
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-3"><%= formatDate(lastRun.ran_at) %><% if (lastRun.duration_ms) { %> · <%= (lastRun.duration_ms / 1000).toFixed(0) %>s<% } %></p>
      <% if (lastRun.error_log) { %>
      <details class="mt-2">
        <summary class="text-xs text-red-500 cursor-pointer">Error details</summary>
        <pre class="text-xs text-red-600 bg-red-50 p-2 rounded mt-1 overflow-auto max-h-24"><%= lastRun.error_log %></pre>
      </details>
      <% } %>
    </div>
    <% } else { %>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5 text-center text-sm text-gray-400">
      No runs yet. Hit <strong>Run Once</strong> to start.
    </div>
    <% } %>
  </div>

  <!-- Last job matches -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
        <h2 class="font-semibold text-gray-900 text-sm">Last Session — Strong Matches</h2>
        <div class="flex items-center gap-3">
          <% if (lastRunJobs.length > 0) { %><span class="text-xs text-gray-400"><%= Math.min(50, lastRunJobs.length) %><% if (lastRunJobs.length > 50) { %> of <%= lastRunJobs.length %><% } %></span><% } %>
          <a href="/jobs" class="text-xs text-blue-600 hover:underline">View all →</a>
        </div>
      </div>
      <% if (lastRunJobs.length === 0) { %>
      <div class="px-5 py-10 text-center text-sm text-gray-400">No strong matches from the last run.</div>
      <% } else { %>
      <ul class="divide-y divide-gray-50">
        <% lastRunJobs.slice(0, 50).forEach(job => { %>
        <li class="px-5 py-3.5 hover:bg-gray-50 transition-colors cursor-pointer" onclick="homeJobClick(<%= job.id %>)">
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-start gap-2 flex-1 min-w-0">
              <%- renderCompanyLogo(job.company, job.logo_url) %>
              <div class="min-w-0">
                <p class="text-sm font-medium text-gray-900 truncate"><%= job.title %></p>
                <p class="text-xs text-gray-400 mt-0.5 truncate">
                  <span class="md:hidden"><%= job.company %></span>
                  <span class="hidden md:inline"><%= job.company %><% if (job.location) { %> · <%- countryToFlag(job.country) ? countryToFlag(job.country) + ' ' : '' %><%= job.location %><% } %></span>
                </p>
              </div>
            </div>
            <div class="hidden md:flex items-center gap-2 flex-shrink-0">
              <button class="verdict-btn" data-job-id="<%= job.id %>" data-verdict="<%= job.is_duplicate ? 'DUPLICATE' : job.ai_verdict %>" data-chip-style="compact"><%- verdictChip(job.is_duplicate ? 'DUPLICATE' : job.ai_verdict) %></button>
              <%- renderScoreCell(job.ai_score) %>
              <%- renderSourceLinkCell(job.url, job.job_source || 'LinkedIn') %>
            </div>
            <div class="md:hidden flex-shrink-0"><%- renderScoreCell(job.ai_score) %></div>
          </div>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </div>
  </div>

</div>

<script>
let homeRunPoller = null;

// ── Dismissible intro cards ──
const HOME_CARDS = ['letter', 'hiw', 'modes'];
function dismissHomeCard(key) {
  try { localStorage.setItem('home-card-' + key, '1'); } catch(_) {}
  document.getElementById('home-card-' + key)?.classList.add('hidden');
  const row = document.getElementById('home-cards-row');
  if (row && HOME_CARDS.every(k => document.getElementById('home-card-' + k)?.classList.contains('hidden'))) {
    row.classList.add('hidden');
  }
}
(function initHomeCards() {
  let allHidden = true;
  HOME_CARDS.forEach(key => {
    try {
      if (localStorage.getItem('home-card-' + key) === '1') {
        document.getElementById('home-card-' + key)?.classList.add('hidden');
      } else { allHidden = false; }
    } catch(_) { allHidden = false; }
  });
  if (allHidden) document.getElementById('home-cards-row')?.classList.add('hidden');
})();

function showLockedMessage() {
  showPreflightErrors(['Add credits or enable your own API keys in <a href="/settings?tab=ai" class="underline font-medium">Settings → AI Setup</a> to run.']);
}

function homeJobClick(id) {
  location.href = '/job/' + id + '?from=home';
}

async function quickToggleApplied(event, jobId, btn) {
  event.stopPropagation();
  const next = btn.dataset.applied !== '1';
  btn.dataset.applied = next ? '1' : '0';
  btn.className = 'inline-flex h-7 items-center justify-center rounded-lg px-2 text-xs font-medium border transition-colors whitespace-nowrap ' + window.JHUI.getAppliedTone(next);
  btn.textContent = window.JHUI.formatAppliedLabel(next);
  await fetch('/api/jobs/' + jobId + '/applied', {
    method: 'PATCH', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ applied: next }),
  }).catch(() => {});
}

async function preflight() {
  const res = await fetch('/api/preflight');
  return res.json(); // { ok, errors }
}

function showPreflightErrors(errors) {
  const wrap = document.getElementById('preflight-errors');
  const list = document.getElementById('preflight-errors-list');
  list.innerHTML = errors.map(e => `<li>${escHtml(e)}</li>`).join('');
  wrap.classList.remove('hidden');
}

function clearPreflightErrors() {
  document.getElementById('preflight-errors').classList.add('hidden');
  document.getElementById('preflight-errors-list').innerHTML = '';
}

async function homeSchedule() {
  // If schedule is active, show status modal (no preflight needed)
  if (typeof _scheduleActive !== 'undefined' && _scheduleActive) {
    handleScheduleClick();
    return;
  }
  clearPreflightErrors();
  try {
    const check = await preflight();
    if (!check.ok) { showPreflightErrors(check.errors); return; }
  } catch (e) {
    showPreflightErrors(['Could not verify configuration: ' + e.message]);
    return;
  }
  handleScheduleClick();
}

async function homeRun(btn) {
  clearPreflightErrors();
  try {
    const check = await preflight();
    if (!check.ok) { showPreflightErrors(check.errors); return; }
  } catch (e) {
    showPreflightErrors(['Could not verify configuration: ' + e.message]);
    return;
  }

  // Set callback that will be invoked by submitRun() after a successful API call
  _runCallback = function() {
    startHomeProgress(btn);
  };

  openRunModal();
}

function updateProgress(stage) {
  const bar = document.getElementById('home-run-bar');
  const pctEl = document.getElementById('home-run-pct');
  const statusText = document.getElementById('home-run-status-text');
  const pct = stage ? stage.pct : 0;
  bar.style.width = pct + '%';
  pctEl.textContent = pct + '%';
  if (!stage) { statusText.innerHTML = 'Starting…'; return; }
  const s = stage;
  const spinner = `<svg class="inline-block w-3.5 h-3.5 animate-spin text-emerald-500 align-text-bottom" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>`;
  const parts = [];
  if (s.providerCount > 1) parts.push(`Provider <strong class="text-gray-700">${s.providerIdx}/${s.providerCount}</strong>`);
  if (s.roleIdx != null && s.roleCount != null) parts.push(`Role <strong class="text-gray-700">${s.roleIdx}/${s.roleCount}</strong>`);
  if (s.action) parts.push(`${spinner} <span class="text-emerald-600 font-medium">${s.action}</span>`);
  statusText.innerHTML = parts.length ? parts.join(' · ') : (s.text || 'Running…');
}

function startPolling(btn) {
  const label = document.getElementById('home-run-label');
  const progress = document.getElementById('home-run-progress');
  if (homeRunPoller) clearInterval(homeRunPoller);
  homeRunPoller = setInterval(async () => {
    try {
      const res = await fetch('/api/status');
      const data = await res.json();
      if (data.stage) updateProgress(data.stage);
      if (!data.isRunning && data.lastRun) {
        clearInterval(homeRunPoller);
        updateProgress({ pct: 100 });
        const r = data.lastRun;
        const ok = r.status === 'success' || r.status === 'partial_error';
        const tookSec = r.duration_ms ? ` · ${(r.duration_ms / 1000).toFixed(0)}s` : '';
        const errLine = r.error_log ? r.error_log.split('\n')[0] : 'unknown error';
        showRunResult(
          ok ? `Done${tookSec} · <a href="/" class="underline font-medium">Refresh to see new jobs</a>`
             : `Run failed${tookSec} · ${errLine} · <a href="/reports" class="underline font-medium">View log</a>`,
          ok,
        );
        resetRunBtn(btn, label, progress);
        if (ok) setTimeout(() => location.reload(), 3000);
      }
    } catch (_) {}
  }, 2000);
}

function startHomeProgress(btn) {
  const label = document.getElementById('home-run-label');
  const progress = document.getElementById('home-run-progress');
  const result = document.getElementById('home-run-result');

  btn.disabled = true;
  btn.classList.add('opacity-60', 'cursor-not-allowed');
  label.textContent = 'Running…';
  progress.classList.remove('hidden');
  result.classList.add('hidden');
  updateProgress(null);
  startPolling(btn);
}

function showRunResult(msg, success) {
  const el = document.getElementById('home-run-result');
  el.innerHTML = `<span class="${success ? 'text-emerald-700' : 'text-red-600'}">${msg}</span>`;
  el.classList.remove('hidden');
}

function resetRunBtn(btn, label, progress) {
  setTimeout(() => {
    btn.disabled = false;
    btn.classList.remove('opacity-60', 'cursor-not-allowed');
    label.textContent = 'Run Once';
    progress.classList.add('hidden');
    if (typeof applyHomeBtnCooldown === 'function') applyHomeBtnCooldown();
  }, 3000);
}

async function fetchPreview(btn) {
  const label = document.getElementById('fetch-preview-label');
  btn.disabled = true;
  btn.classList.add('opacity-60', 'cursor-not-allowed');
  label.textContent = '…';
  try {
    const res = await fetch('/api/fetch-preview', { method: 'POST' });
    const data = await res.json();
    if (!data.success) { alert('Error: ' + (data.error || 'Unknown error')); return; }
    showFetchPreviewModal(data.count, data.jobs);
  } catch (e) {
    alert('Network error: ' + e.message);
  } finally {
    btn.disabled = false;
    btn.classList.remove('opacity-60', 'cursor-not-allowed');
    label.textContent = 'P';
  }
}

function showFetchPreviewModal(count, jobs) {
  const existing = document.getElementById('fetch-preview-modal');
  if (existing) existing.remove();
  const rows = jobs.map(j => `
    <tr class="border-b border-gray-100 hover:bg-gray-50">
      <td class="py-2.5 pr-4 text-sm text-gray-700 font-medium whitespace-nowrap">${escHtml(j.company)}</td>
      <td class="py-2.5 pr-4 text-sm text-gray-900">${escHtml(j.title)}</td>
      <td class="py-2.5 text-sm">${j.url ? `<a href="${escHtml(j.url)}" target="_blank" class="text-blue-600 hover:underline whitespace-nowrap">View →</a>` : '<span class="text-gray-400">—</span>'}</td>
    </tr>`).join('');
  const modal = document.createElement('div');
  modal.id = 'fetch-preview-modal';
  modal.className = 'fixed inset-0 z-50 flex items-center justify-center p-4';
  modal.innerHTML = `
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="document.getElementById('fetch-preview-modal').remove()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[80vh] flex flex-col overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
        <div><h2 class="font-semibold text-gray-900 text-lg">Fetch Preview</h2>
        <p class="text-sm text-gray-500 mt-0.5"><span class="font-semibold text-blue-600">${count}</span> job${count !== 1 ? 's' : ''} fetched</p></div>
        <button onclick="document.getElementById('fetch-preview-modal').remove()" class="text-gray-400 hover:text-gray-600 p-1 rounded-lg hover:bg-gray-100">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="overflow-y-auto flex-1 px-6 py-2">
        ${count === 0 ? '<p class="text-center text-gray-400 py-8">No jobs found.</p>' :
          `<table class="w-full"><thead><tr class="text-xs text-gray-400 uppercase tracking-wide border-b border-gray-100">
            <th class="pb-2 pr-4 text-left font-medium">Company</th><th class="pb-2 pr-4 text-left font-medium">Title</th><th class="pb-2 text-left font-medium">Link</th>
          </tr></thead><tbody>${rows}</tbody></table>`}
      </div>
    </div>`;
  document.body.appendChild(modal);
}

function escHtml(str) {
  return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function syncRunState(data) {
  if (!data.isRunning) return;
  const btn = document.getElementById('home-run-btn');
  btn.disabled = true;
  btn.classList.add('opacity-60', 'cursor-not-allowed');
  document.getElementById('home-run-label').textContent = 'Running…';
  document.getElementById('home-run-progress').classList.remove('hidden');
  if (data.stage) updateProgress(data.stage);
  startPolling(btn);
}
fetch('/api/status').then(r => r.json()).then(syncRunState).catch(() => {});
document.addEventListener('visibilitychange', () => {
  if (!document.hidden) fetch('/api/status').then(r => r.json()).then(syncRunState).catch(() => {});
});


// ── How it works modal ──
function openHowItWorks() {
  if (document.getElementById('hiw-modal')) { document.getElementById('hiw-modal').remove(); return; }
  const modal = document.createElement('div');
  modal.id = 'hiw-modal';
  modal.className = 'fixed inset-0 z-50 flex items-center justify-center p-4';
  modal.innerHTML = `
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="document.getElementById('hiw-modal').remove()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
        <h2 class="font-semibold text-gray-900">How it works</h2>
        <button onclick="document.getElementById('hiw-modal').remove()"
                class="text-gray-400 hover:text-gray-600 p-1 rounded-lg hover:bg-gray-100 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <ol class="px-6 py-5 space-y-3 text-sm text-gray-600 leading-relaxed list-none">
        <li><span class="font-semibold text-gray-800">1. Fetch</span> — scrapes LinkedIn for each Role's keywords × locations combination.</li>
        <li><span class="font-semibold text-gray-800">2. Title filter</span> — removes jobs whose title doesn't match your filter words (per Role).</li>
        <li><span class="font-semibold text-gray-800">3. Blacklist</span> — removes jobs from blacklisted companies.</li>
        <li><span class="font-semibold text-gray-800">4. Dedup by ID</span> — removes jobs already seen in this or previous runs.</li>
        <li><span class="font-semibold text-gray-800">5. AI scoring</span> <span class="text-xs text-gray-400">(easy model)</span> — scores each new job 0–100 against the Role's prompt → verdict + rationale.</li>
        <li><span class="font-semibold text-gray-800">6. Duplicate check</span> <span class="text-xs text-gray-400">(easy → hard model)</span> — for Strong Matches with a known company history: titles-only pre-filter (easy), then full description dedup (hard) to detect reposts.</li>
        <li><span class="font-semibold text-gray-800">7. Re-score Strong Matches</span> <span class="text-xs text-gray-400">(hard model)</span> — all Strong Matches from this run are re-scored with the more accurate model; verdict and score are updated.</li>
        <li><span class="font-semibold text-gray-800">8. Store</span> — all results saved locally (every verdict, including blacklisted and duplicates).</li>
        <li><span class="font-semibold text-gray-800">9. Email digest</span> — strong matches emailed to you (if enabled in Settings).</li>
      </ol>
    </div>`;
  document.body.appendChild(modal);
}
</script>
