<%
function scoreTextColor(score) {
  if (score >= 85) return 'text-emerald-700 bg-emerald-50';
  if (score >= 71) return 'text-emerald-600 bg-emerald-50';
  return 'text-gray-600 bg-gray-100';
}
const tz = timezone || 'UTC';
function formatDate(iso) {
  return formatDateTimeToMinutes(iso, tz);
}
function statusColor(s) {
  if (s === 'success') return 'text-emerald-700 bg-emerald-50';
  if (s === 'partial_error') return 'text-yellow-700 bg-yellow-50';
  return 'text-red-700 bg-red-50';
}
function verdictChip(verdict) {
  return renderVerdictChip(verdict, { editable: isVerdictEditable(verdict) });
}
%>

<!-- Page header -->
<div class="flex items-center justify-between mb-4">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Start</h1>
    <p class="text-sm text-gray-500 mt-1"><%= new Date().toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
  </div>
</div>

<!-- ── Welcome + How it works + Modes ── -->
<div id="home-cards-row" class="flex flex-col md:flex-row md:items-stretch gap-4 mb-6">

  <!-- Letter card -->
  <div id="home-card-letter" class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 flex-1 min-w-0 flex flex-col">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-semibold text-gray-900">Hi, glad you made it!</h2>
      <button onclick="dismissHomeCard('letter')" class="text-gray-300 hover:text-gray-500 transition-colors flex-shrink-0 ml-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
