<style>
  /* ── Stats page (DS v2) — namespaced under .sp- to avoid global collisions ── */
  .sp-h1{margin:0;font-size:21px;font-weight:800;letter-spacing:-.02em;color:var(--ink)}
  .sp-date{font-size:13px;color:var(--faint);margin-top:3px;font-weight:600}
  .sp-card{background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow-card)}
  .sp-kpi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:22px}
  .sp-kpi{padding:20px;text-align:center}
  .sp-kpi-n{font-size:30px;font-weight:800;letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1.1}
  .sp-kpi-l{font-size:12px;color:var(--faint);font-weight:700;margin-top:6px}
  .sp-kpi-sub{font-size:11px;color:var(--fainter);font-weight:500;margin-top:3px}
  .sp-pad{padding:22px 24px}
  .sp-hd{padding:16px 20px 14px;border-bottom:1px solid var(--line)}
  .sp-title{font-size:14px;font-weight:800;letter-spacing:-.01em;color:var(--ink)}
  .sp-sub{font-size:12px;color:var(--faint);margin-top:3px;font-weight:500}
  .sp-statbar{display:flex;height:36px;border-radius:9px;overflow:hidden;gap:1px;margin-top:18px}
  .sp-statbar>div{display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:700}
  .sp-statlegend{display:flex;flex-wrap:wrap;gap:9px 20px;margin-top:16px}
  .sp-statleg{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--faint);font-weight:500}
  .sp-statdot{width:12px;height:12px;border-radius:4px;flex:none}
  .sp-grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:20px;align-items:start}
  .sp-tbl{width:100%;border-collapse:collapse}
  .sp-tbl thead th{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--faint);padding:10px 12px;background:#fafbfc;border-bottom:1px solid var(--line);text-align:center;white-space:nowrap}
  .sp-tbl thead th.l{text-align:left;padding-left:20px}
  .sp-tbl tbody td{padding:13px 12px;text-align:center;font-size:13px;border-top:1px solid #f3f4f6;color:var(--muted2)}
  .sp-tbl tbody td.l{text-align:left;padding-left:20px;font-weight:600;color:var(--ink)}
  .sp-tbl tbody tr:hover{background:#fafbfc}
  .sp-t-strong{color:var(--green2);font-weight:700}
  .sp-t-applied{color:var(--accent);font-weight:700}
  .sp-rate-wrap{display:inline-flex;align-items:center;gap:8px}
  .sp-rate-bar{width:60px;height:6px;background:#eef0f4;border-radius:999px;overflow:hidden}
  .sp-rate-bar>span{display:block;height:100%;background:var(--accent);border-radius:999px}
  .sp-rate-pct{font-size:12px;color:var(--faint);font-weight:600;width:30px;text-align:right}
  .sp-empty{padding:40px 20px;text-align:center;font-size:13px;color:var(--fainter)}
  .sp-clist{list-style:none;margin:0;padding:4px 20px;max-height:206px;overflow-y:auto}
  .sp-crow{display:flex;align-items:center;gap:12px;padding:11px 0;border-top:1px solid #f3f4f6}
  .sp-crow:first-child{border-top:0}
  .sp-cname{font-size:13px;color:var(--ink2);width:118px;flex:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .sp-cbar{flex:1;height:8px;background:#eef0f4;border-radius:999px;overflow:hidden}
  .sp-cbar>span{display:block;height:100%;background:#34c77b;border-radius:999px}
  .sp-cval{font-size:13px;font-weight:700;color:var(--ink2);width:22px;text-align:right;flex:none}
  .sp-capp{font-size:11.5px;color:var(--accent);font-weight:700;width:66px;text-align:right;flex:none}
  .sp-cmore{display:flex;align-items:center;justify-content:center;gap:6px;padding:11px;border-top:1px solid var(--line);font-size:12px;color:var(--faint);font-weight:600;cursor:pointer}
  .sp-cmore:hover{background:#fafbfc;color:var(--muted)}
  .sp-qlegend{display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:14px;margin-bottom:16px}
  /* By Role: table on desktop, utility rows on phones (the 5 columns clip below ~768px) */
  .sp-roles-mobile{display:none}
  .sp-rolerow{padding:13px 20px;border-top:1px solid #f3f4f6}
  .sp-rolerow:first-child{border-top:0}
  .sp-rolename{font-size:13px;font-weight:700;color:var(--ink);line-height:1.35;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
  .sp-rolemeta{display:flex;flex-wrap:wrap;gap:3px 12px;margin-top:5px;font-size:11.5px;font-weight:600;color:var(--faint)}
  .sp-rolemeta b{font-weight:700;color:var(--ink2);font-variant-numeric:tabular-nums}
  .sp-rolemeta b.sp-t-strong{color:var(--green2)}
  .sp-rolemeta b.sp-t-applied{color:var(--accent)}
  .sp-rolerate{display:flex;align-items:center;gap:8px;margin-top:9px}
  .sp-rolerate .sp-rate-bar{flex:1;width:auto}
  @media(max-width:960px){.sp-kpi-grid{grid-template-columns:1fr}.sp-grid2{grid-template-columns:minmax(0,1fr)}}
  @media(max-width:767px){.sp-roles-desktop{display:none}.sp-roles-mobile{display:block}}
</style>

<!-- Stats page -->
<div>
  <h1 class="sp-h1">Stats</h1>
  <p class="sp-date">How your job search is performing</p>
</div>

<!-- ── Overall numbers ── -->
<div class="sp-kpi-grid">
  <div class="sp-card sp-kpi">
    <div class="sp-kpi-n" style="color:var(--accent)"><%= totals.applied %></div>
    <div class="sp-kpi-l">Applied</div>
    <div class="sp-kpi-sub"><%= totals.strong > 0 ? Math.round(totals.applied / totals.strong * 100) : 0 %>% of strong matches</div>
  </div>
  <div class="sp-card sp-kpi">
    <div class="sp-kpi-n" style="color:var(--ink)"><%= totals.strong %></div>
    <div class="sp-kpi-l">Strong Matches</div>
    <div class="sp-kpi-sub">total found</div>
  </div>
  <div class="sp-card sp-kpi">
    <div class="sp-kpi-n" style="color:var(--faint)"><%= totals.total %></div>
    <div class="sp-kpi-l">Total Jobs Saved</div>
    <div class="sp-kpi-sub">all verdicts (deduplicated)</div>
  </div>
</div>

<!-- ── Status Breakdown ── -->
<% if (totals.total > 0) { %>
<%
  const STATUS_CONFIG = {
    STRONG_MATCH: { label: formatVerdictLabel('STRONG_MATCH'), bar: 'var(--green)' },
    WEAK_MATCH:   { label: formatVerdictLabel('WEAK_MATCH'),   bar: 'var(--amber)' },
    NO_MATCH:     { label: formatVerdictLabel('NO_MATCH'),     bar: 'var(--red)' },
    DUPLICATE:    { label: formatVerdictLabel('DUPLICATE'),    bar: 'var(--purple-strong)' },
    BLACKLISTED:  { label: formatVerdictLabel('BLACKLISTED'),  bar: '#9ca3af' },
    UNKNOWN:      { label: formatVerdictLabel('UNKNOWN'),      bar: '#d1d5db' },
  };
  const STATUS_ORDER = ['STRONG_MATCH', 'WEAK_MATCH', 'NO_MATCH', 'DUPLICATE', 'BLACKLISTED'];
  const sbMap = {};
  statusBreakdown.forEach(s => { sbMap[s.status] = s.count; });
  const orderedBreakdown = STATUS_ORDER.filter(k => sbMap[k]).map(k => ({ status: k, count: sbMap[k] }));
  statusBreakdown.forEach(s => { if (!STATUS_ORDER.includes(s.status) && s.count > 0) orderedBreakdown.push(s); });
  const totalCount = orderedBreakdown.reduce((a, s) => a + s.count, 0) || 1;
%>
<div class="sp-card sp-pad" style="margin-top:20px">
  <div class="sp-title">All Results by Status</div>
  <!-- Stacked proportional bar -->
  <div class="sp-statbar">
    <% orderedBreakdown.forEach(s => {
       const cfg = STATUS_CONFIG[s.status] || { label: formatVerdictLabel(s.status), bar: '#d1d5db' };
       const pct = Math.round(s.count / totalCount * 100);
    %>
    <% if (pct > 0) { %>
    <div style="width:<%= pct %>%;background:<%= cfg.bar %>;" title="<%= cfg.label %>: <%= s.count %> (<%= pct %>%)">
      <% if (pct >= 8) { %><%= pct %>%<% } %>
    </div>
    <% } %>
    <% }); %>
  </div>
  <!-- Legend -->
  <div class="sp-statlegend">
    <% orderedBreakdown.forEach(s => {
       const cfg = STATUS_CONFIG[s.status] || { label: formatVerdictLabel(s.status), bar: '#d1d5db' };
    %>
    <div class="sp-statleg">
      <span class="sp-statdot" style="background:<%= cfg.bar %>"></span>
      <%= cfg.label %>: <b style="color:<%= cfg.bar %>;margin-left:2px"><%= s.count %></b>
    </div>
    <% }); %>
  </div>
</div>
<% } %>

<!-- ── By Role + By Country ── -->
<div class="sp-grid2">

  <!-- By Role -->
  <div class="sp-card" style="overflow:hidden">
    <div class="sp-hd">
      <div class="sp-title">By Role</div>
      <div class="sp-sub">Strong matches found and applied per role</div>
    </div>
    <% if (groupStats.length === 0) { %>
    <div class="sp-empty">No roles yet.</div>
    <% } else { %>
    <table class="sp-tbl sp-roles-desktop">
      <thead>
        <tr><th class="l">Role</th><th>Found</th><th>Strong</th><th>Applied</th><th>Rate</th></tr>
      </thead>
      <tbody>
        <% groupStats.forEach(g => { %>
        <% const rate = g.strong > 0 ? Math.round(g.applied / g.strong * 100) : 0; %>
        <tr>
          <td class="l"><%= g.name %></td>
          <td><%= g.total %></td>
          <td class="sp-t-strong"><%= g.strong %></td>
          <td class="sp-t-applied"><%= g.applied %></td>
          <td>
            <div class="sp-rate-wrap">
              <div class="sp-rate-bar"><span style="width:<%= rate %>%"></span></div>
              <span class="sp-rate-pct"><%= rate %>%</span>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <!-- Phones: the 5-column table can't fit — same rows as utility rows (DS §6). -->
    <div class="sp-roles-mobile">
      <% groupStats.forEach(g => { %>
      <% const rate = g.strong > 0 ? Math.round(g.applied / g.strong * 100) : 0; %>
      <div class="sp-rolerow">
        <div class="sp-rolename"><%= g.name %></div>
        <div class="sp-rolemeta">
          <span>Found <b><%= g.total %></b></span>
          <span>Strong <b class="sp-t-strong"><%= g.strong %></b></span>
          <span>Applied <b class="sp-t-applied"><%= g.applied %></b></span>
        </div>
        <div class="sp-rolerate">
          <div class="sp-rate-bar"><span style="width:<%= rate %>%"></span></div>
          <span class="sp-rate-pct"><%= rate %>%</span>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>

  <!-- By Country -->
  <div class="sp-card" style="overflow:hidden">
    <div class="sp-hd">
      <div class="sp-title">By Country</div>
      <div class="sp-sub">Where strong matches are located</div>
    </div>
    <% if (countryStats.length === 0) { %>
    <div class="sp-empty">No data yet.</div>
    <% } else { %>
    <% const maxCountryStrong = countryStats[0] ? countryStats[0].strong : 1; %>
    <% const COUNTRY_VISIBLE = 4; const countryHidden = Math.max(0, countryStats.length - COUNTRY_VISIBLE); %>
    <ul id="country-list" class="sp-clist jh-scroll">
      <% countryStats.forEach(c => { %>
      <li class="sp-crow">
        <span class="sp-cname"><%= c.country %></span>
        <div class="sp-cbar"><span style="width:<%= Math.round(c.strong / maxCountryStrong * 100) %>%"></span></div>
        <span class="sp-cval"><%= c.strong %></span>
        <span class="sp-capp"><% if (c.applied > 0) { %><%= c.applied %> applied<% } %></span>
      </li>
      <% }); %>
    </ul>
    <% if (countryHidden > 0) { %>
    <div id="country-more" class="sp-cmore" onclick="document.getElementById('country-list').style.maxHeight='none';this.style.display='none';">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9l-7 7-7-7"/></svg>
      <%= countryHidden %> more countr<%= countryHidden === 1 ? 'y' : 'ies' %>
    </div>
    <% } %>
    <% } %>
  </div>

</div>

<!-- ── Daily Strong Matches — last 14 days ── -->
<div class="sp-card sp-pad" style="margin-top:20px">
  <div class="sp-title">Daily Strong Matches — last 14 days</div>
  <div class="sp-sub">AI strong matches kept vs. promoted/demoted by you</div>
  <div id="quality-legend" class="sp-qlegend"></div>
  <div style="overflow-x:auto" class="jh-scroll">
    <div id="quality-chart" style="display:flex;align-items:flex-end;gap:6px;"></div>
  </div>
</div>

<!-- ── Monthly Strong Matches — last 12 months ── -->
<div class="sp-card sp-pad" style="margin-top:20px">
  <div class="sp-title">Monthly Strong Matches — last 12 months</div>
  <div class="sp-sub">AI strong matches kept vs. promoted/demoted by you</div>
  <div id="quality-monthly-legend" class="sp-qlegend"></div>
  <div style="overflow-x:auto" class="jh-scroll">
    <div id="quality-monthly-chart" style="display:flex;align-items:flex-end;gap:6px;"></div>
  </div>
</div>

<!-- ── Daily costs — last 14 days ── -->
<div class="sp-card sp-pad" style="margin-top:20px">
  <div class="sp-title">Daily costs — last 14 days</div>
  <div class="sp-sub">Fetch and AI spend per day</div>
  <div id="cost-legend" class="sp-qlegend"></div>
  <div style="overflow-x:auto" class="jh-scroll">
    <div id="cost-chart" style="display:flex;align-items:flex-end;gap:6px;"></div>
  </div>
</div>

<script>
const QUALITY_RAW         = <%- JSON.stringify(strongQualityRaw) %>;
const QUALITY_MONTHLY_RAW = <%- JSON.stringify(strongQualityMonthlyRaw) %>;
const COST_RAW            = <%- JSON.stringify(dailyCostRaw) %>;
const COST_DAYS           = <%- JSON.stringify(costDays) %>;

// ── Shared helpers ────────────────────────────────────────────────────────────
const MN = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function getLastNDays(n) {
  const out = [];
  const now = new Date();
  for (let i = n-1; i >= 0; i--) {
    const d = new Date(now.getFullYear(), now.getMonth(), now.getDate()-i);
    out.push(d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'));
  }
  return out;
}
function getLastNMonths(n) {
  const out = [];
  const now = new Date();
  for (let i = n-1; i >= 0; i--) {
    const d = new Date(now.getFullYear(), now.getMonth()-i, 1);
    out.push(d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0'));
  }
  return out;
}

// ── Tooltip ───────────────────────────────────────────────────────────────────
let _tip = null;
function _ensureTip() {
  if (_tip) return;
  _tip = document.createElement('div');
  _tip.style.cssText = 'position:fixed;z-index:9999;background:#111827;color:#f9fafb;padding:8px 12px;border-radius:8px;font-size:12px;pointer-events:none;line-height:1.7;white-space:nowrap;box-shadow:0 4px 16px rgba(0,0,0,.35);display:none;';
  document.body.appendChild(_tip);
}
function _moveTip(e) {
  if (!_tip || _tip.style.display === 'none') return;
  const w = _tip.offsetWidth, h = _tip.offsetHeight;
  let x = e.clientX + 14, y = e.clientY - h - 10;
  if (x + w > window.innerWidth - 8) x = e.clientX - w - 14;
  if (y < 8) y = e.clientY + 14;
  _tip.style.left = x + 'px'; _tip.style.top = y + 'px';
}
function hideTip() { if (_tip) _tip.style.display = 'none'; }
document.addEventListener('mousemove', _moveTip);

// ── Stacked chart shared renderer (quality daily/monthly, costs daily) ────────
// A spec supplies the categories, how a value is written, and the tooltip suffix.
const QUALITY_SPEC = {
  order:  ['kept', 'promoted', 'demoted'],
  config: {
    kept:     { label: 'AI strong — kept',    color: 'var(--green)' },
    promoted: { label: 'Promoted to strong',  color: 'var(--amber)' },
    demoted:  { label: 'Demoted from strong', color: 'var(--red)' },
  },
  fmt: v => String(v),
  tipSuffix: ' strong matches',
  colW: 36,
};
// order[0] renders as the topmost segment — AI above, Fetch below.
const COST_SPEC = {
  order:  ['ai', 'fetch'],
  config: {
    ai:    { label: 'AI',    color: 'var(--sky-ink)' },
    fetch: { label: 'Fetch', color: 'var(--sky-border)' },
  },
  fmt: v => '$' + v.toFixed(3),
  tipSuffix: '',
  colW: 46,   // a "$0.302" label needs more room than a count before it collides when scrolled
};

function renderStackedChart(containerId, legendId, rawData, periods, getLabel, getKey, spec) {
  const ORDER = spec.order, CFG = spec.config;
  const dataMap = {};
  for (const p of periods) { dataMap[p] = {}; ORDER.forEach(c => { dataMap[p][c] = 0; }); }
  for (const row of rawData) {
    const key = getKey(row);
    if (dataMap[key] !== undefined && CFG[row.category]) {
      dataMap[key][row.category] += row.count;
    }
  }

  const BAR_H = 96;
  const rawMax = Math.max(...periods.map(p => ORDER.reduce((s,c) => s + dataMap[p][c], 0)));
  // Guard division by zero only — a fixed floor of 1 would scale dollar bars against $1.00.
  const maxTotal = rawMax > 0 ? rawMax : 1;

  const container = document.getElementById(containerId);
  container.style.height = (BAR_H + 46) + 'px';
  container.style.minWidth = (periods.length * spec.colW + (periods.length - 1) * 6) + 'px';
  container.innerHTML = periods.map(p => {
    const cats = dataMap[p];
    const total = ORDER.reduce((s,c) => s + cats[c], 0);
    const totalH = total > 0 ? Math.max(Math.round(total / maxTotal * BAR_H), 4) : 0;
    let segs = '', remaining = totalH;
    const present = ORDER.filter(c => cats[c] > 0);
    for (let i = 0; i < present.length; i++) {
      const c = present[i];
      const segH = i === present.length - 1 ? remaining : Math.round(cats[c] / total * totalH);
      remaining -= segH;
      segs += `<div style="width:100%;height:${segH}px;background:${CFG[c].color};flex-shrink:0;"></div>`;
    }
    const tipLines = ORDER.filter(c => cats[c] > 0).map(c =>
      `<span style="display:inline-block;width:9px;height:9px;border-radius:2px;background:${CFG[c].color};margin-right:5px;vertical-align:middle;"></span>${CFG[c].label}: <b>${spec.fmt(cats[c])}</b>`
    ).join('<br>');
    const label = getLabel(p);
    const tipData = JSON.stringify({ label, totalText: spec.fmt(total) + spec.tipSuffix, lines: tipLines });
    const safeData = tipData.replace(/"/g,'&quot;');
    return `<div style="flex:1;position:relative;padding-top:16px;padding-bottom:30px;">
      <div style="position:relative;width:100%;height:${BAR_H}px;display:flex;align-items:flex-end;cursor:default;"
           data-qtip="${safeData}" onmouseenter="showQTip(event,this)" onmouseleave="hideTip()">
        <div style="width:100%;height:${totalH}px;display:flex;flex-direction:column;border-radius:2px 2px 0 0;overflow:hidden;">${segs}</div>
        ${total > 0 ? `<span style="position:absolute;bottom:${totalH + 4}px;left:0;right:0;text-align:center;font-size:11px;font-weight:700;color:#374151;">${spec.fmt(total)}</span>` : ''}
      </div>
      <span style="font-size:10px;color:#6b7280;text-align:center;display:block;position:absolute;bottom:0;left:0;right:0;">${label}</span>
    </div>`;
  }).join('');

  document.getElementById(legendId).innerHTML = ORDER.map(c =>
    `<div style="display:flex;align-items:center;gap:4px;">
       <div style="width:10px;height:10px;border-radius:2px;background:${CFG[c].color};flex-shrink:0;"></div>
       <span style="font-size:11px;color:#6b7280;">${CFG[c].label}</span>
     </div>`
  ).join('');
}

function showQTip(e, el) {
  _ensureTip();
  const d = JSON.parse(el.dataset.qtip);
  _tip.innerHTML = `<div style="font-weight:700;margin-bottom:5px;border-bottom:1px solid rgba(255,255,255,.15);padding-bottom:4px;">${d.label} &mdash; ${d.totalText}</div>${d.lines}`;
  _tip.style.display = 'block';
  _moveTip(e);
}


renderStackedChart(
  'quality-chart', 'quality-legend', QUALITY_RAW,
  getLastNDays(14),
  d => { const p = d.split('-'); return MN[parseInt(p[1])-1] + ' ' + parseInt(p[2]); },
  row => row.day,
  QUALITY_SPEC
);
renderStackedChart(
  'quality-monthly-chart', 'quality-monthly-legend', QUALITY_MONTHLY_RAW,
  getLastNMonths(12),
  m => MN[parseInt(m.slice(5))-1] + '<br>\'' + m.slice(2,4),
  row => row.month,
  QUALITY_SPEC
);
// Days come from the server, already in the profile's timezone.
renderStackedChart(
  'cost-chart', 'cost-legend', COST_RAW,
  COST_DAYS,
  d => { const p = d.split('-'); return MN[parseInt(p[1])-1] + ' ' + parseInt(p[2]); },
  row => row.day,
  COST_SPEC
);

// Scroll charts to show the most recent (rightmost) data on load
['quality-chart', 'quality-monthly-chart', 'cost-chart'].forEach(id => {
  const el = document.getElementById(id);
  if (el && el.parentElement) el.parentElement.scrollLeft = el.parentElement.scrollWidth;
});
</script>
