<%- include('partials/_sp-styles') %>

<!-- Stats page -->
<div>
  <h1 class="sp-h1">Stats</h1>
  <p class="sp-date">How your job search is performing</p>
</div>

<!-- ── Overall numbers ── -->
<div class="sp-kpi-grid">
  <div class="sp-card sp-kpi">
    <div class="sp-kpi-n" style="color:var(--accent)"><%= totals.applied %></div>
    <div class="sp-kpi-l">Applied</div>
    <div class="sp-kpi-sub"><%= totals.strong > 0 ? Math.round(totals.applied / totals.strong * 100) : 0 %>% of strong matches</div>
  </div>
  <div class="sp-card sp-kpi">
    <div class="sp-kpi-n" style="color:var(--ink)"><%= totals.strong %></div>
    <div class="sp-kpi-l">Strong Matches</div>
    <div class="sp-kpi-sub">total found</div>
  </div>
  <div class="sp-card sp-kpi">
    <div class="sp-kpi-n" style="color:var(--faint)"><%= totals.total %></div>
    <div class="sp-kpi-l">Total Jobs Saved</div>
    <div class="sp-kpi-sub">all verdicts (deduplicated)</div>
  </div>
</div>

<!-- ── Status Breakdown ── -->
<% if (totals.total > 0) { %>
<%
  const STATUS_CONFIG = {
    STRONG_MATCH: { label: formatVerdictLabel('STRONG_MATCH'), bar: 'var(--green)' },
    WEAK_MATCH:   { label: formatVerdictLabel('WEAK_MATCH'),   bar: 'var(--amber)' },
    NO_MATCH:     { label: formatVerdictLabel('NO_MATCH'),     bar: 'var(--red)' },
    DUPLICATE:    { label: formatVerdictLabel('DUPLICATE'),    bar: 'var(--purple-strong)' },
    BLACKLISTED:  { label: formatVerdictLabel('BLACKLISTED'),  bar: '#9ca3af' },
    UNKNOWN:      { label: formatVerdictLabel('UNKNOWN'),      bar: '#d1d5db' },
  };
  const STATUS_ORDER = ['STRONG_MATCH', 'WEAK_MATCH', 'NO_MATCH', 'DUPLICATE', 'BLACKLISTED'];
  const sbMap = {};
  statusBreakdown.forEach(s => { sbMap[s.status] = s.count; });
  const orderedBreakdown = STATUS_ORDER.filter(k => sbMap[k]).map(k => ({ status: k, count: sbMap[k] }));
  statusBreakdown.forEach(s => { if (!STATUS_ORDER.includes(s.status) && s.count > 0) orderedBreakdown.push(s); });
  const totalCount = orderedBreakdown.reduce((a, s) => a + s.count, 0) || 1;
%>
<div class="sp-card sp-pad" style="margin-top:20px">
  <div class="sp-title">All Results by Status</div>
  <!-- Stacked proportional bar -->
  <div class="sp-statbar">
    <% orderedBreakdown.forEach(s => {
       const cfg = STATUS_CONFIG[s.status] || { label: formatVerdictLabel(s.status), bar: '#d1d5db' };
       const pct = Math.round(s.count / totalCount * 100);
    %>
    <% if (pct > 0) { %>
    <div style="width:<%= pct %>%;background:<%= cfg.bar %>;" title="<%= cfg.label %>: <%= s.count %> (<%= pct %>%)">
      <% if (pct >= 8) { %><%= pct %>%<% } %>
    </div>
    <% } %>
    <% }); %>
  </div>
  <!-- Legend -->
  <div class="sp-statlegend">
    <% orderedBreakdown.forEach(s => {
       const cfg = STATUS_CONFIG[s.status] || { label: formatVerdictLabel(s.status), bar: '#d1d5db' };
    %>
    <div class="sp-statleg">
      <span class="sp-statdot" style="background:<%= cfg.bar %>"></span>
      <%= cfg.label %>: <b style="color:<%= cfg.bar %>;margin-left:2px"><%= s.count %></b>
    </div>
    <% }); %>
  </div>
</div>
<% } %>

<!-- ── By Role + By Country ── -->
<div class="sp-grid2">

  <!-- By Role -->
  <div class="sp-card" style="overflow:hidden">
    <div class="sp-hd">
      <div class="sp-title">By Role</div>
      <div class="sp-sub">Strong matches found and applied per role</div>
    </div>
    <% if (groupStats.length === 0) { %>
    <div class="sp-empty">No roles yet.</div>
    <% } else { %>
    <table class="sp-tbl sp-roles-desktop">
      <thead>
        <tr><th class="l">Role</th><th>Found</th><th>Strong</th><th>Applied</th><th>Rate</th></tr>
      </thead>
      <tbody>
        <% groupStats.forEach(g => { %>
        <% const rate = g.strong > 0 ? Math.round(g.applied / g.strong * 100) : 0; %>
        <tr>
          <td class="l"><%= g.name %></td>
          <td><%= g.total %></td>
          <td class="sp-t-strong"><%= g.strong %></td>
          <td class="sp-t-applied"><%= g.applied %></td>
          <td>
            <div class="sp-rate-wrap">
              <div class="sp-rate-bar"><span style="width:<%= rate %>%"></span></div>
              <span class="sp-rate-pct"><%= rate %>%</span>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <!-- Phones: the 5-column table can't fit — same rows as utility rows (DS §6). -->
    <div class="sp-roles-mobile">
      <% groupStats.forEach(g => { %>
      <% const rate = g.strong > 0 ? Math.round(g.applied / g.strong * 100) : 0; %>
      <div class="sp-rolerow">
        <div class="sp-rolename"><%= g.name %></div>
        <div class="sp-rolemeta">
          <span>Found <b><%= g.total %></b></span>
          <span>Strong <b class="sp-t-strong"><%= g.strong %></b></span>
          <span>Applied <b class="sp-t-applied"><%= g.applied %></b></span>
        </div>
        <div class="sp-rolerate">
          <div class="sp-rate-bar"><span style="width:<%= rate %>%"></span></div>
          <span class="sp-rate-pct"><%= rate %>%</span>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>

  <!-- By Country -->
  <div class="sp-card" style="overflow:hidden">
    <div class="sp-hd">
      <div class="sp-title">By Country</div>
      <div class="sp-sub">Where strong matches are located</div>
    </div>
    <% if (countryStats.length === 0) { %>
    <div class="sp-empty">No data yet.</div>
    <% } else { %>
    <% const maxCountryStrong = countryStats[0] ? countryStats[0].strong : 1; %>
    <% const COUNTRY_VISIBLE = 4; const countryHidden = Math.max(0, countryStats.length - COUNTRY_VISIBLE); %>
    <ul id="country-list" class="sp-clist jh-scroll">
      <% countryStats.forEach(c => { %>
      <li class="sp-crow">
        <span class="sp-cname"><%= c.country %></span>
        <div class="sp-cbar"><span style="width:<%= Math.round(c.strong / maxCountryStrong * 100) %>%"></span></div>
        <span class="sp-cval"><%= c.strong %></span>
        <span class="sp-capp"><% if (c.applied > 0) { %><%= c.applied %> applied<% } %></span>
      </li>
      <% }); %>
    </ul>
    <% if (countryHidden > 0) { %>
    <div id="country-more" class="sp-cmore" onclick="document.getElementById('country-list').style.maxHeight='none';this.style.display='none';">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 9l-7 7-7-7"/></svg>
      <%= countryHidden %> more countr<%= countryHidden === 1 ? 'y' : 'ies' %>
    </div>
    <% } %>
    <% } %>
  </div>

</div>

<!-- ── Daily Strong Matches — last 14 days ── -->
<div class="sp-card sp-pad" style="margin-top:20px">
  <div class="sp-title">Daily Strong Matches — last 14 days</div>
  <div class="sp-sub">AI strong matches kept vs. promoted/demoted by you</div>
  <div id="quality-legend" class="sp-qlegend"></div>
  <div style="overflow-x:auto" class="jh-scroll">
    <div id="quality-chart" style="display:flex;align-items:flex-end;gap:6px;"></div>
  </div>
</div>

<!-- ── Monthly Strong Matches — last 12 months ── -->
<div class="sp-card sp-pad" style="margin-top:20px">
  <div class="sp-title">Monthly Strong Matches — last 12 months</div>
  <div class="sp-sub">AI strong matches kept vs. promoted/demoted by you</div>
  <div id="quality-monthly-legend" class="sp-qlegend"></div>
  <div style="overflow-x:auto" class="jh-scroll">
    <div id="quality-monthly-chart" style="display:flex;align-items:flex-end;gap:6px;"></div>
  </div>
</div>

<!-- ── Daily costs — last 14 days ── -->
<div class="sp-card sp-pad" style="margin-top:20px">
  <div class="sp-title">Daily costs — last 14 days</div>
  <div class="sp-sub">Fetch and AI spend per day</div>
  <div id="cost-legend" class="sp-qlegend"></div>
  <div style="overflow-x:auto" class="jh-scroll">
    <div id="cost-chart" style="display:flex;align-items:flex-end;gap:6px;"></div>
  </div>
</div>

<script>
const QUALITY_RAW         = <%- JSON.stringify(strongQualityRaw) %>;
const QUALITY_MONTHLY_RAW = <%- JSON.stringify(strongQualityMonthlyRaw) %>;
const COST_RAW            = <%- JSON.stringify(dailyCostRaw) %>;
const COST_DAYS           = <%- JSON.stringify(costDays) %>;

<%- include('partials/_stacked-chart') %>

const QUALITY_SPEC = {
  order:  ['kept', 'promoted', 'demoted'],
  config: {
    kept:     { label: 'AI strong — kept',    color: 'var(--green)' },
    promoted: { label: 'Promoted to strong',  color: 'var(--amber)' },
    demoted:  { label: 'Demoted from strong', color: 'var(--red)' },
  },
  fmt: v => String(v),
  tipSuffix: ' strong matches',
  colW: 36,
};
// order[0] renders as the topmost segment — AI above, Fetch below.
const COST_SPEC = {
  order:  ['ai', 'fetch'],
  config: {
    ai:    { label: 'AI',    color: 'var(--sky-ink)' },
    fetch: { label: 'Fetch', color: 'var(--sky-border)' },
  },
  fmt: v => '$' + v.toFixed(3),
  tipSuffix: '',
  colW: 46,   // a "$0.302" label needs more room than a count before it collides when scrolled
};


renderStackedChart(
  'quality-chart', 'quality-legend', QUALITY_RAW,
  getLastNDays(14),
  d => { const p = d.split('-'); return MN[parseInt(p[1])-1] + ' ' + parseInt(p[2]); },
  row => row.day,
  QUALITY_SPEC
);
renderStackedChart(
  'quality-monthly-chart', 'quality-monthly-legend', QUALITY_MONTHLY_RAW,
  getLastNMonths(12),
  m => MN[parseInt(m.slice(5))-1] + '<br>\'' + m.slice(2,4),
  row => row.month,
  QUALITY_SPEC
);
// Days come from the server, already in the profile's timezone.
renderStackedChart(
  'cost-chart', 'cost-legend', COST_RAW,
  COST_DAYS,
  d => { const p = d.split('-'); return MN[parseInt(p[1])-1] + ' ' + parseInt(p[2]); },
  row => row.day,
  COST_SPEC
);

// Scroll charts to show the most recent (rightmost) data on load
['quality-chart', 'quality-monthly-chart', 'cost-chart'].forEach(id => {
  const el = document.getElementById(id);
  if (el && el.parentElement) el.parentElement.scrollLeft = el.parentElement.scrollWidth;
});
</script>
