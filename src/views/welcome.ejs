<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Job Search</title>
  <link rel="icon" href="/icon.ico?v=<%= iconVersion %>">
  <link rel="stylesheet" href="/css/tailwind.css">
  <style>
    /* ── Welcome (standalone, DS v2 light) ── */
    html,body{margin:0;padding:0}
    body{background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased}
    input::placeholder{color:#9aa1ad}
    a{text-decoration:none}
    :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:6px}
    .shell{display:flex;min-height:100dvh;width:100%}

    /* ---- Sidebar (locked preview) ---- */
    .sb{width:236px;flex:none;background:#fff;border-right:1px solid var(--line);display:flex;flex-direction:column;
        position:sticky;top:0;height:100dvh;align-self:flex-start}
    .sb-brand{display:flex;align-items:center;gap:9px;padding:18px 18px 6px;position:relative;z-index:11}
    .sb-nav{flex:1;overflow-y:auto;padding:8px 12px;display:flex;flex-direction:column;gap:2px}
    .sb-item{display:flex;align-items:center;gap:11px;padding:9px 11px;border-radius:9px;color:var(--muted);font-size:13.5px;font-weight:600;background:transparent;border:0;width:100%;text-align:left}
    .sb-item svg{stroke:var(--fainter)}
    .sb-item.active{background:var(--accent-soft);color:var(--accent);font-weight:700}
    .sb-item.active svg{stroke:var(--accent)}
    .sb-chev{margin-left:auto}
    .ob{background:var(--accent-soft);border:1px solid var(--accent-border);border-radius:11px;padding:11px 11px 8px;margin-bottom:12px;display:flex;flex-direction:column;gap:7px}
    .ob-head{display:flex;align-items:center;justify-content:space-between}
    .ob-title{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--accent)}
    .ob-meta{display:flex;align-items:center;gap:8px;font-size:10.5px;color:var(--faint);font-weight:700}
    .ob-bar{flex:1;height:3px;background:#e2e6ee;border-radius:999px;overflow:hidden}
    .ob-bar > span{display:block;height:100%;background:var(--accent);border-radius:999px}
    .ob-list{display:flex;flex-direction:column}
    .ob-step{display:grid;grid-template-columns:16px 1fr;align-items:center;gap:8px;padding:4px;border-radius:6px;font-size:12px;line-height:1.2;color:var(--fainter)}
    .ob-check{width:16px;height:16px;border-radius:50%;display:grid;place-items:center;font-size:9.5px;font-weight:700;background:#fff;border:1px solid #d6dae2;color:var(--faint)}
    .sb-foot{padding:12px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:8px}
    .sb-run{display:flex;align-items:center;gap:9px;padding:10px 13px;border-radius:10px;font-size:13.5px;font-weight:700;width:100%;justify-content:flex-start;color:#fff}
    .sb-run-green{background:var(--green)}
    .sb-run-blue{background:var(--accent)}
    .sb-profile{display:flex;align-items:center;gap:10px;padding:8px 6px;margin-top:2px}
    .sb-avatar{width:32px;height:32px;border-radius:50%;background:#eef1f6;display:grid;place-items:center;color:var(--fainter);flex:none}
    .sb-lock{position:absolute;inset:0;background:rgba(255,255,255,.5);backdrop-filter:blur(1.5px);-webkit-backdrop-filter:blur(1.5px);z-index:10;display:flex;align-items:center;justify-content:center}
    .lock-pill{background:#fff;border:1px solid var(--line2);border-radius:10px;padding:9px 15px;display:flex;align-items:center;gap:8px;box-shadow:0 6px 20px -8px rgba(16,24,40,.25);font-size:12px;color:var(--muted);font-weight:600}

    /* ---- Main ---- */
    .main{flex:1;min-width:0}
    .page{max-width:1120px;padding:8px 16px 44px;display:flex;flex-direction:column;gap:16px}
    .card{background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow-card)}

    .field{display:block;width:100%;padding:12px 14px;font-size:13.5px;color:var(--ink);border:1px solid var(--line2);border-radius:11px;background:#fff;outline:none}
    .field:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
    .btn-accent{width:100%;background:var(--accent);color:#fff;font-size:13.5px;font-weight:700;border:0;padding:12px;border-radius:11px;cursor:pointer}
    .btn-accent:hover{background:var(--accent-hover)}
    .link-ghost{color:var(--accent);font-weight:600}

    .hero{display:flex;flex-direction:column;gap:16px}
    @media(min-width:900px){ .hero{flex-direction:row;align-items:stretch} }
    .hero-right{display:flex;flex-direction:column;gap:16px;width:100%}
    @media(min-width:900px){ .hero-right{width:384px;flex:none} }
    .letter-row{display:flex;gap:16px}
    .letter p{margin:0 0 12px;font-size:13.5px;color:var(--ink2);line-height:1.65;text-align:justify}
    .letter p:last-child{margin-bottom:16px}
    /* on a phone the letter runs under the portrait instead of beside it */
    @media(max-width:767px){
      .letter-row{display:block}
      .letter-row > img{float:left;margin-right:14px;margin-bottom:8px}
    }

    @media(max-width:899px){ .sb{display:none} }

    /* ══════════ What you get · How it works · FAQ ══════════ */
    .sc-h2{margin:0;font-size:19px;font-weight:800;letter-spacing:-.015em;color:var(--ink);line-height:normal}

    /* Hero shot */
    .sc1-hero{display:grid;grid-template-columns:1fr;gap:20px;align-items:start}
    @media(min-width:1000px){ .sc1-hero{grid-template-columns:minmax(0,1fr) minmax(228px,264px);gap:22px} }
    .sc1-left{display:flex;flex-direction:column;gap:10px;min-width:0}
    .sc-frame{display:block;width:100%;border:1px solid #d6dae2;border-radius:14px;
              background:#fff;overflow:hidden;box-shadow:var(--shadow-card)}
    .sc-frame img{display:block;width:100%;height:auto}
    .sc1-cap{margin:0;font-size:12px;color:var(--faint);line-height:1.5}

    /* Annotations beside the hero shot */
    .sc1-facts{display:flex;flex-direction:column;gap:9px;min-width:0}
    /* the only inline child is a fixed-height chip, so a unit line-height drops the
       strut and the row is exactly the chip's height (Tailwind sets one app-wide) */
    .sc1-fact{background:#fbfcfe;border:1px solid var(--line2);border-radius:12px;padding:11px 13px;line-height:1}
    .sc1-fact p{margin:7px 0 0;font-size:12px;color:var(--muted);line-height:1.45}
    .chip{display:inline-flex;align-items:center;height:22px;padding:0 9px;border-radius:7px;
          font-size:11.5px;font-weight:700}
    .chip-score{font-size:12px;font-weight:800;font-variant-numeric:tabular-nums;background:var(--green-soft);color:var(--green2)}
    .chip-strong{background:var(--green-soft);color:var(--green2)}
    .chip-applied{background:var(--green);color:#fff}
    .chip-note{background:#eef1f6;color:var(--ink2);border:1px solid var(--line2)}
    /* company row — DS §6: logo, accent name, trailing info glyph, inline */
    .sc1-co{display:flex;align-items:center;gap:7px;min-width:0}
    .sc1-co img{width:22px;height:22px;border-radius:6px;flex:none;border:1px solid var(--line3)}
    .sc1-co b{font-size:12.5px;font-weight:700;color:var(--accent);white-space:nowrap;
              overflow:hidden;text-overflow:ellipsis}
    .sc1-co svg{flex:none;color:var(--accent)}

    /* Step tiles */
    .sc1-row{display:grid;gap:14px;grid-template-columns:repeat(2,minmax(0,1fr))}
    @media(min-width:720px){
      .sc1-row-4{grid-template-columns:repeat(4,minmax(0,1fr))}
      .sc1-row-b{grid-template-columns:repeat(3,minmax(0,1fr))}
    }
    .sc1-tile{min-width:0;display:flex;flex-direction:column;gap:8px}
    .sc1-shot{--tileh:190px;position:relative;height:var(--tileh);border:1px solid #d6dae2;
              border-radius:12px;background:#fff;overflow:hidden;box-shadow:var(--shadow-card)}
    .sc1-row-b .sc1-shot{--tileh:165px}
    .sc1-shot img{display:block;width:100%;height:100%;object-fit:cover;object-position:top center}
    /* the Schedule dialog is 1:1.9 — show it whole on the grey rather than crop a slice.
       Sized off --tileh: a percentage height on a replaced grid item doesn't resolve here. */
    .sc1-shot-fit{background:var(--bg);display:grid;place-items:center;padding:5px 12px}
    .sc1-shot-fit img{width:auto;height:auto;max-width:100%;max-height:calc(var(--tileh) - 10px);
                      object-fit:contain;border-radius:7px;
                      box-shadow:0 0 0 1px var(--line3), 0 4px 14px -8px rgba(16,24,40,.3)}
    /* the step is named before it is shown. Titles wrap to 1-3 lines when the tiles
       go two-up, so the row shares its tracks and the shots still line up. */
    .sc1-head{display:flex;align-items:center;gap:8px;min-width:0;order:-1}
    @supports (grid-template-rows: subgrid){
      .sc1-tile{display:grid;grid-template-rows:subgrid;grid-row:span 2;gap:8px}
      .sc1-head{grid-row:1}
      .sc1-shot{grid-row:2}
    }
    .sc1-num{width:20px;height:20px;flex:none;border-radius:50%;background:var(--accent-soft);
             border:1px solid var(--accent-border);color:var(--accent);display:grid;place-items:center;
             font-size:10.5px;font-weight:800;font-variant-numeric:tabular-nums}
    .sc1-t{margin:0;font-size:13px;font-weight:700;color:var(--ink);line-height:1.25}
    .sc1-phase{display:flex;flex-direction:column;gap:11px}

    /* two-up on a phone: a portrait frame crops a landscape screen down its sides,
       so the frame goes square and keeps more of each shot */
    @media(max-width:719px){
      .sc1-shot{height:auto;aspect-ratio:1}
      .sc1-shot-fit{padding:0}
      .sc1-shot-fit img{width:100%;height:100%;max-width:none;max-height:none;
                        object-fit:contain;box-sizing:border-box;padding:12px}
      /* the odd tile out takes the whole row rather than leaving a hole.
         2.1:1 is one column's width over its height once the 14px gap is taken out —
         so the wide tile is exactly as tall as the square ones beside it.
         WebKit won't grow the grid row for an aspect-ratio box in a full-width subgrid
         item, so the shot spills out of the card — the lone tile leaves subgrid instead */
      .sc1-row-b .sc1-tile:last-child{grid-column:1 / -1;display:flex;grid-row:auto}
      .sc1-row-b .sc1-tile:last-child .sc1-shot{aspect-ratio:2.1}
    }

    /* FAQ: plain text, no boxes */
    .sc1-faq{display:grid;grid-template-columns:1fr;gap:16px}
    @media(min-width:900px){ .sc1-faq{grid-template-columns:repeat(3,minmax(0,1fr));gap:26px} }
    .sc1-faq p{margin:0;font-size:12.5px;color:var(--muted);line-height:1.55}
    /* the question is a signpost, not a headline — it shouldn't outrank the section titles */
    .sc1-faq strong{font-weight:700;color:var(--ink2)}
    .sc1-faq b{font-weight:700;color:var(--ink2)}
  </style>
</head>
<body class="font-sans antialiased">
<div class="shell">

  <!-- ============ SIDEBAR (locked preview) ============ -->
  <aside class="sb">
    <div class="sb-brand">
      <img src="/logo.webp" alt="Job Search" style="width:100%;max-width:200px;height:auto;display:block;" />
    </div>
    <nav class="sb-nav">
      <div class="ob">
        <div class="ob-head">
          <div class="ob-title"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"/></svg>Onboarding</div>
        </div>
        <div class="ob-meta">0 of 5 done<span class="ob-bar"><span style="width:0%"></span></span></div>
        <div class="ob-list">
          <div class="ob-step"><span class="ob-check">1</span><span>Set up your profile</span></div>
          <div class="ob-step"><span class="ob-check">2</span><span>Add target roles</span></div>
          <div class="ob-step"><span class="ob-check">3</span><span>Add or buy API keys</span></div>
          <div class="ob-step"><span class="ob-check">4</span><span>Run your first search</span></div>
          <div class="ob-step"><span class="ob-check">5</span><span>Set a daily schedule</span></div>
        </div>
      </div>
      <span class="sb-item active"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/></svg>Start</span>
      <span class="sb-item"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1l8.8 8.8 8.8-8.8a5 5 0 0 0 0-7.1Z"/></svg>Matches</span>
      <span class="sb-item"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/></svg>All Jobs</span>
      <span class="sb-item"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/></svg>Stats</span>
      <span class="sb-item"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>Run Logs</span>
      <span class="sb-item"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1A2 2 0 1 1 4.3 17l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.3-1.8l-.1-.1A2 2 0 1 1 7 4.3l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1A2 2 0 1 1 19.7 7l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>Settings<span class="sb-chev"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#aeb4bf" stroke-width="1.9" stroke-linecap="round"><path d="m9 6 6 6-6 6"/></svg></span></span>
    </nav>
    <div class="sb-foot">
      <span class="sb-run sb-run-green" style="opacity:.5"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8L6 20V4Z"/></svg>Run once</span>
      <span class="sb-run sb-run-blue" style="opacity:.5"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Schedule</span>
      <div class="sb-profile">
        <div class="sb-avatar"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
        <div style="flex:1;min-width:0"><div style="font-size:13px;font-weight:700;color:var(--muted);line-height:1.2">Your account</div><div style="font-size:11.5px;color:var(--faint)">Sign in to continue</div></div>
      </div>
    </div>
    <!-- frosted lock over the whole sidebar -->
    <div class="sb-lock">
      <div class="lock-pill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8a91a0" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Sign in to unlock</div>
    </div>
  </aside>

  <!-- ============ MAIN ============ -->
  <main class="main">
    <div class="page">

      <% if (typeof error !== 'undefined' && error) { %>
      <div style="padding:12px 14px;border-radius:11px;background:var(--red-soft);border:1px solid var(--red-border);font-size:13px;color:var(--red-ink)"><%= error %></div>
      <% } %>
      <% if (typeof message !== 'undefined' && message) { %>
      <div style="padding:12px 14px;border-radius:11px;background:var(--green-soft);border:1px solid var(--green-border);font-size:13px;color:var(--green2)"><%= message %></div>
      <% } %>

      <!-- hero: letter + sign-in + github -->
      <div class="hero">

        <!-- Letter -->
        <div class="card" style="padding:26px;flex:1;min-width:0">
          <h2 style="margin:0 0 20px;font-size:28px;font-weight:800;letter-spacing:-.02em;line-height:1.25;color:var(--ink);text-wrap:balance">Save 30 minutes a day on your job hunt.</h2>
          <div class="letter-row">
            <img src="/misha.webp" alt="Misha" style="width:64px;height:64px;border-radius:50%;object-fit:cover;flex:none;margin-top:2px">
            <div style="flex:1;min-width:0">
              <div class="letter">
                <p>Hi, I'm Misha, a product guy. I built yet another job search app to save myself time. Turned out useful, so I decided to share it with friends for <b>free</b>. Count yourself invited!</p>
                <p>It's not another catalog of jobs you scroll. It <b>gets you few curated jobs</b> you would have picked yourself. It scans job sites, groups reposts, and scores jobs against your criteria. It won't apply for you (I believe final call should be human), but it gets you there and writes a cover letter.</p>
                <p>It's a <b>non-commercial</b> personal project. Use your own API keys, ask to use mine for some contribution, or just copy it. Welcome aboard!</p>
              </div>
              <p style="margin:0;font-size:13px;color:var(--faint);text-align:right">Cheers, Misha</p>
            </div>
          </div>
        </div>

        <!-- Right column -->
        <div class="hero-right">

          <!-- Sign-in -->
          <div class="card" style="padding:24px;flex:1">
            <div id="step-email">
              <p style="margin:0 0 18px;font-size:19px;font-weight:800;letter-spacing:-.02em;color:var(--ink)">Sign in</p>
              <input id="signin-email" type="email" placeholder="you@work.com"
                     autocomplete="email" autocapitalize="off" inputmode="email"
                     class="field" style="margin-bottom:12px">
              <div id="email-error" class="hidden" style="font-size:12px;margin-bottom:8px"></div>
              <button id="email-btn" onclick="requestCode()" class="btn-accent" style="margin-bottom:14px">Email me a code</button>
              <p style="margin:0;font-size:12px;color:var(--faint);line-height:1.5">No password, enter with a 6-digit code. By signing in you agree to the <a href="/terms" class="link-ghost">Terms</a> and <a href="/privacy" class="link-ghost">Privacy Policy</a>.</p>
            </div>
            <div id="step-verify" class="hidden">
              <p style="margin:0 0 4px;font-size:19px;font-weight:800;letter-spacing:-.02em;color:var(--ink)">Check your inbox</p>
              <p id="verify-hint" style="margin:0 0 18px;font-size:12px;color:var(--faint)"></p>
              <input id="signin-code" type="text" inputmode="numeric" maxlength="6"
                     placeholder="6-digit code" autocomplete="one-time-code"
                     class="field" style="margin-bottom:12px;text-align:center;letter-spacing:.3em;font-weight:700">
              <div id="verify-msg" class="hidden" style="font-size:12px;margin-bottom:8px"></div>
              <button id="verify-btn" onclick="verifyCode()" class="btn-accent" style="margin-bottom:8px">Verify</button>
              <button id="resend-btn" onclick="resendCode()" style="width:100%;background:transparent;border:0;color:var(--accent);font-weight:600;font-size:13.5px;padding:8px;cursor:pointer">Resend code</button>
              <p style="margin:8px 0 0;text-align:center;font-size:12px;color:var(--faint)"><button onclick="backToEmail()" style="background:none;border:0;color:var(--faint);text-decoration:underline;font-size:12px;cursor:pointer">Change email</button></p>
            </div>
          </div>

          <!-- GitHub -->
          <div class="card" style="padding:20px">
            <p style="margin:0 0 12px;font-size:13.5px;font-weight:700;color:var(--ink2)">You're welcome to self-host</p>
            <a href="https://github.com/girshovich/job-hunter" target="_blank" rel="noopener" style="display:flex;align-items:center;gap:9px;width:100%;border:1px solid var(--line2);border-radius:11px;padding:11px 14px;font-size:13px;font-weight:600;color:var(--ink2)">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="flex:none"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
