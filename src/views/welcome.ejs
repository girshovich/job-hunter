<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Job Hunter</title>
  <link rel="icon" href="/icon.ico">
  <link rel="stylesheet" href="/css/tailwind.css">
  <style>
    html, body { overflow: hidden; }
    .app-shell { height: 100dvh; background: #f9fafb; overflow: hidden; }
    .app-sidebar { width: 264px; height: 100dvh; overflow: hidden; }
    .app-main { min-width: 0; height: 100dvh; overflow-y: auto; overflow-x: hidden; }
    .app-content { width: 100%; max-width: 72rem; min-height: 100%; display: flex; flex-direction: column; }
    .app-page { flex: 1 0 auto; padding: 2rem 1.5rem 2rem; }

    :root {
      --jh-sb-bg:     #0C0E12;
      --jh-sb-border: #1F242C;
      --jh-sb-ink:    #E9ECF1;
      --jh-sb-muted:  #8A91A0;
      --jh-sb-hover:  #1A1E26;
      --jh-sb-active: #232936;
      --jh-sb-blue:   #2F6BFF;
      --jh-sb-green:  #1E9E5A;
    }

    .sb-item {
      display: flex; align-items: center; gap: 11px;
      padding: 9px 10px; border-radius: 8px;
      color: var(--jh-sb-ink); font-size: 13.5px; font-weight: 500;
      width: 100%; text-decoration: none; cursor: default;
    }
    .sb-item .ico { color: var(--jh-sb-muted); display: inline-flex; }
    .sb-item.active { background: var(--jh-sb-active); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.04); }
    .sb-item.active .ico { color: var(--jh-sb-ink); }
    .sb-chev { display: inline-flex; align-items: center; margin-left: auto; color: var(--jh-sb-muted); }

    .sb-nav-scroll {
      flex: 1; overflow-y: auto; min-height: 0;
      padding: 12px 10px; display: flex; flex-direction: column; gap: 2px;
    }
    .sb-nav-scroll::-webkit-scrollbar { width: 0; }

    .sb-footer { padding: 12px; border-top: 1px solid var(--jh-sb-border); display: flex; flex-direction: column; gap: 10px; }
    .sb-run-group { display: flex; flex-direction: column; gap: 6px; }
    .sb-run {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 12px; border-radius: 9px;
      font-size: 13.5px; font-weight: 600; font-family: inherit;
      width: 100%; white-space: nowrap; color: white; cursor: default;
    }
    .sb-run-green { background: var(--jh-sb-green); }
    .sb-run-blue  { background: var(--jh-sb-blue); }

    .sb-profile { display: flex; align-items: center; gap: 10px; padding: 8px; border-radius: 10px; }
    .sb-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--jh-sb-hover);
      display: grid; place-items: center;
      color: var(--jh-sb-muted); flex-shrink: 0;
    }

    .sb-onboard {
      background: linear-gradient(180deg, rgba(47,107,255,0.10) 0%, rgba(47,107,255,0.04) 100%);
      border: 1px solid rgba(77,135,255,0.18);
      border-radius: 10px; padding: 10px 10px 6px; margin-bottom: 8px;
      display: flex; flex-direction: column; gap: 6px;
    }
    .sb-onboard-title {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 11px; font-weight: 600; letter-spacing: 0.06em;
      text-transform: uppercase; color: #B6CDFF;
    }
    .sb-onboard-meta { display: flex; align-items: center; gap: 8px; font-size: 10.5px; color: var(--jh-sb-muted); }
    .sb-onboard-bar { flex: 1; height: 3px; background: rgba(255,255,255,0.06); border-radius: 999px; overflow: hidden; }
    .sb-onboard-bar-fill { display: block; height: 100%; background: linear-gradient(90deg, #4D87FF, #2F6BFF); border-radius: 999px; }
    .sb-onboard-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
    .sb-onboard-item {
      width: 100%; display: grid; grid-template-columns: 16px 1fr; align-items: center; gap: 8px;
      padding: 4px; border-radius: 6px;
      color: var(--jh-sb-ink); font-size: 12px; line-height: 1.2; cursor: default;
    }
    .sb-onboard-item.todo { color: var(--jh-sb-muted); }
    .sb-onboard-check {
      width: 16px; height: 16px; border-radius: 50%;
      display: grid; place-items: center;
      border: 1px solid rgba(255,255,255,0.18);
      color: var(--jh-sb-muted); font-size: 9.5px; font-weight: 600;
      background: rgba(255,255,255,0.02); flex-shrink: 0;
    }
  </style>
</head>
<body class="h-full font-sans antialiased text-gray-900">
<div class="app-shell flex">

  <!-- Sidebar preview (desktop only) -->
  <aside class="app-sidebar hidden md:flex flex-shrink-0 flex-col relative"
         style="background:var(--jh-sb-bg);color:var(--jh-sb-ink);">

    <!-- Brand -->
    <div style="display:flex;align-items:center;gap:10px;padding:18px 16px 16px;border-bottom:1px solid var(--jh-sb-border);flex-shrink:0;">
      <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#4D87FF,#2F6BFF);display:grid;place-items:center;color:white;font-weight:700;font-size:12px;flex-shrink:0;">JH</div>
      <div>
        <div style="font-weight:600;font-size:15px;color:var(--jh-sb-ink);">Job Hunter</div>
        <div style="font-size:11px;color:var(--jh-sb-muted);margin-top:1px;">Find a matching job</div>
      </div>
    </div>

    <!-- Nav -->
    <div class="sb-nav-scroll">
      <!-- Onboarding widget preview -->
      <div class="sb-onboard">
        <div class="sb-onboard-title">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"/></svg>
          Onboarding
        </div>
        <div class="sb-onboard-meta">
          0 of 5 done
          <span class="sb-onboard-bar"><span class="sb-onboard-bar-fill" style="width:0%"></span></span>
        </div>
        <ul class="sb-onboard-list">
          <% [
            'Set up your profile',
            'Add target roles & criteria',
            'Buy credits or add API keys',
            'Run your first search',
            'Set a daily schedule'
          ].forEach(function(label, i) { %>
          <li>
            <span class="sb-onboard-item <%= i === 0 ? '' : 'todo' %>">
              <span class="sb-onboard-check"><%= i + 1 %></span>
              <span><%= label %></span>
            </span>
          </li>
          <% }); %>
        </ul>
      </div>

      <!-- Nav items (inert spans — nothing to enable in the console) -->
      <span class="sb-item active">
        <span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/></svg></span>
        Start
      </span>
      <span class="sb-item">
        <span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1l8.8 8.8 8.8-8.8a5 5 0 0 0 0-7.1Z"/></svg></span>
        Matches
      </span>
      <span class="sb-item">
        <span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/></svg></span>
        All Jobs
      </span>
      <span class="sb-item">
        <span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-8"/><path d="M22 20H2"/></svg></span>
        Stats
      </span>
      <span class="sb-item">
        <span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span>
        Run Logs
      </span>
      <span class="sb-item">
        <span class="ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1A2 2 0 1 1 4.3 17l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.3-1.8l-.1-.1A2 2 0 1 1 7 4.3l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1A2 2 0 1 1 19.7 7l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg></span>
        Settings
        <span class="sb-chev"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="m9 6 6 6-6 6"/></svg></span>
      </span>
    </div>

    <!-- Footer -->
    <div class="sb-footer">
      <div class="sb-run-group">
        <span class="sb-run sb-run-green" style="opacity:0.5;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8L6 20V4Z"/></svg>
          Run once
        </span>
        <span class="sb-run sb-run-blue" style="opacity:0.5;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 3"/></svg>
          Schedule
        </span>
      </div>
      <div class="sb-profile">
        <div class="sb-avatar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div style="display:flex;flex-direction:column;flex:1;min-width:0;">
          <span style="font-size:13.5px;font-weight:600;color:var(--jh-sb-muted);line-height:1.2;">Your account</span>
          <span style="font-size:11.5px;color:var(--jh-sb-muted);">Sign in to continue</span>
        </div>
      </div>
    </div>

    <!-- Frosted lock overlay — covers the entire sidebar, pointer-events block clicks through -->
    <div style="position:absolute;inset:0;background:rgba(12,14,18,0.48);backdrop-filter:blur(1.5px);-webkit-backdrop-filter:blur(1.5px);z-index:10;display:flex;align-items:center;justify-content:center;pointer-events:all;">
      <div style="background:rgba(14,17,22,0.88);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:10px 16px;display:flex;align-items:center;gap:8px;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8A91A0" stroke-width="1.75" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span style="font-size:12px;color:#8A91A0;font-weight:500;">Sign in to unlock</span>
      </div>
    </div>

  </aside>

  <!-- Main -->
  <main class="app-main flex-1">
    <div class="app-content">
      <div class="app-page">

        <!-- Page header -->
        <div class="flex items-center justify-between mb-4">
          <div>
            <h1 class="text-2xl font-bold text-gray-900">Welcome</h1>
            <p class="text-sm text-gray-500 mt-1"><%= new Date().toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
          </div>
        </div>

        <!-- Hero + sign-in -->
        <div class="flex flex-col md:flex-row md:items-stretch gap-4 mb-6">

          <!-- Letter card -->
          <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 flex-1 min-w-0">
            <h2 class="text-3xl font-bold text-gray-900 leading-snug mb-5">Save 30 minutes a day on your job hunt.</h2>
            <div class="flex gap-4">
              <img src="/misha.jpg" alt="Misha" class="w-16 h-16 rounded-full object-cover flex-shrink-0 mt-0.5">
              <div class="flex-1 min-w-0">
                <p class="text-sm text-gray-700 leading-relaxed mb-3 text-justify">Hi, I'm Misha, a product guy. I built Job Hunter to save myself time searching jobs. Turned out useful, so I'm sharing it for free.</p>
                <p class="text-sm text-gray-700 leading-relaxed mb-3 text-justify">If you're hunting jobs across countries, scrolling hundreds of reposts from companies you don't even like - virtual hug. Job Hunter knows what you want. It scans same sites you do, kills reposts, and scores the rest against your criteria - showing only jobs you'd actually pick. It won't apply for you (I believe final call should be human), but it gets you there and writes a cover letter.</p>
                <p class="text-sm text-gray-700 leading-relaxed mb-0 text-justify">Fork it, or run it with your own API keys, or buy credits to use mine.</p>
                <p class="text-sm text-gray-700 leading-relaxed mb-4 text-justify">Welcome aboard!</p>
                <p class="text-sm text-gray-500 text-right">Cheers, Misha</p>
              </div>
            </div>
          </div>

          <!-- Right column: sign-in + github -->
          <div class="flex flex-col gap-4 w-full md:w-96 flex-shrink-0">

            <!-- Sign-in card -->
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 flex-1">

              <!-- Step 1: email -->
              <div id="step-email">
                <p class="text-xl font-bold text-gray-900 mb-5">Sign in</p>
                <input id="signin-email" type="email" placeholder="you@work.com"
                       autocomplete="email" autocapitalize="off" inputmode="email"
                       class="block w-full px-4 py-3 text-sm border border-gray-200 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent mb-3">
                <div id="email-error" class="hidden text-xs text-red-600 mb-2 px-0.5"></div>
                <button id="email-btn" onclick="requestCode()"
                        class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold px-5 py-3 rounded-xl text-sm transition-colors mb-4">
                  Email me a code
                </button>
                <p class="text-xs text-gray-400">No password, enter with a 6-digit code. By signing in you agree to the <a href="/terms" class="underline hover:text-gray-600 transition-colors">Terms</a> and <a href="/privacy" class="underline hover:text-gray-600 transition-colors">Privacy Policy</a>.</p>
              </div>

              <!-- Step 2: verify (hidden initially) -->
              <div id="step-verify" class="hidden">
                <p class="text-xl font-bold text-gray-900 mb-1">Check your inbox</p>
                <p id="verify-hint" class="text-xs text-gray-500 mb-5"></p>
                <input id="signin-code" type="text" inputmode="numeric" maxlength="6"
                       placeholder="6-digit code" autocomplete="one-time-code"
                       class="block w-full px-4 py-3 text-sm border border-gray-200 rounded-xl bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent mb-3 tracking-widest text-center font-mono">
                <div id="verify-msg" class="hidden text-xs mb-2 px-0.5"></div>
                <button id="verify-btn" onclick="verifyCode()"
                        class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold px-5 py-3 rounded-xl text-sm transition-colors mb-2">
                  Verify
                </button>
                <button id="resend-btn" onclick="resendCode()"
                        class="w-full text-blue-600 hover:text-blue-700 font-medium px-5 py-2 rounded-lg text-sm transition-colors">
                  Resend code
                </button>
                <p class="text-xs text-gray-400 mt-2 text-center">
                  <button onclick="backToEmail()" class="underline hover:text-gray-600 transition-colors">Change email</button>
                </p>
              </div>

            </div>

            <!-- GitHub card -->
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
              <p class="text-sm font-semibold text-gray-700 mb-3">You're welcome to self-host</p>
              <a href="https://github.com/girshovich/job-hunter" target="_blank" rel="noopener"
                 class="flex items-center gap-2 w-full border border-gray-200 hover:border-gray-300 hover:bg-gray-50 rounded-xl px-4 py-2.5 text-sm font-medium text-gray-700 transition-colors">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="flex-shrink-0"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
                github.com/girshovich/job-hunter
              </a>
            </div>

          </div>

        </div>

        <!-- How it works -->
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
          <h2 class="text-base font-semibold text-gray-900 mb-5">How it works</h2>
          <div class="flex flex-col sm:flex-row sm:items-start gap-4 sm:gap-0">

            <div class="flex sm:flex-col items-start sm:items-center gap-3 sm:gap-3 flex-1">
              <div class="bg-violet-50 rounded-2xl p-3.5 flex-shrink-0">
                <svg class="w-7 h-7 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </div>
              <div class="sm:text-center">
                <p class="text-sm font-semibold text-gray-900">Add your CV</p>
                <p class="text-xs text-gray-500 mt-0.5 leading-snug">Plus the roles, locations and must-haves you care about.</p>
              </div>
            </div>

            <div class="hidden sm:flex items-center justify-center text-gray-300 mt-5 px-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>

            <div class="flex sm:flex-col items-start sm:items-center gap-3 sm:gap-3 flex-1">
              <div class="bg-sky-50 rounded-2xl p-3.5 flex-shrink-0">
                <svg class="w-7 h-7 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
              </div>
              <div class="sm:text-center">
                <p class="text-sm font-semibold text-gray-900">Pick your sources</p>
                <p class="text-xs text-gray-500 mt-0.5 leading-snug">LinkedIn, niche boards, RSS — whatever you trust.</p>
              </div>
            </div>

            <div class="hidden sm:flex items-center justify-center text-gray-300 mt-5 px-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>

            <div class="flex sm:flex-col items-start sm:items-center gap-3 sm:gap-3 flex-1">
              <div class="bg-amber-50 rounded-2xl p-3.5 flex-shrink-0">
                <svg class="w-7 h-7 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div class="sm:text-center">
                <p class="text-sm font-semibold text-gray-900">Daily auto-fetch</p>
                <p class="text-xs text-gray-500 mt-0.5 leading-snug">We pull fresh postings every morning at the time you pick.</p>
              </div>
            </div>

            <div class="hidden sm:flex items-center justify-center text-gray-300 mt-5 px-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>

            <div class="flex sm:flex-col items-start sm:items-center gap-3 sm:gap-3 flex-1">
              <div class="bg-purple-50 rounded-2xl p-3.5 flex-shrink-0">
                <svg class="w-7 h-7 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"/></svg>
              </div>
              <div class="sm:text-center">
                <p class="text-sm font-semibold text-gray-900">Dedupe & AI score</p>
                <p class="text-xs text-gray-500 mt-0.5 leading-snug">Reposts collapsed. Each job scored against your CV.</p>
              </div>
            </div>

            <div class="hidden sm:flex items-center justify-center text-gray-300 mt-5 px-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </div>

            <div class="flex sm:flex-col items-start sm:items-center gap-3 sm:gap-3 flex-1">
              <div class="bg-emerald-50 rounded-2xl p-3.5 flex-shrink-0">
                <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div class="sm:text-center">
                <p class="text-sm font-semibold text-gray-900">Strong matches only</p>
                <p class="text-xs text-gray-500 mt-0.5 leading-snug">Email digest with the gems. Open. Apply. Done.</p>
              </div>
            </div>

          </div>
        </div>

        <!-- Product preview mock -->
        <div class="mt-6 rounded-2xl border border-gray-200 shadow-sm" style="background:#f3f4f6;">

          <!-- Content behind frosted overlay — relative container -->
          <div style="position:relative;">

            <!-- Actual cards (muted underneath) -->
            <div style="padding:1.25rem 1.25rem 1rem;">

              <!-- Search for Jobs bar -->
              <div style="background:white;border-radius:12px;border:1px solid #e5e7eb;padding:1rem 1.25rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1rem;">
                <div>
                  <div style="font-size:16px;font-weight:700;color:#111827;">Search for Jobs</div>
                  <div style="font-size:12.5px;color:#6b7280;margin-top:2px;">Fetch jobs from your sources, score with AI, send the email digest.</div>
                </div>
                <div style="display:flex;gap:8px;flex-shrink:0;">
                  <span style="display:inline-flex;align-items:center;gap:6px;background:#2563eb;color:white;font-size:12.5px;font-weight:600;padding:7px 14px;border-radius:8px;">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 3"/></svg>
                    Schedule
                  </span>
                  <span style="display:inline-flex;align-items:center;gap:6px;background:#16a34a;color:white;font-size:12.5px;font-weight:600;padding:7px 14px;border-radius:8px;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8L6 20V4Z"/></svg>
                    Run Once
                  </span>
                </div>
              </div>

              <!-- Two-column cards -->
              <div style="display:grid;grid-template-columns:220px 1fr;gap:1rem;align-items:start;">

            <!-- Last Run -->
            <div style="background:white;border-radius:12px;border:1px solid #e5e7eb;padding:1rem;">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
                <span style="font-size:14px;font-weight:700;color:#111827;">Last Run</span>
                <span style="background:#dcfce7;color:#16a34a;font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;">success</span>
              </div>
              <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-bottom:0.75rem;">
                <div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:8px 6px;text-align:center;">
                  <div style="font-size:22px;font-weight:800;color:#111827;line-height:1;">88</div>
                  <div style="font-size:10.5px;color:#9ca3af;margin-top:2px;">Fetched</div>
                </div>
                <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:8px 6px;text-align:center;">
                  <div style="font-size:22px;font-weight:800;color:#16a34a;line-height:1;">6</div>
                  <div style="font-size:10.5px;color:#9ca3af;margin-top:2px;">Strong</div>
                </div>
                <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:8px 6px;text-align:center;">
                  <div style="font-size:22px;font-weight:800;color:#d97706;line-height:1;">8</div>
                  <div style="font-size:10.5px;color:#9ca3af;margin-top:2px;">Weak</div>
                </div>
              </div>
              <div style="font-size:11px;color:#9ca3af;">15 May 2026 14:59 · 193s</div>
            </div>

            <!-- Strong Matches -->
            <div style="background:white;border-radius:12px;border:1px solid #e5e7eb;padding:1rem;">
              <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;">
                <span style="font-size:14px;font-weight:700;color:#111827;">Last Run — Strong Matches</span>
                <span style="font-size:12.5px;color:#2563eb;font-weight:500;display:inline-flex;align-items:center;gap:4px;">6 View all →</span>
              </div>
              <div style="display:flex;flex-direction:column;gap:0;">
                <%
                  var mockJobs = [
                    { initials:'R', bg:'#dc2626', title:'Senior Product Manager, B2B Marketplace (m/f/d)', company:'Redcare Pharmacy', flag:'🇩🇪', loc:'Berlin, Berlin, Germany', score:88 },
                    { initials:'DH', bg:'#ef4444', title:'Group Product Manager — Logistics, Routing &amp; Disp…', company:'Delivery Hero', flag:'🇩🇪', loc:'Berlin, Berlin, Germany', score:88 },
                    { initials:'P', bg:'#2563eb', title:'Senior Product Manager, Flights', company:'Priceline', flag:'🇩🇪', loc:'Berlin, Berlin, Germany', score:84 }
                  ];
                  mockJobs.forEach(function(j, idx) {
                %>
                <div style="display:flex;align-items:center;gap:10px;padding:9px 0;<%= idx < mockJobs.length-1 ? 'border-bottom:1px solid rgba(0,0,0,0.06);' : '' %>">
                  <div style="width:32px;height:32px;border-radius:8px;background:<%= j.bg %>;display:grid;place-items:center;color:white;font-weight:700;font-size:11px;flex-shrink:0;"><%= j.initials %></div>
                  <div style="flex:1;min-width:0;">
                    <div style="font-size:12.5px;font-weight:600;color:#111827;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%- j.title %></div>
                    <div style="font-size:11px;color:#9ca3af;margin-top:1px;"><%= j.company %> · <%= j.flag %> <%= j.loc %></div>
                  </div>
                  <div style="display:flex;align-items:center;gap:6px;flex-shrink:0;">
                    <span style="background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;font-size:11px;font-weight:600;padding:3px 8px;border-radius:999px;display:inline-flex;align-items:center;gap:3px;">Strong <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg></span>
                    <span style="background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;font-size:12px;font-weight:700;padding:3px 8px;border-radius:8px;"><%= j.score %></span>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>

            </div><!-- /two-col -->
            </div><!-- /inner padding -->

            <!-- Frosted lock overlay -->
            <div style="position:absolute;inset:0;background:rgba(243,244,246,0.72);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border-radius:16px;display:flex;align-items:center;justify-content:center;pointer-events:none;">
              <div style="background:white;border:1px solid #e5e7eb;border-radius:10px;padding:10px 18px;display:flex;align-items:center;gap:8px;box-shadow:0 2px 8px rgba(0,0,0,0.06);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.75" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span style="font-size:12px;color:#6b7280;font-weight:500;">Sign in to unlock</span>
              </div>
            </div>

          </div><!-- /relative -->

          <!-- Footer — matches layout.ejs style -->
          <div style="padding:0.75rem 1.25rem 1.25rem;">
            <div class="bg-white border border-gray-200 rounded-xl shadow-sm px-6 py-2.5 flex items-center justify-end gap-3 text-xs">
              <a href="/pricing" class="text-gray-500 hover:text-gray-700 transition-colors">Pricing</a>
              <a href="/terms" class="text-gray-500 hover:text-gray-700 transition-colors">Terms</a>
              <a href="/privacy" class="text-gray-500 hover:text-gray-700 transition-colors">Privacy</a>
              <a href="/refunds" class="text-gray-500 hover:text-gray-700 transition-colors">Refunds</a>
            </div>
          </div>

        </div>

      </div>
    </div>
  </main>
</div>

<script>
let currentEmail = '';

function setLoading(id, loading, label) {
  const btn = document.getElementById(id);
  if (!btn) return;
  btn.disabled = loading;
  btn.textContent = loading ? '…' : label;
  btn.classList.toggle('opacity-60', loading);
  btn.classList.toggle('cursor-not-allowed', loading);
}

function showMsg(id, text, isError) {
  const el = document.getElementById(id);
  el.textContent = text;
  el.className = 'text-xs mb-2 px-0.5 ' + (isError ? 'text-red-600' : 'text-emerald-600');
}
function hideMsg(id) { document.getElementById(id).classList.add('hidden'); }

async function requestCode() {
  const email = document.getElementById('signin-email').value.trim();
  hideMsg('email-error');
  setLoading('email-btn', true, 'Email me a code');
  try {
    const res = await fetch('/welcome/request', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });
    const data = await res.json();
    if (!data.ok) { showMsg('email-error', data.error, true); return; }
    if (data.redirect) { location.href = data.redirect; return; }
    currentEmail = email;
    document.getElementById('step-email').classList.add('hidden');
    document.getElementById('step-verify').classList.remove('hidden');
    document.getElementById('verify-hint').textContent = 'Code sent to ' + email;
    setTimeout(() => document.getElementById('signin-code').focus(), 50);
  } catch (_) {
    showMsg('email-error', 'Network error. Try again.', true);
  } finally {
    setLoading('email-btn', false, 'Email me a code');
  }
}

async function verifyCode() {
  const code = document.getElementById('signin-code').value.replace(/\D/g, '');
  hideMsg('verify-msg');
  setLoading('verify-btn', true, 'Verify');
  try {
    const res = await fetch('/welcome/verify', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: currentEmail, code })
    });
    const data = await res.json();
    if (!data.ok) { showMsg('verify-msg', data.error, true); return; }
    location.href = '/';
  } catch (_) {
    showMsg('verify-msg', 'Network error. Try again.', true);
  } finally {
    setLoading('verify-btn', false, 'Verify');
  }
}

async function resendCode() {
  hideMsg('verify-msg');
  setLoading('resend-btn', true, 'Resend code');
  try {
    const res = await fetch('/welcome/request', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: currentEmail })
    });
    const data = await res.json();
    showMsg('verify-msg', data.ok ? 'New code sent.' : data.error, !data.ok);
  } catch (_) {
    showMsg('verify-msg', 'Network error. Try again.', true);
  } finally {
    setLoading('resend-btn', false, 'Resend code');
  }
}

function backToEmail() {
  document.getElementById('step-verify').classList.add('hidden');
  document.getElementById('step-email').classList.remove('hidden');
  hideMsg('email-error');
}

document.getElementById('signin-email').addEventListener('keydown', e => { if (e.key === 'Enter') requestCode(); });
document.getElementById('signin-code').addEventListener('keydown', e => { if (e.key === 'Enter') verifyCode(); });
document.getElementById('signin-code').addEventListener('input', e => {
  const digits = e.target.value.replace(/\D/g, '');
  e.target.value = digits;
  if (digits.length === 6) verifyCode();
});
</script>
</body>
</html>
