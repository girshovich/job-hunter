<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Job Search</title>
  <link rel="icon" href="/icon.ico">
  <link rel="stylesheet" href="/css/tailwind.css">
  <style>
    /* ── Welcome (standalone, DS v2 light) ── */
    html,body{margin:0;height:100%;overflow:hidden}
    body{background:var(--bg);color:var(--ink);-webkit-font-smoothing:antialiased}
    input::placeholder{color:#9aa1ad}
    .shell{display:flex;height:100dvh;width:100%;overflow:hidden}

    /* ---- Sidebar (locked preview) ---- */
    .sb{width:236px;flex:none;background:#fff;border-right:1px solid var(--line);display:flex;flex-direction:column;height:100%;position:relative}
    .sb-brand{display:flex;align-items:center;gap:9px;padding:18px 18px 6px}
    .sb-nav{flex:1;overflow-y:auto;padding:8px 12px;display:flex;flex-direction:column;gap:2px}
    .sb-item{display:flex;align-items:center;gap:11px;padding:9px 11px;border-radius:9px;color:var(--muted);font-size:13.5px;font-weight:600;background:transparent;border:0;width:100%;text-align:left}
    .sb-item svg{stroke:var(--fainter)}
    .sb-item.active{background:var(--accent-soft);color:var(--accent);font-weight:700}
    .sb-item.active svg{stroke:var(--accent)}
    .sb-chev{margin-left:auto}
    .ob{background:var(--accent-soft);border:1px solid var(--accent-border);border-radius:11px;padding:11px 11px 8px;margin-bottom:12px;display:flex;flex-direction:column;gap:7px}
    .ob-head{display:flex;align-items:center;justify-content:space-between}
    .ob-title{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--accent)}
    .ob-meta{display:flex;align-items:center;gap:8px;font-size:10.5px;color:var(--faint);font-weight:700}
    .ob-bar{flex:1;height:3px;background:#e2e6ee;border-radius:999px;overflow:hidden}
    .ob-bar > span{display:block;height:100%;background:var(--accent);border-radius:999px}
    .ob-list{display:flex;flex-direction:column}
    .ob-step{display:grid;grid-template-columns:16px 1fr;align-items:center;gap:8px;padding:4px;border-radius:6px;font-size:12px;line-height:1.2;color:var(--fainter)}
    .ob-check{width:16px;height:16px;border-radius:50%;display:grid;place-items:center;font-size:9.5px;font-weight:700;background:#fff;border:1px solid #d6dae2;color:var(--faint)}
    .sb-foot{padding:12px;border-top:1px solid var(--line);display:flex;flex-direction:column;gap:8px}
    .sb-run{display:flex;align-items:center;gap:9px;padding:10px 13px;border-radius:10px;font-size:13.5px;font-weight:700;width:100%;justify-content:flex-start;color:#fff}
    .sb-run-green{background:var(--green)}
    .sb-run-blue{background:var(--accent)}
    .sb-profile{display:flex;align-items:center;gap:10px;padding:8px 6px;margin-top:2px}
    .sb-avatar{width:32px;height:32px;border-radius:50%;background:#eef1f6;display:grid;place-items:center;color:var(--fainter);flex:none}
    .sb-lock{position:absolute;inset:0;background:rgba(255,255,255,.5);backdrop-filter:blur(1.5px);-webkit-backdrop-filter:blur(1.5px);z-index:10;display:flex;align-items:center;justify-content:center}
    .lock-pill{background:#fff;border:1px solid var(--line2);border-radius:10px;padding:9px 15px;display:flex;align-items:center;gap:8px;box-shadow:0 6px 20px -8px rgba(16,24,40,.25);font-size:12px;color:var(--muted);font-weight:600}

    /* ---- Main ---- */
    .main{flex:1;min-width:0;height:100%;overflow-y:auto}
    .page{max-width:1120px;padding:26px 16px 44px;display:flex;flex-direction:column;gap:16px}
    .w-h1{margin:0;font-size:21px;font-weight:800;letter-spacing:-.02em;color:var(--ink)}
    .w-crumb{font-size:13px;color:var(--faint);margin-top:3px;font-weight:600}
    .card{background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow-card)}

    .field{display:block;width:100%;padding:12px 14px;font-size:13.5px;color:var(--ink);border:1px solid var(--line2);border-radius:11px;background:#fff;outline:none}
    .field:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
    .btn-accent{width:100%;background:var(--accent);color:#fff;font-size:13.5px;font-weight:700;border:0;padding:12px;border-radius:11px;cursor:pointer}
    .btn-accent:hover{background:var(--accent-hover)}
    .link-ghost{color:var(--accent);font-weight:600}

    .steps{display:flex;flex-direction:column;gap:14px}
    @media(min-width:760px){ .steps{flex-direction:row;align-items:flex-start;gap:0} }
    .step{display:flex;align-items:flex-start;gap:12px;flex:1}
    @media(min-width:760px){ .step{flex-direction:column;align-items:center;text-align:center} }
    .step-ico{border-radius:16px;padding:13px;flex:none;display:grid;place-items:center}
    .step-arrow{display:none;color:#d4d7de;margin-top:16px;padding:0 4px}
    @media(min-width:760px){ .step-arrow{display:flex} }

    .hero{display:flex;flex-direction:column;gap:16px}
    @media(min-width:900px){ .hero{flex-direction:row;align-items:stretch} }
    .hero-right{display:flex;flex-direction:column;gap:16px;width:100%}
    @media(min-width:900px){ .hero-right{width:384px;flex:none} }

    .preview-wrap{display:none}
    @media(min-width:900px){ .preview-wrap{display:block} }
    .prev-lock{position:absolute;inset:0;background:rgba(243,244,247,.72);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border-radius:16px;display:flex;align-items:center;justify-content:center;pointer-events:none}

    @media(max-width:899px){ .sb{display:none} }
  </style>
</head>
<body class="h-full font-sans antialiased">
<div class="shell">

  <!-- ============ SIDEBAR (locked preview) ============ -->
  <aside class="sb">
    <div class="sb-brand">
      <img src="/logo.PNG" alt="Job Search" style="width:100%;max-width:200px;height:auto;display:block;" />
    </div>
    <nav class="sb-nav">
      <div class="ob">
        <div class="ob-head">
          <div class="ob-title"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"/></svg>Onboarding</div>
        </div>
        <div class="ob-meta">0 of 5 done<span class="ob-bar"><span style="width:0%"></span></span></div>
        <div class="ob-list">
          <div class="ob-step"><span class="ob-check">1</span><span>Set up your profile</span></div>
          <div class="ob-step"><span class="ob-check">2</span><span>Add target roles</span></div>
          <div class="ob-step"><span class="ob-check">3</span><span>Add or buy API keys</span></div>
          <div class="ob-step"><span class="ob-check">4</span><span>Run your first search</span></div>
          <div class="ob-step"><span class="ob-check">5</span><span>Set a daily schedule</span></div>
        </div>
      </div>
      <span class="sb-item active"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/></svg>Start</span>
      <span class="sb-item"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1l8.8 8.8 8.8-8.8a5 5 0 0 0 0-7.1Z"/></svg>Matches</span>
      <span class="sb-item"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/></svg>All Jobs</span>
      <span class="sb-item"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/></svg>Stats</span>
      <span class="sb-item"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>Run Logs</span>
      <span class="sb-item"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1A2 2 0 1 1 4.3 17l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.3-1.8l-.1-.1A2 2 0 1 1 7 4.3l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1A2 2 0 1 1 19.7 7l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>Settings<span class="sb-chev"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#aeb4bf" stroke-width="1.9" stroke-linecap="round"><path d="m9 6 6 6-6 6"/></svg></span></span>
    </nav>
    <div class="sb-foot">
      <span class="sb-run sb-run-green" style="opacity:.5"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8L6 20V4Z"/></svg>Run once</span>
      <span class="sb-run sb-run-blue" style="opacity:.5"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Schedule</span>
      <div class="sb-profile">
        <div class="sb-avatar"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
        <div style="flex:1;min-width:0"><div style="font-size:13px;font-weight:700;color:var(--muted);line-height:1.2">Your account</div><div style="font-size:11.5px;color:var(--faint)">Sign in to continue</div></div>
      </div>
    </div>
    <!-- frosted lock over the whole sidebar -->
    <div class="sb-lock">
      <div class="lock-pill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8a91a0" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Sign in to unlock</div>
    </div>
  </aside>

  <!-- ============ MAIN ============ -->
  <main class="main jh-scroll">
    <div class="page">

      <!-- header -->
      <div>
        <h1 class="w-h1">Welcome</h1>
        <p class="w-crumb"><%= new Date().toLocaleDateString('en-GB', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
      <div style="padding:12px 14px;border-radius:11px;background:var(--red-soft);border:1px solid var(--red-border);font-size:13px;color:var(--red-ink)"><%= error %></div>
      <% } %>
      <% if (typeof message !== 'undefined' && message) { %>
      <div style="padding:12px 14px;border-radius:11px;background:var(--green-soft);border:1px solid var(--green-border);font-size:13px;color:var(--green2)"><%= message %></div>
      <% } %>

      <!-- hero: letter + sign-in + github -->
      <div class="hero">

        <!-- Letter -->
        <div class="card" style="padding:26px;flex:1;min-width:0">
          <h2 style="margin:0 0 20px;font-size:28px;font-weight:800;letter-spacing:-.02em;line-height:1.25;color:var(--ink)">Save 30 minutes a day on your job hunt.</h2>
          <div style="display:flex;gap:16px">
            <img src="/misha.jpg" alt="Misha" style="width:64px;height:64px;border-radius:50%;object-fit:cover;flex:none;margin-top:2px">
            <div style="flex:1;min-width:0">
              <!-- Mobile: shortened text -->
              <p class="md:hidden" style="margin:0 0 14px;font-size:13.5px;color:var(--ink2);line-height:1.65;text-align:justify">Hi, I'm Misha, a product guy. I built Job Search to save myself time searching jobs. Turned out useful, so I'm sharing it for free. Fork it, or run it with your own API keys for free, or ask me if you could use mine with some sort of compensation. Welcome aboard!</p>
              <!-- Desktop: full text -->
              <p class="hidden md:block" style="margin:0 0 12px;font-size:13.5px;color:var(--ink2);line-height:1.65;text-align:justify">Hi, I'm Misha, a product guy. I built Job Search to save myself time searching jobs. Turned out useful, so I'm sharing it for free.</p>
              <p class="hidden md:block" style="margin:0 0 12px;font-size:13.5px;color:var(--ink2);line-height:1.65;text-align:justify">If you're hunting jobs across countries, scrolling hundreds of reposts from companies you don't even like - virtual hug. Job Search knows what you want. It scans same sites you do, kills reposts, and scores the rest against your criteria - showing only jobs you'd actually pick. It won't apply for you (I believe final call should be human), but it gets you there and writes a cover letter.</p>
              <p class="hidden md:block" style="margin:0 0 12px;font-size:13.5px;color:var(--ink2);line-height:1.65;text-align:justify">Fork it, or run it with your own API keys for free, or ask me if you could use mine with some sort of compensation.</p>
              <p class="hidden md:block" style="margin:0 0 16px;font-size:13.5px;color:var(--ink2);line-height:1.65;text-align:justify">Welcome aboard!</p>
              <p style="margin:0;font-size:13px;color:var(--faint);text-align:right">Cheers, Misha</p>
            </div>
          </div>
        </div>

        <!-- Right column -->
        <div class="hero-right">

          <!-- Sign-in -->
          <div class="card" style="padding:24px;flex:1">
            <div id="step-email">
              <p style="margin:0 0 18px;font-size:19px;font-weight:800;letter-spacing:-.02em;color:var(--ink)">Sign in</p>
              <input id="signin-email" type="email" placeholder="you@work.com"
                     autocomplete="email" autocapitalize="off" inputmode="email"
                     class="field" style="margin-bottom:12px">
              <div id="email-error" class="hidden" style="font-size:12px;margin-bottom:8px"></div>
              <button id="email-btn" onclick="requestCode()" class="btn-accent" style="margin-bottom:14px">Email me a code</button>
              <p style="margin:0;font-size:12px;color:var(--faint);line-height:1.5">No password, enter with a 6-digit code. By signing in you agree to the <a href="/terms" class="link-ghost">Terms</a> and <a href="/privacy" class="link-ghost">Privacy Policy</a>.</p>
            </div>
            <div id="step-verify" class="hidden">
              <p style="margin:0 0 4px;font-size:19px;font-weight:800;letter-spacing:-.02em;color:var(--ink)">Check your inbox</p>
              <p id="verify-hint" style="margin:0 0 18px;font-size:12px;color:var(--faint)"></p>
              <input id="signin-code" type="text" inputmode="numeric" maxlength="6"
                     placeholder="6-digit code" autocomplete="one-time-code"
                     class="field" style="margin-bottom:12px;text-align:center;letter-spacing:.3em;font-weight:700">
              <div id="verify-msg" class="hidden" style="font-size:12px;margin-bottom:8px"></div>
              <button id="verify-btn" onclick="verifyCode()" class="btn-accent" style="margin-bottom:8px">Verify</button>
              <button id="resend-btn" onclick="resendCode()" style="width:100%;background:transparent;border:0;color:var(--accent);font-weight:600;font-size:13.5px;padding:8px;cursor:pointer">Resend code</button>
              <p style="margin:8px 0 0;text-align:center;font-size:12px;color:var(--faint)"><button onclick="backToEmail()" style="background:none;border:0;color:var(--faint);text-decoration:underline;font-size:12px;cursor:pointer">Change email</button></p>
            </div>
          </div>

          <!-- GitHub -->
          <div class="card" style="padding:20px">
            <p style="margin:0 0 12px;font-size:13.5px;font-weight:700;color:var(--ink2)">You're welcome to self-host</p>
            <a href="https://github.com/girshovich/job-hunter" target="_blank" rel="noopener" style="display:flex;align-items:center;gap:9px;width:100%;border:1px solid var(--line2);border-radius:11px;padding:11px 14px;font-size:13px;font-weight:600;color:var(--ink2)">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="flex:none"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.454-1.155-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.741 0 .267.18.578.688.48C19.138 20.163 22 16.418 22 12c0-5.523-4.477-10-10-10z"/></svg>
              github.com/girshovich/job-hunter
            </a>
          </div>

        </div>
      </div>

      <!-- How it works -->
      <div class="card" style="padding:24px">
        <h2 style="margin:0 0 20px;font-size:16px;font-weight:800;letter-spacing:-.01em;color:var(--ink)">How it works</h2>
        <div class="steps">
          <div class="step">
            <div class="step-ico" style="background:#f3f0ff"><svg width="26" height="26" fill="none" stroke="#6d5efc" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg></div>
            <div><p style="margin:0;font-size:13.5px;font-weight:700;color:var(--ink)">Describe yourself</p><p style="margin:3px 0 0;font-size:12px;color:var(--faint);line-height:1.45">You, roles, locations and what you care about.</p></div>
          </div>
          <div class="step-arrow"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></div>
          <div class="step">
            <div class="step-ico" style="background:#eaf5ff"><svg width="26" height="26" fill="none" stroke="#2e86de" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1.001.43-1.563A6 6 0 1121.75 8.25z"/></svg></div>
            <div><p style="margin:0;font-size:13.5px;font-weight:700;color:var(--ink)">Set API keys</p><p style="margin:3px 0 0;font-size:12px;color:var(--faint);line-height:1.45">Add your Apify and LLM keys, or use mine.</p></div>
          </div>
          <div class="step-arrow"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></div>
          <div class="step">
            <div class="step-ico" style="background:#fff6e5"><svg width="26" height="26" fill="none" stroke="var(--amber)" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 8.5l5.5 3.5L10 15.5v-7z"/></svg></div>
            <div><p style="margin:0;font-size:13.5px;font-weight:700;color:var(--ink)">Schedule job search</p><p style="margin:3px 0 0;font-size:12px;color:var(--faint);line-height:1.45">Get the latest jobs from top job platforms.</p></div>
          </div>
          <div class="step-arrow"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></div>
          <div class="step">
            <div class="step-ico" style="background:#f4f0ff"><svg width="26" height="26" fill="none" stroke="var(--purple-strong)" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"/></svg></div>
            <div><p style="margin:0;font-size:13.5px;font-weight:700;color:var(--ink)">Wait for AI scoring</p><p style="margin:3px 0 0;font-size:12px;color:var(--faint);line-height:1.45">Each job scored vs your profile. No duplicates.</p></div>
          </div>
          <div class="step-arrow"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></div>
          <div class="step">
            <div class="step-ico" style="background:var(--green-soft)"><svg width="26" height="26" fill="none" stroke="var(--green)" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></div>
            <div><p style="margin:0;font-size:13.5px;font-weight:700;color:var(--ink)">Get job matches</p><p style="margin:3px 0 0;font-size:12px;color:var(--faint);line-height:1.45">Email digest with the gems. Open. Apply. Done.</p></div>
          </div>
        </div>
      </div>

      <!-- Product preview (frosted) -->
      <div class="preview-wrap">
        <div style="position:relative;background:var(--bg);border:1px solid var(--line);border-radius:16px">
          <div style="padding:20px">
            <!-- Search for Jobs bar -->
            <div style="background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px">
              <div>
                <div style="font-size:16px;font-weight:800;color:var(--ink)">Search for Jobs</div>
                <div style="font-size:12.5px;color:var(--muted2);margin-top:2px">Fetch jobs from your sources, score with AI, send the email digest.</div>
              </div>
              <div style="display:flex;gap:8px;flex:none">
                <span style="display:inline-flex;align-items:center;gap:6px;background:#eef1f6;color:#3a4250;font-size:12.5px;font-weight:700;padding:8px 14px;border-radius:9px"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Schedule</span>
                <span style="display:inline-flex;align-items:center;gap:6px;background:var(--green);color:#fff;font-size:12.5px;font-weight:700;padding:8px 14px;border-radius:9px"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8L6 20V4Z"/></svg>Run Once</span>
              </div>
            </div>
            <!-- two-col -->
            <div style="display:grid;grid-template-columns:230px 1fr;gap:16px;align-items:start">
              <!-- Last Session -->
              <div style="background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
                  <span style="font-size:14px;font-weight:800;color:var(--ink)">Last Session</span>
                  <span style="background:var(--green-soft);color:var(--green2);font-size:11px;font-weight:700;padding:2px 9px;border-radius:7px">success</span>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:7px;margin-bottom:12px">
                  <div style="background:#f6f7f9;border:1px solid var(--line);border-radius:9px;padding:9px 6px;text-align:center"><div style="font-size:22px;font-weight:800;color:var(--ink);line-height:1" class="tnum">88</div><div style="font-size:10.5px;color:var(--fainter);margin-top:2px">Fetched</div></div>
                  <div style="background:var(--green-soft);border:1px solid var(--green-border);border-radius:9px;padding:9px 6px;text-align:center"><div style="font-size:22px;font-weight:800;color:var(--green2);line-height:1" class="tnum">6</div><div style="font-size:10.5px;color:var(--fainter);margin-top:2px">Strong</div></div>
                  <div style="background:var(--amber-soft);border:1px solid var(--amber-border);border-radius:9px;padding:9px 6px;text-align:center"><div style="font-size:22px;font-weight:800;color:var(--amber-ink);line-height:1" class="tnum">8</div><div style="font-size:10.5px;color:var(--fainter);margin-top:2px">Weak</div></div>
                </div>
                <div style="font-size:11px;color:var(--fainter)">15 May 2026 14:59 · 193s</div>
              </div>
              <!-- Strong matches -->
              <div style="background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
                  <span style="font-size:14px;font-weight:800;color:var(--ink)">Last Session — Strong Matches</span>
                  <span style="font-size:12.5px;color:var(--accent);font-weight:600;display:inline-flex;align-items:center;gap:4px">6 View all →</span>
                </div>
                <div>
                  <% [
                    { i:'R',  bg:'#dc2626', title:'Senior Product Manager, B2B Marketplace (m/f/d)', company:'Redcare Pharmacy', flag:'🇩🇪', loc:'Berlin, Germany', score:88 },
                    { i:'DH', bg:'#ef4444', title:'Group Product Manager — Logistics, Routing & Disp…', company:'Delivery Hero', flag:'🇩🇪', loc:'Berlin, Germany', score:88 },
                    { i:'P',  bg:'#2f6bff', title:'Senior Product Manager, Flights', company:'Priceline', flag:'🇩🇪', loc:'Berlin, Germany', score:84 }
                  ].forEach(function(j, idx, arr){ %>
                  <div style="display:flex;align-items:center;gap:10px;padding:9px 0;<%= idx < arr.length-1 ? 'border-bottom:1px solid rgba(16,24,40,.06);' : '' %>">
                    <div style="width:32px;height:32px;border-radius:8px;background:<%= j.bg %>;display:grid;place-items:center;color:#fff;font-weight:800;font-size:11px;flex:none"><%= j.i %></div>
                    <div style="flex:1;min-width:0"><div style="font-size:12.5px;font-weight:700;color:#131722;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= j.title %></div>
                    <div style="font-size:11px;color:#9aa1ad;margin-top:1px"><%= j.company %> · <%= j.flag %> <%= j.loc %></div></div>
                    <div style="display:flex;align-items:center;gap:6px;flex:none">
                      <span style="background:var(--green-soft);color:var(--green2);font-size:11px;font-weight:700;padding:3px 8px;border-radius:7px;display:inline-flex;align-items:center;gap:3px">Strong<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg></span>
                      <span style="background:var(--green);color:#fff;font-size:12px;font-weight:800;padding:3px 8px;border-radius:7px" class="tnum"><%= j.score %></span>
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#2f6bff" stroke-width="2" stroke-linecap="round"><path d="M7 17 17 7M7 7h10v10"/></svg>
                    </div>
                  </div>
                  <% }); %>
                </div>
              </div>
            </div>
          </div>
          <!-- frosted lock -->
          <div class="prev-lock"><div class="lock-pill"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9aa1ad" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Sign in to unlock</div></div>
        </div>
      </div>

      <!-- Footer legal links -->
      <div class="card" style="padding:10px 24px;display:flex;align-items:center;justify-content:flex-end;gap:14px;font-size:12px">
        <a href="/terms" style="color:var(--faint);font-weight:600">Terms</a>
        <a href="/privacy" style="color:var(--faint);font-weight:600">Privacy</a>
      </div>

    </div>
  </main>
</div>

<script>
let currentEmail = '';

function setLoading(id, loading, label) {
  const btn = document.getElementById(id);
  if (!btn) return;
  btn.disabled = loading;
  btn.textContent = loading ? '…' : label;
  btn.classList.toggle('opacity-60', loading);
  btn.classList.toggle('cursor-not-allowed', loading);
}

function showMsg(id, text, isError) {
  const el = document.getElementById(id);
  el.textContent = text;
  el.className = 'text-xs mb-2 px-0.5 ' + (isError ? 'text-red-600' : 'text-[var(--green2)]');
}
function hideMsg(id) { document.getElementById(id).classList.add('hidden'); }

async function requestCode() {
  const email = document.getElementById('signin-email').value.trim();
  hideMsg('email-error');
  setLoading('email-btn', true, 'Email me a code');
  try {
    const res = await fetch('/welcome/request', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email })
    });
    const data = await res.json();
    if (!data.ok) { showMsg('email-error', data.error, true); return; }
    if (data.redirect) { location.href = data.redirect; return; }
    currentEmail = email;
    document.getElementById('step-email').classList.add('hidden');
    document.getElementById('step-verify').classList.remove('hidden');
    document.getElementById('verify-hint').textContent = 'Code sent to ' + email;
    setTimeout(() => document.getElementById('signin-code').focus(), 50);
  } catch (_) {
    showMsg('email-error', 'Network error. Try again.', true);
  } finally {
    setLoading('email-btn', false, 'Email me a code');
  }
}

async function verifyCode() {
  const code = document.getElementById('signin-code').value.replace(/\D/g, '');
  hideMsg('verify-msg');
  setLoading('verify-btn', true, 'Verify');
  try {
    const res = await fetch('/welcome/verify', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: currentEmail, code })
    });
    const data = await res.json();
    if (!data.ok) { showMsg('verify-msg', data.error, true); return; }
    location.href = '/';
  } catch (_) {
    showMsg('verify-msg', 'Network error. Try again.', true);
  } finally {
    setLoading('verify-btn', false, 'Verify');
  }
}

async function resendCode() {
  hideMsg('verify-msg');
  setLoading('resend-btn', true, 'Resend code');
  try {
    const res = await fetch('/welcome/request', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: currentEmail })
    });
    const data = await res.json();
    showMsg('verify-msg', data.ok ? 'New code sent.' : data.error, !data.ok);
  } catch (_) {
    showMsg('verify-msg', 'Network error. Try again.', true);
  } finally {
    setLoading('resend-btn', false, 'Resend code');
  }
}

function backToEmail() {
  document.getElementById('step-verify').classList.add('hidden');
  document.getElementById('step-email').classList.remove('hidden');
  hideMsg('email-error');
}

document.getElementById('signin-email').addEventListener('keydown', e => { if (e.key === 'Enter') requestCode(); });
document.getElementById('signin-code').addEventListener('keydown', e => { if (e.key === 'Enter') verifyCode(); });
document.getElementById('signin-code').addEventListener('input', e => {
  const digits = e.target.value.replace(/\D/g, '');
  e.target.value = digits;
  if (digits.length === 6) verifyCode();
});
</script>
</body>
</html>
