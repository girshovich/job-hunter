            <div class="sc1-tile">
              <div class="sc1-shot"><img src="/screens/profile.webp" loading="lazy" width="500" height="417" alt="Settings: Profile — login email, timezone, country, languages and a profile description."></div>
              <div class="sc1-head"><span class="sc1-num">1</span><p class="sc1-t">Describe yourself</p></div>
