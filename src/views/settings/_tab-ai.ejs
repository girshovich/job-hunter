    <script>
    (function() {
      var jhBtn    = document.getElementById('jh-creds-btn');
      var ownBtn   = document.getElementById('own-keys-btn');
      var jhView   = document.getElementById('jh-credits-view');
      var ownView  = document.getElementById('own-keys-view');
      var inp      = document.getElementById('use-jh-credits-input');
      var apifyInp = document.getElementById('user-apify-token-input');
      var openaiInp= document.getElementById('user-openai-key-input');
      var actions  = document.getElementById('ai-keys-actions');
      var saveBtn  = document.getElementById('ai-keys-save-btn');
      var saveLabel= document.getElementById('ai-keys-save-label');
      var saveHint = document.getElementById('ai-keys-save-hint');

      function applyKeyMode(useJh) {
        jhBtn.setAttribute('aria-pressed', String(useJh));
        ownBtn.setAttribute('aria-pressed', String(!useJh));
        jhView.classList.toggle('hidden', !useJh);
        ownView.classList.toggle('hidden', useJh);
        inp.value = useJh ? '1' : '0';
        if (apifyInp) apifyInp.required = !useJh;
        if (openaiInp) openaiInp.required = !useJh;
      }

      // Save appears only when the block differs from what's saved.
      function refreshKeysSave() {
        var dirty = typeof isFormIdDirty === 'function' && isFormIdDirty('ai-keys-form');
        actions.classList.toggle('hidden', !dirty);
        actions.classList.toggle('flex', dirty);
        if (!dirty) return;
        saveBtn.disabled = false;
        var useJh = inp.value === '1';
        saveLabel.textContent = useJh ? 'Use JH credits' : 'Use my keys';
        saveHint.textContent = useJh
          ? 'Runs will be billed to your JH balance.'
          : 'Runs will use your Apify and OpenAI keys.';
      }
      window.refreshKeysSave = refreshKeysSave;

      // Called after Discard restores the hidden input from the snapshot.
      window.syncKeyMode = function() {
        applyKeyMode(inp.value === '1');
        refreshKeysSave();
      };

      window.setKeyMode = function(useJh) {
        applyKeyMode(useJh);
        refreshKeysSave();
      };

      [apifyInp, openaiInp].forEach(function(el) {
        if (el) el.addEventListener('input', refreshKeysSave);
      });

      applyKeyMode(<%= settings.use_jh_credits ? 'true' : 'false' %>);
    })();

    // ---- Top-up request ----
    function openTopUp() {
      document.getElementById('topup-body').classList.remove('hidden');
      document.getElementById('topup-success').classList.add('hidden');
      document.getElementById('topup-error').classList.add('hidden');
      document.getElementById('topup-modal').classList.remove('hidden');
      document.getElementById('topup-message').focus();
    }

    function closeTopUp() {
      document.getElementById('topup-modal').classList.add('hidden');
    }

    // Sidebar Top up: open the form in place when the AI tab is already showing,
    // otherwise fall back to the layout's behaviour (navigate here, then open it).
    window.jhTopUp = function() {
      var pane = document.getElementById('tab-pane-ai');
      if (pane && !pane.classList.contains('hidden')) openTopUp();
      else window.location.href = '/settings?tab=ai&topup=1';
    };

    async function sendTopUp() {
      var btn = document.getElementById('topup-send-btn');
      var err = document.getElementById('topup-error');
      var message = document.getElementById('topup-message').value.trim();
      if (!message) {
        err.textContent = 'Please write a message before sending.';
        err.classList.remove('hidden');
        return;
      }
      btn.disabled = true;
      err.classList.add('hidden');
      try {
        const res = await fetch('/api/topup-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: message }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Could not send your request.');
        document.getElementById('topup-body').classList.add('hidden');
        document.getElementById('topup-success').classList.remove('hidden');
      } catch (e) {
        err.textContent = e.message;
        err.classList.remove('hidden');
      } finally {
        btn.disabled = false;
      }
    }

    (function () {
      const params = new URLSearchParams(window.location.search);
      if (params.get('topup') !== '1') return;
      // Drop the param so a refresh doesn't reopen the modal.
      params.delete('topup');
      const qs = params.toString();
      history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : ''));
      window.addEventListener('DOMContentLoaded', openTopUp);
    })();
    </script>

