<!-- ==================== PROFILE TAB ==================== -->
<div id="tab-pane-profile" class="<%= activeTab !== 'profile' ? 'hidden' : '' %>">
<form id="profile-form" method="post" action="/settings" class="space-y-6">
  <input type="hidden" name="tab" value="profile">

  <!-- ACCOUNT -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
    <h2 class="text-base font-semibold text-gray-900 mb-1">Account</h2>
    <p class="text-xs text-gray-500 mb-4">Your login email and notification preferences.</p>

    <!-- Login email -->
    <div class="mb-4">
      <label class="block text-xs font-medium text-gray-600 mb-1">Login email</label>
      <input type="email" name="profile_email" value="<%= profileEmail %>"
             class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
      <% if (pendingEmailChange) { %>
      <div class="mt-2 flex items-start gap-2 text-xs bg-amber-50 border border-amber-200 rounded-lg px-3 py-2">
        <svg class="w-3.5 h-3.5 text-amber-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="text-amber-800 flex-1">Confirmation sent to <strong><%= pendingEmailChange.new_email %></strong>. Click the link in the email to confirm.</span>
        <button type="submit" form="cancel-email-change-form" class="text-amber-600 hover:text-red-600 font-medium underline whitespace-nowrap flex-shrink-0">Cancel</button>
      </div>
      <% } else { %>
      <p class="text-xs text-gray-400 mt-1">A confirmation link will be sent to the new address before the change takes effect.</p>
      <% } %>
    </div>

    <!-- Email notifications toggle -->
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-700">Email notifications</p>
        <p class="text-xs text-gray-500">Receive daily job match reports by email</p>
      </div>
      <label class="flex items-center cursor-pointer">
        <input type="checkbox" name="email_enabled" value="on"
               onchange="document.getElementById('profile-save-btn').disabled = false"
               class="sr-only peer"
               <%= settings.email_enabled !== 0 ? 'checked' : '' %> />
        <div class="relative w-10 h-5 bg-gray-300 peer-checked:bg-emerald-500 rounded-full transition-colors
                    after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white
                    after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-5"></div>
      </label>
    </div>
  </div>

  <!-- LANGUAGES -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
    <div class="mb-3">
      <h2 class="text-base font-semibold text-gray-900">Languages</h2>
      <p class="text-xs text-gray-500 mt-0.5">Languages you know on a professional level</p>
    </div>
    <textarea name="languages" rows="2" placeholder="e.g. English, Russian, Armenian"
              class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-y"><%= settings.languages || '' %></textarea>
  </div>

  <!-- CURRENT LOCATION -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
    <div class="mb-3">
      <h2 class="text-base font-semibold text-gray-900">Current location (country)</h2>
    </div>
    <select name="current_location" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent">
      <option value="">— not set —</option>
      <% locationCountries.forEach(function(country) { %>
        <option value="<%= country %>" <%= settings.current_location === country ? 'selected' : '' %>><%= country %></option>
      <% }) %>
      <% if (settings.current_location && !locationCountries.includes(settings.current_location)) { %>
        <option value="<%= settings.current_location %>" selected><%= settings.current_location %> (custom)</option>
      <% } %>
    </select>
  </div>

  <!-- TIMEZONE -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
    <h2 class="text-base font-semibold text-gray-900 mb-1">Timezone</h2>
    <p class="text-xs text-gray-500 mb-4">Used for all timestamps — logs, run times, and scheduled runs</p>
    <select name="timezone" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500">
      <option value="UTC"                               <%= settings.timezone === 'UTC'                               ? 'selected' : '' %>>GMT+0 (UTC)</option>
      <option value="Europe/London"                     <%= settings.timezone === 'Europe/London'                     ? 'selected' : '' %>>GMT+0 (London)</option>
      <option value="Africa/Lagos"                      <%= settings.timezone === 'Africa/Lagos'                      ? 'selected' : '' %>>GMT+1 (Lagos)</option>
      <option value="Europe/Paris"                      <%= settings.timezone === 'Europe/Paris'                      ? 'selected' : '' %>>GMT+1 (Paris)</option>
      <option value="Africa/Cairo"                      <%= settings.timezone === 'Africa/Cairo'                      ? 'selected' : '' %>>GMT+2 (Cairo)</option>
      <option value="Africa/Johannesburg"               <%= settings.timezone === 'Africa/Johannesburg'               ? 'selected' : '' %>>GMT+2 (Johannesburg)</option>
      <option value="Asia/Kuwait"                       <%= settings.timezone === 'Asia/Kuwait'                       ? 'selected' : '' %>>GMT+3 (Kuwait)</option>
      <option value="Asia/Riyadh"                       <%= settings.timezone === 'Asia/Riyadh'                       ? 'selected' : '' %>>GMT+3 (Riyadh)</option>
      <option value="Europe/Istanbul"                   <%= settings.timezone === 'Europe/Istanbul'                   ? 'selected' : '' %>>GMT+3 (Istanbul)</option>
      <option value="Europe/Moscow"                     <%= settings.timezone === 'Europe/Moscow'                     ? 'selected' : '' %>>GMT+3 (Moscow)</option>
      <option value="Asia/Dubai"                        <%= settings.timezone === 'Asia/Dubai'                        ? 'selected' : '' %>>GMT+4 (Dubai)</option>
      <option value="Asia/Yerevan"                      <%= settings.timezone === 'Asia/Yerevan'                      ? 'selected' : '' %>>GMT+4 (Yerevan)</option>
      <option value="Asia/Karachi"                      <%= settings.timezone === 'Asia/Karachi'                      ? 'selected' : '' %>>GMT+5 (Karachi)</option>
      <option value="Asia/Kolkata"                      <%= settings.timezone === 'Asia/Kolkata'                      ? 'selected' : '' %>>GMT+5:30 (Mumbai)</option>
      <option value="Asia/Dhaka"                        <%= settings.timezone === 'Asia/Dhaka'                        ? 'selected' : '' %>>GMT+6 (Dhaka)</option>
      <option value="Asia/Bangkok"                      <%= settings.timezone === 'Asia/Bangkok'                      ? 'selected' : '' %>>GMT+7 (Bangkok)</option>
      <option value="Asia/Shanghai"                     <%= settings.timezone === 'Asia/Shanghai'                     ? 'selected' : '' %>>GMT+8 (Shanghai)</option>
      <option value="Asia/Singapore"                    <%= settings.timezone === 'Asia/Singapore'                    ? 'selected' : '' %>>GMT+8 (Singapore)</option>
      <option value="Asia/Seoul"                        <%= settings.timezone === 'Asia/Seoul'                        ? 'selected' : '' %>>GMT+9 (Seoul)</option>
      <option value="Asia/Tokyo"                        <%= settings.timezone === 'Asia/Tokyo'                        ? 'selected' : '' %>>GMT+9 (Tokyo)</option>
      <option value="Australia/Sydney"                  <%= settings.timezone === 'Australia/Sydney'                  ? 'selected' : '' %>>GMT+10 (Sydney)</option>
      <option value="Pacific/Noumea"                    <%= settings.timezone === 'Pacific/Noumea'                    ? 'selected' : '' %>>GMT+11 (Noumea)</option>
      <option value="Pacific/Auckland"                  <%= settings.timezone === 'Pacific/Auckland'                  ? 'selected' : '' %>>GMT+12 (Auckland)</option>
      <option value="Pacific/Apia"                      <%= settings.timezone === 'Pacific/Apia'                      ? 'selected' : '' %>>GMT+13 (Apia)</option>
      <option value="Atlantic/Azores"                   <%= settings.timezone === 'Atlantic/Azores'                   ? 'selected' : '' %>>GMT-1 (Azores)</option>
      <option value="America/Noronha"                   <%= settings.timezone === 'America/Noronha'                   ? 'selected' : '' %>>GMT-2 (Noronha)</option>
      <option value="America/Argentina/Buenos_Aires"    <%= settings.timezone === 'America/Argentina/Buenos_Aires'    ? 'selected' : '' %>>GMT-3 (Buenos Aires)</option>
      <option value="America/Sao_Paulo"                 <%= settings.timezone === 'America/Sao_Paulo'                 ? 'selected' : '' %>>GMT-3 (São Paulo)</option>
      <option value="America/Halifax"                   <%= settings.timezone === 'America/Halifax'                   ? 'selected' : '' %>>GMT-4 (Halifax)</option>
      <option value="America/New_York"                  <%= settings.timezone === 'America/New_York'                  ? 'selected' : '' %>>GMT-5 (New York)</option>
      <option value="America/Chicago"                   <%= settings.timezone === 'America/Chicago'                   ? 'selected' : '' %>>GMT-6 (Chicago)</option>
      <option value="America/Denver"                    <%= settings.timezone === 'America/Denver'                    ? 'selected' : '' %>>GMT-7 (Denver)</option>
      <option value="America/Los_Angeles"               <%= settings.timezone === 'America/Los_Angeles'               ? 'selected' : '' %>>GMT-8 (Los Angeles)</option>
      <option value="America/Anchorage"                 <%= settings.timezone === 'America/Anchorage'                 ? 'selected' : '' %>>GMT-9 (Anchorage)</option>
      <option value="Pacific/Honolulu"                  <%= settings.timezone === 'Pacific/Honolulu'                  ? 'selected' : '' %>>GMT-10 (Honolulu)</option>
      <option value="Pacific/Pago_Pago"                 <%= settings.timezone === 'Pacific/Pago_Pago'                 ? 'selected' : '' %>>GMT-11 (Pago Pago)</option>
    </select>
  </div>

  <!-- Profile save button -->
  <div class="flex items-center gap-4 flex-wrap">
    <button type="submit" id="profile-save-btn" disabled
            class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-xl text-sm transition-colors shadow-sm disabled:opacity-40 disabled:cursor-not-allowed disabled:pointer-events-none">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
      Save Settings
    </button>
    <p class="text-xs text-gray-400">Last saved: <%= settings.profile_updated_at ? new Date(settings.profile_updated_at).toLocaleString('en-GB') : 'Never' %></p>
  </div>

</form>


<form id="cancel-email-change-form" method="POST" action="/settings/cancel-email-change" class="hidden"></form>
</div>
