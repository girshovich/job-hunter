  <!-- ==================== ROLES TAB ==================== -->
  <div id="tab-pane-roles" class="<%= activeTab !== 'roles' ? 'hidden' : '' %>">
   <div class="stg-stack">

    <!-- SEARCH GROUPS -->
    <div class="jh-card stg-cardpad">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px">
        <div class="stg-h2">
          Roles you seek
          <span id="groups-count" style="margin-left:6px;font-size:12px;font-weight:600;color:var(--faintest)"><%= groups.length %> / 15</span>
        </div>
        <button id="add-group-btn" onclick="openGroupModal(null)"
                <%= groups.length >= 15 ? 'disabled title="Maximum of 15 roles reached"' : '' %>
                class="stg-btn stg-btn-secondary stg-btn-sm">
          <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Add Role
        </button>
      </div>
      <div id="groups-error" class="hidden" style="margin-bottom:12px;font-size:13px;color:var(--red-ink);background:var(--red-soft);border:1px solid var(--red-border);padding:8px 11px;border-radius:9px"></div>
      <div id="groups-list">
        <div style="padding:32px 0;text-align:center;color:var(--faintest);font-size:13px">Loading groups…</div>
      </div>
    </div>

    <!-- CVs -->
    <div class="jh-card" style="overflow:hidden">
      <button type="button" onclick="togglePromptBlock('cvs-body', 'cvs-chevron')" class="stg-coll-head">
        <div>
          <div class="stg-h2">CVs
            <span style="margin-left:6px;font-size:12px;font-weight:600;color:var(--faintest)"><%= cvs ? cvs.length : 0 %></span>
          </div>
          <p class="stg-sub">Upload your CVs to use for job comparison. PDF, TXT, and MD files supported.</p>
        </div>
        <svg id="cvs-chevron" class="stg-coll-chev" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
      <div id="cvs-body" class="hidden stg-coll-body">
      <% if (cvs && cvs.length > 0) { %>
      <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px">
        <% cvs.forEach(function(cv) { %>
        <div class="stg-prow" style="justify-content:space-between" data-cv-id="<%= cv.id %>">
          <div style="display:flex;align-items:center;gap:8px;min-width:0">
            <% if (cv.mime_type === 'application/pdf') { %>
            <svg width="16" height="16" style="color:var(--red-ink);flex:none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <% } else { %>
            <svg width="16" height="16" style="color:var(--fainter);flex:none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <% } %>
            <span style="font-size:13px;color:var(--ink2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= cv.filename %></span>
            <span style="font-size:11.5px;color:var(--faintest);flex:none"><%= (cv.file_size / 1024).toFixed(0) %> KB</span>
          </div>
          <div style="display:flex;align-items:center;gap:8px;flex:none">
            <a href="/settings/cvs/<%= cv.id %>/view" target="_blank" class="stg-btn stg-btn-secondary stg-btn-sm">Open</a>
            <button type="button" onclick="deleteCV(<%= cv.id %>, this)" class="stg-btn stg-btn-sm" style="background:var(--red-soft);color:var(--red-ink);border:1px solid var(--red-border)">Delete</button>
          </div>
        </div>
        <% }); %>
      </div>
      <% } else { %>
      <p style="font-size:13px;color:var(--faintest);margin-bottom:16px">No CVs uploaded yet.</p>
      <% } %>
      <form method="post" action="/settings/cvs/upload" enctype="multipart/form-data" style="display:flex;align-items:center;gap:12px">
        <input type="file" name="cv_file" accept=".pdf,.txt,.md" onchange="toggleUploadBtn(this)"
               class="block text-sm text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border file:border-gray-200 file:text-xs file:font-medium file:bg-gray-50 file:text-gray-700 hover:file:bg-gray-100 cursor-pointer" />
        <button type="submit" id="cv-upload-btn" class="hidden stg-btn stg-btn-secondary stg-btn-sm" style="flex:none">
          <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          Upload
        </button>
      </form>
      </div>
    </div>

    <!-- BLACKLISTED COMPANIES -->
    <div class="jh-card stg-cardpad">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px">
        <div>
          <div class="stg-h2">
            Blacklisted Companies
            <span id="bl-count-badge" style="margin-left:6px;font-size:12px;font-weight:600;color:var(--faintest)"></span>
          </div>
          <p class="stg-sub">Jobs from these companies are removed before scoring — across all groups.</p>
        </div>
        <button onclick="openBlacklistMgmtModal()" class="stg-btn stg-btn-ghost stg-btn-sm">
          <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          Edit
        </button>
      </div>
      <div id="bl-compact-view" style="font-size:13px;color:var(--faintest)">Loading…</div>
    </div>

    <!-- Roles tab footer: last saved -->
    <div class="stg-saverow">
      <p class="stg-saved-note">Last saved: <%= rolesLastSaved ? new Date(rolesLastSaved).toLocaleString('en-GB') : 'Never' %></p>
    </div>

   </div>
  </div>
