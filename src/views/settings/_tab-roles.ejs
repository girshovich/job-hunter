  <!-- ==================== ROLES TAB ==================== -->
  <div id="tab-pane-roles" class="<%= activeTab !== 'roles' ? 'hidden' : '' %>">
   <div class="stg-stack">

    <!-- SEARCH GROUPS -->
    <div class="jh-card stg-cardpad">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px">
        <div class="stg-h2">
          Roles you seek
          <span id="groups-count" style="margin-left:6px;font-size:12px;font-weight:600;color:var(--faintest)"><%= groups.length %> / 15</span>
        </div>
        <button id="add-group-btn" onclick="openGroupModal(null)"
                <%= groups.length >= 15 ? 'disabled title="Maximum of 15 roles reached"' : '' %>
                class="stg-btn stg-btn-secondary stg-btn-sm">
          <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Add Role
        </button>
      </div>
      <div id="groups-error" class="hidden" style="margin-bottom:12px;font-size:13px;color:var(--red-ink);background:var(--red-soft);border:1px solid var(--red-border);padding:8px 11px;border-radius:9px"></div>
      <div id="groups-list">
        <div style="padding:32px 0;text-align:center;color:var(--faintest);font-size:13px">Loading groups…</div>
      </div>
    </div>

    <style>
      /* A reference table, not a form. The type's colour says what a row IS, so the row itself
         stays quiet: hairline separators instead of ten filled cards, no grip (the order is
         derived), and controls that only show an edge when you reach for them. DS v2 §1.1 tokens
         throughout; nothing new is introduced. */
      .stat-row {
        display: flex; align-items: center; gap: 10px;
        padding: 4px 2px; border-bottom: 1px solid var(--line);
      }
      .stat-row:last-child { border-bottom: 0; }
      .stat-dot { width: 8px; height: 8px; border-radius: 3px; flex: none; }
      .stat-name {
        flex: 1; min-width: 0; height: 28px; padding: 0 8px;
        border: 1px solid transparent; border-radius: 8px; background: transparent;
        font-size: 13px; font-weight: 600; color: var(--ink); font-family: inherit; outline: none;
      }
      .stat-name:hover:not([readonly]) { border-color: var(--line2); }
      .stat-name:focus { border-color: var(--accent-border); background: #fff; box-shadow: 0 0 0 3px var(--accent-soft); }
      .stat-name[readonly] { color: var(--muted); cursor: default; }
      .stat-type {
        flex: none; width: 124px; height: 28px; padding: 0 6px;
        border: 1px solid transparent; border-radius: 8px;
        background: transparent; font-size: 12.5px; font-weight: 600; color: var(--muted);
        font-family: inherit; cursor: pointer; outline: none;
      }
      /* The header labels the two columns the user edits; the count and the delete need no name.
         Padding matches the inputs below it, so the labels sit over their own column. */
      .stat-head {
        display: flex; align-items: center; gap: 10px;
        padding: 14px 2px 5px; border-bottom: 1px solid var(--line2);
        font-size: 10.5px; font-weight: 800; letter-spacing: .06em;
        text-transform: uppercase; color: var(--faintest);
      }
      .stat-head-name { flex: 1; min-width: 0; padding-left: 8px; }
      .stat-head-type { flex: none; width: 124px; padding-left: 7px; }

      /* Below 768px the row has 308px and the fixed columns were taking 252 of it, leaving the
         name 52px against the 111px "Hiring Manager" needs. Two columns give way: the type select
         narrows to its longest label ("Not applying", not "In Progress"), and the job count —
         a diagnostic nobody acts on — goes. The name gets 134px, and the row keeps its height. */
      @media (max-width: 767px) {
        .stat-type, .stat-head-type { width: 112px; }   /* 'Not applying' + its caret */
        .stat-use { display: none; }
      }
      .stat-type:hover:not(:disabled) { border-color: var(--line2); background: #fff; }
      .stat-type:focus { border-color: var(--accent-border); background: #fff; }
      .stat-type:disabled { color: var(--faintest); cursor: default; }
      .stat-use {
        flex: none; min-width: 54px; text-align: right; font-size: 11.5px; font-weight: 600;
        color: var(--faintest); font-variant-numeric: tabular-nums;
      }
      .stat-del, .stat-del-spacer {
        flex: none; width: 26px; height: 26px; display: grid; place-items: center;
        border: 0; border-radius: 8px; background: transparent; color: var(--faintest); cursor: pointer;
      }
      .stat-del:hover { background: var(--red-soft); color: var(--red-ink); }
      /* Held by jobs: dimmed so it reads as unavailable, but still pressable — pressing it is how
         you find out why, which matters most on a phone where the count is hidden. */
      .stat-del.is-held { color: var(--line2); }
      .stat-del.is-held:hover { background: #f4f5f7; color: var(--faint); }
      .stat-row.is-new { border-bottom: 0; padding-top: 8px; gap: 8px; }
      .stat-row.is-new .stat-name { border-color: var(--accent-border); background: #fff; }
      .stat-row.is-new .stat-type { border-color: var(--line2); background: #fff; color: var(--ink2); }
      .stat-add-go { flex: none; }
    </style>

    <!-- STATUSES -->
    <%# One list per profile, shared by every role (D5). It lives here, under Roles, because this
        is where the user already goes to shape their search — and it is a card, not a new tab:
        `validTabs` stays ['profile','roles','ai'] (AD4). %>
    <div class="jh-card stg-cardpad">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:6px">
        <div>
          <div class="stg-h2">
            Statuses
            <span id="statuses-count" style="margin-left:6px;font-size:12px;font-weight:600;color:var(--faintest)"></span>
          </div>
          <p class="stg-sub">Track progress of your application with statuses</p>
        </div>
        <button id="add-status-btn" onclick="addStatus()" class="stg-btn stg-btn-secondary stg-btn-sm">
          <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Add Status
        </button>
      </div>
      <div id="statuses-error" class="hidden" style="margin:10px 0 0;font-size:12.5px;line-height:1.45;color:var(--amber-ink);background:var(--amber-soft);border:1px solid var(--amber-border);padding:8px 11px;border-radius:9px"></div>
      <div class="stat-head" aria-hidden="true">
        <span class="stat-dot" style="background:transparent"></span>
        <span class="stat-head-name">Status name</span>
        <span class="stat-head-type">Type</span>
        <span class="stat-use"></span>
        <span class="stat-del-spacer"></span>
      </div>
      <div id="statuses-list">
        <div style="padding:24px 0;text-align:center;color:var(--faintest);font-size:13px">Loading statuses…</div>
      </div>
    </div>

    <!-- CVs -->
    <div class="jh-card" style="overflow:hidden">
      <button type="button" onclick="togglePromptBlock('cvs-body', 'cvs-chevron')" class="stg-coll-head">
        <div>
          <div class="stg-h2">CVs
            <span style="margin-left:6px;font-size:12px;font-weight:600;color:var(--faintest)"><%= cvs ? cvs.length : 0 %></span>
          </div>
          <p class="stg-sub">Upload your CVs to use for job comparison. PDF, TXT, and MD files supported.</p>
        </div>
        <svg id="cvs-chevron" class="stg-coll-chev" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
      <div id="cvs-body" class="hidden stg-coll-body">
      <% if (cvs && cvs.length > 0) { %>
      <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px">
        <% cvs.forEach(function(cv) { %>
        <div class="stg-prow" style="justify-content:space-between" data-cv-id="<%= cv.id %>">
          <div style="display:flex;align-items:center;gap:8px;min-width:0">
            <% if (cv.mime_type === 'application/pdf') { %>
            <svg width="16" height="16" style="color:var(--red-ink);flex:none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <% } else { %>
            <svg width="16" height="16" style="color:var(--fainter);flex:none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <% } %>
            <span style="font-size:13px;color:var(--ink2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= cv.filename %></span>
            <span style="font-size:11.5px;color:var(--faintest);flex:none"><%= (cv.file_size / 1024).toFixed(0) %> KB</span>
          </div>
          <div style="display:flex;align-items:center;gap:8px;flex:none">
            <a href="/settings/cvs/<%= cv.id %>/view" target="_blank" class="stg-btn stg-btn-secondary stg-btn-sm">Open</a>
            <button type="button" onclick="deleteCV(<%= cv.id %>, this)" class="stg-btn stg-btn-sm" style="background:var(--red-soft);color:var(--red-ink);border:1px solid var(--red-border)">Delete</button>
          </div>
        </div>
        <% }); %>
      </div>
      <% } else { %>
      <p style="font-size:13px;color:var(--faintest);margin-bottom:16px">No CVs uploaded yet.</p>
      <% } %>
      <form method="post" action="/settings/cvs/upload" enctype="multipart/form-data" style="display:flex;align-items:center;gap:12px">
        <input type="file" name="cv_file" accept=".pdf,.txt,.md" onchange="toggleUploadBtn(this)"
               class="block text-sm text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border file:border-gray-200 file:text-xs file:font-medium file:bg-gray-50 file:text-gray-700 hover:file:bg-gray-100 cursor-pointer" />
        <button type="submit" id="cv-upload-btn" disabled class="stg-btn stg-btn-secondary stg-btn-sm" style="flex:none">
          <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
          Upload
        </button>
      </form>
      </div>
    </div>

    <!-- BLACKLISTED COMPANIES -->
    <div class="jh-card stg-cardpad">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px">
        <div>
          <div class="stg-h2">
            Blacklisted Companies
            <span id="bl-count-badge" style="margin-left:6px;font-size:12px;font-weight:600;color:var(--faintest)"></span>
          </div>
          <p class="stg-sub">Jobs from these companies are removed before scoring — across all groups.</p>
        </div>
        <button onclick="openBlacklistMgmtModal()" class="stg-btn stg-btn-ghost stg-btn-sm">
          <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          Edit
        </button>
      </div>
      <div id="bl-compact-view" style="font-size:13px;color:var(--faintest)">Loading…</div>
    </div>

    <!-- Roles tab footer: last saved -->
    <div class="stg-saverow">
      <p class="stg-saved-note">Last saved: <%= rolesLastSaved ? new Date(rolesLastSaved).toLocaleString('en-GB') : 'Never' %></p>
    </div>

   </div>
  </div>
