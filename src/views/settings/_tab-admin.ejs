<script>
let _atsStatsLoaded = false;
let _atsStatsLoading = false;

// ── Unified long-job module ──────────────────────────────────────────────────
// One launch/stream/reattach path for every SSE job, keyed by `kind`. New jobs need only a
// JOB_PANELS entry + a startJob(...) call. Two physical panels ('ats'/'pool') render the runs.
const JOB_PANELS = {
  'discover': 'ats', 'discover-lever': 'ats', 'validate': 'ats',
  'resolve-countries': 'resolve', 'recheck-unknowns': 'resolve',
  'pool-gh': 'pool', 'pool-ashby': 'pool', 'telegram': 'pool',
};
const PANEL_BTNS = {
  ats:     ['ats-discover-btn', 'ats-lever-discover-btn', 'ats-validate-btn'],
  pool:    ['pool-gh-fetch-btn', 'pool-ashby-fetch-btn', 'tg-fetch-btn'],
  resolve: ['pool-resolve-btn', 'pool-recheck-btn'],
};
const _streams    = {};                                          // runId -> EventSource
const _retry      = {};                                          // runId -> reconnect attempts
const _panelRunId = { ats: null, pool: null, resolve: null };    // which run currently owns each panel
const _panelState = { ats: {}, pool: {}, resolve: {} };          // { label, unit, kind } per panel

function showPanel(panel, label, unit, opts = {}) {
  _panelState[panel] = { label, unit: unit || '', kind: opts.kind };
  _panelRunId[panel] = opts.runId || null;
  document.getElementById(panel + '-run-log').classList.remove('hidden');
  document.getElementById(panel + '-run-title').textContent = label + ' running…';
  document.getElementById(panel + '-run-lines').innerHTML = '';
  document.getElementById(panel + '-run-progress').classList.add('hidden');
  document.getElementById(panel + '-run-dot').className = 'w-2 h-2 rounded-full bg-blue-400 animate-pulse flex-shrink-0';
  const stopBtn = document.getElementById(panel + '-run-stop-btn');
  if (opts.cancellable) { stopBtn.classList.remove('hidden'); stopBtn.disabled = false; stopBtn.textContent = 'Stop'; }
  else { stopBtn.classList.add('hidden'); }
  PANEL_BTNS[panel].forEach((id) => { const el = document.getElementById(id); if (el) el.disabled = true; });
}

function renderEvent(panel, ev) {
  const st = _panelState[panel] || { unit: '' };
  if (ev.msg && ev.msg !== '') {
    const linesEl = document.getElementById(panel + '-run-lines');
    const line = document.createElement('div');
    line.textContent = ev.msg;
    linesEl.appendChild(line);
    linesEl.scrollTop = linesEl.scrollHeight;
  }
  if (ev.total) {
    const progressEl = document.getElementById(panel + '-run-progress');
    progressEl.textContent = `${ev.processed || 0} / ${ev.total} ${st.unit}`.trim();
    progressEl.classList.remove('hidden');
  }
  if (ev.done) finishPanel(panel, st.label, ev.cancelled);
}

function finishPanel(panel, label, cancelled) {
  const runId = _panelRunId[panel];
  if (runId) { if (_streams[runId]) { _streams[runId].close(); delete _streams[runId]; } delete _retry[runId]; }
  _panelRunId[panel] = null;
  document.getElementById(panel + '-run-title').textContent = cancelled ? label + ' cancelled' : label + ' complete';
  const dot = document.getElementById(panel + '-run-dot');
  dot.classList.remove('animate-pulse', 'bg-blue-400');
  dot.classList.add(cancelled ? 'bg-gray-300' : 'bg-emerald-400');
  document.getElementById(panel + '-run-stop-btn').classList.add('hidden');
  PANEL_BTNS[panel].forEach((id) => { const el = document.getElementById(id); if (el) el.disabled = false; });
  if (panel === 'ats') { const s = document.getElementById('ats-stats'); if (s) s.innerHTML = '<p class="text-xs text-gray-400">Updating…</p>'; }
  setTimeout(() => loadAtsStats({ force: true }), 500);
  if (_panelState[panel]?.kind === 'telegram' && typeof loadTelegramState === 'function') setTimeout(() => loadTelegramState(), 600);
}

async function startJob(url, kind, label, unit, opts = {}) {
  const panel = JOB_PANELS[kind];
  if (!panel) return;
  const res = await fetch(url, { method: 'POST' });
  if (res.status === 409) { const { error } = await res.json().catch(() => ({})); alert(error || 'Already running.'); return; }
  const data = await res.json().catch(() => ({}));
  if (!data.runId) return;
  streamJob({ runId: data.runId, kind, label, unit, cancellable: opts.cancellable !== false });
}

function streamJob(job) {
  const panel = JOB_PANELS[job.kind];
  if (!panel) return;                                // skip unknown kinds
  if (_streams[job.runId]) { _streams[job.runId].close(); }  // never stack two streams on one run
  showPanel(panel, job.label, job.unit, { runId: job.runId, cancellable: job.cancellable, kind: job.kind });
  const es = new EventSource('/api/ats/stream/' + job.runId);
  _streams[job.runId] = es;
  es.onmessage = (e) => renderEvent(panel, JSON.parse(e.data));
  es.onerror = async () => {                          // reconnect with backoff; no false "complete"
    es.close(); delete _streams[job.runId];
    const n = (_retry[job.runId] = (_retry[job.runId] || 0) + 1);
    if (n > 5) { finishPanel(panel, job.label, false); return; }
    let runs = []; try { runs = await (await fetch('/api/ats/active')).json(); } catch {}
    if (runs.find((r) => r.runId === job.runId)) setTimeout(() => streamJob(job), Math.min(1000 * n, 5000));
    else finishPanel(panel, job.label, false);
  };
}

async function stopJob(runId) {
  if (!runId) return;
  const panel = _panelRunId.ats === runId ? 'ats' : _panelRunId.pool === runId ? 'pool' : _panelRunId.resolve === runId ? 'resolve' : null;
  if (panel) { const b = document.getElementById(panel + '-run-stop-btn'); b.disabled = true; b.textContent = 'Stopping…'; }
  await fetch('/api/ats/run/' + runId, { method: 'DELETE' });
}

async function reattachActiveRuns() {                 // restore running jobs after a refresh
  let runs = []; try { runs = await (await fetch('/api/ats/active')).json(); } catch { return; }
  for (const r of runs) {
    if (!JOB_PANELS[r.kind] || _streams[r.runId]) continue;
    streamJob({ runId: r.runId, kind: r.kind, label: r.label, unit: r.unit || '', cancellable: r.cancellable });
  }
}

// Button handlers (names referenced by the inline onclick attributes).
function atsRunDiscovery()             { startJob('/api/ats/discover', 'discover', 'Discovery (GH & Ashby)', 'boards'); }
function atsRunLeverDiscovery()        { startJob('/api/ats/discover-lever', 'discover-lever', 'Discovery (Lever)', 'boards'); }
function atsRunValidation()            { startJob('/api/ats/validate', 'validate', 'Validation', 'boards'); }
function poolFetch(provider)           { const gh = provider === 'greenhouse'; startJob(gh ? '/api/ats/pool/fetch-greenhouse' : '/api/ats/pool/fetch-ashby', gh ? 'pool-gh' : 'pool-ashby', (gh ? 'Greenhouse' : 'Ashby') + ' pool fetch', 'boards'); }
function poolResolveCountries()        { startJob('/api/ats/pool/resolve-countries', 'resolve-countries', 'Resolving job countries', 'locations'); }
function poolRecheckUnknownCountries() { startJob('/api/ats/pool/recheck-unknown-countries', 'recheck-unknowns', 'Re-checking unknown locations', 'locations'); }
function telegramFetchNow()            { startJob('/api/telegram/fetch-now', 'telegram', 'Telegram fetch', '', { cancellable: false }); }
function atsStopRun()                  { stopJob(_panelRunId.ats); }
function poolStopRun()                 { stopJob(_panelRunId.pool); }
function resolveStopRun()              { stopJob(_panelRunId.resolve); }

function _setDot(id, enabled) {
  const dot = document.getElementById(id);
  dot.classList.toggle('bg-emerald-400', enabled);
  dot.classList.toggle('animate-pulse', enabled);
  dot.classList.toggle('bg-gray-300', !enabled);
}

function _applyScheduleState(discEnabled, leverDiscEnabled, valEnabled, tz) {
  const tzLabel = tz || 'UTC';
  document.getElementById('ats-disc-toggle').checked       = discEnabled;
  document.getElementById('ats-lever-disc-toggle').checked = leverDiscEnabled;
  document.getElementById('ats-val-toggle').checked        = valEnabled;
  document.getElementById('ats-disc-tz').textContent       = tzLabel;
  document.getElementById('ats-lever-disc-tz').textContent = tzLabel;
  document.getElementById('ats-val-tz').textContent        = tzLabel;
  _setDot('ats-disc-dot',       discEnabled);
  _setDot('ats-lever-disc-dot', leverDiscEnabled);
  _setDot('ats-val-dot',        valEnabled);
}

function _setAtsStatsLoading() {
  const statsEl = document.getElementById('ats-stats');
  if (statsEl) statsEl.innerHTML = '<p class="text-xs text-gray-400">Loading…</p>';
  const poolEl = document.getElementById('pool-counts');
  if (poolEl) poolEl.innerHTML = '<p class="text-xs text-gray-400">Loading…</p>';
}

async function loadAtsStats(options = {}) {
  const force = !!options.force;
  if (_atsStatsLoading || (_atsStatsLoaded && !force)) return;
  _atsStatsLoading = true;
  _setAtsStatsLoading();
  try {
    const res  = await fetch('/api/ats/status');
    const data = await res.json();

    if (data.settings) {
      _applyScheduleState(
        !!data.settings.ats_discovery_enabled,
        !!data.settings.ats_lever_disc_enabled,
        !!data.settings.ats_validation_enabled,
        data.settings.timezone,
      );
      _applyPoolState(
        !!data.settings.ats_pool_gh_enabled,
        !!data.settings.ats_pool_ashby_enabled,
        data.settings.timezone,
        data.settings.ats_pool_gh_last_fetch,
        data.settings.ats_pool_ashby_last_fetch,
      );
    }
    if (data.poolCounts) {
      _renderPoolCounts(
        data.poolCounts.greenhouse,
        data.poolCounts.ashby,
        data.poolCounts.resolvedLocations,
        data.poolCounts.unknownLocations,
        data.poolCounts.newUnresolvedLocations,
      );
    }

    const statsEl = document.getElementById('ats-stats');
    if (!statsEl) return;
    if (!data.boards?.length) {
      statsEl.innerHTML = '<p class="text-xs text-gray-400">No boards discovered yet. Run Discovery to populate.</p>';
      _atsStatsLoaded = true;
      return;
    }
    const map = Object.fromEntries(data.boards.map(r => [r.ats, r]));
    const fmt = t => { if (!t) return '—'; const d = new Date(t); const p2 = n => String(n).padStart(2, '0'); return `${p2(d.getDate())}.${p2(d.getMonth() + 1)}.${d.getFullYear()}`; };
    statsEl.innerHTML = `
      <table class="w-full text-[10px] sm:text-xs text-left border-collapse">
        <thead><tr class="text-gray-400 border-b">
          <th class="pb-1 pr-2 sm:pr-4 font-medium">ATS</th>
          <th class="pb-1 pr-2 sm:pr-4 font-medium">Total</th>
          <th class="pb-1 pr-2 sm:pr-4 font-medium">Active</th>
          <th class="pb-1 pr-2 sm:pr-4 font-medium">Last discovery</th>
          <th class="pb-1 font-medium">Last validation</th>
        </tr></thead>
        <tbody>
          ${['greenhouse','lever','ashby'].map(ats => {
            const r = map[ats] || {};
            return `<tr class="border-b border-gray-50">
              <td class="py-1 pr-2 sm:pr-4 font-medium capitalize">${ats}</td>
              <td class="py-1 pr-2 sm:pr-4">${r.total || 0}</td>
              <td class="py-1 pr-2 sm:pr-4">${r.active || 0}</td>
              <td class="py-1 pr-2 sm:pr-4">${fmt(r.last_discovered)}</td>
              <td class="py-1">${fmt(r.last_validated)}</td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>`;
    _atsStatsLoaded = true;
  } catch {
    const el = document.getElementById('ats-stats');
    if (el) el.innerHTML = '<p class="text-xs text-red-400">Failed to load stats.</p>';
  } finally {
    _atsStatsLoading = false;
  }
}

function ensureAdminStatsLoaded(force = false) {
  return loadAtsStats({ force });
}

window.ensureAdminStatsLoaded = ensureAdminStatsLoaded;

