<script>
function _applyPoolState(ghEnabled, ashbyEnabled, tz, ghLastFetch, ashbyLastFetch) {
  const tzLabel = tz || 'UTC';
  document.getElementById('pool-gh-toggle').checked    = ghEnabled;
  document.getElementById('pool-ashby-toggle').checked = ashbyEnabled;
  document.getElementById('pool-gh-tz').textContent    = tzLabel;
  document.getElementById('pool-ashby-tz').textContent = tzLabel;
  const _fmtLast = (v) => v ? ' · last fetch ' + new Date(v).toLocaleString() : ' · never fetched';
  if (ghLastFetch !== undefined)    document.getElementById('pool-gh-last').textContent    = _fmtLast(ghLastFetch);
  if (ashbyLastFetch !== undefined) document.getElementById('pool-ashby-last').textContent = _fmtLast(ashbyLastFetch);
  const ghDot    = document.getElementById('pool-gh-dot');
  const ashbyDot = document.getElementById('pool-ashby-dot');
  ghDot.classList.toggle('bg-emerald-400', ghEnabled);
  ghDot.classList.toggle('animate-pulse',  ghEnabled);
  ghDot.classList.toggle('bg-gray-300',   !ghEnabled);
  ashbyDot.classList.toggle('bg-emerald-400', ashbyEnabled);
  ashbyDot.classList.toggle('animate-pulse',  ashbyEnabled);
  ashbyDot.classList.toggle('bg-gray-300',   !ashbyEnabled);
}

function _renderPoolCounts(ghCount, ashbyCount, resolvedLocations = 0, unknownLocations = 0, newUnresolvedLocations = 0) {
  const el = document.getElementById('pool-counts');
  if (!el) return;
  const unknownHtml = unknownLocations > 0
    ? `<a href="/settings/unresolved-locations" class="whitespace-nowrap font-medium text-gray-700 underline decoration-dotted underline-offset-2 hover:text-sky-700">Unknown ${unknownLocations.toLocaleString()}</a>`
    : `<span class="whitespace-nowrap font-medium text-gray-500">Unknown ${unknownLocations.toLocaleString()}</span>`;
  el.innerHTML = `
    <div class="flex items-start sm:items-center gap-3 sm:gap-4 rounded-lg bg-gray-50 border border-gray-100 px-3 py-2 text-xs">
      <span class="w-20 sm:w-28 flex-shrink-0 font-medium text-gray-500">Pool size</span>
      <div class="flex flex-col items-start gap-1 sm:flex-row sm:items-center sm:gap-4">
        <span class="flex items-center gap-1.5 whitespace-nowrap">
          <span class="w-2 h-2 rounded-full bg-green-400 inline-block"></span>
          <span class="text-gray-700 font-medium">Greenhouse ${ghCount.toLocaleString()}</span>
        </span>
        <span class="flex items-center gap-1.5 whitespace-nowrap">
          <span class="w-2 h-2 rounded-full bg-violet-400 inline-block"></span>
          <span class="text-gray-700 font-medium">Ashby ${ashbyCount.toLocaleString()}</span>
        </span>
      </div>
    </div>
    <div class="flex items-start sm:items-center gap-3 sm:gap-4 rounded-lg bg-gray-50 border border-gray-100 px-3 py-2 text-xs">
      <span class="w-20 sm:w-28 flex-shrink-0 font-medium text-gray-500">Locations</span>
      <div class="flex flex-col items-start gap-1 sm:flex-row sm:items-center sm:gap-4">
        <span class="whitespace-nowrap font-medium text-gray-700">Known ${resolvedLocations.toLocaleString()}</span>
        <span class="whitespace-nowrap font-medium text-gray-700">Need resolving ${newUnresolvedLocations.toLocaleString()}</span>
        ${unknownHtml}
      </div>
    </div>`;
}

async function poolToggle(provider, enabled) {
  const ghEnabled    = provider === 'gh'    ? enabled : document.getElementById('pool-gh-toggle').checked;
  const ashbyEnabled = provider === 'ashby' ? enabled : document.getElementById('pool-ashby-toggle').checked;
  const toggleEl = document.getElementById(`pool-${provider}-toggle`);
  toggleEl.disabled = true;
  try {
    const res = await fetch('/api/ats/pool/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ gh_enabled: ghEnabled, ashby_enabled: ashbyEnabled }),
    });
    const data = await res.json();
    if (data.error) { alert(data.error); toggleEl.checked = !enabled; return; }
    _applyPoolState(
      document.getElementById('pool-gh-toggle').checked,
      document.getElementById('pool-ashby-toggle').checked,
      data.timezone,
    );
  } catch { toggleEl.checked = !enabled; }
  toggleEl.disabled = false;
}

// ── Telegram admin JS ────────────────────────────────────────────────────────

let _tgChannels = [];
let _tgPromptSaved = '';

async function loadTelegramState() {
  try {
    const [settingsRes, channelsRes, statsRes] = await Promise.all([
      fetch('/api/telegram/settings'),
      fetch('/api/telegram/channels'),
      fetch('/api/ats/status'),
    ]);
    const settings  = await settingsRes.json();
    const chData    = await channelsRes.json();
    const statsData = await statsRes.json();

    document.getElementById('tg-ingest-toggle').checked = !!settings.enabled;
    _setDot('tg-ingest-dot', !!settings.enabled);

    const prompt = settings.extract_prompt || '';
    const promptTextarea = document.getElementById('tg-prompt-textarea');
    const promptSaveBtn  = document.getElementById('tg-prompt-save-btn');
    promptTextarea.value = prompt;
    document.getElementById('tg-prompt-fixed').textContent = settings.fixed_schema || '';
    // Dirty-tracking: Save is enabled only when the prompt differs from the saved value.
    _tgPromptSaved = prompt.trim();
    promptSaveBtn.disabled = true;
    promptSaveBtn.textContent = 'Save prompt';
    promptTextarea.oninput = () => {
      promptSaveBtn.disabled = (promptTextarea.value.trim() === _tgPromptSaved);
    };

    const tz = statsData?.settings?.timezone || 'UTC';
    document.getElementById('tg-tz').textContent = tz;
    // SQLite datetime('now') is naive UTC "YYYY-MM-DD HH:MM:SS"; mark it UTC then show in admin tz.
    const fmtAdminTs = (s) => {
      if (!s) return '—';
      const raw = String(s);
      const norm = /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/.test(raw) ? raw.replace(' ', 'T') + 'Z' : raw;
      const d = new Date(norm);
      if (isNaN(d.getTime())) return raw;
      return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: tz })
        + ' ' + d.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: tz });
    };

    if (statsData?.telegramCounts) {
      const { jobs, channels, posts, lastRun } = statsData.telegramCounts;
      const lastRunHtml = lastRun
        ? `<div class="flex items-start sm:items-center gap-3 sm:gap-4 rounded-lg bg-gray-50 border border-gray-100 px-3 py-2 text-xs">
             <span class="w-20 sm:w-28 flex-shrink-0 font-medium text-gray-500">Last ingest</span>
             <div class="flex flex-col items-start gap-1 sm:flex-row sm:items-center sm:gap-4">
               <span class="whitespace-nowrap font-mono text-gray-700 font-medium">${lastRun.jobs_created.toLocaleString()} jobs</span>
               <a href="/settings/telegram-posts" class="whitespace-nowrap font-mono text-sky-600 hover:text-sky-800 underline">${(lastRun.inserted + lastRun.edited).toLocaleString()} posts</a>
               <span class="whitespace-nowrap font-mono text-gray-400">${fmtAdminTs(lastRun.started_at)}</span>
             </div>
           </div>`
        : `<div class="rounded-lg bg-gray-50 border border-gray-100 px-3 py-2 text-xs text-gray-400">No ingest run recorded yet.</div>`;
      document.getElementById('tg-counts').innerHTML = `
        <div class="space-y-1.5">
          <div class="flex items-start sm:items-center gap-3 sm:gap-4 rounded-lg bg-gray-50 border border-gray-100 px-3 py-2 text-xs">
            <span class="w-20 sm:w-28 flex-shrink-0 font-medium text-gray-500">Pool size</span>
            <div class="flex flex-col items-start gap-1 sm:flex-row sm:items-center sm:gap-4">
              <span class="flex items-center gap-1.5 whitespace-nowrap">
                <span class="w-2 h-2 rounded-full bg-sky-400 inline-block"></span>
                <span class="font-mono text-gray-700 font-medium">${jobs.toLocaleString()} jobs</span>
              </span>
              <span class="whitespace-nowrap font-mono text-gray-500">${posts.toLocaleString()} posts</span>
              <span class="whitespace-nowrap font-mono text-gray-500">${channels} active channel(s)</span>
            </div>
          </div>
          ${lastRunHtml}
        </div>`;
    }

    _tgChannels = chData.channels || [];
    _renderTgChannels();
  } catch {
    document.getElementById('tg-counts').innerHTML = '<p class="text-xs text-red-400">Failed to load Telegram stats.</p>';
  }
}

function _renderTgChannels() {
  const el = document.getElementById('tg-channel-chips');
  if (!_tgChannels.length) {
    el.innerHTML = '<span class="text-xs text-gray-400">No channels added yet.</span>';
    return;
  }
  el.innerHTML = _tgChannels
    .filter(c => c.is_active)
    .map(c => `
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-sky-50 text-sky-700 border border-sky-200 text-xs font-medium">
        @${c.channel_username}
        <button type="button" onclick="telegramRemoveChannel('${c.channel_username}')" class="ml-0.5 text-sky-400 hover:text-sky-700 leading-none">&times;</button>
      </span>`)
    .join('');
}

async function telegramToggle(enabled) {
  const toggle = document.getElementById('tg-ingest-toggle');
  toggle.disabled = true;
  try {
    const res = await fetch('/api/telegram/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled }),
    });
    const data = await res.json();
    if (data.error) { alert(data.error); toggle.checked = !enabled; return; }
    _setDot('tg-ingest-dot', enabled);
    document.getElementById('tg-tz').textContent = data.timezone || 'UTC';
  } catch { toggle.checked = !enabled; }
  toggle.disabled = false;
}

async function telegramAddChannel() {
  const input = document.getElementById('tg-channel-input');
  const username = input.value.trim().replace(/^@/, '');
  if (!username) return;
  try {
    const res = await fetch('/api/telegram/channels', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ channel_username: username }),
    });
    const data = await res.json();
    if (data.error) { alert(data.error); return; }
    input.value = '';
    const existing = _tgChannels.find(c => c.channel_username === data.channel_username);
    if (existing) existing.is_active = 1;
    else _tgChannels.push({ channel_username: data.channel_username, is_active: 1 });
    _renderTgChannels();
  } catch { alert('Failed to add channel.'); }
}

async function telegramRemoveChannel(username) {
  try {
    const res = await fetch('/api/telegram/channels/' + encodeURIComponent(username), { method: 'DELETE' });
    const data = await res.json();
    if (data.error) { alert(data.error); return; }
    const ch = _tgChannels.find(c => c.channel_username === username);
    if (ch) ch.is_active = 0;
    _renderTgChannels();
  } catch { alert('Failed to remove channel.'); }
}

async function telegramSavePrompt() {
  const btn = document.getElementById('tg-prompt-save-btn');
  const prompt = document.getElementById('tg-prompt-textarea').value.trim();
  const enabled = document.getElementById('tg-ingest-toggle').checked;
  btn.disabled = true;
  try {
    const res = await fetch('/api/telegram/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled, extract_prompt: prompt }),
    });
    const data = await res.json();
    if (data.error) { alert(data.error); btn.disabled = false; return; }
    _tgPromptSaved = prompt;
    btn.textContent = 'Saved ✓';
    setTimeout(() => { btn.textContent = 'Save prompt'; }, 1500);
  } catch {
    alert('Failed to save prompt.');
    btn.disabled = false;
  }
}

// Load Telegram state when admin tab activates
document.addEventListener('DOMContentLoaded', () => {
  const adminTab = document.querySelector('[data-tab="admin"]') || document.querySelector('[href="#admin"]');
  if (adminTab) {
    adminTab.addEventListener('click', () => { loadTelegramState(); reattachActiveRuns(); });
  }
  // Also load if admin tab is already active on page load
  const pane = document.getElementById('tab-pane-admin');
  if (pane && !pane.classList.contains('hidden')) { loadTelegramState(); reattachActiveRuns(); }
});

async function setUserCredits(profileId, btn) {
  const input = document.getElementById('credits-input-' + profileId);
  const amount = parseFloat(input.value);
  if (isNaN(amount) || amount < 0) { alert('Enter a valid amount (≥ 0)'); return; }
  const orig = btn.textContent;
  btn.disabled = true;
  btn.textContent = '…';
  try {
    const res = await fetch('/api/admin/credits', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ profileId, credits: amount }),
    });
    const data = await res.json();
    if (data.error) { alert(data.error); }
    else { btn.textContent = '✓'; setTimeout(() => { btn.textContent = orig; btn.disabled = false; }, 1500); return; }
  } catch { alert('Failed to update credits'); }
  btn.disabled = false;
  btn.textContent = orig;
}

// ── Region definitions ────────────────────────────────────────────────────────
async function loadRegions() {
  const list = document.getElementById('regions-list');
  if (!list) return;
  try {
    const res = await fetch('/api/regions');
    const data = await res.json();
    if (!data.regions || data.regions.length === 0) {
      list.innerHTML = '<span class="text-xs text-gray-400">No regions defined.</span>';
      return;
    }
    list.innerHTML = data.regions.map((r, i) => {
      const w = `region-warn-${i}`;
      const nm = escHtml(r.name);
      return `
      <div class="border border-gray-100 rounded-lg p-3">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-sm font-semibold text-gray-800">${nm}</span>
          <span class="text-xs text-gray-400">${r.affectedCount} job(s) affected</span>
          <button onclick="deleteRegion('${nm}','${w}')" class="ml-auto text-xs px-2 py-0.5 rounded border border-red-300 text-red-600 hover:bg-red-50">Delete</button>
        </div>
        <div class="flex flex-wrap gap-1 mb-2">
          ${(r.members || []).map(m => `
            <span class="inline-flex items-center gap-1 text-xs bg-gray-100 px-2 py-0.5 rounded-full">
              ${escHtml(canonLabel(m.country))}
              <button onclick="removeRegionMember('${nm}','${escHtml(m.country)}','${w}')" class="text-gray-400 hover:text-red-500">×</button>
            </span>
          `).join('') || '<span class="text-xs text-gray-300 italic">no member countries yet</span>'}
        </div>
        <div class="flex gap-2 mb-2">
          <select id="add-country-${i}" class="flex-1 min-w-0 text-xs rounded border border-gray-200 px-2 py-1 focus:ring-1 focus:ring-blue-400">${countryOptions()}</select>
          <button onclick="addRegionMember('${nm}', document.getElementById('add-country-${i}').value, false, '${w}')"
                  class="shrink-0 whitespace-nowrap text-xs px-3 py-1 rounded bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100">Add country</button>
        </div>
        <div class="flex flex-wrap items-center gap-1 pt-2 border-t border-gray-50">
          <span class="text-xs text-gray-400 mr-1">Aliases:</span>
          ${(r.aliases || []).map(a => `
            <span class="inline-flex items-center gap-1 text-xs bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full">
              ${escHtml(a)}
              <button onclick="removeRegionAlias('${nm}','${escHtml(a)}','${w}')" class="text-blue-300 hover:text-red-500">×</button>
            </span>
          `).join('')}
          <span class="inline-flex items-center gap-1">
            <input id="alias-input-${i}" type="text" placeholder="add alias" onkeydown="if(event.key==='Enter'){addRegionAlias('${nm}', this.value, '${w}'); this.value='';}"
                   class="text-xs rounded border border-gray-200 px-2 py-0.5 focus:ring-1 focus:ring-blue-400 w-28" />
            <button onclick="const el=document.getElementById('alias-input-${i}'); addRegionAlias('${nm}', el.value, '${w}'); el.value='';"
                    class="text-xs px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100">Add</button>
          </span>
        </div>
        <span id="${w}" role="alert" class="block mt-2 text-xs text-red-600"></span>
      </div>`;
    }).join('');
  } catch { list.innerHTML = '<span class="text-xs text-red-400">Failed to load regions.</span>'; }
}

function escHtml(s) { return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

// Inline warning: red text in the given element, auto-cleared after 3s (replaces alert()).
const _warnTimers = {};
function showWarn(elId, msg) {
  const el = document.getElementById(elId);
  if (!el) return;
  el.textContent = msg || '';
  if (_warnTimers[elId]) clearTimeout(_warnTimers[elId]);
  if (msg) _warnTimers[elId] = setTimeout(() => { const e = document.getElementById(elId); if (e) e.textContent = ''; }, 3000);
}

// Canonical countries (capitalized) for region dropdowns + chip labels.
const _CANON = window.__CANON_COUNTRIES || [];
const _CANON_LABEL = {}; _CANON.forEach(n => { _CANON_LABEL[n.toLowerCase()] = n; });
function canonLabel(lc) { return _CANON_LABEL[lc] || String(lc).replace(/\b\w/g, c => c.toUpperCase()); }
function countryOptions() {
  return '<option value="">— select country —</option>' +
    _CANON.map(n => `<option value="${escHtml(n.toLowerCase())}">${escHtml(n)}</option>`).join('');
}

async function addRegionMember(name, country, isCreate, warnId) {
  name = (name || '').trim(); country = (country || '').toLowerCase().trim();
  if (!name || !country) { showWarn(warnId, 'Region name and country are required.'); return; }
  if (isCreate && _CANON_LABEL[name.toLowerCase()]) { showWarn(warnId, `"${name}" is a country name — a region can't share a country's name.`); return; }
  const res = await fetch(`/api/regions/${encodeURIComponent(name)}/members`, {
    method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ country, create: !!isCreate }),
  });
  const data = await res.json();
  if (data.error) { showWarn(warnId, data.error); return; }
  if (isCreate) document.getElementById('new-region-name').value = '';
  await loadRegions();
}

async function removeRegionMember(name, country, warnId) {
  if (!confirm(`Remove ${country} from ${name}?`)) return;
  const res = await fetch(`/api/regions/${encodeURIComponent(name)}/members/${encodeURIComponent(country)}`, { method: 'DELETE' });
  const data = await res.json();
  if (data.error) { showWarn(warnId, data.error); return; }
  await loadRegions();
}

async function deleteRegion(name, warnId) {
  if (!confirm(`Delete region "${name}", its member countries and aliases? This cannot be undone.`)) return;
  const res = await fetch(`/api/regions/${encodeURIComponent(name)}`, { method: 'DELETE' });
  const data = await res.json();
  if (data.error) { showWarn(warnId, data.error); return; }
  await loadRegions();
}

async function addRegionAlias(name, alias, warnId) {
  alias = (alias || '').toLowerCase().trim();
  if (!alias) return;
  const res = await fetch(`/api/regions/${encodeURIComponent(name)}/aliases`, {
    method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ alias }),
  });
  const data = await res.json();
  if (data.error) { showWarn(warnId, data.error); return; }
  await loadRegions();
}

async function removeRegionAlias(name, alias, warnId) {
  if (!confirm(`Remove alias "${alias}" from ${name}?`)) return;
  const res = await fetch(`/api/regions/${encodeURIComponent(name)}/aliases/${encodeURIComponent(alias)}`, { method: 'DELETE' });
  const data = await res.json();
  if (data.error) { showWarn(warnId, data.error); return; }
  await loadRegions();
}

// ── Country synonyms editor (per-item, like regions) ──────────────────────────
let _synData = [];               // [{ country, synonyms: [] }]
let _regionLabels = new Set();   // lowercased region names + aliases, for the client-side guard

async function openSynonymsModal() {
  document.getElementById('synonyms-modal').classList.remove('hidden');
  document.getElementById('synonyms-list').innerHTML = '<span class="text-xs text-gray-400">Loading…</span>';
  try {
    const [sres, rres] = await Promise.all([fetch('/api/country-synonyms'), fetch('/api/regions')]);
    _synData = (await sres.json()).countries || [];
    _regionLabels = new Set();
    try {
      const rdata = await rres.json();
      for (const r of (rdata.regions || [])) {
        _regionLabels.add((r.name || '').toLowerCase());
        for (const a of (r.aliases || [])) _regionLabels.add((a || '').toLowerCase());
      }
    } catch {}
    renderSynonyms();
  } catch { document.getElementById('synonyms-list').innerHTML = '<span class="text-xs text-red-400">Failed to load.</span>'; }
}

function closeSynonymsModal() { document.getElementById('synonyms-modal').classList.add('hidden'); }

function renderSynonyms() {
  const q = (document.getElementById('synonyms-search').value || '').toLowerCase().trim();
  const list = document.getElementById('synonyms-list');
  const rows = _synData.filter(c => !q || c.country.toLowerCase().includes(q) || c.synonyms.some(s => s.includes(q)));
  list.innerHTML = rows.map(c => {
    const i = _synData.indexOf(c);
    return `
      <div class="border border-gray-100 rounded-lg p-2">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="text-sm font-medium text-gray-800 w-full sm:w-auto sm:min-w-[140px]">${escHtml(c.country)}</span>
          ${c.synonyms.map(s => `
            <span class="inline-flex items-center gap-1 text-xs bg-gray-100 px-2 py-0.5 rounded-full">
              ${escHtml(s)}
              <button onclick="removeSynonym(${i}, '${escHtml(s)}')" class="text-gray-400 hover:text-red-500">×</button>
            </span>`).join('')}
          <span class="inline-flex items-center gap-1">
            <input id="syn-input-${i}" type="text" placeholder="add synonym" onkeydown="if(event.key==='Enter'){addSynonym(${i}, this.value); this.value='';}"
                   class="text-xs rounded border border-gray-200 px-2 py-0.5 focus:ring-1 focus:ring-blue-400 w-32" />
            <button onclick="const el=document.getElementById('syn-input-${i}'); addSynonym(${i}, el.value); el.value='';"
                    class="text-xs px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100">Add</button>
          </span>
        </div>
        <span id="syn-warn-${i}" role="alert" class="block mt-1 text-xs text-red-600"></span>
      </div>`;
  }).join('');
}

async function addSynonym(idx, val) {
  const s = String(val || '').toLowerCase().trim();
  if (!s) return;
  const wid = `syn-warn-${idx}`;
  if (_CANON_LABEL[s]) { showWarn(wid, `"${s}" is a country name — it can't be a synonym.`); return; }
  if (_regionLabels.has(s)) { showWarn(wid, `"${s}" is a region name — it can't be a synonym.`); return; }
  if (_synData[idx].synonyms.includes(s)) return;
  const res = await fetch('/api/country-synonyms', {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ synonym: s, country: _synData[idx].country }),
  });
  const data = await res.json();
  if (data.error) { showWarn(wid, data.error); return; }
  _synData[idx].synonyms.push(s);
  _synData[idx].synonyms.sort();
  renderSynonyms();
}

async function removeSynonym(idx, val) {
  const res = await fetch(`/api/country-synonyms/${encodeURIComponent(val)}`, { method: 'DELETE' });
  const data = await res.json();
  if (data.error) { showWarn(`syn-warn-${idx}`, data.error); return; }
  _synData[idx].synonyms = _synData[idx].synonyms.filter(s => s !== val);
  renderSynonyms();
}

// Load on page ready (only when admin tab is active or becomes active)
if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', loadRegions); }
else { loadRegions(); }
</script>
