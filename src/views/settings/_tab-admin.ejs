<script>
let _atsRunId = null;
let _atsEventSource = null;
let _atsStatsLoaded = false;
let _atsStatsLoading = false;

function _setDot(id, enabled) {
  const dot = document.getElementById(id);
  dot.classList.toggle('bg-emerald-400', enabled);
  dot.classList.toggle('animate-pulse', enabled);
  dot.classList.toggle('bg-gray-300', !enabled);
}

function _applyScheduleState(discEnabled, leverDiscEnabled, valEnabled, tz) {
  const tzLabel = tz || 'UTC';
  document.getElementById('ats-disc-toggle').checked       = discEnabled;
  document.getElementById('ats-lever-disc-toggle').checked = leverDiscEnabled;
  document.getElementById('ats-val-toggle').checked        = valEnabled;
  document.getElementById('ats-disc-tz').textContent       = tzLabel;
  document.getElementById('ats-lever-disc-tz').textContent = tzLabel;
  document.getElementById('ats-val-tz').textContent        = tzLabel;
  _setDot('ats-disc-dot',       discEnabled);
  _setDot('ats-lever-disc-dot', leverDiscEnabled);
  _setDot('ats-val-dot',        valEnabled);
}

function _setAtsStatsLoading() {
  const statsEl = document.getElementById('ats-stats');
  if (statsEl) statsEl.innerHTML = '<p class="text-xs text-gray-400">Loading…</p>';
  const poolEl = document.getElementById('pool-counts');
  if (poolEl) poolEl.innerHTML = '<p class="text-xs text-gray-400">Loading…</p>';
}

async function loadAtsStats(options = {}) {
  const force = !!options.force;
  if (_atsStatsLoading || (_atsStatsLoaded && !force)) return;
  _atsStatsLoading = true;
  _setAtsStatsLoading();
  try {
    const res  = await fetch('/api/ats/status');
    const data = await res.json();

    if (data.settings) {
      _applyScheduleState(
        !!data.settings.ats_discovery_enabled,
        !!data.settings.ats_lever_disc_enabled,
        !!data.settings.ats_validation_enabled,
        data.settings.timezone,
      );
      _applyPoolState(
        !!data.settings.ats_pool_gh_enabled,
        !!data.settings.ats_pool_ashby_enabled,
        data.settings.timezone,
      );
    }
    if (data.poolCounts) {
      _renderPoolCounts(
        data.poolCounts.greenhouse,
        data.poolCounts.ashby,
        data.poolCounts.resolvedLocations,
        data.poolCounts.unknownLocations,
        data.poolCounts.newUnresolvedLocations,
      );
    }

    const statsEl = document.getElementById('ats-stats');
    if (!statsEl) return;
    if (!data.boards?.length) {
      statsEl.innerHTML = '<p class="text-xs text-gray-400">No boards discovered yet. Run Discovery to populate.</p>';
      _atsStatsLoaded = true;
      return;
    }
    const map = Object.fromEntries(data.boards.map(r => [r.ats, r]));
    const fmt = t => t ? new Date(t).toLocaleDateString() : '—';
    statsEl.innerHTML = `
      <table class="w-full text-xs text-left border-collapse">
        <thead><tr class="text-gray-400 border-b">
          <th class="pb-1 pr-4 font-medium">ATS</th>
          <th class="pb-1 pr-4 font-medium">Total</th>
          <th class="pb-1 pr-4 font-medium">Active</th>
          <th class="pb-1 pr-4 font-medium">Last discovery</th>
          <th class="pb-1 font-medium">Last validation</th>
        </tr></thead>
        <tbody>
          ${['greenhouse','lever','ashby'].map(ats => {
            const r = map[ats] || {};
            return `<tr class="border-b border-gray-50">
              <td class="py-1 pr-4 font-medium capitalize">${ats}</td>
              <td class="py-1 pr-4">${r.total || 0}</td>
              <td class="py-1 pr-4">${r.active || 0}</td>
              <td class="py-1 pr-4">${fmt(r.last_discovered)}</td>
              <td class="py-1">${fmt(r.last_validated)}</td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>`;
    _atsStatsLoaded = true;
  } catch {
    const el = document.getElementById('ats-stats');
    if (el) el.innerHTML = '<p class="text-xs text-red-400">Failed to load stats.</p>';
  } finally {
    _atsStatsLoading = false;
  }
}

function ensureAdminStatsLoaded(force = false) {
  return loadAtsStats({ force });
}

window.ensureAdminStatsLoaded = ensureAdminStatsLoaded;

async function _atsToggle(discEnabled, leverDiscEnabled, valEnabled) {
  const res = await fetch('/api/ats/settings', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ discovery_enabled: discEnabled, lever_disc_enabled: leverDiscEnabled, validation_enabled: valEnabled }),
  });
  return res.json();
}

async function atsDiscToggle(enabled) {
  const toggle = document.getElementById('ats-disc-toggle');
  toggle.disabled = true;
  const data = await _atsToggle(enabled, document.getElementById('ats-lever-disc-toggle').checked, document.getElementById('ats-val-toggle').checked);
  toggle.disabled = false;
  if (data.error) { alert(data.error); toggle.checked = !enabled; return; }
  _setDot('ats-disc-dot', enabled);
  document.getElementById('ats-disc-tz').textContent = data.timezone || 'UTC';
}

async function atsLeverDiscToggle(enabled) {
  const toggle = document.getElementById('ats-lever-disc-toggle');
  toggle.disabled = true;
  const data = await _atsToggle(document.getElementById('ats-disc-toggle').checked, enabled, document.getElementById('ats-val-toggle').checked);
  toggle.disabled = false;
  if (data.error) { alert(data.error); toggle.checked = !enabled; return; }
  _setDot('ats-lever-disc-dot', enabled);
  document.getElementById('ats-lever-disc-tz').textContent = data.timezone || 'UTC';
}

async function atsValToggle(enabled) {
  const toggle = document.getElementById('ats-val-toggle');
  toggle.disabled = true;
  const data = await _atsToggle(document.getElementById('ats-disc-toggle').checked, document.getElementById('ats-lever-disc-toggle').checked, enabled);
  toggle.disabled = false;
  if (data.error) { alert(data.error); toggle.checked = !enabled; return; }
  _setDot('ats-val-dot', enabled);
  document.getElementById('ats-val-tz').textContent = data.timezone || 'UTC';
}

function _atsDisableAllButtons() {
  document.getElementById('ats-discover-btn').disabled       = true;
  document.getElementById('ats-lever-discover-btn').disabled = true;
  document.getElementById('ats-validate-btn').disabled       = true;
}

function _atsEnableAllButtons() {
  document.getElementById('ats-discover-btn').disabled       = false;
  document.getElementById('ats-lever-discover-btn').disabled = false;
  document.getElementById('ats-validate-btn').disabled       = false;
}

async function atsRunDiscovery() {
  _atsDisableAllButtons();
  const res = await fetch('/api/ats/discover', { method: 'POST' });
  const { runId } = await res.json();
  _atsStartStream(runId, 'Discovery (GH & Ashby)');
}

async function atsRunLeverDiscovery() {
  _atsDisableAllButtons();
  const res = await fetch('/api/ats/discover-lever', { method: 'POST' });
  const { runId } = await res.json();
  _atsStartStream(runId, 'Discovery (Lever)');
}

async function atsRunValidation() {
  _atsDisableAllButtons();
  const res = await fetch('/api/ats/validate', { method: 'POST' });
  const { runId } = await res.json();
  _atsStartStream(runId, 'Validation');
}

function _atsStartStream(runId, label) {
  _atsRunId = runId;
  const logEl      = document.getElementById('ats-run-log');
  const titleEl    = document.getElementById('ats-run-title');
  const linesEl    = document.getElementById('ats-run-lines');
  const progressEl = document.getElementById('ats-run-progress');
  const dotEl      = document.getElementById('ats-run-dot');
  const stopBtn    = document.getElementById('ats-run-stop-btn');

  logEl.classList.remove('hidden');
  titleEl.textContent = label + ' running…';
  linesEl.innerHTML = '';
  progressEl.classList.add('hidden');
  dotEl.className = 'w-2 h-2 rounded-full bg-blue-400 animate-pulse flex-shrink-0';
  stopBtn.classList.remove('hidden');
  stopBtn.disabled = false;
  stopBtn.textContent = 'Stop';

  _atsEventSource = new EventSource('/api/ats/stream/' + runId);

  _atsEventSource.onmessage = (e) => {
    const ev = JSON.parse(e.data);
    const line = document.createElement('div');
    line.textContent = ev.msg;
    linesEl.appendChild(line);
    linesEl.scrollTop = linesEl.scrollHeight;
    if (ev.total) {
      progressEl.textContent = `${ev.processed || 0} / ${ev.total} boards`;
      progressEl.classList.remove('hidden');
    }
    if (ev.done) _atsStreamDone(label, ev.cancelled);
  };

  _atsEventSource.onerror = () => _atsStreamDone(label, false);
}

function _atsStreamDone(label, cancelled) {
  if (_atsEventSource) { _atsEventSource.close(); _atsEventSource = null; }
  _atsRunId = null;
  document.getElementById('ats-run-title').textContent = cancelled ? label + ' cancelled' : label + ' complete';
  const dot = document.getElementById('ats-run-dot');
  dot.classList.remove('animate-pulse', 'bg-blue-400');
  dot.classList.add(cancelled ? 'bg-gray-300' : 'bg-emerald-400');
  document.getElementById('ats-run-stop-btn').classList.add('hidden');
  _atsEnableAllButtons();
  const statsEl = document.getElementById('ats-stats');
  if (statsEl) statsEl.innerHTML = '<p class="text-xs text-gray-400">Updating…</p>';
  setTimeout(() => loadAtsStats({ force: true }), 500);
}

async function atsStopRun() {
  if (!_atsRunId) return;
  const btn = document.getElementById('ats-run-stop-btn');
  btn.disabled = true;
  btn.textContent = 'Stopping…';
  await fetch('/api/ats/run/' + _atsRunId, { method: 'DELETE' });
}

</script>

<script>
let _poolRunId = null;
let _poolEventSource = null;

function _applyPoolState(ghEnabled, ashbyEnabled, tz) {
  const tzLabel = tz || 'UTC';
  document.getElementById('pool-gh-toggle').checked    = ghEnabled;
  document.getElementById('pool-ashby-toggle').checked = ashbyEnabled;
  document.getElementById('pool-gh-tz').textContent    = tzLabel;
  document.getElementById('pool-ashby-tz').textContent = tzLabel;
  const ghDot    = document.getElementById('pool-gh-dot');
  const ashbyDot = document.getElementById('pool-ashby-dot');
  ghDot.classList.toggle('bg-emerald-400', ghEnabled);
  ghDot.classList.toggle('animate-pulse',  ghEnabled);
  ghDot.classList.toggle('bg-gray-300',   !ghEnabled);
  ashbyDot.classList.toggle('bg-emerald-400', ashbyEnabled);
  ashbyDot.classList.toggle('animate-pulse',  ashbyEnabled);
  ashbyDot.classList.toggle('bg-gray-300',   !ashbyEnabled);
}

function _renderPoolCounts(ghCount, ashbyCount, resolvedLocations = 0, unknownLocations = 0, newUnresolvedLocations = 0) {
  const el = document.getElementById('pool-counts');
  if (!el) return;
  const unknownHtml = unknownLocations > 0
    ? `<a href="/settings/unresolved-locations" class="font-medium text-gray-700 underline decoration-dotted underline-offset-2 hover:text-sky-700">Unknown ${unknownLocations.toLocaleString()}</a>`
    : `<span class="font-medium text-gray-500">Unknown ${unknownLocations.toLocaleString()}</span>`;
  el.innerHTML = `
    <div class="flex items-center gap-4 rounded-lg bg-gray-50 border border-gray-100 px-3 py-2 text-xs">
      <span class="w-28 flex-shrink-0 font-medium text-gray-500">Pool size</span>
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-green-400 inline-block"></span>
        <span class="text-gray-700 font-medium">Greenhouse ${ghCount.toLocaleString()}</span>
      </span>
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-violet-400 inline-block"></span>
        <span class="text-gray-700 font-medium">Ashby ${ashbyCount.toLocaleString()}</span>
      </span>
    </div>
    <div class="flex items-center gap-4 rounded-lg bg-gray-50 border border-gray-100 px-3 py-2 text-xs">
      <span class="w-28 flex-shrink-0 font-medium text-gray-500">Locations</span>
      <span class="font-medium text-gray-700">Known ${resolvedLocations.toLocaleString()}</span>
      <span class="font-medium text-gray-700">Need resolving ${newUnresolvedLocations.toLocaleString()}</span>
      ${unknownHtml}
    </div>`;
}

async function poolToggle(provider, enabled) {
  const ghEnabled    = provider === 'gh'    ? enabled : document.getElementById('pool-gh-toggle').checked;
  const ashbyEnabled = provider === 'ashby' ? enabled : document.getElementById('pool-ashby-toggle').checked;
  const toggleEl = document.getElementById(`pool-${provider}-toggle`);
  toggleEl.disabled = true;
  try {
    const res = await fetch('/api/ats/pool/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ gh_enabled: ghEnabled, ashby_enabled: ashbyEnabled }),
    });
    const data = await res.json();
    if (data.error) { alert(data.error); toggleEl.checked = !enabled; return; }
    _applyPoolState(
      document.getElementById('pool-gh-toggle').checked,
      document.getElementById('pool-ashby-toggle').checked,
      data.timezone,
    );
  } catch { toggleEl.checked = !enabled; }
  toggleEl.disabled = false;
}

function _poolDisableAllButtons() {
  document.getElementById('pool-gh-fetch-btn').disabled    = true;
  document.getElementById('pool-ashby-fetch-btn').disabled = true;
  document.getElementById('pool-resolve-btn').disabled     = true;
  document.getElementById('pool-recheck-btn').disabled     = true;
}

async function poolFetch(provider) {
  _poolDisableAllButtons();
  const endpoint = provider === 'greenhouse' ? '/api/ats/pool/fetch-greenhouse' : '/api/ats/pool/fetch-ashby';
  const label    = provider === 'greenhouse' ? 'Greenhouse' : 'Ashby';
  const res = await fetch(endpoint, { method: 'POST' });
  const { runId } = await res.json();
  _poolStartStream(runId, label + ' pool fetch', 'boards');
}

async function poolResolveCountries() {
  _poolDisableAllButtons();
  const res = await fetch('/api/ats/pool/resolve-countries', { method: 'POST' });
  const { runId } = await res.json();
  _poolStartStream(runId, 'Resolving job countries', 'locations');
}

async function poolRecheckUnknownCountries() {
  _poolDisableAllButtons();
  const res = await fetch('/api/ats/pool/recheck-unknown-countries', { method: 'POST' });
  const { runId } = await res.json();
  _poolStartStream(runId, 'Re-checking unknown locations', 'locations');
}

function _poolStartStream(runId, label, unit = 'boards') {
  _poolRunId = runId;
  const logEl      = document.getElementById('pool-run-log');
  const titleEl    = document.getElementById('pool-run-title');
  const linesEl    = document.getElementById('pool-run-lines');
  const progressEl = document.getElementById('pool-run-progress');
  const dotEl      = document.getElementById('pool-run-dot');
  const stopBtn    = document.getElementById('pool-run-stop-btn');

  logEl.classList.remove('hidden');
  titleEl.textContent = label + ' running…';
  linesEl.innerHTML = '';
  progressEl.classList.add('hidden');
  dotEl.className = 'w-2 h-2 rounded-full bg-blue-400 animate-pulse flex-shrink-0';
  stopBtn.classList.remove('hidden');
  stopBtn.disabled = false;
  stopBtn.textContent = 'Stop';

  _poolEventSource = new EventSource('/api/ats/stream/' + runId);

  _poolEventSource.onmessage = (e) => {
    const ev = JSON.parse(e.data);
    if (ev.msg && ev.msg !== '') {
      const line = document.createElement('div');
      line.textContent = ev.msg;
      linesEl.appendChild(line);
      linesEl.scrollTop = linesEl.scrollHeight;
    }
    if (ev.total) {
      progressEl.textContent = `${ev.processed || 0} / ${ev.total} ${unit}`;
      progressEl.classList.remove('hidden');
    }
    if (ev.done) _poolStreamDone(label, ev.cancelled);
  };

  _poolEventSource.onerror = () => _poolStreamDone(label, false);
}

function _poolStreamDone(label, cancelled) {
  if (_poolEventSource) { _poolEventSource.close(); _poolEventSource = null; }
  _poolRunId = null;
  document.getElementById('pool-run-title').textContent = cancelled ? label + ' cancelled' : label + ' complete';
  const dot = document.getElementById('pool-run-dot');
  dot.classList.remove('animate-pulse', 'bg-blue-400');
  dot.classList.add(cancelled ? 'bg-gray-300' : 'bg-emerald-400');
  document.getElementById('pool-run-stop-btn').classList.add('hidden');
  document.getElementById('pool-gh-fetch-btn').disabled    = false;
  document.getElementById('pool-ashby-fetch-btn').disabled = false;
  document.getElementById('pool-resolve-btn').disabled     = false;
  document.getElementById('pool-recheck-btn').disabled     = false;
  setTimeout(() => loadAtsStats({ force: true }), 500);
}

async function poolStopRun() {
  if (!_poolRunId) return;
  const btn = document.getElementById('pool-run-stop-btn');
  btn.disabled = true;
  btn.textContent = 'Stopping…';
  await fetch('/api/ats/run/' + _poolRunId, { method: 'DELETE' });
}

// ── Telegram admin JS ────────────────────────────────────────────────────────

let _tgChannels = [];

async function loadTelegramState() {
  try {
    const [settingsRes, channelsRes, statsRes] = await Promise.all([
      fetch('/api/telegram/settings'),
      fetch('/api/telegram/channels'),
      fetch('/api/ats/status'),
    ]);
    const settings  = await settingsRes.json();
    const chData    = await channelsRes.json();
    const statsData = await statsRes.json();

    document.getElementById('tg-ingest-toggle').checked = !!settings.enabled;
    _setDot('tg-ingest-dot', !!settings.enabled);

    const prompt = settings.extract_prompt || '';
    document.getElementById('tg-prompt-textarea').value = prompt;

    const tz = statsData?.settings?.timezone || 'UTC';
    document.getElementById('tg-tz').textContent = tz;

    if (statsData?.telegramCounts) {
      const { jobs, channels } = statsData.telegramCounts;
      document.getElementById('tg-counts').innerHTML = `
        <div class="flex items-center gap-4 rounded-lg bg-gray-50 border border-gray-100 px-3 py-2 text-xs">
          <span class="w-28 flex-shrink-0 font-medium text-gray-500">Pool size</span>
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-sky-400 inline-block"></span>
            <span class="font-mono text-gray-700 font-medium">${jobs.toLocaleString()} jobs</span>
          </span>
          <span class="font-mono text-gray-500">${channels} active channel(s)</span>
        </div>`;
    }

    _tgChannels = chData.channels || [];
    _renderTgChannels();
  } catch {
    document.getElementById('tg-counts').innerHTML = '<p class="text-xs text-red-400">Failed to load Telegram stats.</p>';
  }
}

function _renderTgChannels() {
  const el = document.getElementById('tg-channel-chips');
  if (!_tgChannels.length) {
    el.innerHTML = '<span class="text-xs text-gray-400">No channels added yet.</span>';
    return;
  }
  el.innerHTML = _tgChannels
    .filter(c => c.is_active)
    .map(c => `
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-sky-50 text-sky-700 border border-sky-200 text-xs font-medium">
        @${c.channel_username}
        <button type="button" onclick="telegramRemoveChannel('${c.channel_username}')" class="ml-0.5 text-sky-400 hover:text-sky-700 leading-none">&times;</button>
      </span>`)
    .join('');
}

async function telegramToggle(enabled) {
  const toggle = document.getElementById('tg-ingest-toggle');
  toggle.disabled = true;
  try {
    const res = await fetch('/api/telegram/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled }),
    });
    const data = await res.json();
    if (data.error) { alert(data.error); toggle.checked = !enabled; return; }
    _setDot('tg-ingest-dot', enabled);
    document.getElementById('tg-tz').textContent = data.timezone || 'UTC';
  } catch { toggle.checked = !enabled; }
  toggle.disabled = false;
}

async function telegramFetchNow() {
  const btn = document.getElementById('tg-fetch-btn');
  btn.disabled = true;
  btn.textContent = 'Fetching…';
  try {
    const res = await fetch('/api/telegram/fetch-now', { method: 'POST' });
    const data = await res.json();
    if (data.error) { alert(data.error); return; }
    btn.textContent = 'Done!';
    setTimeout(() => { btn.textContent = 'Fetch now'; btn.disabled = false; loadTelegramState(); }, 2000);
  } catch {
    btn.textContent = 'Error';
    setTimeout(() => { btn.textContent = 'Fetch now'; btn.disabled = false; }, 2000);
  }
}

async function telegramAddChannel() {
  const input = document.getElementById('tg-channel-input');
  const username = input.value.trim().replace(/^@/, '');
  if (!username) return;
  try {
    const res = await fetch('/api/telegram/channels', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ channel_username: username }),
    });
    const data = await res.json();
    if (data.error) { alert(data.error); return; }
    input.value = '';
    const existing = _tgChannels.find(c => c.channel_username === data.channel_username);
    if (existing) existing.is_active = 1;
    else _tgChannels.push({ channel_username: data.channel_username, is_active: 1 });
    _renderTgChannels();
  } catch { alert('Failed to add channel.'); }
}

async function telegramRemoveChannel(username) {
  try {
    const res = await fetch('/api/telegram/channels/' + encodeURIComponent(username), { method: 'DELETE' });
    const data = await res.json();
    if (data.error) { alert(data.error); return; }
    const ch = _tgChannels.find(c => c.channel_username === username);
    if (ch) ch.is_active = 0;
    _renderTgChannels();
  } catch { alert('Failed to remove channel.'); }
}

async function telegramSavePrompt() {
  const prompt = document.getElementById('tg-prompt-textarea').value.trim();
  const enabled = document.getElementById('tg-ingest-toggle').checked;
  try {
    const res = await fetch('/api/telegram/settings', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled, extract_prompt: prompt }),
    });
    const data = await res.json();
    if (data.error) { alert(data.error); return; }
  } catch { alert('Failed to save prompt.'); }
}

// Load Telegram state when admin tab activates
document.addEventListener('DOMContentLoaded', () => {
  const adminTab = document.querySelector('[data-tab="admin"]') || document.querySelector('[href="#admin"]');
  if (adminTab) {
    adminTab.addEventListener('click', () => loadTelegramState());
  }
  // Also load if admin tab is already active on page load
  const pane = document.getElementById('tab-pane-admin');
  if (pane && !pane.classList.contains('hidden')) loadTelegramState();
});

async function setUserCredits(profileId, btn) {
  const input = document.getElementById('credits-input-' + profileId);
  const amount = parseFloat(input.value);
  if (isNaN(amount) || amount < 0) { alert('Enter a valid amount (≥ 0)'); return; }
  const orig = btn.textContent;
  btn.disabled = true;
  btn.textContent = '…';
  try {
    const res = await fetch('/api/admin/credits', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ profileId, credits: amount }),
    });
    const data = await res.json();
    if (data.error) { alert(data.error); }
    else { btn.textContent = '✓'; setTimeout(() => { btn.textContent = orig; btn.disabled = false; }, 1500); return; }
  } catch { alert('Failed to update credits'); }
  btn.disabled = false;
  btn.textContent = orig;
}
</script>
