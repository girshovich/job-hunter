<!-- ==================== ADMIN TAB ==================== -->
<div id="tab-pane-admin" class="<%= activeTab !== 'admin' ? 'hidden' : '' %> space-y-4">

  <!-- Global API Keys -->
  <form id="admin-keys-form" method="post" action="/settings" class="">
    <input type="hidden" name="tab" value="admin">
    <input type="hidden" name="section" value="keys">
    <div class="bg-white rounded-xl border border-red-100 shadow-sm p-4 sm:p-6">
      <h2 class="text-base font-semibold text-gray-900 mb-1">Global API Keys</h2>
      <p class="text-xs text-gray-500 mb-4">Used by all users who are on "Use JH credits" mode. Only visible to admin.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
        <div>
          <div class="flex items-center gap-1 mb-1">
            <label class="text-xs font-medium text-gray-600">Apify API Token</label>
            <a href="https://console.apify.com/settings/integrations" target="_blank" rel="noopener noreferrer"
               class="text-gray-400 hover:text-blue-500 transition-colors" title="Get your Apify token">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </a>
          </div>
          <div class="relative">
            <input id="global-apify-token-input" type="password" name="apify_api_token" value="<%= settings.apify_api_token %>"
                   class="w-full rounded-lg border border-gray-300 px-3 py-2 pr-9 text-sm font-mono focus:ring-2 focus:ring-blue-500"
                   placeholder="apify_api_…" autocomplete="off" />
            <button type="button" onclick="toggleEye('global-apify-token-input', this)"
                    class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            </button>
          </div>
        </div>
        <div>
          <div class="flex items-center gap-1 mb-1">
            <label class="text-xs font-medium text-gray-600">OpenAI API Key</label>
            <a href="https://platform.openai.com/api-keys" target="_blank" rel="noopener noreferrer"
               class="text-gray-400 hover:text-blue-500 transition-colors" title="Get your OpenAI API key">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </a>
          </div>
          <div class="relative">
            <input id="global-openai-key-input" type="password" name="openai_api_key" value="<%= settings.openai_api_key %>"
                   class="w-full rounded-lg border border-gray-300 px-3 py-2 pr-9 text-sm font-mono focus:ring-2 focus:ring-blue-500"
                   placeholder="sk-…" autocomplete="off" />
            <button type="button" onclick="toggleEye('global-openai-key-input', this)"
                    class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            </button>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" onclick="testApiKey('apify', 'global-apify-token-input', 'global-apify-test-status')"
                class="px-3 py-2 text-sm font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition-colors">
          Test Apify
        </button>
        <button type="button" onclick="testApiKey('openai', 'global-openai-key-input', 'global-openai-test-status')"
                class="px-3 py-2 text-sm font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition-colors">
          Test OpenAI
        </button>
        <button type="submit"
                class="px-4 py-2 text-sm font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
          Save
        </button>
      </div>
      <p id="global-apify-test-status" class="text-xs mt-1 hidden"></p>
      <p id="global-openai-test-status" class="text-xs mt-1 hidden"></p>
    </div>
  </form>

  <!-- Email Delivery -->
  <form id="admin-email-form" method="post" action="/settings" class="">
    <input type="hidden" name="tab" value="admin">
    <input type="hidden" name="section" value="email">
    <div class="bg-white rounded-xl border border-red-100 shadow-sm p-4 sm:p-6">
      <h2 class="text-base font-semibold text-gray-900 mb-1">Email Delivery</h2>
      <p class="text-xs text-gray-500 mb-4">Used to send login codes and job reports to all users.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
        <div>
          <label class="block text-xs font-medium text-gray-600 mb-1">Sender</label>
          <input type="text" name="email_from" value="<%= settings.email_from %>"
                 placeholder="Job Hunter <jobs@yourdomain.com>"
                 class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
          <div class="flex items-center gap-1 mb-1">
            <label class="text-xs font-medium text-gray-600">Resend API Key</label>
            <a href="https://resend.com/api-keys" target="_blank" rel="noopener noreferrer"
               class="text-gray-400 hover:text-blue-500 transition-colors" title="Get your Resend API key">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </a>
          </div>
          <div class="relative">
            <input id="resend-key-input" type="password" name="resend_api_key" value="<%= settings.resend_api_key %>"
                   class="w-full rounded-lg border border-gray-300 px-3 py-2 pr-9 text-sm font-mono focus:ring-2 focus:ring-blue-500"
                   placeholder="re_…" autocomplete="off" />
            <button type="button" onclick="toggleEye('resend-key-input', this)"
                    class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            </button>
          </div>
        </div>
      </div>
      <div class="mt-3">
        <label class="block text-xs font-medium text-gray-600 mb-1">Site URL</label>
        <input type="text" name="app_url" value="<%= settings.app_url %>"
               placeholder="https://hunter.example.com"
               class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500" />
        <p class="text-xs text-gray-400 mt-1">Used for links in job report emails. Auto-detected on first admin login.</p>
      </div>
      <div class="flex items-center gap-2 flex-wrap mt-3">
        <button type="button" onclick="testApiKey('resend', 'resend-key-input', 'resend-test-status')"
                class="px-3 py-2 text-sm font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition-colors">
          Test key
        </button>
        <button type="button" id="test-email-btn" onclick="sendTestEmail(this)"
                class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          Test Email
        </button>
        <button type="submit"
                class="px-4 py-2 text-sm font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
          Save
        </button>
      </div>
      <p id="resend-test-status" class="text-xs mt-1 hidden"></p>
      <p id="test-email-status" class="text-xs mt-1 hidden"></p>
    </div>
  </form>

  <!-- Profiles -->
  <div class="bg-white rounded-xl border border-red-100 shadow-sm p-4 sm:p-6">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-base font-semibold text-gray-900">Profiles</h2>
        <p class="text-xs text-gray-500 mt-0.5">Manage accounts that can log into this app.</p>
      </div>
    </div>
    <div class="space-y-2 mb-4" id="profiles-list">
      <% allProfiles.forEach(function(p) { %>
      <div class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-3 px-3 py-2.5 bg-gray-50 rounded-lg border border-gray-200" id="profile-row-<%= p.id %>">
        <div class="flex items-center gap-2 min-w-0 flex-1">
          <div class="w-7 h-7 rounded-full bg-blue-500 flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
            <%= p.email.charAt(0).toUpperCase() %>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm text-gray-900 font-medium truncate"><%= p.email.split('@')[0] %></p>
            <p class="text-xs text-gray-400 truncate"><%= p.email %></p>
          </div>
          <% if (p.is_admin) { %>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-100 text-amber-700 font-medium flex-shrink-0">admin</span>
          <% } %>
        </div>
        <div class="flex items-center justify-between gap-2 sm:contents">
        <!-- Credits editor -->
        <div class="flex items-center gap-1.5 flex-shrink-0">
          <span class="text-[10px] text-gray-500 font-medium">Credits $</span>
          <input type="number" step="0.01" min="0"
                 value="<%= Number(p.credits_balance || 0).toFixed(2) %>"
                 class="w-20 rounded border border-gray-300 px-2 py-1 text-xs font-mono text-right focus:ring-1 focus:ring-blue-500"
                 id="credits-input-<%= p.id %>" />
          <button type="button" onclick="setUserCredits(<%= p.id %>, this)"
                  class="px-2 py-1 text-xs font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded transition-colors">Set</button>
        </div>
        <% if (!p.is_admin) { %>
        <button type="button" onclick="deleteProfile(<%= p.id %>, '<%= p.email %>')"
                class="text-xs text-red-500 hover:text-red-700 hover:underline flex-shrink-0">Delete</button>
        <% } %>
        </div>
      </div>
      <% }); %>
    </div>
    <div class="flex items-center gap-2" id="create-profile-area">
      <input type="email" id="new-profile-email" placeholder="newuser@example.com"
             class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
      <button type="button" onclick="createProfile()"
              class="flex-shrink-0 inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 border border-blue-200 px-3 py-2 rounded-lg transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Add
      </button>
    </div>
    <p id="profiles-msg" class="text-xs mt-2 hidden"></p>
  </div>

  <!-- ATS Board Discovery -->
  <div class="bg-white rounded-xl border border-red-100 shadow-sm p-4 sm:p-6">
    <h2 class="text-base font-semibold text-gray-900 mb-1">ATS Board Discovery</h2>
    <p class="text-xs text-gray-500 mb-4">
      Discovers Greenhouse and Ashby boards via Common Crawl, and Lever companies via HuggingFace.
      Validates all boards <%= atsSchedules.validation.cadence %> to keep the list current.
    </p>

    <!-- Stats -->
    <div id="ats-stats" class="mb-5">
      <p class="text-xs text-gray-400">Loading…</p>
    </div>

    <!-- Live run log (shown while a manual run is active) -->
    <div id="ats-run-log" class="hidden mb-4">
      <div class="rounded-xl border border-gray-200 bg-gray-50 p-3">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <span id="ats-run-dot" class="w-2 h-2 rounded-full bg-blue-400 animate-pulse flex-shrink-0"></span>
            <span id="ats-run-title" class="text-xs font-medium text-gray-700">Running…</span>
          </div>
          <button id="ats-run-stop-btn" type="button" onclick="atsStopRun()"
                  class="px-2 py-1 text-xs font-medium text-red-600 hover:text-red-700 hover:bg-red-50 border border-red-200 rounded-lg transition-colors">
            Stop
          </button>
        </div>
        <div id="ats-run-progress" class="text-xs text-gray-400 mb-1.5 hidden"></div>
        <div id="ats-run-lines" class="text-xs font-mono text-gray-500 max-h-36 overflow-y-auto space-y-0.5"></div>
      </div>
    </div>

    <!-- Schedules -->
    <div class="divide-y divide-gray-100 border border-gray-200 rounded-xl overflow-hidden">

      <!-- Discovery row: Greenhouse & Ashby via CDX -->
      <div class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:justify-between px-4 py-3">
        <div class="flex items-center gap-3 min-w-0">
          <span id="ats-disc-dot" class="w-2 h-2 rounded-full bg-gray-300 flex-shrink-0 transition-colors"></span>
          <div>
            <div class="flex items-baseline gap-1.5">
              <span class="text-sm font-medium text-gray-800">Greenhouse &amp; Ashby</span>
              <span class="text-xs text-gray-400"><%= atsSchedules.discovery.cadence %></span>
            </div>
            <p class="text-xs text-gray-400 mt-0.5">via Common Crawl · <%= atsSchedules.discovery.when %> · <span id="ats-disc-tz"><%= settings.timezone || 'UTC' %></span></p>
          </div>
        </div>
        <div class="flex items-center justify-between gap-3 sm:justify-end sm:ml-4 flex-shrink-0">
          <button id="ats-discover-btn" type="button" onclick="atsRunDiscovery()"
                  class="w-28 whitespace-nowrap px-3 py-1.5 text-xs font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition-colors disabled:opacity-40">
            Start Now
          </button>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="ats-disc-toggle" class="sr-only peer" onchange="atsDiscToggle(this.checked)">
            <div class="w-9 h-5 bg-gray-200 rounded-full transition-colors peer peer-checked:bg-blue-500 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-transform peer-checked:after:translate-x-4"></div>
          </label>
        </div>
      </div>

      <!-- Discovery row: Lever via HuggingFace -->
      <div class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:justify-between px-4 py-3">
        <div class="flex items-center gap-3 min-w-0">
          <span id="ats-lever-disc-dot" class="w-2 h-2 rounded-full bg-gray-300 flex-shrink-0 transition-colors"></span>
          <div>
            <div class="flex items-baseline gap-1.5">
              <span class="text-sm font-medium text-gray-800">Lever</span>
              <span class="text-xs text-gray-400"><%= atsSchedules.lever.cadence %></span>
            </div>
            <p class="text-xs text-gray-400 mt-0.5">via HuggingFace · <%= atsSchedules.lever.when %> · <span id="ats-lever-disc-tz"><%= settings.timezone || 'UTC' %></span></p>
          </div>
        </div>
        <div class="flex items-center justify-between gap-3 sm:justify-end sm:ml-4 flex-shrink-0">
          <button id="ats-lever-discover-btn" type="button" onclick="atsRunLeverDiscovery()"
                  class="w-28 whitespace-nowrap px-3 py-1.5 text-xs font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition-colors disabled:opacity-40">
            Start Now
          </button>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="ats-lever-disc-toggle" class="sr-only peer" onchange="atsLeverDiscToggle(this.checked)">
            <div class="w-9 h-5 bg-gray-200 rounded-full transition-colors peer peer-checked:bg-blue-500 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-transform peer-checked:after:translate-x-4"></div>
          </label>
        </div>
      </div>

      <!-- Validation row -->
      <div class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:justify-between px-4 py-3">
        <div class="flex items-center gap-3 min-w-0">
          <span id="ats-val-dot" class="w-2 h-2 rounded-full bg-gray-300 flex-shrink-0 transition-colors"></span>
          <div>
            <div class="flex items-baseline gap-1.5">
              <span class="text-sm font-medium text-gray-800">Validation</span>
              <span class="text-xs text-gray-400"><%= atsSchedules.validation.cadence %></span>
            </div>
            <p class="text-xs text-gray-400 mt-0.5"><%= atsSchedules.validation.when %> · <span id="ats-val-tz"><%= settings.timezone || 'UTC' %></span></p>
          </div>
        </div>
        <div class="flex items-center justify-between gap-3 sm:justify-end sm:ml-4 flex-shrink-0">
          <button id="ats-validate-btn" type="button" onclick="atsRunValidation()"
                  class="w-28 whitespace-nowrap px-3 py-1.5 text-xs font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition-colors disabled:opacity-40">
            Start Now
          </button>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="ats-val-toggle" class="sr-only peer" onchange="atsValToggle(this.checked)">
            <div class="w-9 h-5 bg-gray-200 rounded-full transition-colors peer peer-checked:bg-blue-500 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-transform peer-checked:after:translate-x-4"></div>
          </label>
        </div>
      </div>

    </div><!-- end schedule rows -->
  </div><!-- end ATS card -->

  <!-- Job Pool — Greenhouse & Ashby -->
  <div class="bg-white rounded-xl border border-red-100 shadow-sm p-4 sm:p-6">
    <h2 class="text-base font-semibold text-gray-900 mb-1">Job Pool — Greenhouse &amp; Ashby</h2>
    <p class="text-xs text-gray-500 mb-4 leading-relaxed">
      Greenhouse and Ashby public APIs have no search filters — they return all open jobs for each company.
      Instead of querying thousands of companies on every run, jobs are pre-fetched here into a shared pool.
      When a profile run includes Greenhouse or Ashby it queries this pool locally and applies your keyword,
      location and date filters — no live API call happens during the run.
    </p>

    <!-- Pool counts -->
    <div id="pool-counts" class="space-y-2 mb-5">
      <p class="text-xs text-gray-400">Loading…</p>
    </div>

    <!-- Live fetch log -->
    <div id="pool-run-log" class="hidden mb-4">
      <div class="rounded-xl border border-gray-200 bg-gray-50 p-3">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <span id="pool-run-dot" class="w-2 h-2 rounded-full bg-blue-400 animate-pulse flex-shrink-0"></span>
            <span id="pool-run-title" class="text-xs font-medium text-gray-700">Running…</span>
          </div>
          <button id="pool-run-stop-btn" type="button" onclick="poolStopRun()"
                  class="px-2 py-1 text-xs font-medium text-red-600 hover:text-red-700 hover:bg-red-50 border border-red-200 rounded-lg transition-colors">
            Stop
          </button>
        </div>
        <div id="pool-run-progress" class="text-xs text-gray-400 mb-1.5 hidden"></div>
        <div id="pool-run-lines" class="text-xs font-mono text-gray-500 max-h-36 overflow-y-auto space-y-0.5"></div>
      </div>
    </div>

    <!-- Live resolution log (resolve / re-check — own panel so it can run alongside a fetch) -->
    <div id="resolve-run-log" class="hidden mb-4">
      <div class="rounded-xl border border-gray-200 bg-gray-50 p-3">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <span id="resolve-run-dot" class="w-2 h-2 rounded-full bg-blue-400 animate-pulse flex-shrink-0"></span>
            <span id="resolve-run-title" class="text-xs font-medium text-gray-700">Running…</span>
          </div>
          <button id="resolve-run-stop-btn" type="button" onclick="resolveStopRun()"
                  class="px-2 py-1 text-xs font-medium text-red-600 hover:text-red-700 hover:bg-red-50 border border-red-200 rounded-lg transition-colors">
            Stop
          </button>
        </div>
        <div id="resolve-run-progress" class="text-xs text-gray-400 mb-1.5 hidden"></div>
        <div id="resolve-run-lines" class="text-xs font-mono text-gray-500 max-h-36 overflow-y-auto space-y-0.5"></div>
      </div>
    </div>

    <!-- Schedule rows -->
    <div class="divide-y divide-gray-100 border border-gray-200 rounded-xl overflow-hidden">

      <!-- Greenhouse row -->
      <div class="flex flex-col items-stretch gap-2 sm:flex-row sm:items-center sm:justify-between px-4 py-3">
        <div class="flex items-center gap-3 min-w-0">
          <span id="pool-gh-dot" class="w-2 h-2 rounded-full bg-gray-300 flex-shrink-0 transition-colors"></span>
          <div>
            <div class="flex items-baseline gap-1.5">
              <span class="text-sm font-medium text-gray-800">Greenhouse</span>
              <span class="text-xs text-gray-400">daily</span>
            </div>
