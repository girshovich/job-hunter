<%
function fmtDate(iso) {
  return formatDateTimeToMinutes(iso, typeof timezone !== 'undefined' ? timezone : 'UTC');
}

function verdictChip(verdict) {
  return renderVerdictChip(verdict, { editable: isVerdictEditable(verdict), rounded: true });
}
%>

<%- renderPageHeader('Run Diff', 'Comparing the last 2 pipeline runs') %>

<% if (error) { %>
<div style="background:var(--red-soft);border:1px solid var(--red-border);border-radius:14px;padding:16px 20px;font-size:13.5px;color:var(--red-ink)"><%= error %></div>
<% } else { %>

<!-- Run summary -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
  <div style="background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px 20px;box-shadow:var(--shadow-card)">
    <p style="font-size:11px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);margin-bottom:4px">Newer run #<%= runNewer.id %></p>
    <p style="font-size:13.5px;font-weight:700;color:var(--ink)"><%= fmtDate(runNewer.ran_at) %></p>
    <% if (runNewer.scraping_provider) { %><p style="font-size:12px;color:var(--muted);margin-top:2px"><%= runNewer.scraping_provider %></p><% } %>
    <p style="font-size:12px;color:var(--faint);margin-top:4px"><%= onlyInNewer.length + inBoth.length %> unique jobs logged</p>
  </div>
  <div style="background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px 20px;box-shadow:var(--shadow-card)">
    <p style="font-size:11px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);margin-bottom:4px">Older run #<%= runOlder.id %></p>
    <p style="font-size:13.5px;font-weight:700;color:var(--ink)"><%= fmtDate(runOlder.ran_at) %></p>
    <% if (runOlder.scraping_provider) { %><p style="font-size:12px;color:var(--muted);margin-top:2px"><%= runOlder.scraping_provider %></p><% } %>
    <p style="font-size:12px;color:var(--faint);margin-top:4px"><%= onlyInOlder.length + inBoth.length %> unique jobs logged</p>
  </div>
</div>

<div class="space-y-3">

<%
function diffSection(title, count, note, pillStyle, jobsHtml) {
  return `<details class="group" style="background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow-card);overflow:hidden">
    <summary class="flex items-center justify-between cursor-pointer select-none list-none" style="padding:16px 20px">
      <div class="flex items-center gap-3">
        <svg class="transition-transform group-open:rotate-90" style="width:15px;height:15px;color:var(--fainter);flex-shrink:0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span style="font-size:14px;font-weight:700;color:var(--ink);white-space:nowrap">${title}</span>
        <span style="font-size:11.5px;font-weight:700;padding:1px 8px;border-radius:999px;${pillStyle}">${count}</span>
      </div>
      <span style="font-size:11.5px;color:var(--faint);white-space:nowrap">${note}</span>
    </summary>
    <div style="border-top:1px solid var(--line)">${jobsHtml}</div>
  </details>`;
}
%>
<!-- New this run -->
<%- diffSection('Only in new run', onlyInNewer.length, 'run #' + runNewer.id, 'background:var(--accent-soft);color:var(--accent)', jobTable(onlyInNewer)) %>

<!-- Seen in both -->
<%- diffSection('Seen in both', inBoth.length, 'verdict from run #' + runOlder.id, 'background:#eef1f6;color:var(--ink2)', jobTable(inBoth)) %>

<!-- Only in previous run -->
<%- diffSection('Only in previous run', onlyInOlder.length, 'run #' + runOlder.id, 'background:var(--amber-soft);color:var(--amber-ink)', jobTable(onlyInOlder)) %>

</div>
<% } %>

<%
function jobTable(jobs) {
  if (jobs.length === 0) {
    return '<p class="px-5 py-6 text-sm text-gray-400 text-center">No jobs.</p>';
  }

  let desktopRows = jobs.map(job => {
    const href = job.internal_job_id ? `/job/${job.internal_job_id}` : null;
    const chip = `<span onclick="showJobMenu(event,this)" data-internal-id="${escapeHtml(job.internal_job_id || '')}" data-url="${escapeHtml(job.url || '')}" data-log-id="${escapeHtml(job.id)}" data-verdict="${escapeHtml(job.ai_verdict)}" class="cursor-pointer">${verdictChip(job.ai_verdict)}</span>`;
    return `<tr class="${getJobTableRowClass()}">
      <td class="${getJobTableCellClass()} pl-5">${renderJobPositionCompanyCell(job.title, job.company, href, job.logo_url)}</td>
      <td class="${getJobTableCellClass()}">${renderLocationCell(job.location, job.country)}</td>
      <td class="${getJobTableCellClass('score')}">${renderScoreCell(job.ai_score, job.ai_verdict)}</td>
      <td class="${getJobTableCellClass('verdict')}">${chip}</td>
      <td class="${getJobTableCellClass('date')}">${renderDateTimeCell(job.logged_at, typeof timezone !== 'undefined' ? timezone : 'UTC')}</td>
      <td class="${getJobTableCellClass('source')}">${renderSourceLinkCell(job.url, job.job_source || 'LinkedIn')}</td>
    </tr>`;
  }).join('');

  let mobileCards = jobs.map(job => {
    const target = job.internal_job_id ? `/job/${job.internal_job_id}` : (job.url || null);
    const chip = `<span onclick="showJobMenu(event,this)" data-internal-id="${escapeHtml(job.internal_job_id || '')}" data-url="${escapeHtml(job.url || '')}" data-log-id="${escapeHtml(job.id)}" data-verdict="${escapeHtml(job.ai_verdict)}" class="cursor-pointer">${verdictChip(job.ai_verdict)}</span>`;
    const clickAttr = target ? ` onclick="location.href=${escapeHtml(JSON.stringify(target))}"` : '';
    return `<div class="${getJobMobileCardClass(target ? 'cursor-pointer' : '')}"${clickAttr}>
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <span class="job-identity-title text-sm font-semibold text-gray-900">${escapeHtml(job.title || 'Untitled role')}</span>
        </div>
        <div class="flex-shrink-0">${renderScoreCell(job.ai_score, job.ai_verdict)}</div>
      </div>
      <div class="mt-1 flex items-start justify-between gap-3">
        <span class="job-identity-meta text-xs text-gray-500">${renderCompanyLogo(job.company, job.logo_url)} ${escapeHtml(job.company || 'Unknown company')}</span>
        <div class="flex-shrink-0">${chip}</div>
      </div>
      <div class="mt-2">${renderLocationCell(job.location, job.country)}</div>
      <div class="mt-3 flex items-center justify-between gap-3">
        ${renderDateTimeCell(job.logged_at, typeof timezone !== 'undefined' ? timezone : 'UTC')}
        ${renderSourceLinkCell(job.url, job.job_source || 'LinkedIn')}
      </div>
    </div>`;
  }).join('');

  return `<table class="${getJobTableClass()}">
    ${renderJobsAllColgroup()}
    ${renderJobTableHeader('run-diff')}
    <tbody class="bg-white divide-y divide-gray-50">${desktopRows}</tbody>
  </table>
  <div class="${getJobMobileListClass()} p-3">${mobileCards}</div>`;
}
%>

<!-- Job context menu -->
<div id="job-menu" class="hidden fixed" style="z-index:50;background:#fff;border:1px solid #e4e6ec;border-radius:12px;box-shadow:0 12px 32px -8px rgba(16,24,40,.28);padding:6px;min-width:170px">
  <a id="job-menu-link" href="#" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2" style="padding:8px 9px;border-radius:8px;font-size:12.5px;font-weight:600;color:var(--ink2)" onmouseover="this.style.background='#f5f6f8'" onmouseout="this.style.background='transparent'">Open on LinkedIn</a>
  <div style="margin-top:4px;padding-top:5px;border-top:1px solid var(--line)">
    <p style="padding:4px 9px;font-size:11px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--faint)">Change verdict</p>
    <button onclick="menuSetVerdict('STRONG_MATCH')" class="w-full text-left flex items-center gap-2" style="padding:8px 9px;border-radius:8px;font-size:12.5px;font-weight:600;color:#067647" onmouseover="this.style.background='#ecfdf3'" onmouseout="this.style.background='transparent'">Strong</button>
    <button onclick="menuSetVerdict('WEAK_MATCH')" class="w-full text-left flex items-center gap-2" style="padding:8px 9px;border-radius:8px;font-size:12.5px;font-weight:600;color:#b54708" onmouseover="this.style.background='#fffaeb'" onmouseout="this.style.background='transparent'">Weak</button>
    <button onclick="menuSetVerdict('NO_MATCH')" class="w-full text-left flex items-center gap-2" style="padding:8px 9px;border-radius:8px;font-size:12.5px;font-weight:600;color:#b42318" onmouseover="this.style.background='#fef3f2'" onmouseout="this.style.background='transparent'">No match</button>
  </div>
</div>

<script>
let _menuTargetEl = null;

function showJobMenu(event, el) {
  event.stopPropagation();
  _menuTargetEl = el;
  const url = el.dataset.url;
  const menu = document.getElementById('job-menu');
  const extLink = document.getElementById('job-menu-link');

  if (url) {
    extLink.href = url;
    extLink.classList.remove('hidden');
  } else {
    extLink.classList.add('hidden');
  }

  const rect = el.getBoundingClientRect();
  menu.style.top = (rect.bottom + 4) + 'px';
  menu.style.left = Math.min(rect.left, window.innerWidth - 172) + 'px';
  menu.classList.remove('hidden');
}

function verdictChipStatic(verdict) {
  const label = window.JHUI.formatVerdictLabel(verdict) + (window.JHUI.isVerdictEditable(verdict) ? ' ▾' : '');
  return '<span style="display:inline-flex;align-items:center;gap:3px;height:22px;padding:0 8px;border-radius:7px;font-size:11.5px;font-weight:700;white-space:nowrap;' + window.JHUI.getVerdictChipStyle(verdict) + '">' + label + '</span>';
}

async function menuSetVerdict(newVerdict) {
  const el = _menuTargetEl;
  if (!el) return;
  document.getElementById('job-menu').classList.add('hidden');

  const current = el.dataset.verdict;
  if (newVerdict === current) return;

  if (!confirm('Change verdict to "' + window.JHUI.formatVerdictLabel(newVerdict) + '"?')) return;

  const internalId = el.dataset.internalId;
  const logId = el.dataset.logId;
  const endpoint = internalId
    ? '/api/jobs/' + internalId + '/verdict'
    : '/api/run-log/' + logId + '/verdict';

  try {
    const res = await fetch(endpoint, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ verdict: newVerdict }),
    });
    const data = await res.json();
    if (data.success) {
      el.dataset.verdict = newVerdict;
      if (data.internal_job_id && !internalId) {
        el.dataset.internalId = String(data.internal_job_id);
      }
      el.innerHTML = verdictChipStatic(newVerdict);
    } else {
      alert(data.error || 'Failed to update verdict');
    }
  } catch (e) {
    alert('Could not reach the server.');
  }
}

document.addEventListener('click', () => {
  document.getElementById('job-menu').classList.add('hidden');
});
</script>
