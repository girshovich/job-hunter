<%- include('partials/_stg-styles') %>
<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="stg-h1">Unresolved Locations</h1>
    <p class="stg-sub">
      Cached unknown pool locations — <span style="color:var(--ink2);font-weight:700"><%= total.toLocaleString() %></span> total
    </p>
  </div>
  <a href="/admin?tab=locations" class="stg-btn stg-btn-ghost stg-btn-sm">Back to Admin</a>
</div>

<div class="jh-card overflow-hidden">
  <div class="px-5 py-4" style="border-bottom:1px solid var(--line)">
    <form method="GET" action="/admin/unresolved-locations" class="flex gap-2 items-center">
      <input type="text" name="q" value="<%= q %>" placeholder="Filter locations"
             class="stg-ctl" style="max-width:24rem">
      <button type="submit" class="stg-btn stg-btn-secondary stg-btn-sm">Filter</button>
      <% if (q) { %>
        <a href="/admin/unresolved-locations" class="stg-btn stg-btn-ghost stg-btn-sm">Clear</a>
      <% } %>
    </form>
  </div>

  <% if (locations.length === 0) { %>
    <%- renderEmptyState('No cached unknown locations found.') %>
  <% } else { %>
    <table class="stg-tbl">
      <thead>
        <tr>
          <th>Location</th>
          <th class="w-24">Jobs</th>
          <th class="w-36">Providers</th>
          <th>Examples</th>
          <th class="w-40">Last Checked</th>
        </tr>
      </thead>
      <tbody>
        <% locations.forEach(row => { %>
          <tr class="hover:bg-gray-50/70">
            <td class="align-top">
              <div class="font-semibold break-words" style="color:var(--ink)"><%= row.location %></div>
            </td>
            <td class="align-top font-semibold" style="color:var(--ink2)"><%= row.job_count.toLocaleString() %></td>
            <td class="align-top">
              <div class="flex flex-wrap gap-1">
                <% String(row.providers || '').split(',').filter(Boolean).forEach(provider => { %>
                  <span class="stg-chip-c" style="font-size:11px;padding:2px 8px"><%= provider %></span>
                <% }) %>
              </div>
            </td>
            <td class="align-top">
              <div class="space-y-1">
                <% row.examples.forEach(ex => { %>
                  <div style="color:var(--muted)">
                    <span class="font-semibold" style="color:var(--ink2)"><%= ex.company %></span>
                    <span style="color:var(--faintest)">·</span>
                    <span><%= ex.title %></span>
                  </div>
                <% }) %>
              </div>
            </td>
            <td class="align-top" style="color:var(--faint)">
              <%= row.last_checked ? new Date(row.last_checked).toLocaleString() : '—' %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<% if (pageCount > 1) { %>
  <div class="flex items-center justify-between mt-5">
    <div class="text-xs" style="color:var(--faint)">
      Page <%= page %> of <%= pageCount %>
    </div>
    <div class="flex gap-2">
      <% if (page > 1) { %>
        <a href="/admin/unresolved-locations?page=<%= page - 1 %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
           class="stg-btn stg-btn-ghost stg-btn-sm">Previous</a>
      <% } %>
      <% if (page < pageCount) { %>
        <a href="/admin/unresolved-locations?page=<%= page + 1 %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
           class="stg-btn stg-btn-ghost stg-btn-sm">Next</a>
      <% } %>
    </div>
  </div>
<% } %>
