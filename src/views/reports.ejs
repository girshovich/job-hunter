<%
// ── Server-side helpers ──
function runProviderName(run) {
  return run.scraping_provider ? formatSourceName(run.scraping_provider) : 'Unknown provider';
}

// DS v2 run-status pill (local — the shared getRunStatusTone stays on its Tailwind form for
// other pages until their phases). bg/color per DS §1.1 tokens.
const RUN_STATUS_PILL = {
  success:       { bg: 'var(--green-soft)', color: 'var(--green2)' },
  partial_error: { bg: 'var(--amber-soft)', color: 'var(--amber-ink)' },
  running:       { bg: 'var(--accent-soft)', color: 'var(--accent)' },
  stopped:       { bg: '#f2f4f7', color: '#5b6472' },
  error:         { bg: 'var(--red-soft)', color: 'var(--red-ink)' },
};
function statusPill(status) {
  const t = RUN_STATUS_PILL[String(status || '').toLowerCase()] || RUN_STATUS_PILL.error;
  return '<span style="display:inline-flex;align-items:center;justify-content:center;gap:5px;height:22px;min-width:84px;padding:0 9px;border-radius:999px;font-size:11px;font-weight:800;white-space:nowrap;background:' + t.bg + ';color:' + t.color + '">'
    + '<span style="width:6px;height:6px;border-radius:50%;background:currentColor"></span>'
    + escapeHtml(formatRunStatusLabel(status)) + '</span>';
}

const anyFilterActive = !!(filterSource || filterVerdict || filterCompany);
%>

<!-- ── Page header ── -->
<div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:18px">
  <div>
    <h1 style="margin:0;font-size:24px;font-weight:800;letter-spacing:-.02em;color:var(--ink)">Run Logs</h1>
    <p style="margin:6px 0 0;font-size:13px;color:var(--faint);font-weight:600">Full audit log of every pipeline run — showing last <%= runs.length %> run<%= runs.length !== 1 ? 's' : '' %></p>
  </div>
  <a href="/run-diff" style="display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:var(--accent)">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 7h11M8 7l3-3M8 7l3 3M16 17H5M16 17l-3-3M16 17l-3 3"/></svg>
    Compare last 2 runs
  </a>
</div>

<!-- ── Filter bar (server-rendered; Source & Verdict single-select, Company search) ── -->
<form id="rl-filter" method="get" action="/reports" style="background:#fff;border:1px solid #e9ebf1;border-radius:14px;padding:14px 16px;box-shadow:0 1px 2px rgba(16,24,40,.03);display:flex;gap:16px;flex-wrap:wrap;align-items:flex-end;margin-bottom:18px">
  <div style="display:flex;flex-direction:column;gap:6px;min-width:150px">
    <label style="font-size:11px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:var(--fainter)">Source</label>
    <div style="position:relative">
      <select name="source" onchange="this.form.submit()" style="width:100%;height:38px;padding:0 32px 0 12px;border:1px solid #e2e5ec;border-radius:10px;background:#fbfcfe;font-size:13px;font-weight:600;color:var(--ink);cursor:pointer;outline:none;appearance:none;-webkit-appearance:none">
        <option value="">All sources</option>
        <% sourceOptions.forEach(function(s){ %>
        <option value="<%= s.value %>" <%= filterSource === s.value ? 'selected' : '' %>><%= s.label %></option>
        <% }); %>
      </select>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#9aa1ad" stroke-width="2.2" stroke-linecap="round" style="position:absolute;right:11px;top:13px;pointer-events:none"><path d="m6 9 6 6 6-6"/></svg>
    </div>
  </div>
  <div style="display:flex;flex-direction:column;gap:6px;min-width:150px">
    <label style="font-size:11px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:var(--fainter)">Verdict in log</label>
    <div style="position:relative">
      <select name="verdict" onchange="this.form.submit()" style="width:100%;height:38px;padding:0 32px 0 12px;border:1px solid #e2e5ec;border-radius:10px;background:#fbfcfe;font-size:13px;font-weight:600;color:var(--ink);cursor:pointer;outline:none;appearance:none;-webkit-appearance:none">
        <% const vOpts = [['','All verdicts'],['STRONG_MATCH','Strong match'],['WEAK_MATCH','Weak match'],['NO_MATCH','No match'],['DUPLICATE','Duplicate'],['FILTERED','Filtered'],['BLACKLISTED','Blacklisted']]; %>
        <% vOpts.forEach(function(o){ %>
        <option value="<%= o[0] %>" <%= filterVerdict === o[0] ? 'selected' : '' %>><%= o[1] %></option>
        <% }); %>
      </select>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#9aa1ad" stroke-width="2.2" stroke-linecap="round" style="position:absolute;right:11px;top:13px;pointer-events:none"><path d="m6 9 6 6 6-6"/></svg>
    </div>
  </div>
  <div style="display:flex;flex-direction:column;gap:6px;flex:1;min-width:190px">
    <label style="font-size:11px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:var(--fainter)">Company</label>
    <div style="display:flex;align-items:center;gap:8px;height:38px;padding:0 11px;background:#fbfcfe;border:1px solid #e2e5ec;border-radius:10px">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9aa1ad" stroke-width="1.9" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
      <input name="company" value="<%= filterCompany %>" placeholder="Search company…" style="flex:1;min-width:0;border:none;outline:none;background:transparent;font-size:13px;font-weight:600;color:var(--ink)">
      <% if (filterCompany) { %><button type="button" onclick="this.form.company.value='';this.form.submit()" title="Clear" style="border:none;background:none;color:var(--fainter);cursor:pointer;font-size:16px;line-height:1;padding:0">×</button><% } %>
    </div>
  </div>
  <% if (anyFilterActive) { %>
  <a href="/reports" style="height:38px;display:inline-flex;align-items:center;padding:0 14px;border:1px solid #e5e7ee;border-radius:10px;font-size:12.5px;font-weight:700;color:var(--accent);background:#fff">Clear</a>
  <% } %>
</form>

<% if (runs.length === 0) { %>
  <% if (anyFilterActive) { %>
  <div style="background:#fff;border:1px solid var(--line);border-radius:16px;padding:48px 20px;text-align:center;box-shadow:var(--shadow-card)">
    <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#d4d8e0" stroke-width="1.5" stroke-linecap="round" style="margin:0 auto 12px"><path d="M3 4h18M7 12h10M10 20h4"/></svg>
    <p style="margin:0;font-size:13.5px;font-weight:600;color:var(--faint)">No runs match these filters</p>
    <a href="/reports" style="display:inline-flex;align-items:center;margin-top:14px;height:34px;padding:0 14px;border:1px solid #e5e7ee;border-radius:9px;color:var(--accent);font-size:12.5px;font-weight:700">Clear all filters</a>
  </div>
  <% } else { %>
  <%- renderEmptyState('No pipeline runs yet. Run the pipeline from the Dashboard to see results here.', 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2') %>
  <% } %>
<% } else { %>

<div class="rl-runs" style="display:flex;flex-direction:column;gap:12px">
<% runs.forEach(function(run){ %>
<%
  const totalCost = (run.cost_openai_usd == null && run.cost_apify_usd == null) ? null : (run.cost_openai_usd ?? 0) + (run.cost_apify_usd ?? 0);
  const jobsJson = JSON.stringify(run.jobs).replace(/</g, '\\u003c');
%>
<details class="rl-card" data-run-id="<%= run.id %>" data-run-date="<%= run.ran_at_date %> · <%= run.ran_at_time %>" <%= run.preloaded ? 'data-preloaded' : '' %>
         style="background:#fff;border:1px solid #e9ebf1;border-radius:14px;box-shadow:0 1px 3px rgba(16,24,40,.04);overflow:hidden">
  <summary style="display:flex;align-items:center;gap:12px;padding:14px 18px;cursor:pointer;user-select:none;list-style:none">
    <svg class="rl-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#aeb4bf" stroke-width="2.6" stroke-linecap="round" style="flex:none;transition:transform .15s"><path d="M9 5l7 7-7 7"/></svg>
    <div style="min-width:0;flex:1;display:flex;align-items:center;gap:9px;flex-wrap:wrap">
      <span style="font-size:13.5px;font-weight:800;white-space:nowrap;color:var(--ink)"><%= run.ran_at_date %></span>
      <span style="font-size:12.5px;color:var(--faint);font-weight:600;white-space:nowrap"><%= run.ran_at_time %></span>
      <%- statusPill(run.status) %>
      <% if (run.trigger === 'manual') { %><span title="Started manually" style="display:inline-flex;align-items:center;justify-content:center;height:20px;min-width:20px;padding:0 5px;border-radius:6px;background:#eef2ff;color:var(--accent);font-size:11px;font-weight:800">M</span><% } %>
      <span style="width:1px;height:13px;background:#e2e5ea"></span>
      <span style="font-size:12.5px;font-weight:600;color:var(--muted);white-space:nowrap"><%= runProviderName(run) %></span>
    </div>
    <div style="flex:none;display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:flex-end">
      <span style="font-size:12px;color:var(--faint);font-weight:600;white-space:nowrap"><span style="font-weight:800;color:var(--ink2)"><%= run.jobs_fetched %></span> fetched</span>
      <%- renderRunStatusCounts(run) %>
      <span class="rl-cost-trigger" onclick="toggleCostPopup('<%= run.id %>', this, event)" title="View cost breakdown" style="display:inline-flex;align-items:center;height:22px;padding:0 9px;border-radius:7px;font-size:11.5px;font-weight:800;font-variant-numeric:tabular-nums;background:#f4f5f8;color:var(--muted);white-space:nowrap;cursor:pointer;text-decoration:underline dotted;text-decoration-color:#b4b9c4;text-underline-offset:3px"><%= formatRunCost(totalCost) %></span>
    </div>
  </summary>

  <!-- cost breakdown popup -->
  <div id="cost-popup-<%= run.id %>" class="hidden" style="position:fixed;z-index:70;background:#fff;border:1px solid var(--line2);border-radius:12px;box-shadow:0 12px 32px -8px rgba(16,24,40,.28);padding:12px;font-size:12px;min-width:180px">
    <% if (run.job_source || run.scraping_provider) { %>
    <div style="display:flex;justify-content:space-between;gap:24px;color:var(--muted);padding-bottom:6px;margin-bottom:6px;border-bottom:1px solid #f2f3f6">
      <span>Source</span>
      <span style="font-weight:600;color:var(--ink2)"><%= formatSourceLabel(run.job_source || run.scraping_provider) %></span>
    </div>
    <div style="display:flex;justify-content:space-between;gap:24px;color:var(--muted);padding-bottom:6px;margin-bottom:6px;border-bottom:1px solid #f2f3f6">
      <span>Provider</span>
      <span style="font-weight:600;color:var(--ink2)"><%= run.scraping_provider ? formatSourceLabel(run.scraping_provider) : '—' %></span>
    </div>
    <% } %>
    <div style="display:flex;justify-content:space-between;gap:24px;padding-bottom:6px;margin-bottom:6px;border-bottom:1px solid #f2f3f6">
      <span style="font-weight:700;color:var(--ink2)">Total</span>
      <span style="font-weight:800;color:var(--ink)"><%= formatRunCost(totalCost) %></span>
    </div>
    <% if (run.cost_apify_usd != null) { %>
    <div style="display:flex;justify-content:space-between;gap:24px;color:var(--muted)"><span>Fetch</span><span style="font-weight:600;color:var(--ink)"><%= formatRunCost(run.cost_apify_usd) %></span></div>
    <% } %>
    <% if (run.cost_openai_usd != null) { %>
    <div style="display:flex;justify-content:space-between;gap:24px;color:var(--muted);margin-top:6px"><span>AI</span><span style="font-weight:600;color:var(--ink)"><%= formatRunCost(run.cost_openai_usd) %></span></div>
    <% } %>
  </div>

  <!-- expanded -->
  <div style="border-top:1px solid #eef0f4">
    <% if (run.error_log) { %>
    <div style="padding:11px 20px;background:var(--red-soft);border-bottom:1px solid #fbdcd9;display:flex;gap:9px;align-items:flex-start">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2" stroke-linecap="round" style="flex:none;margin-top:1px"><path d="M12 9v4M12 17h.01M10.3 3.9 2 18a2 2 0 0 0 1.7 3h16.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
      <div style="font-size:12px;line-height:1.5;color:var(--red-ink);font-weight:600;white-space:pre-wrap"><%= run.error_log %></div>
    </div>
    <% } %>

    <div class="run-jobs-container" data-run-id="<%= run.id %>"><% if (run.preloaded) { %><script type="application/json" class="rl-jobs-json"><%- jobsJson %></script><% } %></div>

    <div style="padding:10px 20px;border-top:1px solid #eef0f4;display:flex;align-items:center;justify-content:space-between;font-size:11.5px;color:var(--faintest);font-weight:600">
      <span>Run #<%= run.id %></span>
      <% if (run.duration_ms) { %><span><%= (run.duration_ms / 1000).toFixed(1) %>s</span><% } %>
    </div>
  </div>
</details>
<% }); %>
</div>
<% } %>

<!-- ── Job detail slide-in drawer (desktop; mobile taps → /job/:id) ── -->
<div id="rl-drawer" class="hidden">
  <div id="rl-drawer-backdrop" style="position:absolute;inset:0;background:rgba(19,23,34,.4)"></div>
  <aside id="rl-drawer-panel" class="jh-scroll" style="position:relative;width:min(620px,94vw);height:100%;background:#f6f5f3;box-shadow:-16px 0 44px -14px rgba(16,24,40,.4);overflow-y:auto">
    <div style="position:sticky;top:0;z-index:2;display:flex;align-items:center;gap:12px;padding:13px 18px;background:rgba(246,245,243,.9);backdrop-filter:blur(8px);border-bottom:1px solid #e7e6e2">
      <div style="display:inline-flex;align-items:center;gap:7px;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--fainter)">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
        <span id="rl-drawer-label">Job details</span>
      </div>
      <span style="flex:1"></span>
      <button id="rl-drawer-close" title="Close (Esc)" style="flex:none;width:32px;height:32px;display:grid;place-items:center;border:1px solid #e2e5ea;border-radius:9px;background:#fff;color:var(--muted);cursor:pointer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6l-12 12"/></svg>
      </button>
    </div>
    <div id="rl-drawer-body"></div>
  </aside>
</div>

<style>
  .rl-card > summary::-webkit-details-marker { display: none; }
  .rl-card > summary::marker { content: ''; }
  .rl-card[open] .rl-chev { transform: rotate(90deg); }
  .rl-row:hover { background: #fafbfe; }
  .rl-desktop { display: block; }
  .rl-mobile { display: none; }
  @media (max-width: 767px) { .rl-desktop { display: none; } .rl-mobile { display: flex; } }
  /* z-index 40 keeps the drawer below the shared overlays it hosts — the verdict/applied
     dropdowns (z-50) and the confirm/alert modals (z-[60]) must open ON TOP of it. */
  #rl-drawer { position: fixed; inset: 0; z-index: 40; display: flex; justify-content: flex-end; }
  #rl-drawer.hidden { display: none; }
  #rl-drawer:not(.hidden) #rl-drawer-backdrop { animation: jhfade .18s ease; }
  #rl-drawer:not(.hidden) #rl-drawer-panel { animation: jhslide .22s ease; }
  @keyframes jhslide { from { transform: translateX(24px); opacity: .4 } to { transform: translateX(0); opacity: 1 } }
  @keyframes jhfade { from { opacity: 0 } to { opacity: 1 } }
  .rl-ell { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>

<script>
// ── Config from server ──
const RL_ROW_FILTER = <%- JSON.stringify({ verdict: filterVerdict || '', company: filterCompany || '' }) %>;
const RL_GRID = 'minmax(220px,1fr) 150px 60px 122px 100px 84px';

function escHtml(str) {
  return String(str == null ? '' : str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function logVerdictChip(verdict, editable) {
  const canEdit = editable === undefined ? window.JHUI.isVerdictEditable(verdict) : editable;
  const label = window.JHUI.formatVerdictLabel(verdict) + (canEdit ? ' ▾' : '');
  return '<span style="display:inline-flex;align-items:center;gap:3px;height:22px;padding:0 8px;border-radius:7px;font-size:11.5px;font-weight:700;white-space:nowrap;' + window.JHUI.getVerdictChipStyle(verdict) + '">' + label + '</span>';
}

function scoreChip(score, verdict) {
  return '<span style="display:inline-flex;align-items:center;justify-content:center;min-width:34px;height:23px;padding:0 8px;border-radius:7px;font-size:12px;font-weight:800;font-variant-numeric:tabular-nums;' + window.JHUI.getVerdictChipStyle(verdict) + '">' + window.JHUI.formatScore(score) + '</span>';
}

function sourceLink(url) {
  return url
    ? '<a href="' + escHtml(url) + '" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()" title="Open posting" style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:8px;color:var(--accent)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg></a>'
    : '<span style="color:#c9cdd6;font-size:13px">—</span>';
}

function companyLogo(company) {
  const letter = escHtml(String(company || 'U').charAt(0).toUpperCase());
  return '<div style="width:30px;height:30px;flex:none;border-radius:8px;background:#eef1f6;display:grid;place-items:center;color:var(--muted);font-weight:800;font-size:12px">' + letter + '</div>';
}

// ── Build a run's jobs block (desktop grid + mobile cards) ──
function buildJobsHTML(jobs) {
  if (!jobs || jobs.length === 0) {
    return '<div style="padding:34px 20px;text-align:center;font-size:13px;color:var(--faint);font-weight:600">No job logs for this run.</div>';
  }

  const headCell = function(label, right) {
    return '<div style="font-size:11px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--fainter)' + (right ? ';text-align:right' : '') + '">' + label + '</div>';
  };
  let desktop = '<div class="jh-scroll" style="overflow-x:auto"><div style="min-width:806px">'
    + '<div style="display:grid;grid-template-columns:' + RL_GRID + ';align-items:center;gap:14px;padding:10px 20px;background:#fafbfd;border-bottom:1px solid #eef0f4">'
    + headCell('Position') + headCell('Location') + headCell('Score') + headCell('Verdict') + headCell('Logged') + headCell('Source', true)
    + '</div>';

  let mobile = '<div class="rl-mobile" style="flex-direction:column">';

  jobs.forEach(function(job) {
    const owned = !!job.internal_job_id;
    const flag = job.flag ? '<span style="flex:none">' + job.flag + '</span>' : '';
    const loc = job.location
      ? '<div style="display:flex;align-items:center;gap:6px;min-width:0;font-size:12.5px;font-weight:600;color:var(--muted)">' + flag + '<span class="rl-ell">' + escHtml(job.location) + '</span></div>'
      : '<span style="font-size:12.5px;color:#c9cdd6">—</span>';
    const verdictCell = owned
      ? '<button class="verdict-btn" data-job-id="' + job.internal_job_id + '" data-log-id="' + job.id + '" data-verdict="' + escHtml(job.ai_verdict) + '" data-chip-style="compact" style="background:none;border:none;padding:0;cursor:pointer">' + logVerdictChip(job.ai_verdict) + '</button>'
      : logVerdictChip(job.ai_verdict, false);

    // Desktop grid row
    desktop += '<div class="rl-row" data-job-id="' + (owned ? job.internal_job_id : '') + '"'
      + (owned ? ' onclick="rlRowClick(event, this)"' : '')
      + ' style="display:grid;grid-template-columns:' + RL_GRID + ';align-items:center;gap:14px;padding:11px 20px;border-bottom:1px solid #f2f3f6;' + (owned ? 'cursor:pointer' : '') + '">'
      + '<div style="display:flex;align-items:center;gap:11px;min-width:0">' + companyLogo(job.company)
      + '<div style="min-width:0"><div class="rl-ell" style="font-size:13.5px;font-weight:700;color:var(--ink)" title="' + escHtml(job.title) + '">' + escHtml(job.title) + '</div>'
      + '<div class="rl-ell" style="font-size:12px;font-weight:600;color:var(--faint);margin-top:2px">' + escHtml(job.company || 'Unknown company') + '</div></div></div>'
      + loc
      + '<div>' + scoreChip(job.ai_score, job.ai_verdict) + '</div>'
      + '<div>' + verdictCell + '</div>'
      + '<div style="font-size:12px;font-weight:600;color:var(--faint)">' + escHtml(((job.logged_date || '') + ' ' + (job.logged_time || '')).trim() || '—') + '</div>'
      + '<div style="text-align:right">' + sourceLink(job.apply_url || job.url) + '</div>'
      + '</div>';

    // Mobile card (tap → /job/:id for owned)
    mobile += '<div class="rl-mrow"' + (owned ? ' data-href="/job/' + job.internal_job_id + '" onclick="if(event.target.closest(&quot;.verdict-btn&quot;)||event.target.closest(&quot;a&quot;))return;location.href=this.dataset.href"' : '')
      + ' style="padding:12px 16px;border-bottom:1px solid #f2f3f6;' + (owned ? 'cursor:pointer' : '') + '">'
      + '<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px"><span style="font-size:13.5px;font-weight:700;color:var(--ink)">' + escHtml(job.title) + '</span>' + scoreChip(job.ai_score, job.ai_verdict) + '</div>'
      + '<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:6px"><span style="font-size:12px;font-weight:600;color:var(--faint)">' + escHtml(job.company || 'Unknown company') + '</span>' + verdictCell + '</div>'
      + '<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:8px"><div style="min-width:0">' + loc + '</div>' + sourceLink(job.apply_url || job.url) + '</div>'
      + '</div>';
  });

  desktop += '</div></div>';
  mobile += '</div>';
  return '<div class="rl-desktop">' + desktop + '</div>' + mobile;
}

// ── Preloaded runs: build from embedded JSON. Lazy runs: fetch on first expand. ──
function rlRowFilterQS() {
  const p = new URLSearchParams();
  if (RL_ROW_FILTER.verdict) p.set('verdict', RL_ROW_FILTER.verdict);
  if (RL_ROW_FILTER.company) p.set('company', RL_ROW_FILTER.company);
  const s = p.toString();
  return s ? '?' + s : '';
}

document.querySelectorAll('.run-jobs-container').forEach(function(container) {
  const dataEl = container.querySelector('.rl-jobs-json');
  if (dataEl) {
    try { container.innerHTML = buildJobsHTML(JSON.parse(dataEl.textContent)); }
    catch (_) { container.innerHTML = '<div style="padding:20px;text-align:center;color:var(--red-ink);font-size:13px">Failed to render logs.</div>'; }
  }
});

document.querySelectorAll('details[data-run-id]:not([data-preloaded])').forEach(function(details) {
  details.addEventListener('toggle', async function() {
    if (!this.open || this.dataset.loaded) return;
    this.dataset.loaded = '1';
    const container = this.querySelector('.run-jobs-container');
    if (!container) return;
    container.innerHTML = '<div style="padding:34px 20px;text-align:center;font-size:13px;color:var(--faint);font-weight:600">Loading…</div>';
    try {
      const res = await fetch('/reports/runs/' + this.dataset.runId + '/logs' + rlRowFilterQS());
      const data = await res.json();
      container.innerHTML = buildJobsHTML(data.jobs);
    } catch (_) {
      container.innerHTML = '<div style="padding:34px 20px;text-align:center;font-size:13px;color:var(--red-ink);font-weight:600">Failed to load logs.</div>';
    }
  });
});

// ── Slide-in drawer ──
function rlRowClick(event, el) {
  if (event.target.closest('.verdict-btn') || event.target.closest('a')) return;
  const jobId = el.dataset.jobId;
  if (!jobId) return;
  if (window.innerWidth < 768) { location.href = '/job/' + jobId; return; }
  openDrawer(jobId, el);
}

function runInjectedScripts(container) {
  container.querySelectorAll('script').forEach(function(old) {
    const s = document.createElement('script');
    if (old.src) s.src = old.src; else s.textContent = old.textContent;
    old.replaceWith(s);
  });
}

async function openDrawer(jobId, rowEl) {
  const drawer = document.getElementById('rl-drawer');
  const body = document.getElementById('rl-drawer-body');
  const label = document.getElementById('rl-drawer-label');
  const details = rowEl ? rowEl.closest('details') : null;
  label.textContent = details ? ('Run · ' + details.dataset.runDate) : 'Job details';
  body.innerHTML = '<div style="padding:48px 20px;text-align:center;color:var(--faint);font-size:13px;font-weight:600">Loading…</div>';
  drawer.classList.remove('hidden');
  document.body.style.overflow = 'hidden';
  document.getElementById('rl-drawer-panel').scrollTop = 0;
  try {
    const res = await fetch('/reports/job/' + jobId + '/detail');
    if (!res.ok) throw new Error('bad');
    body.innerHTML = await res.text();
    runInjectedScripts(body);
  } catch (_) {
    body.innerHTML = '<div style="padding:48px 20px;text-align:center;color:var(--red-ink);font-size:13px;font-weight:600">Failed to load this job.</div>';
  }
}

function closeDrawer() {
  const drawer = document.getElementById('rl-drawer');
  drawer.classList.add('hidden');
  document.getElementById('rl-drawer-body').innerHTML = '';
  document.body.style.overflow = '';
}

document.getElementById('rl-drawer-close').addEventListener('click', closeDrawer);
document.getElementById('rl-drawer-backdrop').addEventListener('click', closeDrawer);
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape' && !document.getElementById('rl-drawer').classList.contains('hidden')) closeDrawer();
});

// ── Cost popups ──
function toggleCostPopup(runId, btn, event) {
  if (event) { event.stopPropagation(); event.preventDefault(); }
  const popup = document.getElementById('cost-popup-' + runId);
  if (!popup || !btn) return;
  const isHidden = popup.classList.contains('hidden');
  document.querySelectorAll('[id^="cost-popup-"]').forEach(function(el) { el.classList.add('hidden'); });
  if (isHidden) {
    const rect = btn.getBoundingClientRect();
    popup.style.top = (rect.bottom + 4) + 'px';
    popup.style.right = (window.innerWidth - rect.right) + 'px';
    popup.classList.remove('hidden');
  }
}

document.addEventListener('click', function(e) {
  if (e.target.closest('.rl-cost-trigger')) return;
  document.querySelectorAll('[id^="cost-popup-"]').forEach(function(el) { el.classList.add('hidden'); });
});
</script>
