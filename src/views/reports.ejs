<%
// Server-side helpers

function verdictChip(verdict, rejectionCategory) {
  return renderVerdictChip(verdict, { editable: isVerdictEditable(verdict) });
}

function statusBadge(status) {
  if (status === 'success')       return 'bg-emerald-50 text-emerald-700';
  if (status === 'partial_error') return 'bg-yellow-50 text-yellow-700';
  if (status === 'running')       return 'bg-blue-50 text-blue-700';
  return 'bg-red-50 text-red-600';
}

function statusLabel(status) {
  if (status === 'partial_error') return 'partial error';
  return status;
}

function scoreClass(score) {
  if (score == null) return 'text-gray-400';
  return score >= 71 ? 'text-emerald-600 font-semibold' : score >= 51 ? 'text-yellow-600 font-semibold' : 'text-red-500';
}

function runJobDetailHref(job) {
  return job.internal_job_id ? `/job/${job.internal_job_id}` : '';
}

function runSourceName(run) {
  return formatSourceName(run.job_source || (run.scraping_provider === 'indeed' ? 'Indeed' : run.scraping_provider === 'stepstone' ? 'StepStone' : run.scraping_provider === 'greenhouse' ? 'Greenhouse' : run.scraping_provider === 'ashby' ? 'Ashby' : 'LinkedIn'));
}

function runProviderName(run) {
  return run.scraping_provider ? formatSourceLabel(run.scraping_provider) : 'Unknown provider';
}
%>

<!-- Page header -->
<div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Run Logs</h1>
    <p class="text-sm text-gray-500 mt-1">Full audit log of every pipeline run — showing last <%= runs.length %> run<%= runs.length !== 1 ? 's' : '' %></p>
  </div>
  <div class="flex items-center gap-4">
    <a href="/run-diff" class="text-sm font-medium text-blue-600 hover:text-blue-800 hover:underline">Compare last 2 runs</a>
    <label class="flex items-center gap-2 cursor-pointer flex-shrink-0">
      <span class="text-xs text-gray-500">Split by location</span>
      <input type="checkbox" id="location-split-checkbox" onchange="toggleLocationSplit(this.checked)" class="sr-only peer" />
      <div class="relative w-9 h-5 bg-gray-300 peer-checked:bg-blue-500 rounded-full transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-4"></div>
    </label>
  </div>
</div>

<% if (runs.length === 0) { %>
<div class="bg-white rounded-xl border border-gray-200 shadow-sm p-12 text-center">
  <svg class="w-10 h-10 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
  </svg>
  <p class="text-sm text-gray-500">No pipeline runs yet. Run the pipeline from the Dashboard to see results here.</p>
</div>
<% } else { %>

<div class="space-y-3">
<% runs.forEach(run => { %>

<details class="group bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden"
         data-run-id="<%= run.id %>"
         <%= run.preloaded ? 'data-preloaded' : '' %>>

  <summary class="flex items-start gap-3 px-5 py-3 cursor-pointer select-none list-none hover:bg-gray-50 transition-colors">
    <div class="flex-shrink-0 pt-1">
      <svg class="w-4 h-4 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-2 min-w-0 flex-wrap">
        <span class="font-semibold text-gray-900 text-sm whitespace-nowrap"><%= run.ran_at_date %></span>
        <span class="text-gray-400 text-xs">·</span>
        <span class="text-gray-500 text-sm whitespace-nowrap"><%= run.ran_at_time %></span>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium capitalize <%= statusBadge(run.status) %>"><%= statusLabel(run.status) %></span>
        <% if (run.trigger === 'manual') { %><span title="Run started manually" class="inline-flex h-5 min-w-5 items-center justify-center rounded bg-blue-50 px-1.5 text-xs font-semibold text-blue-600">M</span><% } %>
        <span class="relative md:hidden" onclick="event.stopPropagation()">
          <%- renderDottedPopupLink('$', { onclick: `toggleCostPopup('${run.id}', this, event)`, title: 'Run costs', 'aria-label': 'Run costs', class: 'align-baseline leading-inherit p-0' }) %>
        </span>
        <span class="hidden md:inline text-gray-300">·</span>
        <span class="hidden md:inline truncate text-xs text-gray-500"><%= runProviderName(run) %></span>
      </div>
      <div class="mt-1 flex items-center text-xs text-gray-500 md:hidden">
        <span class="truncate"><%= runProviderName(run) %></span>
      </div>
    </div>

    <div class="hidden md:flex flex-wrap items-baseline justify-end gap-x-2 gap-y-1 text-xs text-gray-500 md:min-w-[390px]">
      <span><span class="font-medium text-gray-700"><%= run.jobs_fetched %></span> fetched</span>
      <span class="text-gray-300">·</span>
      <%- renderRunStatusCounts(run) %>
      <span class="text-gray-300">·</span>
      <span class="relative" onclick="event.stopPropagation()">
        <%- renderDottedPopupLink('$', { onclick: `toggleCostPopup('${run.id}', this, event)`, title: 'Run costs', 'aria-label': 'Run costs', class: 'align-baseline leading-inherit p-0' }) %>
      </span>
    </div>
    <div id="cost-popup-<%= run.id %>" class="hidden fixed z-50 bg-white border border-gray-200 rounded-xl shadow-lg p-3 text-xs min-w-[170px]">
      <% if (run.job_source || run.scraping_provider) { %>
      <div class="flex justify-between gap-6 text-gray-500 pb-1.5 mb-1.5 border-b border-gray-100">
        <span>Source</span>
        <span class="font-medium text-gray-700"><%= formatSourceLabel(run.job_source || (run.scraping_provider === 'harvestapi' ? 'LinkedIn' : run.scraping_provider === 'indeed' ? 'Indeed' : run.scraping_provider === 'stepstone' ? 'StepStone' : run.scraping_provider === 'greenhouse' ? 'Greenhouse' : run.scraping_provider === 'ashby' ? 'Ashby' : run.scraping_provider)) %></span>
      </div>
      <div class="flex justify-between gap-6 text-gray-500 pb-1.5 mb-1.5 border-b border-gray-100">
        <span>Provider</span>
        <span class="font-medium text-gray-700"><%= run.scraping_provider ? formatSourceLabel(run.scraping_provider) : '—' %></span>
      </div>
      <% } %>
      <% const totalCost = (run.cost_openai_usd == null && run.cost_apify_usd == null) ? null : (run.cost_openai_usd ?? 0) + (run.cost_apify_usd ?? 0); %>
      <div class="flex justify-between gap-6 pb-1.5 mb-1.5 border-b border-gray-100">
        <span class="font-medium text-gray-700">Total</span>
        <span class="font-bold text-gray-900"><%= formatRunCost(totalCost) %></span>
      </div>
      <% if (run.cost_apify_usd != null) { %>
      <div class="flex justify-between gap-6 text-gray-600">
        <span>Fetch</span>
        <span class="font-medium text-gray-900"><%= formatRunCost(run.cost_apify_usd) %></span>
      </div>
      <% } %>
      <% if (run.cost_openai_usd != null) { %>
      <div class="flex justify-between gap-6 text-gray-600 mt-1.5">
        <span>AI</span>
        <span class="font-medium text-gray-900"><%= formatRunCost(run.cost_openai_usd) %></span>
      </div>
      <% } %>
    </div>
  </summary>

  <!-- Expanded content -->
  <div class="border-t border-gray-100">

    <% if (run.error_log) { %>
    <div class="px-5 py-3 bg-red-50 border-b border-red-100">
      <p class="text-xs text-red-600 font-medium">Error log:</p>
      <pre class="text-xs text-red-500 mt-1 whitespace-pre-wrap"><%= run.error_log %></pre>
    </div>
    <% } %>

    <!-- Jobs container: server-rendered for preloaded runs, lazy for the rest -->
    <div class="run-jobs-container">
      <% if (run.preloaded) { %>
        <% if (run.jobs.length === 0) { %>
        <div class="px-5 py-8 text-center text-sm text-gray-400">
          No job logs for this run.
          <% if (run.status === 'running') { %><span class="block mt-1 text-xs">Run is still in progress.</span><% } %>
        </div>
        <% } else { %>

        <!-- Desktop table -->
        <table class="<%= getJobTableClass() %>">
          <%- renderJobsAllColgroup() %>
          <%- renderJobsAllTableHeader() %>
          <tbody class="divide-y divide-gray-50">
            <% run.jobs.forEach(function(job, idx) { %>
            <tr data-row-idx="<%= idx %>" data-country="<%= job.country %>" class="<%= getJobTableRowClass() %>">
              <td class="<%= getJobTableCellClass() %> pl-5">
                <%- renderJobPositionCompanyCell(job.title, job.company, runJobDetailHref(job), job.logo_url) %>
              </td>
              <td class="<%= getJobTableCellClass() %>">
                <%- renderLocationCell(job.location, job.country) %>
              </td>
              <td class="<%= getJobTableCellClass('score') %>">
                <%- renderScoreCell(job.ai_score) %>
              </td>
              <td class="<%= getJobTableCellClass('verdict') %>">
                <button class="verdict-btn cursor-pointer"
                      <% if (job.internal_job_id) { %>data-job-id="<%= job.internal_job_id %>"<% } %>
                      data-log-id="<%= job.id %>"
                      data-verdict="<%= job.ai_verdict %>"
                      data-chip-style="compact">
                  <%- verdictChip(job.ai_verdict, job.rejection_category) %>
                </button>
              </td>
              <td class="<%= getJobTableCellClass('date') %>">
                <%- renderDateTimeCell(job.logged_at, timezone || 'UTC') %>
              </td>
              <td class="<%= getJobTableCellClass('source') %>">
                <%- renderSourceLinkCell(job.url, job.job_source || 'LinkedIn') %>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>

        <!-- Mobile list -->
        <div class="<%= getJobMobileListClass() %> jobs-mobile-list">
          <% run.jobs.forEach(function(job, idx) { %>
          <% const target = job.internal_job_id ? '/job/' + job.internal_job_id : (job.url || null); %>
          <div class="job-mobile-row <%= getJobMobileCardClass(target ? 'cursor-pointer' : '') %>"
               data-row-idx="<%= idx %>"
               data-country="<%= job.country %>"
               <% if (target) { %>data-href="<%= target %>" onclick="if(event.target.closest('.verdict-btn')) return; location.href=this.dataset.href"<% } %>>
            <div class="flex items-start justify-between gap-3">
              <span class="job-identity-title text-sm font-semibold text-gray-900"><%= job.title %></span>
              <div class="flex-shrink-0"><%- renderScoreCell(job.ai_score) %></div>
            </div>
            <div class="mt-1 flex items-start justify-between gap-3">
              <span class="job-identity-meta text-xs text-gray-500 flex items-center gap-1.5"><%- renderCompanyLogo(job.company, job.logo_url) %><%= job.company || 'Unknown company' %></span>
              <div class="flex-shrink-0">
                <button class="verdict-btn cursor-pointer"
                      <% if (job.internal_job_id) { %>data-job-id="<%= job.internal_job_id %>"<% } %>
                      data-log-id="<%= job.id %>"
                      data-verdict="<%= job.ai_verdict %>"
                      data-chip-style="compact">
                  <%- verdictChip(job.ai_verdict, job.rejection_category) %>
                </button>
              </div>
            </div>
            <div class="mt-2 flex items-start justify-between gap-3">
              <div class="min-w-0"><%- renderLocationCell(job.location) %></div>
              <%- renderSourceLinkCell(job.url, job.job_source || 'LinkedIn') %>
            </div>
          </div>
          <% }); %>
        </div>

        <% } %>
      <% } %>
      <!-- Lazy runs: container is empty; JS fills it on first expand -->
    </div>

    <!-- Run footer -->
    <div class="px-5 py-2.5 border-t border-gray-100 text-xs text-gray-400 flex items-center justify-between">
      <span>Run #<%= run.id %></span>
      <% if (run.duration_ms) { %>
      <span><%= (run.duration_ms / 1000).toFixed(1) %>s</span>
      <% } %>
    </div>

  </div>
</details>

<% }); %>
</div>
<% } %>

<script>
// ---- Utilities ----
const RUN_LOG_TIMEZONE = <%- JSON.stringify(timezone || 'UTC') %>;

function escHtml(str) {
  return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function formatDateTimeToMinutes(value) {
  if (!value) return '\u2014';
  const d = new Date(String(value));
  if (Number.isNaN(d.getTime())) return String(value).slice(0, 16) || '\u2014';
  const date = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: RUN_LOG_TIMEZONE }).format(d);
  const time = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: RUN_LOG_TIMEZONE }).format(d);
  return date + ' ' + time;
}

function scoreClass(score) {
  if (score == null) return 'text-gray-400';
  return score >= 71 ? 'text-emerald-600 font-semibold' : score >= 51 ? 'text-yellow-600 font-semibold' : 'text-red-500';
}

function logVerdictChip(verdict, rejectionCategory) {
  const base = 'inline-flex h-7 items-center justify-center rounded-lg px-2 text-xs font-medium whitespace-nowrap';
  const label = window.JHUI.formatVerdictLabel(verdict) + (window.JHUI.isVerdictEditable(verdict) ? ' \u25be' : '');
  return '<span class="' + base + ' ' + window.JHUI.getVerdictTone(verdict) + '">' + label + '</span>';
}

function sourceLinkHTML(url, source) {
  return url
    ? '<a href="' + escHtml(url) + '" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()" title="Open ' + escHtml(source || 'Source') + '" aria-label="Open ' + escHtml(source || 'Source') + '" class="source-link-cell inline-flex h-7 w-7 items-center justify-center rounded-lg text-blue-600 hover:bg-blue-50 hover:text-blue-800 transition-colors"><svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M9 7h8v8"/></svg></a>'
    : '<span class="text-gray-300 text-xs">\u2014</span>';
}

// ---- Build jobs HTML from JSON (used by lazy-load) ----

function buildJobsHTML(jobs) {
  if (!jobs || jobs.length === 0) {
    return '<div class="px-5 py-8 text-center text-sm text-gray-400">No job logs for this run.</div>';
  }

  let tableRows = '';
  let mobileRows = '';

  jobs.forEach(function(job, idx) {
    const sc = scoreClass(job.ai_score);
    const target = job.internal_job_id ? '/job/' + job.internal_job_id : (job.url || null);

    const detailHref = job.internal_job_id ? '/job/' + job.internal_job_id : '';
    tableRows += '<tr data-row-idx="' + idx + '" data-country="' + escHtml(job.country) + '" class="job-table-row">'
      + '<td class="job-table-cell pl-5">'
      + '<div class="min-w-0">'
      + (job.internal_job_id
          ? '<a href="' + detailHref + '" class="job-identity-title text-sm font-semibold text-gray-900 hover:text-blue-600 transition-colors">' + escHtml(job.title) + '</a>'
          : '<span class="job-identity-title text-sm font-semibold text-gray-900">' + escHtml(job.title) + '</span>')
      + '<span class="job-identity-meta text-xs text-gray-500 mt-0.5">' + escHtml(job.company || 'Unknown company') + '</span>'
      + '</div></td>'
      + '<td class="job-table-cell">' + (job.location ? '<span class="job-location-text text-xs leading-snug text-gray-500">' + (job.flag ? job.flag + ' ' : '') + escHtml(job.location) + '</span>' : '<span class="text-xs text-gray-300">\u2014</span>') + '</td>'
      + '<td class="job-table-cell job-table-fixed">' + (job.ai_score != null ? '<span class="inline-flex h-7 min-w-9 items-center justify-center rounded-lg px-2 font-bold text-xs score-badge ' + (job.ai_score >= 71 ? 'text-emerald-600 bg-emerald-50' : 'text-gray-600 bg-gray-100') + '">' + window.JHUI.formatScore(job.ai_score) + '</span>' : '<span class="inline-flex h-7 min-w-9 items-center justify-center rounded-lg px-2 font-bold text-xs score-badge text-gray-600 bg-gray-100">\u2014</span>') + '</td>'
      + '<td class="job-table-cell job-table-fixed">'
      + '<button class="verdict-btn cursor-pointer"'
      + (job.internal_job_id ? ' data-job-id="' + job.internal_job_id + '"' : '')
      + ' data-log-id="' + job.id + '"'
      + ' data-verdict="' + job.ai_verdict + '"'
      + ' data-chip-style="compact">'
      + logVerdictChip(job.ai_verdict, job.rejection_category)
      + '</button></td>'
      + '<td class="job-table-cell job-table-fixed"><span class="text-xs text-gray-500 whitespace-nowrap">' + escHtml(formatDateTimeToMinutes(job.logged_at)) + '</span></td>'
      + '<td class="job-table-cell job-table-fixed">' + sourceLinkHTML(job.url, job.job_source || 'LinkedIn') + '</td>'
      + '</tr>';

    mobileRows += '<div class="job-mobile-row job-mobile-card' + (target ? ' cursor-pointer' : '') + '"'
      + ' data-row-idx="' + idx + '"'
      + ' data-country="' + escHtml(job.country) + '"'
      + (target ? ' data-href="' + escHtml(target) + '" onclick="if(event.target.closest(&quot;.verdict-btn&quot;)) return; location.href=this.dataset.href"' : '')
      + '>'
      + '<div class="flex items-start justify-between gap-3">'
      + '<span class="job-identity-title text-sm font-semibold text-gray-900">' + escHtml(job.title) + '</span>'
      + '<div class="flex-shrink-0">' + (job.ai_score != null ? '<span class="inline-flex h-7 min-w-9 items-center justify-center rounded-lg px-2 font-bold text-xs score-badge ' + (job.ai_score >= 71 ? 'text-emerald-600 bg-emerald-50' : 'text-gray-600 bg-gray-100') + '">' + window.JHUI.formatScore(job.ai_score) + '</span>' : '<span class="inline-flex h-7 min-w-9 items-center justify-center rounded-lg px-2 font-bold text-xs score-badge text-gray-600 bg-gray-100">\u2014</span>') + '</div>'
      + '</div>'
      + '<div class="mt-1 flex items-start justify-between gap-3">'
      + '<span class="job-identity-meta text-xs text-gray-500">' + escHtml(job.company || 'Unknown company') + '</span>'
      + '<div class="flex-shrink-0">'
      + '<button class="verdict-btn cursor-pointer"'
      + (job.internal_job_id ? ' data-job-id="' + job.internal_job_id + '"' : '')
      + ' data-log-id="' + job.id + '"'
      + ' data-verdict="' + job.ai_verdict + '"'
      + ' data-chip-style="compact">'
      + logVerdictChip(job.ai_verdict, job.rejection_category)
      + '</button>'
      + '</div></div>'
      + '<div class="mt-2 flex items-start justify-between gap-3"><div class="min-w-0">' + (job.location ? '<span class="job-location-text text-xs leading-snug text-gray-500">' + (job.flag ? job.flag + ' ' : '') + escHtml(job.location) + '</span>' : '<span class="text-xs text-gray-300">\u2014</span>') + '</div>' + sourceLinkHTML(job.url, job.job_source || 'LinkedIn') + '</div>'
      + '</div>';
  });

  return '<table class="job-table job-desktop-table"><colgroup><col style="width:auto;"><col style="width:150px;"><col style="width:56px;"><col style="width:88px;"><col style="width:150px;"><col style="width:44px;"></colgroup><thead class="bg-gray-50"><tr><th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide ">Position</th><th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide ">Location</th><th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">Score</th><th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">Verdict</th><th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide text-center">Date</th><th class="px-3 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide text-center"><span class="sr-only">Source</span></th></tr></thead><tbody class="divide-y divide-gray-50">' + tableRows + '</tbody></table>'
       + '<div class="job-mobile-list jobs-mobile-list-js space-y-2">' + mobileRows + '</div>';
}

// ---- Lazy-load ----

async function loadRunLogs(runId, detailsEl) {
  const container = detailsEl.querySelector('.run-jobs-container');
  if (!container) return;
  container.innerHTML = '<div class="px-5 py-8 text-center text-sm text-gray-400">Loading\u2026</div>';
  try {
    const res = await fetch('/reports/runs/' + runId + '/logs');
    const data = await res.json();
    container.innerHTML = buildJobsHTML(data.jobs);
    if (isSplitEnabled) applySplitToDetailsEl(detailsEl, true);
  } catch (_) {
    container.innerHTML = '<div class="px-5 py-8 text-center text-sm text-red-400">Failed to load logs.</div>';
  }
}

// Attach toggle listeners to lazy runs
document.querySelectorAll('details[data-run-id]:not([data-preloaded])').forEach(function(details) {
  details.addEventListener('toggle', async function() {
    if (!this.open || this.dataset.loaded) return;
    this.dataset.loaded = '1';
    await loadRunLogs(this.dataset.runId, this);
  });
});

// ---- Location split ----

function buildCountryGroups(rows) {
  const map = new Map();
  rows.forEach(function(row) {
    const c = row.dataset.country || 'Remote / Unknown';
    if (!map.has(c)) map.set(c, []);
    map.get(c).push(row);
  });
  return Array.from(map.entries()).sort(function([a], [b]) {
    if (a === 'Remote / Unknown') return 1;
    if (b === 'Remote / Unknown') return -1;
    return a.localeCompare(b);
  });
}

function applyLocationSplitToTbody(tbody) {
  tbody.querySelectorAll('.country-header').forEach(function(el) { el.remove(); });
  const groups = buildCountryGroups(Array.from(tbody.querySelectorAll('tr[data-row-idx]')));
  groups.forEach(function([country, rows]) {
    const hdr = document.createElement('tr');
    hdr.className = 'country-header';
    hdr.innerHTML = `<td colspan="6" class="px-5 py-2 bg-gray-50 border-y border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide">${escHtml(country)}</td>`;
    tbody.appendChild(hdr);
    rows.forEach(function(r) { tbody.appendChild(r); });
  });
}

function restoreFlatOrderToTbody(tbody) {
  tbody.querySelectorAll('.country-header').forEach(function(el) { el.remove(); });
  const rows = Array.from(tbody.querySelectorAll('tr[data-row-idx]'));
  rows.sort(function(a, b) { return +a.dataset.rowIdx - +b.dataset.rowIdx; });
  rows.forEach(function(r) { tbody.appendChild(r); });
}

function applyLocationSplitToMobileList(list) {
  list.querySelectorAll('.country-header').forEach(function(el) { el.remove(); });
  const groups = buildCountryGroups(Array.from(list.querySelectorAll('[data-row-idx]')));
  groups.forEach(function([country, rows]) {
    const hdr = document.createElement('div');
    hdr.className = 'country-header px-4 py-2 bg-gray-50 border-y border-gray-100 text-xs font-semibold text-gray-500 uppercase tracking-wide';
    hdr.textContent = country;
    list.appendChild(hdr);
    rows.forEach(function(r) { list.appendChild(r); });
  });
}

function restoreFlatOrderToMobileList(list) {
  list.querySelectorAll('.country-header').forEach(function(el) { el.remove(); });
  const rows = Array.from(list.querySelectorAll('[data-row-idx]'));
  rows.sort(function(a, b) { return +a.dataset.rowIdx - +b.dataset.rowIdx; });
  rows.forEach(function(r) { list.appendChild(r); });
}

function applySplitToDetailsEl(detailsEl, split) {
  const tbody = detailsEl.querySelector('tbody');
  const mobileList = detailsEl.querySelector('.jobs-mobile-list');
  if (tbody)      { split ? applyLocationSplitToTbody(tbody)      : restoreFlatOrderToTbody(tbody); }
  if (mobileList) { split ? applyLocationSplitToMobileList(mobileList) : restoreFlatOrderToMobileList(mobileList); }
}

let isSplitEnabled = false;

function toggleLocationSplit(checked) {
  isSplitEnabled = checked;
  document.querySelectorAll('details[data-run-id]').forEach(function(detailsEl) {
    // Only touch runs that are already loaded
    if (detailsEl.hasAttribute('data-preloaded') || detailsEl.dataset.loaded) {
      applySplitToDetailsEl(detailsEl, checked);
    }
  });
  localStorage.setItem('runLogsSplitByLocation', checked ? '1' : '0');
}

// Restore split preference on load
(function() {
  if (localStorage.getItem('runLogsSplitByLocation') === '1') {
    const cb = document.getElementById('location-split-checkbox');
    if (cb) { cb.checked = true; toggleLocationSplit(true); }
  }
})();

// ---- Cost popups ----

function toggleCostPopup(runId, btn, event) {
  if (event) event.stopPropagation();
  const popup = document.getElementById('cost-popup-' + runId);
  if (!popup || !btn) return;
  const isHidden = popup.classList.contains('hidden');
  document.querySelectorAll('[id^="cost-popup-"]').forEach(function(el) { el.classList.add('hidden'); });
  if (isHidden) {
    const rect = btn.getBoundingClientRect();
    popup.style.top  = (rect.bottom + 4) + 'px';
    popup.style.right = (window.innerWidth - rect.right) + 'px';
    popup.classList.remove('hidden');
  }
}

document.addEventListener('click', function() {
  document.querySelectorAll('[id^="cost-popup-"]').forEach(function(el) { el.classList.add('hidden'); });
});
</script>
