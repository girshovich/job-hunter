<%
function scoreTextColor(score) {
  if (score >= 85) return 'text-[var(--green2)] bg-[var(--green-soft)]';
  if (score >= 71) return 'text-[var(--green2)] bg-[var(--green-soft)]';
  return 'text-gray-600 bg-gray-100';
}
const tz = timezone || 'UTC';
function formatDate(iso) {
  return formatDateTimeToMinutes(iso, tz);
}
function verdictChip(verdict) {
  return renderVerdictChip(verdict, { editable: isVerdictEditable(verdict) });
}
function renderJobsAllDesktopRows(jobs) {
  return jobs.map(job => {
    const verdict = job.is_duplicate ? 'DUPLICATE' : job.ai_verdict;
    return `<tr class="${getJobTableRowClass()}" onclick="jobRowClick(event, '/job/${job.id}?from=history')">
      <td class="${getJobTableCellClass()} pl-5">${renderJobPositionCompanyCell(job.title, job.company, undefined, job.logo_url)}</td>
      <td class="${getJobTableCellClass()}">${renderLocationCell(job.location, job.country, job.locationLabels, locPref)}</td>
      <td class="${getJobTableCellClass('score')}">${renderScoreCell(job.ai_score)}</td>
      <td class="${getJobTableCellClass('verdict')}">${renderVerdictSelector(verdict, { 'data-job-id': job.id, 'data-verdict': verdict, 'data-chip-style': 'compact', title: 'Click to change status', class: 'cursor-pointer' })}</td>
      <td class="${getJobTableCellClass('date')}">${renderDateTimeCell(job.fetched_at, tz)}</td>
      <td class="${getJobTableCellClass('source')}">${renderSourceLinkCell(job.url, job.job_source || 'LinkedIn')}</td>
    </tr>`;
  }).join('');
}
function renderJobsAllMobileCards(jobs) {
  return jobs.map(job => {
    const verdict = job.is_duplicate ? 'DUPLICATE' : job.ai_verdict;
    return `<div class="${getJobMobileCardClass()}" onclick="jobRowClick(event, '/job/${job.id}?from=history')">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0 flex-1">
          <span class="job-identity-title text-sm font-semibold text-gray-900">${escapeHtml(job.title)}</span>
        </div>
        <div class="flex-shrink-0">${renderScoreCell(job.ai_score)}</div>
      </div>
      <div class="mt-1 flex items-start justify-between gap-3">
        <span class="job-identity-meta text-xs text-gray-500">${renderCompanyLogo(job.company, job.logo_url)} ${escapeHtml(job.company || 'Unknown company')}</span>
        <div class="flex-shrink-0">${renderVerdictSelector(verdict, { 'data-job-id': job.id, 'data-verdict': verdict, 'data-chip-style': 'compact', title: 'Click to change status', class: 'cursor-pointer' })}</div>
      </div>
      <div class="mt-3 flex items-end justify-between gap-3">
        <div class="flex-shrink-0">${renderDateTimeCell(job.fetched_at, tz)}</div>
        <div class="min-w-0 flex items-center justify-end gap-2 text-right">
          <div class="min-w-0">${renderLocationCell(job.location, job.country, job.locationLabels, locPref)}</div>
          ${renderSourceLinkCell(job.url, job.job_source || 'LinkedIn')}
        </div>
      </div>
    </div>`;
  }).join('');
}
function qs(overrides) {
  const params = {
    verdict: filters.verdict,
    company: filters.company,
    country: filters.country,
    score_min: filters.scoreMin,
    score_max: filters.scoreMax,
    date_from: filters.dateFrom,
    date_to: filters.dateTo,
    group: filters.groupId === null ? 'null' : filters.groupId,
    ...overrides
  };
  return '?' + Object.entries(params)
    .filter(([, v]) => v !== '' && v !== null && v !== undefined)
    .map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`)
    .join('&');
}
%>

<!-- Header -->
<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">All Jobs</h1>
    <p class="text-sm text-gray-500 mt-1"><%= total %> job<%= total !== 1 ? 's' : '' %> stored</p>
  </div>
</div>

<!-- Filters -->
<div class="jh-card p-3 md:p-5 mb-6">
  <form method="get" action="/history" class="grid grid-cols-2 gap-2 md:flex md:flex-wrap md:gap-3 md:items-end">

    <div class="col-span-2 min-w-0 md:col-span-1 md:min-w-[120px]">
      <label class="sr-only md:not-sr-only md:block text-xs font-medium text-gray-600 mb-1">Verdict</label>
      <select name="verdict" class="w-full h-10 rounded-lg border border-gray-300 px-3 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent">
        <option value="">All verdicts</option>
        <option value="STRONG_MATCH" <%= filters.verdict === 'STRONG_MATCH' ? 'selected' : '' %>><%= formatVerdictLabel('STRONG_MATCH') %></option>
        <option value="WEAK_MATCH"   <%= filters.verdict === 'WEAK_MATCH'   ? 'selected' : '' %>><%= formatVerdictLabel('WEAK_MATCH') %></option>
        <option value="NO_MATCH"     <%= filters.verdict === 'NO_MATCH'     ? 'selected' : '' %>><%= formatVerdictLabel('NO_MATCH') %></option>
        <option value="DUPLICATE"    <%= filters.verdict === 'DUPLICATE'    ? 'selected' : '' %>><%= formatVerdictLabel('DUPLICATE') %></option>
      </select>
    </div>

    <% if (groups.length > 0) { %>
    <div class="col-span-2 min-w-0 md:col-span-1 md:min-w-[140px]">
      <label class="sr-only md:not-sr-only md:block text-xs font-medium text-gray-600 mb-1">Role</label>
      <select name="group" class="w-full h-10 rounded-lg border border-gray-300 px-3 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent">
        <option value="">All roles</option>
        <% groups.forEach(g => { %>
        <option value="<%= g.id %>" <%= filters.groupId === g.id ? 'selected' : '' %>>
          <%= g.group_name || ('Role ' + g.id) %>
        </option>
        <% }); %>
        <option value="null" <%= filters.groupId === null ? 'selected' : '' %>>Ungrouped</option>
      </select>
    </div>
    <% } %>

    <% if (countries && countries.length > 0) { %>
    <div class="min-w-0 md:min-w-[140px]">
      <label class="sr-only md:not-sr-only md:block text-xs font-medium text-gray-600 mb-1">Country</label>
      <select name="country" class="w-full h-10 rounded-lg border border-gray-300 px-3 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent">
        <option value="">All countries</option>
        <% countries.forEach(c => { %>
        <option value="<%= c.value %>" <%= filters.country === c.value ? 'selected' : '' %>><%= c.label %></option>
        <% }); %>
      </select>
    </div>
    <% } %>

    <div class="min-w-0 md:min-w-[160px] md:flex-1">
      <label class="sr-only md:not-sr-only md:block text-xs font-medium text-gray-600 mb-1">Company</label>
      <input type="text" name="company" value="<%= filters.company %>"
             placeholder="Filter by company…"
             class="w-full h-10 rounded-lg border border-gray-300 px-3 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
    </div>

    <div class="min-w-0 md:min-w-[140px]">
      <label class="block text-xs font-medium text-gray-600 mb-1">Score</label>
      <div class="flex gap-1.5">
        <input type="number" name="score_min" value="<%= filters.scoreMin ?? '' %>" min="0" max="100"
               class="w-full h-10 rounded-lg border border-gray-300 px-2 text-sm focus:ring-2 focus:ring-blue-500" placeholder="0" />
        <span class="self-center text-gray-400 text-xs">–</span>
        <input type="number" name="score_max" value="<%= filters.scoreMax ?? '' %>" min="0" max="100"
               class="w-full h-10 rounded-lg border border-gray-300 px-2 text-sm focus:ring-2 focus:ring-blue-500" placeholder="100" />
      </div>
    </div>

    <div class="col-span-2 min-w-0 md:col-span-1 md:min-w-[200px]">
      <label class="sr-only md:not-sr-only md:block text-xs font-medium text-gray-600 mb-1">Date range</label>
      <div class="flex gap-1.5">
        <input type="date" name="date_from" value="<%= filters.dateFrom %>"
               class="w-full h-10 rounded-lg border border-gray-300 px-2 text-xs focus:ring-2 focus:ring-blue-500" />
        <input type="date" name="date_to" value="<%= filters.dateTo %>"
               class="w-full h-10 rounded-lg border border-gray-300 px-2 text-xs focus:ring-2 focus:ring-blue-500" />
      </div>
    </div>

    <div class="col-span-2 flex gap-2 flex-shrink-0 md:col-span-1">
      <button type="submit" class="h-10 flex-1 md:flex-none bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-lg px-4 transition-colors">
        Filter
      </button>
      <a href="/history" class="h-10 flex-1 md:flex-none inline-flex items-center justify-center text-center bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg px-4 transition-colors">
        Clear
      </a>
    </div>
  </form>
</div>

<!-- Job table -->
<div class="jh-card overflow-hidden">
  <% if (jobs.length === 0) { %>
  <div class="px-6 py-16 text-center">
    <svg class="w-10 h-10 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    <p class="text-sm text-gray-500">No jobs match your filters.</p>
  </div>
  <% } else { %>
  <table class="<%= getJobTableClass() %>">
    <%- renderJobsAllColgroup() %>
    <%- renderJobsAllTableHeader() %>
    <tbody class="bg-white divide-y divide-gray-50">
      <%- renderJobsAllDesktopRows(jobs) %>
    </tbody>
  </table>
  <div class="<%= getJobMobileListClass() %> p-3">
    <%- renderJobsAllMobileCards(jobs) %>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
  <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between">
    <p class="text-xs text-gray-500">Page <%= page %> of <%= totalPages %> · <%= total %> results</p>
    <div class="flex items-center gap-2">
      <% if (page > 1) { %>
      <a href="<%= qs({ page: page - 1 }) %>"
         class="px-3 py-1.5 text-xs font-medium text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">
        ← Prev
      </a>
      <% } %>
      <% if (page < totalPages) { %>
      <a href="<%= qs({ page: page + 1 }) %>"
         class="px-3 py-1.5 text-xs font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors">
        Next →
      </a>
      <% } %>
    </div>
  </div>
  <% } %>
  <% } %>
</div>
