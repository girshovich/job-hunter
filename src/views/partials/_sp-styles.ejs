  .sp-tbl-months,.sp-tbl.sp-tbl-sum{width:100%;max-width:none;table-layout:fixed}
  /* Two behaviours, one threshold. With MANY statuses the label column is pinned at 24% and the
     figures divide the rest evenly, so the table justifies across the card. With FEW, pinning the
