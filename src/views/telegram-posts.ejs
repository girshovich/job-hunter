<%- include('partials/_stg-styles') %>
<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="stg-h1">Telegram — Last Ingest</h1>
    <p class="stg-sub">
      <span style="color:var(--ink2);font-weight:700"><%= postCount.toLocaleString() %></span> unique post(s)
      <% if (repostCount > 0) { %>
        · <span style="color:var(--ink2);font-weight:700"><%= repostCount.toLocaleString() %></span> repost(s) excluded
      <% } %>
      <% if (lastRunAt) { %>
        · ingested <span style="color:var(--ink2);font-weight:700"><%= formatDateTimeToMinutes(lastRunAt, timezone) %></span>
      <% } %>
    </p>
  </div>
  <a href="/admin?tab=sources" class="stg-btn stg-btn-ghost stg-btn-sm">Back to Admin</a>
</div>

<% if (channels.length === 0) { %>
  <%- renderEmptyState('No posts were ingested in the last run.') %>
<% } else { %>
  <div class="space-y-8">
    <% channels.forEach(group => { %>
      <section>
        <h2 class="text-sm font-semibold mb-3" style="color:var(--ink2)">
          @<%= group.channel %>
          <span style="color:var(--faint);font-weight:400">· <%= group.posts.length %> post(s)</span>
        </h2>
        <div class="space-y-4">
          <% group.posts.forEach(post => { %>
            <div class="jh-card overflow-hidden">
              <div class="flex items-center justify-between px-5 py-3" style="background:#fbfcfe;border-bottom:1px solid var(--line)">
                <a href="<%= post.post_url %>" target="_blank" rel="noopener"
                   class="text-xs font-medium underline break-all" style="color:var(--accent)">
                  <%= post.post_url %>
                </a>
                <span class="text-xs flex-shrink-0 ml-3" style="color:var(--faint)"><%= post.published_at || '—' %></span>
              </div>
              <div class="px-5 py-4">
                <pre class="text-xs whitespace-pre-wrap font-sans leading-relaxed" style="color:var(--ink2)"><%= post.text || '(no text)' %></pre>
              </div>
              <div class="px-5 py-3" style="border-top:1px solid var(--line)">
                <% if (post.jobs.length === 0) { %>
                  <p class="text-xs" style="color:var(--faint)">No jobs scraped from this post.</p>
                <% } else { %>
                  <p class="text-xs font-medium mb-2" style="color:var(--muted)"><%= post.jobs.length %> job(s) scraped</p>
                  <div class="space-y-1">
                    <% post.jobs.forEach(job => { %>
                      <div class="text-xs" style="color:var(--muted)">
                        <span class="font-semibold" style="color:var(--ink2)"><%= job.company %></span>
                        <span style="color:var(--faintest)">·</span>
                        <span><%= job.title %></span>
                        <% if (job.location) { %>
                          <span style="color:var(--faintest)">·</span>
                          <span style="color:var(--muted)"><%= job.location %></span>
                        <% } %>
                      </div>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    <% }) %>
  </div>
<% } %>
