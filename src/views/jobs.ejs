<%
function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function stripMd(text){ if(!text) return ''; return String(text).replace(/\*\*([^*]+)\*\*/g,'$1').replace(/\*/g,''); }
const f = filters;
const verdictLabels = { all:'All verdicts', STRONG_MATCH:'Strong', WEAK_MATCH:'Weak', NO_MATCH:'No match', DUPLICATE:'Duplicate' };
const statusLabels = { '':'Status', new:'New', applied:'Applied', wont:"Won't apply" };
const rolesActive = (f.roleIds.length > 0) || f.roleOther;
const verdictActive = f.verdict !== 'all';
const countryActive = f.countries.length > 0;
const dateActive = !!(f.df || f.dt);
// value(lowercase) → display label, for the single-selected Country trigger label
const countryLabelMap = {};
countryOptions.forEach(c => { countryLabelMap[c.value] = c.label; });
%>

<%
// ── Filter bar (relative-lookup menus → no duplicate IDs; server-nav on select) ──
function chev(){ return '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" style="opacity:.7"><path d="m6 9 6 6 6-6"/></svg>'; }
function filterBtn(id, iconSvg, label, active){
  const style = active
    ? 'color:var(--accent);background:var(--accent-soft);border:1px solid var(--accent-border)'
    : 'color:var(--muted);background:#fff;border:1px solid var(--line2)';
  return '<button type="button" class="filter-btn" data-filter="'+id+'" onclick="JH.toggleMenu(this)" style="display:inline-flex;align-items:center;gap:6px;padding:7px 11px;font-size:12px;font-weight:700;border-radius:9px;cursor:pointer;white-space:nowrap;'+style+'">'
    + iconSvg + '<span class="fb-label">' + esc(label) + '</span>' + chev() + '</button>';
}
function menuWrap(inner){
  return '<div class="filter-menu" style="display:none;position:absolute;top:38px;left:0;z-index:30;background:#fff;border:1px solid #e4e6ec;border-radius:12px;box-shadow:var(--shadow-dropdown);padding:6px;min-width:200px;max-height:340px;overflow-y:auto">'+inner+'</div>';
}
function menuRow(onclick, dot, label, count, active){
  return '<div onclick="event.stopPropagation();'+onclick+'" style="display:flex;align-items:center;gap:9px;padding:8px 9px;border-radius:8px;cursor:pointer;background:'+(active?'var(--accent-soft)':'transparent')+'">'
    + (dot ? '<span style="flex:none;width:9px;height:9px;border-radius:50%;background:'+dot+'"></span>' : '')
    + '<span style="flex:1;min-width:0;font-size:12.5px;font-weight:'+(active?'800':'600')+';color:var(--ink)">'+esc(label)+'</span>'
    + (count!=null ? '<span style="font-size:11.5px;color:var(--faintest);font-weight:600">'+count+'</span>' : '')
    + (active ? '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"><path d="m5 12 5 5L20 6"/></svg>' : '')
    + '</div>';
}
function multiMenu(kind, width){
  // Rows are filled client-side by JH.renderMultiMenu on open (single source of truth in JS).
  return '<div class="filter-menu" data-menu="'+kind+'" style="display:none;position:absolute;top:38px;left:0;z-index:30;background:#fff;border:1px solid #e4e6ec;border-radius:12px;box-shadow:var(--shadow-dropdown);padding:6px;width:'+width+'px;max-height:340px;overflow-y:auto"></div>';
}
function renderFilterBar(){
  // Roles (multi)
  const roleIcon = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="3" y="4" width="18" height="4" rx="1"/><rect x="3" y="10" width="12" height="4" rx="1"/><rect x="3" y="16" width="7" height="4" rx="1"/></svg>';
  const roleLabel = !rolesActive ? 'Role' : ((f.roleIds.length + (f.roleOther?1:0)) === 1 ? (f.roleOther ? 'Other' : (roleOptions.find(r => r.id === f.roleIds[0])||{}).group_name || '1 role') : (f.roleIds.length + (f.roleOther?1:0)) + ' roles');

  // Verdict (single)
  const verdictIcon = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1l8.8 8.8 8.8-8.8a5 5 0 0 0 0-7.1Z"/></svg>';
  const verdictDots = { all:null, STRONG_MATCH:'#1e9e5a', WEAK_MATCH:'#f0a500', NO_MATCH:'#e5484d', DUPLICATE:'#8b5cf6' };
  let verdictMenu = '';
  ['all','STRONG_MATCH','WEAK_MATCH','NO_MATCH','DUPLICATE'].forEach(v => { verdictMenu += menuRow("JH.setVerdict('"+v+"')", verdictDots[v], verdictLabels[v], null, f.verdict === v); });

  // Company (text)
  const companyBox = '<div style="flex:1;min-width:120px;display:flex;align-items:center;gap:7px;padding:0 11px;height:33px;background:#fff;border:1px solid '+(f.company?'var(--accent-border)':'var(--line2)')+';border-radius:9px">'
    + '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#9aa1ad" stroke-width="1.9" stroke-linecap="round"><rect x="4" y="8" width="16" height="12" rx="2"/><path d="M9 8V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v3"/></svg>'
    + '<input class="company-input" value="'+esc(f.company)+'" onkeydown="if(event.key===\'Enter\')JH.setCompany(this.value)" placeholder="Company" style="flex:1;min-width:0;border:0;background:transparent;outline:none;font-size:12px;font-weight:600;color:var(--ink)"/>'
    + (f.company ? '<span onclick="JH.setCompany(\'\')" style="cursor:pointer;color:var(--faintest);display:inline-flex"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M6 6l12 12M18 6l-12 12"/></svg></span>' : '')
    + '</div>';

  // Country (multi)
  const countryIcon = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>';
  const countryLabel = !countryActive ? 'Country' : (f.countries.length === 1 ? (countryLabelMap[f.countries[0]] || f.countries[0]) : f.countries.length + ' countries');

  // Status (single)
  const statusIcon = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>';
  let statusMenu = menuRow("JH.setStatus('')", '#cfd4dd', 'All statuses', statusCounts.all, f.status === '');
  statusMenu += menuRow("JH.setStatus('new')", '#8a91a0', 'New', statusCounts[0], f.status === 'new');
  statusMenu += menuRow("JH.setStatus('applied')", '#1e9e5a', 'Applied', statusCounts[1], f.status === 'applied');
  statusMenu += menuRow("JH.setStatus('wont')", '#e5484d', "Won't apply", statusCounts[2], f.status === 'wont');

  // Date range (custom calendar)
  const dateIcon = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#9aa1ad" stroke-width="1.9" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>';
  const fmtDot = iso => iso ? iso.replace(/-/g, '.') : '…';
  const dateLabel = dateActive ? (fmtDot(f.df) + ' – ' + fmtDot(f.dt)) : 'Dates';
  const dateMenu = '<div class="filter-menu" style="display:none;position:absolute;top:38px;left:0;z-index:30;background:#fff;border:1px solid #e4e6ec;border-radius:14px;box-shadow:var(--shadow-dropdown);padding:14px"><div class="date-cal" style="width:288px"></div></div>';

  return '<div style="display:flex;gap:7px;margin-top:14px;flex-wrap:wrap">'
      + '<div style="position:relative;flex:none">'+filterBtn('roles', roleIcon, roleLabel, rolesActive)+multiMenu('roles', 290)+'</div>'
      + '<div style="position:relative;flex:none">'+filterBtn('verdict', verdictIcon, f.verdict==='all'?'Verdict':verdictLabels[f.verdict], verdictActive)+menuWrap(verdictMenu)+'</div>'
      + companyBox
    + '</div>'
    + '<div style="display:flex;gap:7px;margin-top:8px;flex-wrap:wrap">'
      + '<div style="position:relative;flex:none">'+filterBtn('country', countryIcon, countryLabel, countryActive)+multiMenu('country', 240)+'</div>'
      + '<div style="position:relative;flex:none">'+filterBtn('status', statusIcon, statusLabels[f.status]||'Status', f.status!=='')+menuWrap(statusMenu)+'</div>'
      + '<div style="position:relative;flex:none">'
        + '<button type="button" class="filter-btn" data-filter="date" onclick="JH.toggleMenu(this)" style="display:inline-flex;align-items:center;gap:6px;padding:7px 11px;font-size:12px;font-weight:700;border-radius:9px;cursor:pointer;white-space:nowrap;'+(dateActive?'color:var(--accent);background:var(--accent-soft);border:1px solid var(--accent-border)':'color:var(--muted);background:#fff;border:1px solid var(--line2)')+'">'+dateIcon+'<span>'+esc(dateLabel)+'</span>'+chev()+'</button>'
        + dateMenu
      + '</div>'
    + '</div>';
}
%>

<%
// ── List card (desktop → selects pane; mobile → navigates to /job/:id) ──
function scoreChip(score, verdict){
  // Score chip takes the verdict tone (same palette as the verdict chip), not a flat green.
  const t = verdict === 'STRONG_MATCH' ? 'background:#ecfdf3;color:#067647'
    : verdict === 'WEAK_MATCH' ? 'background:#fffaeb;color:#b54708'
    : verdict === 'DUPLICATE' ? 'background:#f4f3ff;color:#6941c6'
    : 'background:#fef3f2;color:#b42318'; // NO_MATCH / fallback
  return '<span style="display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:7px;font-size:12px;font-weight:800;font-variant-numeric:tabular-nums;'+t+'">'+formatScore(score)+'</span>';
}
function card(job, mobile){
  const applied = Number(job.applied) || 0;
  const cardVerdict = job.is_duplicate ? 'DUPLICATE' : job.ai_verdict;
  // Applied status (chip + New-tint + dim) is a matches-workflow concept — strong matches only.
  const isStrongCard = cardVerdict === 'STRONG_MATCH';
  const isNew = applied === 0;
  const selected = job.id === selectedJobId;
  const cardBg = (isStrongCard && isNew) ? 'var(--accent-tint)' : '#fff';
  const borderColor = selected ? 'var(--accent)' : '#e6e8ee';
  const shadow = selected ? '0 0 0 3px var(--accent-soft),0 1px 2px rgba(16,24,40,.06)' : '0 1px 2px rgba(16,24,40,.05)';
  const opacity = (!selected && isStrongCard && applied !== 0) ? '.85' : '1';
  const onSelect = mobile ? ("location.href='/job/"+job.id+"?from="+fromKey+"'") : ('JH.select('+job.id+')');
  const summary = job.ai_summary ? esc(stripMd(job.ai_summary)) : '';
  const applyUrl = job.apply_url || job.url;
  let html = '<div class="jobcard" data-id="'+job.id+'" onclick="if(!JH.isControl(event)){'+onSelect+'}" style="display:flex;flex-direction:column;gap:9px;padding:14px 15px;border-radius:14px;cursor:pointer;background:'+cardBg+';border:1px solid '+borderColor+';box-shadow:'+shadow+';opacity:'+opacity+';transition:box-shadow .12s,border-color .12s,opacity .12s">';
  html += '<div style="display:flex;align-items:flex-start;gap:11px">'
    + '<div style="flex:1;min-width:0">'
      + '<div style="font-size:14px;font-weight:700;line-height:1.3;color:var(--ink)">'+esc(job.title)+'</div>'
      + '<div style="display:flex;align-items:center;gap:7px;margin-top:5px">'+renderCompanyLogo(job.company, job.logo_url)+'<span style="font-size:12.5px;color:var(--muted2);font-weight:700">'+esc(job.company||'Unknown company')+'</span></div>'
    + '</div>'
    + (isStrongCard ? '<div style="flex:none">'+renderAppliedSelector(job.applied, { 'data-job-id': job.id })+'</div>' : '')
  + '</div>';
  if (summary) html += '<div class="clamp3" style="font-size:12.5px;line-height:1.5;color:var(--muted2)">'+summary+'</div>';
  html += '<div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap">'
    + scoreChip(job.ai_score, cardVerdict)
    + renderVerdictSelector(cardVerdict, { 'data-job-id': job.id, 'data-verdict': cardVerdict, 'data-chip-style': 'compact', class: 'cursor-pointer' })
    + '<span style="display:inline-flex;align-items:center;gap:5px;font-size:11.5px;color:var(--faint);font-weight:600">'+renderLocationCell(job.location, job.country, job.locationLabels, locPref)+'</span>'
    + '<span style="flex:1"></span>'
    + (applyUrl ? '<a href="'+esc(applyUrl)+'" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()" style="display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:700;color:var(--accent)">Apply<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><path d="M7 17 17 7M9 7h8v8"/></svg></a>' : '')
  + '</div>';
  html += '</div>';
  return html;
}
function renderList(mobile){
  let html = '';
  dateGroups.forEach((group, gi) => {
    html += '<div onclick="JH.toggleGroup('+gi+')" style="display:flex;align-items:center;gap:9px;padding:14px 6px 8px;cursor:pointer;user-select:none">'
      + '<svg class="grp-chev" data-gi="'+gi+'" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#aeb4bf" stroke-width="2.6" stroke-linecap="round" style="transform:rotate(90deg);transition:transform .15s"><path d="M9 5l7 7-7 7"/></svg>'
      + '<span style="font-size:12px;font-weight:800;letter-spacing:.02em;text-transform:uppercase;color:var(--muted2)">'+esc(group.label)+'</span>'
      + '<span style="flex:1;height:1px;background:var(--line)"></span>'
      + '<span style="font-size:11.5px;color:var(--faintest);font-weight:600">'+group.jobs.length+(group.jobs.length===1?' job':' jobs')+'</span>'
    + '</div>';
    html += '<div class="grp-body" data-gi="'+gi+'" style="display:flex;flex-direction:column;gap:9px">';
    group.jobs.forEach(job => { html += card(job, mobile); });
    html += '</div>';
  });
  return html;
}
%>

<!-- ============ DESKTOP TWO-PANE ============ -->
<div class="hidden md:flex" style="height:100dvh">
  <!-- List column -->
  <section style="width:456px;flex:none;border-left:1px solid #e6e8ee;border-right:1px solid #dfe2e9;box-shadow:var(--shadow-list-edge);z-index:1;display:flex;flex-direction:column;min-height:0;background:var(--panel)">
    <div style="padding:24px 22px 12px 16px;flex:none">
      <div style="display:flex;align-items:baseline;gap:10px">
        <h1 style="margin:0;font-size:21px;font-weight:800;letter-spacing:-.02em;color:var(--ink)"><%= title %></h1>
        <% if (showSubtitle) { %><span style="font-size:13px;color:var(--faint);font-weight:600"><%= newCount %> new</span><% } %>
      </div>
      <%- renderFilterBar() %>
    </div>
    <div class="jh-scroll" style="flex:1;min-height:0;overflow-y:auto;padding:4px 16px 24px">
      <% if (totalUnfiltered === 0) { %>
        <div style="padding:52px 20px;text-align:center">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#d4d8e0" stroke-width="1.5" stroke-linecap="round" style="margin:0 auto 12px;display:block"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M8 4V2M16 4V2"/></svg>
          <p style="margin:0;font-size:13.5px;color:var(--faint);font-weight:600">Run a job search first</p>
          <p style="margin:4px 0 0;font-size:12.5px;color:var(--faintest)">Your matches will show up here.</p>
        </div>
      <% } else if (dateGroups.length === 0) { %>
        <div style="padding:52px 20px;text-align:center">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#d4d8e0" stroke-width="1.5" stroke-linecap="round" style="margin:0 auto 12px;display:block"><circle cx="12" cy="12" r="9"/><path d="M9.2 15a4 4 0 0 1 5.6 0M9 10h.01M15 10h.01"/></svg>
          <p style="margin:0;font-size:13.5px;color:var(--faint);font-weight:600">No matches fit your filters.</p>
          <button onclick="JH.clearAll()" style="margin-top:14px;height:34px;padding:0 16px;border:1px solid #e5e7ee;border-radius:9px;background:#fff;color:var(--accent);font-size:12.5px;font-weight:700;cursor:pointer">Clear all filters</button>
        </div>
      <% } else { %>
        <%- renderList(false) %>
        <% if (totalPages > 1 || page > 1) { %>
        <div style="margin-top:18px;padding-top:14px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between">
          <span style="font-size:11.5px;color:var(--faint);font-weight:600">
            <% const fmtD = iso => new Date(iso + 'T12:00:00Z').toLocaleDateString('en-GB', { day:'numeric', month:'short' }); %>
            <% if (pageOldest && pageNewest) { %><%= pageOldest === pageNewest ? fmtD(pageNewest) : fmtD(pageOldest) + ' – ' + fmtD(pageNewest) %> · <% } %>page <%= page %> of <%= totalPages %>
          </span>
          <div style="display:flex;gap:7px">
            <button onclick="<%= page > 1 ? 'JH.gotoPage(' + (page-1) + ')' : '' %>" <%= page > 1 ? '' : 'disabled' %> style="padding:6px 12px;font-size:12px;font-weight:700;border-radius:9px;<%= page > 1 ? 'color:var(--muted);background:#fff;border:1px solid var(--line2);cursor:pointer' : 'color:var(--faintest);background:#f4f5f8;border:1px solid var(--line2);cursor:not-allowed' %>">← Newer</button>
            <button onclick="<%= page < totalPages ? 'JH.gotoPage(' + (page+1) + ')' : '' %>" <%= page < totalPages ? '' : 'disabled' %> style="padding:6px 12px;font-size:12px;font-weight:700;border-radius:9px;<%= page < totalPages ? 'color:#fff;background:var(--accent);border:0;cursor:pointer' : 'color:var(--faintest);background:#f4f5f8;border:1px solid var(--line2);cursor:not-allowed' %>">Older →</button>
          </div>
        </div>
        <% } %>
      <% } %>
    </div>
  </section>

  <!-- Detail pane -->
  <section class="jh-scroll" style="flex:1;min-width:0;overflow-y:auto;background:#f6f5f3">
    <div style="max-width:900px;margin:0;padding:18px clamp(14px,1.5vw,22px) 40px">
      <% if (pane) { %>
        <%- include('partials/job-detail-body', { job: pane.job, original: pane.original, duplicatesOfThis: pane.duplicatesOfThis, cvs: pane.cvs, settings: pane.settings, companyNote: pane.companyNote, locationLabels: pane.locationLabels, locPref: pane.locPref }) %>
      <% } else { %>
        <div style="height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#d4d8e0" stroke-width="1.5" stroke-linecap="round" style="margin-bottom:10px"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 10h8M8 14h5"/></svg>
          <p style="margin:0;font-size:13px;color:var(--faint);font-weight:600">No job selected</p>
          <p style="margin:4px 0 0;font-size:12px;color:var(--faintest)">Pick a job from the list to see the details.</p>
        </div>
      <% } %>
    </div>
  </section>
</div>

<!-- ============ MOBILE (list → tap → /job/:id) ============ -->
<div class="md:hidden" style="padding:20px 16px 84px">
  <div style="display:flex;align-items:baseline;gap:10px;margin-bottom:2px">
    <h1 style="margin:0;font-size:21px;font-weight:800;letter-spacing:-.02em;color:var(--ink)"><%= title %></h1>
    <% if (showSubtitle) { %><span style="font-size:13px;color:var(--faint);font-weight:600"><%= newCount %> new</span><% } %>
  </div>
  <%- renderFilterBar() %>
  <div style="margin-top:12px">
    <% if (totalUnfiltered === 0) { %>
      <div style="padding:52px 20px;text-align:center">
        <p style="margin:0;font-size:13.5px;color:var(--faint);font-weight:600">Run a job search first</p>
        <p style="margin:4px 0 0;font-size:12.5px;color:var(--faintest)">Your matches will show up here.</p>
      </div>
    <% } else if (dateGroups.length === 0) { %>
      <div style="padding:52px 20px;text-align:center">
        <p style="margin:0;font-size:13.5px;color:var(--faint);font-weight:600">No matches fit your filters.</p>
        <button onclick="JH.clearAll()" style="margin-top:14px;height:34px;padding:0 16px;border:1px solid #e5e7ee;border-radius:9px;background:#fff;color:var(--accent);font-size:12.5px;font-weight:700;cursor:pointer">Clear all filters</button>
      </div>
    <% } else { %>
      <%- renderList(true) %>
      <% if (totalPages > 1 || page > 1) { %>
      <div style="margin-top:18px;padding-top:14px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between">
        <span style="font-size:11.5px;color:var(--faint);font-weight:600">page <%= page %> of <%= totalPages %></span>
        <div style="display:flex;gap:7px">
          <button onclick="<%= page > 1 ? 'JH.gotoPage(' + (page-1) + ')' : '' %>" <%= page > 1 ? '' : 'disabled' %> style="padding:6px 12px;font-size:12px;font-weight:700;border-radius:9px;<%= page > 1 ? 'color:var(--muted);background:#fff;border:1px solid var(--line2);cursor:pointer' : 'color:var(--faintest);background:#f4f5f8;border:1px solid var(--line2);cursor:not-allowed' %>">← Newer</button>
          <button onclick="<%= page < totalPages ? 'JH.gotoPage(' + (page+1) + ')' : '' %>" <%= page < totalPages ? '' : 'disabled' %> style="padding:6px 12px;font-size:12px;font-weight:700;border-radius:9px;<%= page < totalPages ? 'color:#fff;background:var(--accent);border:0;cursor:pointer' : 'color:var(--faintest);background:#f4f5f8;border:1px solid var(--line2);cursor:not-allowed' %>">Older →</button>
        </div>
      </div>
      <% } %>
    <% } %>
  </div>
</div>

<script>
window.__dateFilter = { df: '<%= f.df %>', dt: '<%= f.dt %>' };
window.__selectedJobId = <%= selectedJobId || 'null' %>;
window.__filterOpts = {
  roles: <%- JSON.stringify(roleOptions.map(r => ({ v: String(r.id), label: r.group_name || ('Role ' + r.id), count: r.cnt })).concat(orphanCount > 0 ? [{ v: 'other', label: 'Other', count: orphanCount }] : [])) %>,
  country: <%- JSON.stringify(countryOptions.map(c => ({ v: c.value, label: c.label, count: c.cnt }))) %>
};
// When applied status changes via the shared dropdown, the card must drop/gain the New tint + dim.
window.onAppliedChanged = function(jobId, state){
  const isNew = Number(state) === 0;
  const selected = String(window.__selectedJobId) === String(jobId);
  document.querySelectorAll('.jobcard[data-id="' + jobId + '"]').forEach(function(card){
    card.style.background = isNew ? 'var(--accent-tint)' : '#fff';
    card.style.opacity = (!selected && !isNew) ? '.85' : '1';
  });
};
window.JH = (function(){
  function currentUrl(){ return new URL(window.location.href); }
  function nav(changes, opts){
    const u = currentUrl();
    for (const k in changes){
      const v = changes[k];
      if (v === null || v === '' || v === undefined) u.searchParams.delete(k);
      else u.searchParams.set(k, v);
    }
    if (!opts || opts.resetPage !== false) u.searchParams.delete('page');
    if (!opts || opts.keepSelected !== true) u.searchParams.delete('selected');
    window.location.href = u.pathname + '?' + u.searchParams.toString();
  }
  const di = window.__dateFilter || {};
  const _cal = { from: di.df || null, to: di.dt || null, y: 0, m: 0 };
  (function(){ const base = (_cal.to || _cal.from) ? new Date((_cal.to || _cal.from) + 'T12:00:00') : new Date(); _cal.y = base.getFullYear(); _cal.m = base.getMonth(); })();
  // Pending (un-applied) multi-select state; applied on menu close (not per checkbox click).
  const _pending = {
    roles: <%- JSON.stringify(f.roleIds.map(String).concat(f.roleOther ? ['other'] : [])) %>,
    country: <%- JSON.stringify(f.countries) %>
  };
  function escJs(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  const CHK_W = '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><path d="m5 12 5 5L20 6"/></svg>';
  const CHK_A = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"><path d="m5 12 5 5L20 6"/></svg>';
  function buildRows(kind){
    const opts = (window.__filterOpts[kind]) || [];
    const sel = _pending[kind];
    const allActive = sel.length === 0;
    let html = '<div onclick="event.stopPropagation();JH.clearMulti(\''+kind+'\')" style="display:flex;align-items:center;gap:9px;padding:8px 9px;border-radius:8px;cursor:pointer;background:'+(allActive?'var(--accent-soft)':'transparent')+'">'
      + '<span style="flex:1;font-size:12.5px;font-weight:'+(allActive?'800':'600')+';color:var(--ink)">'+(kind==='roles'?'All roles':'All countries')+'</span>'
      + (allActive?CHK_A:'') + '</div>';
    opts.forEach(function(o){
      const checked = sel.indexOf(String(o.v)) >= 0;
      const val = String(o.v).replace(/\\/g,'\\\\').replace(/'/g,"\\'");
      html += '<div onclick="event.stopPropagation();JH.toggleMulti(\''+kind+'\',\''+val+'\')" style="display:flex;align-items:center;gap:10px;padding:8px 9px;border-radius:8px;cursor:pointer;background:'+(checked?'var(--accent-soft)':'transparent')+'">'
        + '<span style="width:16px;height:16px;flex:none;border-radius:5px;display:grid;place-items:center;border:1.5px solid '+(checked?'var(--accent)':'#cfd4dd')+';background:'+(checked?'var(--accent)':'#fff')+'">'+(checked?CHK_W:'')+'</span>'
        + '<span style="flex:1;min-width:0;font-size:12.5px;font-weight:600;color:var(--ink)">'+escJs(o.label)+'</span>'
        + '<span style="font-size:11.5px;color:var(--faintest);font-weight:600">'+o.count+'</span>'
        + '</div>';
    });
    return html;
  }
  return {
    isControl(e){ return !!e.target.closest('.verdict-btn,.applied-btn,a,button,input,.filter-menu'); },
    toggleMenu(btn){
      if (this.applyMulti()) return; // apply pending multi-select from the previously open menu
      const menu = btn.parentElement.querySelector('.filter-menu');
      const isOpen = menu.style.display === 'block';
      document.querySelectorAll('.filter-menu').forEach(m => m.style.display = 'none');
      if (!isOpen) {
        menu.style.display = 'block';
        if (menu.querySelector('.date-cal')) this.renderCal();
        const kind = menu.getAttribute('data-menu');
        if (kind) this.renderMultiMenu(kind);
      }
    },
    setVerdict(v){ nav({ verdict: v }); },
    toggleMulti(kind, value){
      const arr = _pending[kind];
      const i = arr.indexOf(value);
      if (i >= 0) arr.splice(i, 1); else arr.push(value);
      this.renderMultiMenu(kind);
      this.updateMultiLabel(kind);
    },
    clearMulti(kind){ _pending[kind] = []; this.renderMultiMenu(kind); this.updateMultiLabel(kind); },
    renderMultiMenu(kind){ document.querySelectorAll('[data-menu="' + kind + '"]').forEach(function(m){ m.innerHTML = buildRows(kind); }); },
    updateMultiLabel(kind){
      const sel = _pending[kind];
      const active = sel.length > 0;
      let label;
      if (kind === 'roles') label = sel.length === 0 ? 'Role' : (sel.length === 1 ? ((window.__filterOpts.roles.find(o => String(o.v) === String(sel[0])) || {}).label || sel[0]) : sel.length + ' roles');
      else label = sel.length === 0 ? 'Country' : (sel.length === 1 ? ((window.__filterOpts.country.find(o => String(o.v) === String(sel[0])) || {}).label || sel[0]) : sel.length + ' countries');
      document.querySelectorAll('[data-filter="' + kind + '"]').forEach(function(btn){
        const lbl = btn.querySelector('.fb-label'); if (lbl) lbl.textContent = label;
        if (active) { btn.style.color = 'var(--accent)'; btn.style.background = 'var(--accent-soft)'; btn.style.border = '1px solid var(--accent-border)'; }
        else { btn.style.color = 'var(--muted)'; btn.style.background = '#fff'; btn.style.border = '1px solid var(--line2)'; }
      });
    },
    applyMulti(){
      const u = currentUrl();
      const curR = (u.searchParams.get('roles') || '').split(',').filter(Boolean).sort();
      const curC = (u.searchParams.get('country') || '').split(',').filter(Boolean).sort();
      const pr = _pending.roles.slice().sort();
      const pc = _pending.country.slice().sort();
      if (pr.join(',') !== curR.join(',') || pc.join(',') !== curC.join(',')) {
        nav({ roles: _pending.roles.join(',') || null, country: _pending.country.join(',') || null });
        return true;
      }
      return false;
    },
    setStatus(s){ nav({ status: s || null }); },
    setCompany(val){ nav({ company: (val||'').trim() || null }); },
    navDates(df, dt){ nav({ df: df || null, dt: dt || null }); },
    calDay(ds){
      if (!_cal.from || (_cal.from && _cal.to)) { _cal.from = ds; _cal.to = null; }
      else if (ds < _cal.from) { _cal.from = ds; }
      else { _cal.to = ds; }
      this.renderCal();
    },
    calPrev(){ _cal.m--; if (_cal.m < 0){ _cal.m = 11; _cal.y--; } this.renderCal(); },
    calNext(){ _cal.m++; if (_cal.m > 11){ _cal.m = 0; _cal.y++; } this.renderCal(); },
    calApply(){ this.navDates(_cal.from, _cal.to || _cal.from); },
    clearDates(){ this.navDates(null, null); },
    renderCal(){
      const MN = ['January','February','March','April','May','June','July','August','September','October','November','December'];
      const pad = n => String(n).padStart(2,'0');
      const ymd = (y,m,d) => y + '-' + pad(m+1) + '-' + pad(d);
      const first = new Date(_cal.y, _cal.m, 1);
      const startDow = (first.getDay() + 6) % 7; // Monday-first
      const days = new Date(_cal.y, _cal.m + 1, 0).getDate();
      let cells = '';
      for (let i=0;i<startDow;i++) cells += '<div></div>';
      for (let d=1; d<=days; d++){
        const ds = ymd(_cal.y, _cal.m, d);
        const isEnd = ds === _cal.from || ds === _cal.to;
        const inRange = _cal.from && _cal.to && ds > _cal.from && ds < _cal.to;
        const bg = isEnd ? 'var(--accent)' : inRange ? 'var(--accent-soft)' : 'transparent';
        const col = isEnd ? '#fff' : 'var(--ink)';
        cells += '<div onclick="event.stopPropagation();JH.calDay(\''+ds+'\')" style="height:30px;display:grid;place-items:center;border-radius:7px;cursor:pointer;font-size:12px;font-weight:600;background:'+bg+';color:'+col+'">'+d+'</div>';
      }
      const dows = ['Mo','Tu','We','Th','Fr','Sa','Su'].map(w => '<div style="height:22px;display:grid;place-items:center;font-size:10.5px;font-weight:700;color:var(--faintest)">'+w+'</div>').join('');
      const html =
        '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">'
          + '<button type="button" onclick="event.stopPropagation();JH.calPrev()" style="width:26px;height:26px;display:grid;place-items:center;border:0;background:transparent;border-radius:7px;cursor:pointer;color:var(--muted)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m15 6-6 6 6 6"/></svg></button>'
          + '<span style="font-size:12.5px;font-weight:800;color:var(--ink)">'+MN[_cal.m]+' '+_cal.y+'</span>'
          + '<button type="button" onclick="event.stopPropagation();JH.calNext()" style="width:26px;height:26px;display:grid;place-items:center;border:0;background:transparent;border-radius:7px;cursor:pointer;color:var(--muted)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m9 6 6 6-6 6"/></svg></button>'
        + '</div>'
        + '<div style="display:grid;grid-template-columns:repeat(7,1fr);gap:2px;margin-bottom:2px">'+dows+'</div>'
        + '<div style="display:grid;grid-template-columns:repeat(7,1fr);gap:2px">'+cells+'</div>'
        + '<div style="display:flex;align-items:center;justify-content:space-between;margin-top:10px;padding-top:10px;border-top:1px solid var(--line)">'
          + '<button type="button" onclick="event.stopPropagation();JH.clearDates()" style="font-size:12px;font-weight:700;color:var(--muted);background:transparent;border:0;cursor:pointer">Clear</button>'
          + '<button type="button" onclick="event.stopPropagation();JH.calApply()" style="padding:6px 14px;font-size:12px;font-weight:700;color:#fff;background:var(--accent);border:0;border-radius:9px;cursor:pointer">Apply</button>'
        + '</div>';
      document.querySelectorAll('.date-cal').forEach(c => c.innerHTML = html);
    },
    clearAll(){ window.location.href = '<%= basePath %>'; },
    gotoPage(p){ nav({ page: p }, { resetPage: false, keepSelected: true }); },
    select(id){ nav({ selected: id }, { resetPage: false, keepSelected: true }); },
    toggleGroup(gi){
      const body = document.querySelector('.grp-body[data-gi="'+gi+'"]');
      const chev = document.querySelector('.grp-chev[data-gi="'+gi+'"]');
      const open = body.style.display !== 'none';
      body.style.display = open ? 'none' : 'flex';
      if (chev) chev.style.transform = open ? 'rotate(0deg)' : 'rotate(90deg)';
    },
  };
})();

// Outside click: apply any pending multi-select (roles/country); otherwise just close the menus.
document.addEventListener('click', function(e){
  if (!e.target.closest('.filter-btn') && !e.target.closest('.filter-menu')){
    if (!JH.applyMulti()) document.querySelectorAll('.filter-menu').forEach(m => m.style.display = 'none');
  }
});
</script>
