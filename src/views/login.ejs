<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Job Hunter — Login</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gray-50 flex items-center justify-center p-4">
  <div class="w-full max-w-xs mx-auto flex flex-col items-center gap-6 p-8 bg-white rounded-2xl shadow-md">
    <img src="/capy.png" alt="" class="w-28 h-28 object-contain rounded-xl" />

    <div class="w-full text-center">
      <h1 class="text-lg font-semibold text-gray-900">
        <% if (firstRun) { %>Create your account<% } else { %>Sign in<% } %>
      </h1>
      <p class="text-xs text-gray-500 mt-1">
        <% if (firstRun) { %>
          First run — enter your email to create the admin account.
        <% } else { %>
          Enter your email to receive a login code.
        <% } %>
      </p>
    </div>

    <% if (message) { %>
      <p class="w-full text-sm text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg px-3 py-2 text-center -mb-2"><%= message %></p>
    <% } %>
    <% if (error) { %>
      <p class="w-full text-sm text-red-600 bg-red-50 border border-red-200 rounded-lg px-3 py-2 text-center -mb-2"><%= error %></p>
    <% } %>

    <form method="POST" action="/login/request" class="w-full flex flex-col gap-3">
      <input
        type="text"
        inputmode="email"
        name="email"
        placeholder="you@example.com"
        autofocus
        autocomplete="email"
        autocapitalize="off"
        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
      <button
        type="submit"
        class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg transition-colors"
      >
        <% if (firstRun) { %>Create Account<% } else { %>Send Code<% } %>
      </button>
    </form>
  </div>
</body>
</html>
