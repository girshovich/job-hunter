          </span>
          <span class="sb-credits-num">$<%= Number(locals.creditsBalance || 0).toFixed(2) %></span>
          <span class="sb-credits-sub">≈ <%= Math.floor(Math.round(Number(locals.creditsBalance || 0) / 0.2 * 100) / 100) %> runs</span>
          <button class="sb-credits-topup" type="button" onclick="jhTopUp()">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            Top up
          </button>
        </div>
        <div id="topup-msg" style="position:absolute;bottom:120px;left:50%;transform:translateX(-50%);background:#1e2535;color:#a0aec0;font-size:11px;padding:6px 12px;border-radius:6px;white-space:nowrap;box-shadow:0 2px 8px rgba(0,0,0,0.35);pointer-events:none;opacity:0;transition:opacity 0.25s ease;">Awaiting Paddle approval, coming soon!</div>
        <% } %>
        <script>
          function jhTopUp() {
            var el = document.getElementById('topup-msg');
            if (!el) {
              alert('Top-up is coming soon!');
              return;
            }
            el.style.opacity = '1';
            clearTimeout(el._t);
            el._t = setTimeout(function(){ el.style.opacity = '0'; }, 3000);
          }
        </script>

