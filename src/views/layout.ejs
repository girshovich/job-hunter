    async function openRunModal() {
      document.getElementById('run-modal').classList.remove('hidden');
      document.getElementById('run-modal-msg').classList.add('hidden');
      document.getElementById('run-modal-submit').disabled = false;
      document.getElementById('run-modal-groups').innerHTML = '<span class="text-sm text-gray-400">Loading…</span>';
      document.getElementById('run-provider-options').innerHTML = '<span class="text-sm text-gray-400">Loading…</span>';

      const [schedRes, groupsRes] = await Promise.allSettled([
        fetch('/api/schedule/status'),
        fetch('/api/groups'),
      ]);

      // Restore last-used Run Once date range + provider selection (saved by the last Run)
      let runDateRange = '24h';
      let savedProviders = null;
      if (schedRes.status === 'fulfilled') {
        try {
          const sched = await schedRes.value.json();
          runDateRange = sched.run_date_range || '24h';
          savedProviders = sched.run_providers;
        } catch (_) {}
      }
      setRunDateRange(runDateRange);
      renderRunProviders(savedProviders || DEFAULT_PROVIDER_VALUES);

      if (groupsRes.status === 'fulfilled') {
        try { renderRunGroups((await groupsRes.value.json()).groups || []); }
        catch (_) { document.getElementById('run-modal-groups').innerHTML = '<span class="text-sm text-red-500">Failed to load roles.</span>'; }
      } else {
        document.getElementById('run-modal-groups').innerHTML = '<span class="text-sm text-red-500">Failed to load roles.</span>';
      }
    }

    function closeRunModal() {
      document.getElementById('run-modal').classList.add('hidden');
      closeRunRolePicker();
      closeRunProviderPicker();
      const submitBtn = document.getElementById('run-modal-submit');
      if (submitBtn.dataset.originalHtml) {
        submitBtn.innerHTML = submitBtn.dataset.originalHtml;
        submitBtn.dataset.originalHtml = '';
      }
      submitBtn.disabled = false;
    }

    async function submitRun() {
      const groupStates = _runGroups.map(g => ({
        id: parseInt(g.id, 10),
        is_active: !!g.is_active,
      }));
      const groupIds = groupStates.filter(g => g.is_active).map(g => g.id);

      const dateRange = _runDateRange;
      const providers = _runProviders.filter(p => p.checked).map(p => p.value);

      const submitBtn = document.getElementById('run-modal-submit');
      const msgEl = document.getElementById('run-modal-msg');

      if (providers.length === 0) {
        msgEl.textContent = 'Select at least one provider.';
        msgEl.classList.remove('hidden');
        return;
      }

      if (groupIds.length === 0) {
        msgEl.textContent = 'Select at least one role.';
        msgEl.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.dataset.originalHtml = submitBtn.innerHTML;
      submitBtn.textContent = 'Starting…';
      msgEl.classList.add('hidden');

      try {
        // Pass the selected roles explicitly, so the run uses them without depending on
        // the is_active writes below having landed first.
        const res = await fetch('/api/run', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dateRange, providers, groupIds }),
        });
        const data = await res.json();

        closeRunModal();

        if (!data.success) {
          await showAlert(data.error || 'Failed to start pipeline.');
          return;
        }

        // Only once the run is accepted, persist is_active (syncs with settings page) —
        // a rejected run (e.g. one already in progress in another tab) must not overwrite it.
        await Promise.all(groupStates.map(({ id, is_active }) =>
          fetch('/api/groups/' + id, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ is_active }),
          })
        ));

        if (typeof _runCallback === 'function') {
          // Started from the Start page's own button — it shows the progress itself.
          _runCallback();
          _runCallback = null;
        } else if (window.location.pathname === '/') {
          // Started from the sidebar while already on Start: show progress in place.
          startHomeProgress();
        } else {
          // Started from the sidebar on another page: land on Start, where syncRunState()
          // picks the run up from /api/status and paints the progress card.
          window.location.href = '/';
          return;
        }

        if (window.jhSyncSidebarRunBtn) window.jhSyncSidebarRunBtn();   // grey out Run once now, not on next reload
      } catch (e) {
        closeRunModal();
        await showAlert('Network error. Could not reach the server.');
      }
    }

    // Restore schedule state on every page load (also populates _scheduleData for status modal)
    fetch('/api/schedule/status').then(r => r.json()).then(data => {
      _scheduleData = data;
      setScheduleUI(data.active, data.expression, data.timezone);
    }).catch(() => {});


    // Close modals on Escape
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        closeScheduleModal();
        closeScheduleStatusModal();
        closeRunModal();
        closeVerdictDropdown();
        if (_jhConfirmResolve) _jhConfirmResolve(false);
        if (_jhAlertResolve) _jhAlertResolve();
      }
    });

    // ---- Clickable row helper ----
    function jobRowClick(event, url) {
      if (event.target.closest('.verdict-btn') || event.target.closest('a') || event.target.closest('button')) return;
      if (event.metaKey || event.ctrlKey) { window.open(url, '_blank'); return; }
      location.href = url;
    }

    // ---- Styled confirm / alert helpers ----
    let _jhConfirmResolve = null;
    function showConfirm(msg) {
      return new Promise(resolve => {
        _jhConfirmResolve = (v) => {
          document.getElementById('jh-confirm-modal').classList.add('hidden');
          resolve(v);
        };
        document.getElementById('jh-confirm-msg').textContent = msg;
        document.getElementById('jh-confirm-modal').classList.remove('hidden');
      });
    }

    let _jhAlertResolve = null;
    function showAlert(msg) {
      return new Promise(resolve => {
        _jhAlertResolve = () => {
          document.getElementById('jh-alert-modal').classList.add('hidden');
          resolve();
        };
        document.getElementById('jh-alert-msg').textContent = msg;
        document.getElementById('jh-alert-modal').classList.remove('hidden');
      });
    }

    // ---- Verdict dropdown ----
    let _verdictBtn = null;

    function openVerdictDropdown(btn) {
      _verdictBtn = btn;
      const dd = document.getElementById('verdict-dropdown');
      dd.classList.remove('hidden');
      const rect = btn.getBoundingClientRect();
      const ddW = 160;
      let left = rect.left;
      if (left + ddW > window.innerWidth - 8) left = window.innerWidth - ddW - 8;
      dd.style.top  = (rect.bottom + 4) + 'px';
      dd.style.left = left + 'px';
    }

    function closeVerdictDropdown() {
      document.getElementById('verdict-dropdown').classList.add('hidden');
      _verdictBtn = null;
    }

    document.addEventListener('click', e => {
      const dd = document.getElementById('verdict-dropdown');
      if (!dd.classList.contains('hidden') && !dd.contains(e.target) && !e.target.closest('.verdict-btn')) {
        closeVerdictDropdown();
      }
    });

    document.addEventListener('click', e => {
      const btn = e.target.closest('.verdict-btn');
      if (btn) { e.stopPropagation(); openVerdictDropdown(btn); }
    });

    // The sidebar Matches badge counts un-applied strong matches, so both the verdict and the
    // applied endpoints return the recomputed number — repaint it instead of reloading the page.
    function updateMatchesBadge(count) {
      const el = document.getElementById('sb-matches-count');
      if (!el || typeof count !== 'number') return;
      el.textContent = String(count);
      el.hidden = count === 0;
    }

    /** The three Matches shortcut counts, repainted from the same response as the badge. */
    function updateShortcutCounts(counts) {
      if (!Array.isArray(counts)) return;
      counts.forEach(function (c) {
        const el = document.querySelector('.sb-subcount[data-shortcut="' + c.id + '"]');
        if (el) el.textContent = String(c.count);
      });
    }

    function verdictChipHTML(verdict, style) {
      const label = window.JHUI.formatVerdictLabel(verdict) + (window.JHUI.isVerdictEditable(verdict) ? ' \u25be' : '');
      return '<span style="display:inline-flex;align-items:center;gap:3px;height:22px;padding:0 8px;border-radius:7px;font-size:11.5px;font-weight:700;white-space:nowrap;' + window.JHUI.getVerdictChipStyle(verdict) + '">' + label + '</span>';
    }

    async function setVerdict(newVerdict) {
      const btn = _verdictBtn;
      if (!btn) return;
      const jobId  = btn.dataset.jobId;
      const logId  = btn.dataset.logId;
      const current = btn.dataset.verdict;
      closeVerdictDropdown();
      if (newVerdict === current) return;
      const ok = await showConfirm('Change the verdict to "' + window.JHUI.formatVerdictLabel(newVerdict) + '"?');
      if (!ok) return;
      try {
        const endpoint = jobId ? '/api/jobs/' + jobId + '/verdict' : '/api/run-log/' + logId + '/verdict';
        const res = await fetch(endpoint, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ verdict: newVerdict }),
        });
        const data = await res.json();
        if (data.success) {
          updateMatchesBadge(data.matchesCount);
          if (data.internal_job_id && !btn.dataset.jobId) {
            btn.dataset.jobId = String(data.internal_job_id);
          }
          const jid = btn.dataset.jobId;
          // If this job is open in the detail pane, its verdict-toned blocks (score chip, General
          // AI analysis box, applied-selector visibility) must re-render too — reload so both panes
          // stay consistent. This covers changing the verdict from the detail OR from the open
          // job's list card.
          if (jid && document.querySelector('.verdict-btn[data-job-id="' + jid + '"][data-chip-style="detail"]')) {
            location.reload();
            return;
          }
          // Otherwise repaint the verdict chip everywhere this job appears (the list card, etc.).
          const targets = jid ? document.querySelectorAll('.verdict-btn[data-job-id="' + jid + '"]') : [btn];
          targets.forEach(b => {
            b.dataset.verdict = newVerdict;
            b.innerHTML = verdictChipHTML(newVerdict, b.dataset.chipStyle || 'compact');
          });
        } else {
          await showAlert(data.error || 'Failed to update the verdict');
        }
      } catch (e) {
        await showAlert('Could not reach the server. Make sure the app is running and try again.');
      }
    }

    // ---- Status picker ----
    // One picker serves the card chip, the pane chip and the rail's `＋`. Which statuses it
    // offers first comes from the user's own order, never from a guess about what comes next
    // (D21). `New` never appears — it is written by the fetch and cannot be picked twice (D34).
    window.JH_STATUSES = <%- JSON.stringify(locals.statusList || []) %>;
    let _statusBtn = null;
    let _statusOnPick = null;

    function statusPickerRows(currentId) {
      const all = (window.JH_STATUSES || []).filter(s => s.type !== 'new');
      // "Move on" is everything below the current status in the user's arranged list. It claims
      // no path — it is just the half of the list they are most likely to reach for next.
      const byOrder = all.slice().sort((a, b) => a.order - b.order);
      const at = byOrder.findIndex(s => String(s.id) === String(currentId));
      const ahead = at < 0 ? byOrder : byOrder.slice(at + 1);
      const rest  = at < 0 ? []      : byOrder.slice(0, at);
      const row = s => '<button type="button" class="sp-row" data-pick="' + s.id + '">'
        + '<span class="sp-dot" style="background:' + window.JHUI.getStatusDot(s.type) + '"></span>'
        + esc(s.name) + '</button>';
      let html = '';
      if (ahead.length) html += '<div class="sp-lbl">Move on</div>' + ahead.map(row).join('');
      if (rest.length)  html += (ahead.length ? '<div class="sp-sep"></div>' : '')
        + '<div class="sp-lbl">Anything else</div>' + rest.map(row).join('');
      return html || '<div class="sp-lbl">No statuses</div>';
    }
    function esc(v) {
      return String(v == null ? '' : v).replace(/[&<>"]/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));
    }

    function openStatusPicker(btn, onPick) {
      _statusBtn = btn;
      _statusOnPick = onPick || null;
      const wrap  = document.getElementById('status-picker');
      const panel = document.getElementById('status-picker-panel');
      const back  = document.getElementById('status-picker-backdrop');
      panel.innerHTML = statusPickerRows(btn.dataset.statusId);
      wrap.classList.remove('hidden');
      const mobile = window.innerWidth < 768;
      back.classList.toggle('hidden', !mobile);
      if (!mobile) {
        const rect = btn.getBoundingClientRect();
        const w = panel.offsetWidth || 206;
        let left = Math.min(rect.left, window.innerWidth - w - 12);
        let top = rect.bottom + 4;
        const h = panel.offsetHeight;
        if (top + h + 12 > window.innerHeight && rect.top - h - 6 > 0) top = rect.top - h - 6;
        panel.style.left = Math.max(8, left) + 'px';
        panel.style.top  = top + 'px';
      }
      panel.querySelectorAll('[data-pick]').forEach(b => {
        b.onclick = ev => { ev.stopPropagation(); setJobStatus(Number(b.dataset.pick)); };
      });
    }

    function closeStatusPicker() {
      document.getElementById('status-picker').classList.add('hidden');
      _statusBtn = null;
      _statusOnPick = null;
    }

    document.addEventListener('click', e => {
      const wrap = document.getElementById('status-picker');
      if (!wrap.classList.contains('hidden') && !wrap.contains(e.target) && !e.target.closest('.status-btn')) {
        closeStatusPicker();
      }
    });
    document.addEventListener('click', e => {
      const btn = e.target.closest('.status-btn');
      if (btn) { e.stopPropagation(); openStatusPicker(btn); }
    });
    // The two exits that set a status go straight there — no picker, that is the point of them.
    document.addEventListener('click', e => {
      const btn = e.target.closest('.exit-btn');
      if (!btn) return;
      e.stopPropagation();
      _statusBtn = btn;
      _statusOnPick = null;
      setJobStatus(Number(btn.dataset.exitStatus));
    });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeStatusPicker(); });

    function statusChipHTML(status, age, full) {
      const width = full ? 'width:100%;justify-content:center;' : '';
      const ageHtml = age ? '<span style="opacity:.72;font-weight:600"> \u00b7 ' + esc(age) + '</span>' : '';
      return '<span style="display:inline-flex;align-items:center;gap:4px;height:24px;padding:0 10px;border-radius:8px;font-size:11.5px;font-weight:700;white-space:nowrap;'
        + width + window.JHUI.getStatusChipStyle(status.type) + '">' + esc(status.name) + ageHtml + ' \u25be</span>';
    }

    /** Repaint every chip for this job, on the card and in the pane — they share data-job-id. */
    function paintStatus(jobId, status, age) {
      document.querySelectorAll('.status-btn[data-job-id="' + jobId + '"]').forEach(b => {
        b.dataset.statusId = String(status.id);
        b.dataset.statusType = status.type;
        b.innerHTML = statusChipHTML(status, b.dataset.chipStyle === 'detail' ? '' : age, b.dataset.chipStyle === 'detail');
      });
    }

    async function setJobStatus(statusId) {
      const btn = _statusBtn;
      const after = _statusOnPick;
      if (!btn) return;
      const jobId = btn.dataset.jobId;
      closeStatusPicker();
      try {
        const res = await fetch('/api/jobs/' + jobId + '/status', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status_id: statusId }),
        });
        const data = await res.json();
        if (data.success) {
          updateMatchesBadge(data.matchesCount);
          updateShortcutCounts(data.shortcutCounts);
          if (after) { after(data); return; }
          if (data.status) paintStatus(jobId, data.status, window.JHUI.formatStatusAge(0, data.status.type));
          if (window.onStatusChanged) { try { window.onStatusChanged(jobId, data); } catch (e) {} }
          // The standalone /job/:id page has no pane to swap — the rail is the page, so it
          // re-renders the only way it can.
          else if (document.querySelector('.pane-exits, .hist')) window.location.reload();
        } else {
          await showAlert(data.error || 'Failed to update the status');
        }
      } catch (e) {
        await showAlert('Could not reach the server. Make sure the app is running and try again.');
      }
    }

    // ── The step editor ────────────────────────────────────────────────────────────────────
    //
    // One popover doing all three jobs — change the step's status, move its date, delete it — with
    // no second menu and no separate delete mode (D30). The date field is a trigger, not a text
    // box: pressing it swaps this same surface to the calendar and a back link returns. Nesting a
    // second popover inside the editor would put two dismiss layers on top of each other; one
    // surface with two faces has neither problem.
    let _stepPop = null;
    let _stepState = null;

    function closeStepEditor() {
      if (_stepPop) { _stepPop.remove(); _stepPop = null; }
      _stepState = null;
    }
    document.addEventListener('click', e => {
      if (_stepPop && !_stepPop.contains(e.target) && !e.target.closest('.rstep')) closeStepEditor();
    });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeStepEditor(); });

    document.addEventListener('click', e => {
      const step = e.target.closest('.rstep[data-step-id]');
      if (!step) return;
      e.stopPropagation();
      const rail = step.closest('.hist');
      openStepEditor(step, {
        eventId: Number(step.dataset.stepId),
        jobId: Number(rail.dataset.jobId),
        statusId: Number(step.dataset.stepStatus),
        date: step.dataset.stepDate,
        cal: false,
      });
    });

    function stepEditorPop(anchorEl) {
      closeStepEditor();
      const p = document.createElement('div');
      p.className = 'stepedit';
      p.style.cssText = 'position:absolute;z-index:60;background:#fff;border:1px solid #e4e6ec;'
        + 'border-radius:12px;box-shadow:var(--shadow-dropdown)';
      document.body.appendChild(p);
      _stepPop = p;
      return p;
    }
    function placeStepPop(p, anchorEl) {
      const r = anchorEl.getBoundingClientRect();
      const w = p.offsetWidth, h = p.offsetHeight;
      let left = Math.min(r.left + window.scrollX, window.scrollX + document.documentElement.clientWidth - w - 12);
      let top = r.bottom + window.scrollY + 6;
      if (r.bottom + h + 12 > window.innerHeight && r.top - h - 6 > 0) top = r.top + window.scrollY - h - 6;
      p.style.left = Math.max(8, left) + 'px';
      p.style.top = top + 'px';
    }

    function openStepEditor(anchorEl, st) {
      _stepState = st;
      const p = stepEditorPop(anchorEl);
      const all = (window.JH_STATUSES || []).filter(x => x.type !== 'new');

      if (st.cal) {
        p.innerHTML = '<div class="date-cal" style="width:234px"></div>';
        placeStepPop(p, anchorEl);
        // JHCal in single-date mode (D47). `allowFuture` is left at its default, so future days
        // are greyed and unclickable and the next-month chevron disables past today — the newest
        // step IS the current status, so a date next Tuesday would make an unbooked interview
        // today's status (D9).
        const cal = JHCal.attach({
          root: p.querySelector('.date-cal'),
          from: st.date, to: st.date,
          single: true,
          backLabel: 'Back to the step',
          note: 'Future dates are blocked — the newest step is the current status.',
          onPick: d => openStepEditor(anchorEl, Object.assign({}, st, { date: d, cal: false })),
          onBack: () => openStepEditor(anchorEl, Object.assign({}, st, { cal: false })),
        });
        cal.render();
        placeStepPop(p, anchorEl);
        return;
      }

      // The guard rail of §5 Trap 2, shown at the moment it applies. The rule is "the newest step
      // is where you are now", so the thing worth warning about is a save that changes WHICH step
      // is newest — in either direction. Moving a step up to the front is the obvious case; moving
      // the current step back down is the one that used to change the job's status with nothing
      // said about it.
      const rail = anchorEl.closest('.hist');
      const editable = Array.prototype.slice.call(rail.querySelectorAll('.rstep[data-step-id]'));
      const byId = x => (window.JH_STATUSES || []).find(y => String(y.id) === String(x));
      const nameOf = id => { const s = byId(id); return s ? s.name : ''; };
      const nowNewest = editable.length ? editable[editable.length - 1] : null;
      // What the log would look like after this save, sorted the way the server sorts it.
      const after = editable
        .map(el => el === anchorEl
          ? { date: st.date, statusId: String(st.statusId), self: true }
          : { date: el.dataset.stepDate, statusId: el.dataset.stepStatus, self: false })
        .sort((a, b) => a.date < b.date ? -1 : a.date > b.date ? 1 : 0);
      const willBeNewest = after.length ? after[after.length - 1] : null;
      const currentName = nowNewest ? nameOf(nowNewest.dataset.stepStatus) : '';
      const nextName = willBeNewest ? nameOf(willBeNewest.statusId) : '';
      const changesCurrent = willBeNewest && nextName && nextName !== currentName;
      const warn = changesCurrent
        ? '<div class="warn"><span>\u26a0</span><span>This makes <b>' + esc(nextName)
          + '</b> the newest step. The job will show <b>' + esc(nextName) + '</b>.</span></div>'
        : '';

      let lastType = null;
      const options = all.map(x => {
        let out = '';
        if (x.type !== lastType) {
          if (lastType !== null) out += '</optgroup>';
          out += '<optgroup label="' + esc(x.typeLabel) + '">';
          lastType = x.type;
        }
        return out + '<option value="' + x.id + '"' + (String(x.id) === String(st.statusId) ? ' selected' : '') + '>' + esc(x.name) + '</option>';
      }).join('') + (lastType !== null ? '</optgroup>' : '');

      p.innerHTML = '<div class="et">Edit step</div>'
        + '<div class="fr"><label>Status</label><select data-step-select>' + options + '</select></div>'
        + '<div class="fr"><label>Date</label><button type="button" class="dateinput" data-step-cal>'
          + esc(prettyStepDate(st.date))
          + '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--faint)" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>'
        + '</button></div>'
        + warn
        + '<div class="ef"><button type="button" class="eb del" data-step-del>Delete step</button>'
          + '<button type="button" class="eb ghost" data-step-cancel>Cancel</button>'
          + '<button type="button" class="eb pri" data-step-save>Save</button></div>';
      placeStepPop(p, anchorEl);

      p.querySelector('[data-step-select]').onchange = ev => {
        openStepEditor(anchorEl, Object.assign({}, st, { statusId: Number(ev.target.value) }));
      };
      p.querySelector('[data-step-cal]').onclick = ev => {
        ev.stopPropagation();
        openStepEditor(anchorEl, Object.assign({}, st, { cal: true }));
      };
      p.querySelector('[data-step-cancel]').onclick = ev => { ev.stopPropagation(); closeStepEditor(); };
      p.querySelector('[data-step-save]').onclick = ev => { ev.stopPropagation(); saveStep(st); };
      p.querySelector('[data-step-del]').onclick = ev => { ev.stopPropagation(); deleteStep(st); };
    }

    // The fold is a phone affordance only; on a desktop every step is already on screen (D31).
    document.addEventListener('click', e => {
      const f = e.target.closest('.rfold');
      if (!f) return;
      e.stopPropagation();
      const rail = f.closest('.rail');
      if (rail) rail.classList.add('is-open');
    });

    function prettyStepDate(iso) {
      const d = new Date(String(iso).slice(0, 10) + 'T12:00:00Z');
      if (isNaN(d.getTime())) return String(iso);
      return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
    }

    // Saving or deleting a step reorders the log, which can move the current status with it, so
    // the whole pane is reloaded rather than patched — the rail, the chip, the corner and the
    // action buttons all derive from that one answer.
    async function refreshDetailPane(jobId) {
      const host = document.getElementById('jh-pane');
      if (host && window.JH && typeof window.JH.reloadPane === 'function') { window.JH.reloadPane(jobId); return; }
      window.location.reload();
    }

    async function saveStep(st) {
      closeStepEditor();
      try {
        const res = await fetch('/api/history/' + st.eventId, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status_id: st.statusId, changed_at: st.date }),
        });
        const data = await res.json();
        if (!data.success) { await showAlert(data.error || 'Failed to save the step'); return; }
        updateMatchesBadge(data.matchesCount);
        updateShortcutCounts(data.shortcutCounts);
        refreshDetailPane(st.jobId);
      } catch (e) {
        await showAlert('Could not reach the server. Make sure the app is running and try again.');
      }
    }

    async function deleteStep(st) {
      closeStepEditor();
      // Deleting the last step promotes the one before it; deleting them all returns the job to
      // New. Both happen server-side, in the same transaction as the delete (DP10, DP12).
      const ok = await showConfirm('Delete this step?');
      if (!ok) return;
      try {
        const res = await fetch('/api/history/' + st.eventId, { method: 'DELETE' });
        const data = await res.json();
        if (!data.success) { await showAlert(data.error || 'Failed to delete the step'); return; }
        updateMatchesBadge(data.matchesCount);
        updateShortcutCounts(data.shortcutCounts);
        refreshDetailPane(st.jobId);
      } catch (e) {
        await showAlert('Could not reach the server. Make sure the app is running and try again.');
      }
    }

    function openProfileSheet() {
      document.getElementById('profile-sheet').classList.remove('hidden');
    }
    function closeProfileSheet() {
      document.getElementById('profile-sheet').classList.add('hidden');
    }

    // ── The sidebar column: Settings, the onboarding widget, and making them fit ──────────
    //
    // Two blocks want to be open at once and the column is not always tall enough for both. It
    // never scrolls and nothing is ever clipped (D33), so it yields in a FIXED order instead:
    //
    //   ≥800px   both open
    //   700–800  the onboarding widget drops to its one row
    //   660–700  if the user reopens the widget, Settings collapses instead — reopening it was an
    //            explicit choice, and Settings is one click back
    //   <660     one of the two stays collapsed and the column says which and why, rather than
    //            silently undoing a click
    //
    // The widget yields first because it is temporary by definition; Settings is not (D51).
    (function () {
      const SET_KEY = 'jh_settings_open';
      const ONB_MINI_KEY = 'jh_onboarding_mini';
      const DISMISS_KEY = 'jh_onboarding_dismissed';

      const settingsSub  = document.getElementById('sb-settings-sub');
      const settingsChev = document.getElementById('sb-settings-chev');
      const widget = document.getElementById('sb-onboard-widget');
      const fitNote = document.getElementById('sb-fit-note');
      const nav = document.querySelector('.sb-nav-scroll');

      // What the user asked for. What actually renders may be less, and only because of height.
      let settingsWanted = localStorage.getItem(SET_KEY) !== '0';
      let widgetWanted   = localStorage.getItem(ONB_MINI_KEY) !== '1';

      if (widget && localStorage.getItem(DISMISS_KEY)) widget.style.display = 'none';

      function paint(settingsOpen, widgetOpen, note) {
        if (settingsSub)  settingsSub.style.display = settingsOpen ? '' : 'none';
        if (settingsChev) settingsChev.classList.toggle('open', settingsOpen);
        if (widget) widget.classList.toggle('mini', !widgetOpen);
        if (fitNote) fitNote.classList.toggle('hidden', !note);
      }

      // Does the column fit as currently painted? Measured, not assumed — the nav's own scroll
      // height against the room it has.
      function overflows() {
        return !!nav && nav.scrollHeight > nav.clientHeight + 1;
      }

      function fit() {
        if (!nav) { paint(settingsWanted, widgetWanted, false); return; }
        // Try what the user asked for.
        paint(settingsWanted, widgetWanted, false);
        if (!overflows()) return;
        // The widget yields first: it is temporary by definition.
        if (widgetWanted) {
          paint(settingsWanted, false, false);
          if (!overflows()) return;
        }
        // Still short, and the user explicitly reopened the widget: Settings gives way instead,
        // because it is one click back and the widget was the deliberate choice.
        if (widgetWanted && settingsWanted) {
          paint(false, true, false);
          if (!overflows()) return;
        }
        // Nothing fits both. Keep the widget's own choice, collapse the other, and SAY so.
        paint(false, widgetWanted, widgetWanted);
        if (!overflows()) return;
        paint(false, false, false);
      }

      window.jhToggleSettings = function () {
        settingsWanted = !settingsWanted;
        localStorage.setItem(SET_KEY, settingsWanted ? '1' : '0');
        fit();
      };
      window.jhToggleOnboarding = function () {
        widgetWanted = !widgetWanted;
        localStorage.setItem(ONB_MINI_KEY, widgetWanted ? '0' : '1');
        fit();
      };
      window.jhDismissOnboarding = function () {
        localStorage.setItem(DISMISS_KEY, '1');
        if (widget) widget.style.display = 'none';
        fit();
      };

      fit();
      window.addEventListener('resize', fit);
    })();

    // ── The profile menu (D43) ──────────────────────────────────────
    (function () {
      const menu = document.getElementById('sb-profile-menu');
      if (!menu) return;
      window.jhToggleProfileMenu = function (e) {
        if (e) e.stopPropagation();
        menu.classList.toggle('hidden');
      };
      document.addEventListener('click', function (ev) {
        if (!menu.classList.contains('hidden') && !menu.contains(ev.target)) menu.classList.add('hidden');
      });
      document.addEventListener('keydown', function (ev) {
        if (ev.key === 'Escape') menu.classList.add('hidden');
      });
    })();

    // ── Onboarding actions: land on Start, then open the modal ──────
    (function () {
      const onStart = window.location.pathname === '/';

      window.jhOnboardRun = async function () {
        if (!onStart) { window.location.href = '/?run=1'; return; }
        // A run is already in progress: Start shows its live progress, so no modal.
        try {
          const data = await (await fetch('/api/status')).json();
          if (data.isRunning) return;
        } catch (e) { /* status unreachable — let the run modal handle it */ }
        openRunModal();
      };

      window.jhOnboardSchedule = function () {
        if (!onStart) { window.location.href = '/?schedule=1'; return; }
        handleScheduleClick();
      };

      const params = new URLSearchParams(window.location.search);
      const wantsRun = params.get('run') === '1';
      const wantsSchedule = params.get('schedule') === '1';
      if (wantsRun || wantsSchedule) {
        params.delete(wantsRun ? 'run' : 'schedule');
        const qs = params.toString();
        history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : ''));
        window.addEventListener('DOMContentLoaded', wantsRun ? jhOnboardRun : jhOnboardSchedule);
      }
    })();

    // ── Sidebar "Run once": disabled while a run is in progress ─────
    // A run can also be started by the schedule or in another tab, so this reflects server state
    // rather than what this page did. Stopping a run lives on Start, next to the progress bar.
    (function () {
      let poller = null;

      // Rendered disabled when the profile cannot pay for a run; that lock outranks the
      // run-in-progress state, which must never re-enable the button on the next poll.
      const paymentLocked = <%= locals.canRun === false ? 'true' : 'false' %>;

      function apply(isRunning) {
        const btn = document.getElementById('sidebar-run-btn');
        if (!btn) return;
        if (paymentLocked) return;
        btn.disabled = isRunning;
        btn.title = isRunning ? 'Run in progress — open Start to stop it' : '';
        document.getElementById('sidebar-run-label').textContent = isRunning ? 'Running…' : 'Run once';
      }

      async function check() {
        let isRunning = false;
        try {
          isRunning = !!(await (await fetch('/api/status')).json()).isRunning;
        } catch (e) { return; }   // server unreachable — leave the button as it is
        apply(isRunning);
        if (isRunning && !poller) poller = setInterval(check, 3000);
        else if (!isRunning && poller) { clearInterval(poller); poller = null; }
      }
      window.jhSyncSidebarRunBtn = check;   // submitRun() calls this the moment a run is accepted

      window.addEventListener('DOMContentLoaded', check);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) check(); });
    })();
  </script>
  <%- include('partials/_analytics') %>
</body>
</html>
