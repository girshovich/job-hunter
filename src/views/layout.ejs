    }

    function setAllRunProviders(checked) {
      _runProviders = _runProviders.map(p => ({ ...p, checked }));
      renderRunProviderPicker();
    }

    async function openRunModal() {
      document.getElementById('run-modal').classList.remove('hidden');
      document.getElementById('run-modal-msg').classList.add('hidden');
      document.getElementById('run-modal-submit').disabled = false;
      document.getElementById('run-modal-groups').innerHTML = '<span class="text-sm text-gray-400">Loading…</span>';
      document.getElementById('run-provider-options').innerHTML = '<span class="text-sm text-gray-400">Loading…</span>';
      setRunDateRange('24h');

      const [schedRes, groupsRes] = await Promise.allSettled([
        fetch('/api/schedule/status'),
        fetch('/api/groups'),
      ]);

      // Restore last-used provider selection; fall back to all checked
      let savedProviders = null;
      if (schedRes.status === 'fulfilled') {
        try { savedProviders = (await schedRes.value.json()).scraping_providers; } catch (_) {}
      }
      renderRunProviders(savedProviders || SCHED_PROVIDER_OPTIONS.map(p => p.value));

      if (groupsRes.status === 'fulfilled') {
        try { renderRunGroups((await groupsRes.value.json()).groups || []); }
        catch (_) { document.getElementById('run-modal-groups').innerHTML = '<span class="text-sm text-red-500">Failed to load roles.</span>'; }
      } else {
        document.getElementById('run-modal-groups').innerHTML = '<span class="text-sm text-red-500">Failed to load roles.</span>';
      }
    }

    function closeRunModal() {
      document.getElementById('run-modal').classList.add('hidden');
      closeRunRolePicker();
      closeRunProviderPicker();
    }

    async function submitRun() {
      const groupStates = _runGroups.map(g => ({
        id: parseInt(g.id, 10),
        is_active: !!g.is_active,
      }));

      const dateRange = _runDateRange;
      const providers = _runProviders.filter(p => p.checked).map(p => p.value);

      const submitBtn = document.getElementById('run-modal-submit');
      const msgEl = document.getElementById('run-modal-msg');

      if (providers.length === 0) {
        msgEl.textContent = 'Select at least one provider.';
        msgEl.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Starting…';
      msgEl.classList.add('hidden');

      try {
        // Save is_active states (syncs with settings page)
        await Promise.all(groupStates.map(({ id, is_active }) =>
          fetch('/api/groups/' + id, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ is_active }),
          })
        ));

        const res = await fetch('/api/run', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dateRange, providers }),
        });
        const data = await res.json();

        closeRunModal();

        if (data.success) {
          if (typeof _runCallback === 'function') {
            _runCallback();
            _runCallback = null;
          } else {
            // Sidebar feedback
            const label = document.getElementById('sidebar-run-label');
            const sidebarBtn = document.getElementById('sidebar-run-btn');
            if (label) label.textContent = 'Running…';
            if (sidebarBtn) sidebarBtn.disabled = true;
            setTimeout(() => {
              if (label) label.textContent = 'Run Once';
              if (sidebarBtn) sidebarBtn.disabled = false;
            }, 5000);
          }
        } else {
          await showAlert(data.error || 'Failed to start pipeline.');
        }
      } catch (e) {
        closeRunModal();
        await showAlert('Network error. Could not reach the server.');
      }
    }

    // Restore schedule state on every page load (also populates _scheduleData for status modal)
    fetch('/api/schedule/status').then(r => r.json()).then(data => {
      _scheduleData = data;
      setScheduleUI(data.active, data.expression, data.timezone);
    }).catch(() => {});


    // Close modals on Escape
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        closeScheduleModal();
        closeScheduleStatusModal();
        closeRunModal();
        closeVerdictDropdown();
        if (_jhConfirmResolve) _jhConfirmResolve(false);
        if (_jhAlertResolve) _jhAlertResolve();
      }
    });

    // ---- Clickable row helper ----
    function jobRowClick(event, url) {
      if (event.target.closest('.verdict-btn') || event.target.closest('a') || event.target.closest('button')) return;
      if (event.metaKey || event.ctrlKey) { window.open(url, '_blank'); return; }
      location.href = url;
    }

    // ---- Styled confirm / alert helpers ----
    let _jhConfirmResolve = null;
    function showConfirm(msg) {
      return new Promise(resolve => {
        _jhConfirmResolve = (v) => {
          document.getElementById('jh-confirm-modal').classList.add('hidden');
          resolve(v);
        };
        document.getElementById('jh-confirm-msg').textContent = msg;
        document.getElementById('jh-confirm-modal').classList.remove('hidden');
      });
    }

    let _jhAlertResolve = null;
    function showAlert(msg) {
      return new Promise(resolve => {
        _jhAlertResolve = () => {
          document.getElementById('jh-alert-modal').classList.add('hidden');
          resolve();
        };
        document.getElementById('jh-alert-msg').textContent = msg;
        document.getElementById('jh-alert-modal').classList.remove('hidden');
      });
    }

    // ---- Verdict dropdown ----
    let _verdictBtn = null;

    function openVerdictDropdown(btn) {
      _verdictBtn = btn;
      const dd = document.getElementById('verdict-dropdown');
      dd.classList.remove('hidden');
      const rect = btn.getBoundingClientRect();
      const ddW = 160;
      let left = rect.left;
      if (left + ddW > window.innerWidth - 8) left = window.innerWidth - ddW - 8;
      dd.style.top  = (rect.bottom + 4) + 'px';
      dd.style.left = left + 'px';
    }

    function closeVerdictDropdown() {
      document.getElementById('verdict-dropdown').classList.add('hidden');
      _verdictBtn = null;
    }

    document.addEventListener('click', e => {
      const dd = document.getElementById('verdict-dropdown');
      if (!dd.classList.contains('hidden') && !dd.contains(e.target) && !e.target.closest('.verdict-btn')) {
        closeVerdictDropdown();
      }
    });

    document.addEventListener('click', e => {
      const btn = e.target.closest('.verdict-btn');
      if (btn) { e.stopPropagation(); openVerdictDropdown(btn); }
    });

    function verdictChipHTML(verdict, style) {
      const base = 'inline-flex h-7 items-center justify-center rounded-lg px-2 text-xs font-medium whitespace-nowrap';
      const label = window.JHUI.formatVerdictLabel(verdict) + (window.JHUI.isVerdictEditable(verdict) ? ' \u25be' : '');
      return '<span class="' + base + ' ' + window.JHUI.getVerdictTone(verdict) + '">' + label + '</span>';
    }

    async function setVerdict(newVerdict) {
      const btn = _verdictBtn;
      if (!btn) return;
      const jobId  = btn.dataset.jobId;
      const logId  = btn.dataset.logId;
      const current = btn.dataset.verdict;
      closeVerdictDropdown();
      if (newVerdict === current) return;
      const ok = await showConfirm('Change status to "' + window.JHUI.formatVerdictLabel(newVerdict) + '"?');
      if (!ok) return;
      try {
        const endpoint = jobId ? '/api/jobs/' + jobId + '/verdict' : '/api/run-log/' + logId + '/verdict';
        const res = await fetch(endpoint, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ verdict: newVerdict }),
        });
        const data = await res.json();
        if (data.success) {
          if (data.internal_job_id && !btn.dataset.jobId) {
            btn.dataset.jobId = String(data.internal_job_id);
          }
          if (btn.dataset.chipStyle === 'detail') {
            location.reload();
          } else {
            btn.innerHTML = verdictChipHTML(newVerdict, btn.dataset.chipStyle || 'compact');
            btn.dataset.verdict = newVerdict;
          }
        } else {
          await showAlert(data.error || 'Failed to update status');
        }
      } catch (e) {
        await showAlert('Could not reach the server. Make sure the app is running and try again.');
      }
    }

    function openProfileSheet() {
      document.getElementById('profile-sheet').classList.remove('hidden');
    }
    function closeProfileSheet() {
      document.getElementById('profile-sheet').classList.add('hidden');
    }

    // ── Settings submenu ────────────────────────────────────────────
    (function () {
      const SETTINGS_KEY = 'jh_settings_open';
      const btn  = document.getElementById('sb-settings-btn');
      const sub  = document.getElementById('sb-settings-sub');
      const chev = document.getElementById('sb-settings-chev');
      if (!btn) return;
      function setOpen(open) {
        sub.style.display  = open ? '' : 'none';
        chev.classList.toggle('open', open);
        localStorage.setItem(SETTINGS_KEY, open ? '1' : '0');
      }
      const onSettings = document.title.includes('Settings') ||
                         window.location.pathname.startsWith('/settings');
      const stored = localStorage.getItem(SETTINGS_KEY);
      setOpen(onSettings || stored === '1');
      window.jhToggleSettings = function () {
        setOpen(sub.style.display === 'none');
      };
    })();

    // ── Onboarding dismiss ──────────────────────────────────────────
    (function () {
      const DISMISS_KEY = 'jh_onboarding_dismissed';
      const widget = document.getElementById('sb-onboard-widget');
      if (!widget) return;
      if (localStorage.getItem(DISMISS_KEY)) widget.style.display = 'none';
      window.jhDismissOnboarding = function () {
        localStorage.setItem(DISMISS_KEY, '1');
        widget.style.display = 'none';
      };
    })();

    // ── Onboarding throb helpers ────────────────────────────────────
    (function () {
      function throb(el, cls) {
        if (!el) return;
        el.classList.add(cls);
        setTimeout(function () { el.classList.remove(cls); }, 2000);
      }
      window.jhThrobRun = function () {
        openRunModal();
        throb(document.getElementById('sidebar-run-btn'), 'jh-throb-run');
      };
      window.jhThrobSchedule = function () {
        openScheduleModal();
        throb(document.querySelector('#schedule-inactive button'), 'jh-throb-sched');
      };
    })();
  </script>
</body>
</html>
