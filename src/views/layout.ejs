<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Job Search — <%= title %></title>
  <link rel="icon" href="/icon.ico">
  <link rel="stylesheet" href="/css/tailwind.css">
  <style>
    [x-cloak] { display: none !important; }
    :root { --page-max-w: <%= locals.pageMaxWidth || '1120px' %>; }
    html, body { overflow: hidden; }
    .app-shell { height: 100dvh; min-height: 100%; background: #fcfcfb; overflow: hidden; }
    .app-sidebar { width: 14rem; height: 100dvh; overflow: hidden; overscroll-behavior: contain; }
    .app-sidebar nav { overflow-y: visible; }
    .app-main { min-width: 0; height: 100dvh; overflow-y: auto; overflow-x: hidden; }
    .app-content { width: 100%; max-width: var(--page-max-w); min-height: 100%; display: flex; flex-direction: column; }
    .app-page { flex: 1 0 auto; padding: 24px 16px 24px; }
    @media (max-width: 767px) { .app-page { padding-bottom: 5rem; } }
    /* Full-bleed pages (two-pane Matches/All Jobs, Run Logs): fill the main area edge-to-edge */
    .app-content.full { max-width: none; }
    .app-page.full { padding: 0; }
    .app-footer { flex-shrink: 0; padding: 0 1.5rem 1.5rem; }
    .mobile-bottom-nav {
      height: calc(4rem + env(safe-area-inset-bottom, 0px));
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .job-list-container {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 0.75rem;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
      overflow-x: auto;
      overflow-y: hidden;
    }
    .job-table {
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
    }
    .job-table-row {
      border-top: 1px solid var(--line);
      cursor: pointer;
      transition: background-color 0.15s ease;
    }
    .job-table-row:hover { background: var(--accent-tint); }
    .job-table-cell { padding: 0.875rem 0.75rem; vertical-align: top; min-width: 0; }
    .job-table-fixed { white-space: nowrap; text-align: center; }
    .job-table-cell.job-table-fixed:last-child { padding-left: 0.25rem; padding-right: 0.5rem; }
    .job-table-cell.job-table-fixed:nth-last-child(2) { padding-left: 0.75rem; padding-right: 0.75rem; }
    .job-mobile-list { display: block; }
    .job-mobile-card {
      background: #fff;
      border: 1px solid var(--line3);
      border-radius: 14px;
      box-shadow: var(--shadow-card);
      padding: 1rem;
      cursor: pointer;
      transition: box-shadow 0.15s ease;
    }
    .job-mobile-card:hover { box-shadow: inset 3px 0 0 var(--accent), 0 1px 2px rgba(15, 23, 42, 0.04); }
    .job-identity-title { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .job-table .job-identity-title { overflow: visible; text-overflow: clip; white-space: normal; line-height: 1.35; }
    .job-mobile-card .job-identity-title { overflow: visible; text-overflow: clip; white-space: normal; line-height: 1.35; }
    .job-identity-meta { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .job-summary-text {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      overflow: hidden;
    }
    .job-location-text {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }
    @media (min-width: 768px) {
      .job-mobile-list { display: none; }
      .job-desktop-table { display: table; }
    }
    @media (max-width: 767px) {
      .job-desktop-table { display: none; }
    }

    /* Sidebar width override (DS v2: 236px, light) */
    .app-sidebar { width: 236px; }

    /* ── Nav items ──────────────────────────────────────────────── */
    .sb-item {
      display: flex; align-items: center; gap: 11px;
      padding: 9px 11px; border-radius: 9px;
      color: var(--muted); font-size: 13.5px; font-weight: 600; line-height: 1.2;
      background: transparent; border: 0; width: 100%;
      text-align: left; cursor: pointer; text-decoration: none;
    }
    .sb-item .ico { color: var(--fainter); display: inline-flex; }
    .sb-item .ico svg { stroke-width: 1.8; }
    .sb-item:hover { background: #f5f6f8; color: var(--ink2); }
    .sb-item.active {
      background: var(--accent-soft); color: var(--accent); font-weight: 700;
    }
    .sb-item.active .ico { color: var(--accent); }
    .sb-item.active .ico svg { stroke-width: 1.9; }
    .sb-count {
      margin-left: auto; font-size: 11px; font-weight: 700;
      color: #fff;
      background: var(--accent);
      border-radius: 999px; padding: 1px 8px;
    }

    /* ── Scrollable nav middle section ──────────────────────────── */
    .sb-nav-scroll {
      flex: 1; overflow-y: auto; min-height: 0;
      padding: 8px 12px;
      display: flex; flex-direction: column; gap: 2px;
    }
    .sb-nav-scroll::-webkit-scrollbar { width: 0; }

    /* ── Settings sub-nav ───────────────────────────────────────── */
    .sb-subnav {
      display: flex; flex-direction: column; gap: 2px;
      padding: 2px 0 4px 10px; margin-left: 10px;
      border-left: 1px solid var(--line);
    }
    .sb-subitem {
      padding: 7px 10px; font-size: 13px; font-weight: 600; line-height: 1.2;
      color: var(--muted); gap: 10px;
    }
    .sb-subitem:hover { color: var(--ink2); background: #f5f6f8; }
    .sb-subitem.active { background: var(--accent-soft); color: var(--accent); font-weight: 700; }
    .sb-subdot {
      width: 4px; height: 4px; border-radius: 50%;
      background: currentColor; opacity: 0.55; flex-shrink: 0; margin-left: 2px;
    }
    .sb-subitem.active .sb-subdot { opacity: 1; }
    .sb-subitem.admin.active { background: var(--red-soft); color: var(--red-ink); }
    .sb-subitem.admin.active .sb-subdot { opacity: 1; background: var(--red); }
    .sb-admin-divider { height: 1px; background: var(--line); margin: 10px 10px; }
    .sb-chev {
      display: inline-flex; align-items: center; margin-left: auto;
      color: var(--fainter); transition: transform 0.15s ease;
    }
    .sb-chev.open { transform: rotate(90deg); }

    /* ── Sidebar footer ─────────────────────────────────────────── */
    .sb-footer {
      padding: 12px; border-top: 1px solid var(--line);
      display: flex; flex-direction: column; gap: 8px;
    }
    .sb-run-group { display: flex; flex-direction: column; gap: 6px; }

    /* ── Run buttons (DS v2 light) ──────────────────────────────── */
    .sb-run {
      display: flex; align-items: center; gap: 9px;
      padding: 10px 13px; border-radius: 10px; border: 0;
      font-size: 13.5px; font-weight: 700; font-family: inherit;
      text-align: left; width: 100%; cursor: pointer;
      white-space: nowrap;
    }
    .sb-run-primary {
      border: 1px solid var(--green-border);
      background: var(--green-soft); color: var(--green2);
    }
    .sb-run-primary:hover { background: #e6f3ec; }
    .sb-run-primary:disabled { opacity: 0.55; cursor: not-allowed; }
    .sb-run-secondary {
      background: #eef1f6; color: var(--ink2);
    }
    .sb-run-secondary:hover { background: #e6eaf1; }
    .sb-run-danger {
      border: 1px solid var(--red-border);
      background: var(--red-soft); color: var(--red-ink);
    }
    .sb-run-danger:hover { background: #fde7e5; }

    /* ── Shared success / run button color (solid green, on light) ── */
    .jh-btn-success { background: var(--green); border-color: var(--green); }
    .jh-btn-success:hover { background: var(--green2); border-color: var(--green2); }
    .jh-btn-success:disabled { opacity: 0.55; cursor: not-allowed; }

    .sb-run-meta {
      margin-left: auto; font-size: 11px; font-weight: 600;
      opacity: 0.85; font-family: monospace;
    }

    /* ── Credits placeholder ────────────────────────────────────── */
    .sb-credits {
      background: #fbfcfe;
      border: 1px solid var(--line2);
      border-radius: 11px; padding: 9px 11px;
      display: flex; align-items: center; gap: 10px;
      margin-top: 2px;
    }
    .sb-credits-icon { color: var(--accent); display: inline-flex; }
    .sb-credits-vals { display: flex; align-items: baseline; gap: 6px; }
    .sb-credits-num {
      font-size: 16px; font-weight: 800;
      letter-spacing: -0.02em; color: var(--ink);
    }
    .sb-credits-sub { font-size: 10.5px; color: var(--faint); font-weight: 600; white-space: nowrap; }
    .sb-credits-topup {
      margin-left: auto; flex-shrink: 0;
      display: inline-flex; align-items: center; justify-content: center;
      width: 26px; height: 26px; padding: 0;
      background: transparent; color: var(--accent);
      border: 1px solid var(--accent-border);
      border-radius: 7px; cursor: pointer;
    }
    .sb-credits-topup:hover { background: var(--accent-soft); }

    /* ── Profile row ────────────────────────────────────────────── */
    .sb-profile {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 6px; border-radius: 10px;
      background: transparent; width: 100%;
      color: var(--ink);
    }
    .sb-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: linear-gradient(135deg, #5b8cff, var(--accent));
      display: grid; place-items: center;
      color: white; font-weight: 700; font-size: 13px; flex-shrink: 0;
    }
    .sb-profile-meta { display: flex; flex-direction: column; flex: 1; min-width: 0; }
    .sb-profile-name { font-size: 13px; font-weight: 700; line-height: 1.2; }
    .sb-profile-email {
      font-size: 11px; color: var(--faint);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .sb-role-pill {
      display: inline-flex; align-items: center; height: 16px;
      font-size: 9.5px;
      background: #eef2ff; color: var(--accent);
      padding: 0 6px; border-radius: 5px;
      letter-spacing: 0.04em; text-transform: uppercase;
      font-weight: 800; margin-left: 6px; vertical-align: middle;
    }
    .sb-logout-btn {
      width: 30px; height: 30px; border-radius: 8px;
      display: grid; place-items: center;
      color: var(--fainter); flex-shrink: 0;
      background: transparent; border: 0; cursor: pointer;
    }
    .sb-logout-btn:hover { background: #f4f5f7; color: var(--muted); }

    /* ── Onboarding widget ──────────────────────────────────────── */
    .sb-onboard {
      background: var(--accent-soft);
      border: 1px solid var(--accent-border);
      border-radius: 11px; padding: 11px 11px 8px; margin-bottom: 12px;
      display: flex; flex-direction: column; gap: 7px;
    }
    .sb-onboard-head { display: flex; align-items: center; justify-content: space-between; }
    .sb-onboard-title {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 11px; font-weight: 800; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--accent);
    }
    .sb-onboard-title svg { color: var(--accent); width: 12px; height: 12px; }
    .sb-onboard-close {
      width: 20px; height: 20px; border-radius: 5px;
      display: grid; place-items: center;
      background: transparent; border: 0;
      color: var(--faintest); cursor: pointer;
    }
    .sb-onboard-close:hover { background: rgba(0,0,0,0.05); color: var(--muted); }
    .sb-onboard-meta {
      display: flex; align-items: center; gap: 8px;
      font-size: 10.5px; color: var(--faint); font-weight: 700;
    }
    .sb-onboard-bar {
      flex: 1; height: 3px;
      background: #e2e6ee; border-radius: 999px; overflow: hidden;
    }
    .sb-onboard-bar-fill {
      display: block; height: 100%;
      background: var(--accent); border-radius: 999px;
    }
    .sb-onboard-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
    .sb-onboard-item {
      width: 100%; display: grid;
      grid-template-columns: 16px 1fr 12px;
      align-items: center; gap: 8px; padding: 4px;
      border-radius: 6px; background: transparent; border: 0;
      color: var(--ink2); font-size: 12px; font-family: inherit;
      text-align: left; text-decoration: none; cursor: pointer; line-height: 1.2;
    }
    .sb-onboard-item:hover:not(.no-action) { background: rgba(47,107,255,0.06); }
    .sb-onboard-item.no-action { cursor: default; }
    .sb-onboard-item.done { color: var(--fainter); }
    .sb-onboard-item.done .sb-onboard-label {
      text-decoration: line-through;
    }
    .sb-onboard-check {
      width: 16px; height: 16px; border-radius: 50%;
      display: grid; place-items: center;
      border: 1px solid #d6dae2;
      color: var(--faint); font-size: 9.5px; font-weight: 700;
      background: #fff; flex-shrink: 0;
    }
    .sb-onboard-check.done { background: var(--green); border-color: var(--green); color: white; }
    .sb-onboard-check.done svg { width: 10px; height: 10px; stroke-width: 2.6; }
    .sb-onboard-chev { color: var(--faintest); opacity: 0.6; width: 12px; height: 12px; }
    .sb-onboard-item:hover .sb-onboard-chev { opacity: 1; }

  </style>
  <script>
    window.JHUI_TOKENS = <%- JSON.stringify(getClientUiTokens()) %>;
    window.JHUI = {
      formatVerdictLabel(value) {
        const key = String(value || '').trim().toUpperCase();
        return window.JHUI_TOKENS.verdictLabels[key] || (key ? key.replace(/[_-]+/g, ' ').toLowerCase().replace(/\b\w/g, c => c.toUpperCase()) : 'Unknown');
      },
      getVerdictTone(value) {
        return window.JHUI_TOKENS.verdictTones[String(value || '').trim().toUpperCase()] || 'bg-gray-100 text-gray-500';
      },
      isVerdictEditable(value) {
        return window.JHUI_TOKENS.editableVerdicts.includes(String(value || '').trim().toUpperCase());
      },
      formatScore(value) {
        if (value === null || value === undefined || value === '') return '\u2014';
        const num = Number(value);
        return Number.isFinite(num) ? String(Math.round(num)) : '\u2014';
      },
      formatAppliedLabel(value) {
        const n = Number(value);
        return n === 1 ? 'Applied' : n === 2 ? "Won't Apply" : 'New';
      },
      getVerdictChipStyle(value) {
        return window.JHUI_TOKENS.verdictChipStyles[String(value || '').trim().toUpperCase()] || window.JHUI_TOKENS.verdictChipFallback;
      },
      getAppliedChipStyle(value) {
        const n = Number(value);
        return window.JHUI_TOKENS.appliedChipStyles[n === 1 ? 1 : n === 2 ? 2 : 0];
      }
    };
  </script>
</head>
<body class="h-full font-sans antialiased text-gray-900">

  <!-- AppShell -->
  <div class="app-shell flex">

    <!-- SidebarNav (desktop only) -->
    <aside class="app-sidebar hidden md:flex flex-shrink-0 flex-col sticky top-0 h-screen" style="background:#fff;color:var(--ink);border-right:1px solid var(--line);">

      <!-- Brand row -->
      <div style="display:flex;align-items:center;padding:16px 18px 6px;flex-shrink:0;">
        <img src="/logo.PNG" alt="Job Search" style="width:100%;max-width:200px;height:auto;display:block;" />
      </div>

      <!-- Scrollable nav section -->
      <div class="sb-nav-scroll">

        <!-- Onboarding widget -->
        <div class="sb-onboard" id="sb-onboard-widget">
          <div class="sb-onboard-head">
            <div class="sb-onboard-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"/></svg>
              Onboarding
            </div>
            <button class="sb-onboard-close" onclick="jhDismissOnboarding()" aria-label="Dismiss onboarding">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 6l12 12M18 6l-12 12"/></svg>
            </button>
          </div>
          <div class="sb-onboard-meta">
            <%= onboarding.completedCount %> of 5 done
            <span class="sb-onboard-bar">
              <span class="sb-onboard-bar-fill" style="width:<%= (onboarding.completedCount/5*100) %>%"></span>
            </span>
          </div>
          <ul class="sb-onboard-list">
            <%
              const obSteps = [
                { label: 'Set up your profile',          href: '/settings',          clickFn: null },
                { label: 'Add target roles',             href: '/settings?tab=roles', clickFn: null },
                { label: 'Add or buy API keys',          href: '/settings?tab=ai',   clickFn: null },
                { label: 'Run your first search',        href: null,                  clickFn: 'jhOnboardRun()' },
                { label: 'Set a daily schedule',         href: null,                  clickFn: 'jhOnboardSchedule()' },
              ];
            %>
            <% obSteps.forEach(function(step, i) { %>
              <% const state = onboarding.states[i]; %>
              <% const hasAction = step.href || step.clickFn; %>
              <% if (step.href) { %>
            <li><a href="<%= step.href %>" class="sb-onboard-item <%= state %>">
              <% } else if (step.clickFn) { %>
            <li><button type="button" class="sb-onboard-item <%= state %>" onclick="<%= step.clickFn %>">
              <% } else { %>
            <li><span class="sb-onboard-item <%= state %> no-action">
              <% } %>
                <span class="sb-onboard-check <%= state === 'done' ? 'done' : '' %>">
                  <% if (state === 'done') { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="m5 12 5 5L20 6"/></svg>
                  <% } else { %>
                    <%= i + 1 %>
                  <% } %>
                </span>
                <span class="sb-onboard-label"><%= step.label %></span>
                <% if (hasAction) { %>
                  <svg class="sb-onboard-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="m9 6 6 6-6 6"/></svg>
                <% } else { %>
                  <span></span>
                <% } %>
              <% if (step.href) { %></a></li>
              <% } else if (step.clickFn) { %></button></li>
              <% } else { %></span></li>
              <% } %>
            <% }); %>
          </ul>
        </div>

        <!-- Nav items -->
        <a href="/" class="sb-item <%= title === 'Start' ? 'active' : '' %>">
          <span class="ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/></svg>
          </span>
          Start
        </a>
        <a href="/jobs" class="sb-item <%= title === 'Matches' ? 'active' : '' %>">
          <span class="ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1l8.8 8.8 8.8-8.8a5 5 0 0 0 0-7.1Z"/></svg>
          </span>
          Matches
          <% const mc = typeof matchesCount === 'undefined' ? 0 : matchesCount; %>
          <span class="sb-count" id="sb-matches-count" <%= mc > 0 ? '' : 'hidden' %>><%= mc %></span>
        </a>
        <a href="/history" class="sb-item <%= title === 'All Jobs' ? 'active' : '' %>">
          <span class="ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/></svg>
          </span>
          All Jobs
        </a>
        <a href="/analytics" class="sb-item <%= title === 'Stats' ? 'active' : '' %>">
          <span class="ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-8"/><path d="M22 20H2"/></svg>
          </span>
          Stats
        </a>
        <a href="/reports" class="sb-item <%= title === 'Run Logs' ? 'active' : '' %>">
          <span class="ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
          </span>
          Run Logs
        </a>

        <!-- Settings expandable submenu -->
        <%
          const isSettings = title === 'Settings';
          const curTab = locals.activeTab || 'profile';
        %>
        <button type="button" class="sb-item" id="sb-settings-btn" onclick="jhToggleSettings()">
          <span class="ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1A2 2 0 1 1 4.3 17l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.3-1.8l-.1-.1A2 2 0 1 1 7 4.3l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1A2 2 0 1 1 19.7 7l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>
          </span>
          Settings
          <span class="sb-chev" id="sb-settings-chev">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="m9 6 6 6-6 6"/></svg>
          </span>
        </button>
        <div class="sb-subnav" id="sb-settings-sub" style="display:none;">
          <a href="/settings" class="sb-item sb-subitem <%= isSettings && curTab === 'profile' ? 'active' : '' %>">
            <span class="sb-subdot"></span>Profile
          </a>
          <a href="/settings?tab=roles" class="sb-item sb-subitem <%= isSettings && curTab === 'roles' ? 'active' : '' %>">
            <span class="sb-subdot"></span>Roles
          </a>
          <a href="/settings?tab=ai" class="sb-item sb-subitem <%= isSettings && curTab === 'ai' ? 'active' : '' %>">
            <span class="sb-subdot"></span>AI Setup
          </a>
        </div>

        <% if (activeProfile.isAdmin) { %>
        <!-- Admin (operator area) -->
        <div class="sb-admin-divider"></div>
        <%
          const isAdminPage = title === 'Admin';
          const curAdminTab = locals.adminTab || 'general';
        %>
        <button type="button" class="sb-item" id="sb-admin-btn" onclick="jhToggleAdmin()">
          <span class="ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z"/></svg>
          </span>
          Admin
          <span class="sb-chev" id="sb-admin-chev">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="m9 6 6 6-6 6"/></svg>
          </span>
        </button>
        <div class="sb-subnav" id="sb-admin-sub" style="display:none;">
          <a href="/admin?tab=general" class="sb-item sb-subitem admin <%= isAdminPage && curAdminTab === 'general' ? 'active' : '' %>">
            <span class="sb-subdot"></span>General
          </a>
          <a href="/admin?tab=sources" class="sb-item sb-subitem admin <%= isAdminPage && curAdminTab === 'sources' ? 'active' : '' %>">
            <span class="sb-subdot"></span>Sources
          </a>
          <a href="/admin?tab=locations" class="sb-item sb-subitem admin <%= isAdminPage && curAdminTab === 'locations' ? 'active' : '' %>">
            <span class="sb-subdot"></span>Locations
          </a>
        </div>
        <% } %>
      </div>

      <!-- Footer -->
      <div class="sb-footer">
        <div class="sb-run-group">
          <!-- Run once -->
          <button id="sidebar-run-btn" onclick="openRunModal()" class="sb-run sb-run-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8L6 20V4Z"/></svg>
            <span id="sidebar-run-label">Run once</span>
          </button>

          <!-- Schedule inactive -->
          <div id="schedule-inactive" class="<%= locals.scheduleStatus && locals.scheduleStatus.active ? 'hidden' : '' %>">
            <button onclick="openScheduleModal()" class="sb-run sb-run-secondary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              Schedule
            </button>
          </div>

          <!-- Schedule active stop button -->
          <div id="schedule-active" class="<%= locals.scheduleStatus && locals.scheduleStatus.active ? '' : 'hidden' %>">
            <button onclick="scheduleStop()" class="sb-run sb-run-danger">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12"/></svg>
              Stop Schedule
            </button>
          </div>

          <!-- Schedule active status row (shown below stop button when active) -->
          <div id="schedule-status" class="<%= locals.scheduleStatus && locals.scheduleStatus.active ? '' : 'hidden' %>" style="align-items:center;justify-content:space-between;padding:2px 4px;<%= locals.scheduleStatus && locals.scheduleStatus.active ? 'display:flex;' : '' %>">
            <span style="display:flex;align-items:center;gap:6px;font-size:11px;color:var(--green2);font-weight:500;">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--green)] animate-pulse inline-block"></span>
              Schedule active
            </span>
            <span id="schedule-expr" style="font-size:11px;color:var(--muted);font-family:monospace;"></span>
          </div>

          <p id="schedule-msg" class="text-xs text-center hidden" style="color:var(--muted);"></p>
        </div>

        <!-- Credits widget (shown only when using JH credits) -->
        <% if (locals.useJhCredits) { %>
        <div class="sb-credits">
          <span class="sb-credits-icon">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M3 7a2 2 0 0 1 2-2h12v4"/><path d="M3 7v11a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-9a1 1 0 0 0-1-1H5a2 2 0 0 1-2-2Z"/><circle cx="17" cy="14" r="1.2" fill="currentColor" stroke="none"/></svg>
          </span>
          <div class="sb-credits-vals">
            <span class="sb-credits-num">$<%= Number(locals.creditsBalance || 0).toFixed(1) %></span>
            <span class="sb-credits-sub">≈ <%= Math.floor(Math.round(Number(locals.creditsBalance || 0) / 0.2 * 100) / 100) %> runs</span>
          </div>
          <button class="sb-credits-topup" type="button" onclick="jhTopUp()" title="Top up" aria-label="Top up">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          </button>
        </div>
        <% } %>
        <script>
          // Default: land on AI Setup, which opens the top-up form on arrival.
          // The AI tab overrides this to open the form in place.
          function jhTopUp() {
            window.location.href = '/settings?tab=ai&topup=1';
          }
        </script>

        <!-- Profile row -->
        <div class="sb-profile">
          <div class="sb-avatar"><%= activeProfile.displayName.charAt(0).toUpperCase() %></div>
          <div class="sb-profile-meta">
            <div class="sb-profile-name">
              <%= activeProfile.displayName %>
              <% if (activeProfile.isAdmin) { %><span class="sb-role-pill">admin</span><% } %>
            </div>
            <div class="sb-profile-email"><%= activeProfile.email %></div>
          </div>
          <form method="POST" action="/logout" style="display:contents;">
            <button type="submit" title="Log out" class="sb-logout-btn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
            </button>
          </form>
        </div>
      </div>
    </aside>

    <!-- Main content -->
    <main class="app-main flex-1">
      <div class="app-content<%= locals.fullBleed ? ' full' : '' %>">
        <div class="app-page<%= locals.fullBleed ? ' full' : '' %>">
          <%- body %>
        </div>
        <footer class="app-footer hidden md:block<%= locals.fullBleed ? ' hidden' : '' %>">
          <div class="bg-white border border-gray-200 rounded-xl shadow-sm px-6 py-2.5 flex items-center justify-end gap-3 text-xs">
            <a href="/terms" class="<%= title === 'Terms' ? 'text-gray-900 font-medium' : 'text-gray-500 hover:text-gray-700' %> transition-colors">Terms</a>
            <a href="/privacy" class="<%= title === 'Privacy' ? 'text-gray-900 font-medium' : 'text-gray-500 hover:text-gray-700' %> transition-colors">Privacy</a>
          </div>
        </footer>
      </div>
    </main>
  </div>

  <!-- MobileBottomNav -->
  <nav class="mobile-bottom-nav md:hidden fixed bottom-0 left-0 right-0 z-40 border-t flex items-stretch" style="background:#fff;border-color:var(--line);">
    <a href="/" class="flex-1 flex flex-col items-center justify-center gap-0.5" style="color:<%= title === 'Start' ? 'var(--accent)' : 'var(--muted)' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
      <span class="text-[10px] font-medium">Start</span>
    </a>
    <a href="/jobs" class="flex-1 flex flex-col items-center justify-center gap-0.5" style="color:<%= title === 'Matches' ? 'var(--accent)' : 'var(--muted)' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
      <span class="text-[10px] font-medium">Matches</span>
    </a>
    <a href="/history" class="flex-1 flex flex-col items-center justify-center gap-0.5" style="color:<%= title === 'All Jobs' ? 'var(--accent)' : 'var(--muted)' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
      <span class="text-[10px] font-medium">All</span>
    </a>
    <a href="/analytics" class="flex-1 flex flex-col items-center justify-center gap-0.5" style="color:<%= title === 'Stats' ? 'var(--accent)' : 'var(--muted)' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
      <span class="text-[10px] font-medium">Stats</span>
    </a>
    <a href="/reports" class="flex-1 flex flex-col items-center justify-center gap-0.5" style="color:<%= title === 'Run Logs' ? 'var(--accent)' : 'var(--muted)' %>">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
      <span class="text-[10px] font-medium">Logs</span>
    </a>
    <button onclick="openProfileSheet()" class="flex-1 flex flex-col items-center justify-center gap-0.5">
      <div class="w-7 h-7 rounded-full flex items-center justify-center text-white text-sm font-bold" style="background:linear-gradient(135deg,#4D87FF,#2F6BFF);">
        <%= activeProfile.displayName.charAt(0).toUpperCase() %>
      </div>
    </button>
  </nav>

  <!-- Profile bottom sheet (mobile only) -->
  <div id="profile-sheet" class="md:hidden hidden fixed inset-0 z-50">
    <div class="absolute inset-0 bg-black/50" onclick="closeProfileSheet()"></div>
    <div class="absolute bottom-16 left-0 right-0 rounded-t-2xl border-t px-4 pt-4 pb-6" style="background:#fff;border-color:var(--line);">
      <!-- Current user info -->
      <div class="flex items-center gap-3 px-3 py-3 mb-2">
        <div class="w-9 h-9 rounded-full flex items-center justify-center text-white font-bold flex-shrink-0" style="background:linear-gradient(135deg,#4D87FF,#2F6BFF);">
          <%= activeProfile.displayName.charAt(0).toUpperCase() %>
        </div>
        <div>
          <p class="text-sm font-medium" style="color:var(--ink);"><%= activeProfile.displayName %></p>
          <p class="text-xs" style="color:var(--muted);"><%= activeProfile.email %></p>
        </div>
        <% if (activeProfile.isAdmin) { %>
        <span class="ml-auto text-[10px] px-1.5 py-0.5 rounded font-medium" style="background:#eef2ff;color:var(--accent);">admin</span>
        <% } %>
      </div>
      <div class="border-t pt-3 space-y-0.5" style="border-color:var(--line);">
        <div class="flex gap-2">
        <a href="/settings" onclick="closeProfileSheet()"
           class="flex-1 flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl hover:bg-gray-100 transition-colors" style="color:var(--muted);">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          <span class="text-sm font-medium">Settings</span>
        </a>
        <% if (activeProfile.isAdmin) { %>
        <a href="/admin" onclick="closeProfileSheet()"
           class="flex-1 flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl hover:bg-gray-100 transition-colors" style="color:var(--muted);">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/></svg>
          <span class="text-sm font-medium">Admin</span>
        </a>
        <% } %>
        </div>
        <div class="px-3 pt-1 pb-0.5">
          <div class="flex items-center gap-1.5">
            <p class="text-[10px] uppercase tracking-wide" style="color:var(--muted);">Legal</p>
            <div class="flex-1 h-px" style="background:var(--line);"></div>
          </div>
          <div class="mt-1 flex items-center gap-1">
            <a href="/terms" onclick="closeProfileSheet()"
               class="px-2 py-1 rounded-md text-[11px] font-medium text-center <%= title === 'Terms' ? 'bg-blue-50 text-blue-700' : 'hover:bg-gray-100' %> transition-colors" style="<%= title !== 'Terms' ? 'color:var(--muted)' : '' %>">Terms</a>
            <a href="/privacy" onclick="closeProfileSheet()"
               class="px-2 py-1 rounded-md text-[11px] font-medium text-center <%= title === 'Privacy' ? 'bg-blue-50 text-blue-700' : 'hover:bg-gray-100' %> transition-colors" style="<%= title !== 'Privacy' ? 'color:var(--muted)' : '' %>">Privacy</a>
          </div>
        </div>
        <form method="POST" action="/logout">
          <button type="submit"
                  class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-red-600 hover:bg-gray-100 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            <span class="text-sm font-medium">Log out</span>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Confirm modal -->
  <div id="jh-confirm-modal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="_jhConfirmResolve(false)"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden">
      <div class="px-6 py-5">
        <p id="jh-confirm-msg" class="text-sm text-gray-700 leading-relaxed"></p>
      </div>
      <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-end gap-3">
        <button onclick="_jhConfirmResolve(false)"
                class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded-lg transition-colors">
          Cancel
        </button>
        <button onclick="_jhConfirmResolve(true)"
                class="px-4 py-2 text-sm font-semibold text-white bg-ds-accent hover:bg-ds-accent-hover rounded-lg transition-colors">
          Confirm
        </button>
      </div>
    </div>
  </div>

  <!-- Alert modal -->
  <div id="jh-alert-modal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="_jhAlertResolve()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden">
      <div class="px-6 py-5">
        <p id="jh-alert-msg" class="text-sm text-gray-700 leading-relaxed"></p>
      </div>
      <div class="px-6 py-4 border-t border-gray-100 flex justify-end">
        <button onclick="_jhAlertResolve()"
                class="px-4 py-2 text-sm font-semibold text-white bg-ds-accent hover:bg-ds-accent-hover rounded-lg transition-colors">
          OK
        </button>
      </div>
    </div>
  </div>

  <!-- Verdict dropdown -->
  <div id="verdict-dropdown" class="hidden fixed z-50 bg-white rounded-xl shadow-xl border border-gray-200 overflow-hidden" style="min-width:148px">
    <div class="py-1">
      <button onclick="setVerdict('STRONG_MATCH')" class="w-full text-left px-4 py-2 text-sm hover:bg-[var(--green-soft)] text-[var(--green2)] font-medium">Strong</button>
      <button onclick="setVerdict('WEAK_MATCH')"   class="w-full text-left px-4 py-2 text-sm hover:bg-ds-amber-soft text-ds-amber-ink font-medium">Weak</button>
      <button onclick="setVerdict('NO_MATCH')"     class="w-full text-left px-4 py-2 text-sm hover:bg-ds-red-soft text-ds-red-ink font-medium">No match</button>
      <button onclick="setVerdict('DUPLICATE')"    class="w-full text-left px-4 py-2 text-sm hover:bg-ds-purple-soft text-ds-purple font-medium">Duplicate</button>
    </div>
  </div>

  <!-- Applied dropdown -->
  <div id="applied-dropdown" class="hidden fixed z-50 bg-white rounded-xl shadow-xl border border-gray-200 overflow-hidden" style="min-width:148px">
    <div class="py-1">
      <button onclick="setApplied(0)" class="w-full text-left px-4 py-2 text-sm hover:bg-gray-50 text-gray-600 font-medium">New</button>
      <button onclick="setApplied(1)" class="w-full text-left px-4 py-2 text-sm hover:bg-[var(--green-soft)] text-[var(--green2)] font-medium">Applied</button>
      <button onclick="setApplied(2)" class="w-full text-left px-4 py-2 text-sm hover:bg-ds-red-soft text-ds-red-ink font-medium">Won't Apply</button>
    </div>
  </div>

  <!-- Schedule Setup Modal -->
  <div id="schedule-modal" class="hidden fixed inset-0 z-50 flex items-end justify-center p-0 md:items-center md:p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeScheduleModal()"></div>
    <div class="relative bg-white rounded-t-2xl md:rounded-2xl shadow-2xl w-full max-w-sm h-[calc(100dvh-1rem)] md:h-auto overflow-hidden flex flex-col">
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
        <h2 class="font-semibold text-gray-900">Run Schedule</h2>
        <button onclick="closeScheduleModal()" class="text-gray-400 hover:text-gray-600 p-1 rounded-lg hover:bg-gray-100 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="px-6 py-4 space-y-4 flex-1 overflow-y-auto md:max-h-[75vh]">
        <!-- Roles -->
        <div>
          <div class="text-sm font-medium text-gray-700 mb-2">Roles to run</div>
          <div id="sched-modal-groups" class="space-y-1">
            <span class="text-sm text-gray-400">Loading…</span>
          </div>
        </div>
        <!-- Providers -->
        <div>
          <div class="text-sm font-medium text-gray-700 mb-2">Scraping providers</div>
          <div id="sched-provider-options" class="space-y-1.5">
            <span class="text-sm text-gray-400">Loading…</span>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Run at</label>
          <input id="sched-time-input" type="time" value="07:00"
                 class="w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-500" />
          <p class="text-xs text-gray-400 mt-1.5">Runs start within ~10 minutes of this time to spread server load.</p>
        </div>
        <!-- Frequency: daily vs specific days -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Frequency</label>
          <div class="flex gap-2 mb-2">
            <button type="button" id="freq-daily" onclick="setSchedFrequency('daily')"
                    class="freq-btn flex-1 py-1.5 px-2 rounded-lg border text-xs md:text-sm font-medium transition-colors">
              Daily
            </button>
            <button type="button" id="freq-custom" onclick="setSchedFrequency('custom')"
                    class="freq-btn flex-1 py-1.5 px-2 rounded-lg border text-xs md:text-sm font-medium transition-colors">
              Specific days
            </button>
          </div>
          <div id="sched-freq-days" class="hidden">
            <div class="flex flex-wrap gap-2">
              <label class="flex items-center gap-1.5 cursor-pointer text-sm text-gray-700 select-none">
                <input type="checkbox" class="sched-day-check w-3.5 h-3.5 accent-blue-600" value="1" checked> Mon
              </label>
              <label class="flex items-center gap-1.5 cursor-pointer text-sm text-gray-700 select-none">
                <input type="checkbox" class="sched-day-check w-3.5 h-3.5 accent-blue-600" value="2" checked> Tue
              </label>
              <label class="flex items-center gap-1.5 cursor-pointer text-sm text-gray-700 select-none">
                <input type="checkbox" class="sched-day-check w-3.5 h-3.5 accent-blue-600" value="3" checked> Wed
              </label>
              <label class="flex items-center gap-1.5 cursor-pointer text-sm text-gray-700 select-none">
