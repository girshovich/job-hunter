  <!-- Status picker.
       No job follows a fixed path — a hiring manager can come before a case, a recruiter round
       can be skipped entirely — so nothing here is enforced, greyed out or predicted (D7, D20).
       The picker simply uses the order the user arranged their own statuses in: what sits below
       the current one is offered first under "Move on", everything else is one glance away
       under "Anything else" (D21). `New` is written once, by the fetch, and is absent from every
       picker (D34).
       Below 768px this is a bottom sheet — fifteen rows do not fit a 148px menu (§12.5, MB2). -->
  <div id="status-picker" class="hidden fixed z-50" style="inset:auto">
    <div id="status-picker-backdrop" class="hidden fixed inset-0 bg-black/35" onclick="closeStatusPicker()"></div>
    <div id="status-picker-panel" class="fixed bg-white border border-gray-200 overflow-y-auto"
         style="border-radius:12px;box-shadow:var(--shadow-dropdown);padding:6px;min-width:206px;max-height:340px"></div>
  </div>
  <style>
    .sp-row { display:flex; align-items:center; gap:8px; padding:7px 9px; border-radius:8px;
              font-size:12.5px; font-weight:600; color:var(--ink2); border:0; background:none;
              width:100%; text-align:left; cursor:pointer; }
    .sp-row:hover { background:#f5f6f8; }
    .sp-row .sp-dot { width:8px; height:8px; border-radius:2px; flex:none; }
    .sp-lbl { font-size:10px; font-weight:800; letter-spacing:.06em; text-transform:uppercase;
              color:var(--faintest); padding:6px 9px 3px; }
    .sp-sep { height:1px; background:var(--line); margin:5px 4px; }
    @media (max-width: 767px) {
      /* A bottom sheet, not a 148px menu — fifteen statuses need the room (MB2). */
      #status-picker-panel { left:0 !important; right:0; bottom:0; top:auto !important;
        max-height:70dvh; border-radius:16px 16px 0 0; padding:10px 10px calc(10px + env(safe-area-inset-bottom)); }
      .sp-row { padding:11px 12px; font-size:14px; }
    }
  </style>

