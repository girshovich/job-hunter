        <!-- Stats — one sentence, each figure a link -->
        <p id="cm-stats" style="font-size:13px;color:var(--ink2);line-height:1.6"></p>

        <!-- Note — Save is a text link in the label row, matching "Notes about the job" -->
        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:7px">
            <div style="font-size:11px;font-weight:800;color:var(--faint);text-transform:uppercase;letter-spacing:.05em">My note</div>
            <button type="button" id="cm-note-save" onclick="JHCompanyModal.saveNote()"
                    style="font-size:12px;font-weight:700;color:var(--accent);background:transparent;border:0;cursor:pointer">Save</button>
          </div>
          <textarea id="cm-note" rows="3" maxlength="5000" placeholder="Add notes about this company…"
                    style="width:100%;font-size:13px;color:var(--ink2);border:1px solid var(--line2);border-radius:9px;padding:9px 11px;resize:vertical;outline:none;line-height:1.5"></textarea>
          <p id="cm-note-status" class="hidden" style="font-size:11px;color:var(--faintest);margin-top:6px"></p>
        </div>

        <!-- Blacklist — the action opens a confirm step; nothing is written on the first click -->
        <div style="border-top:1px solid var(--line);padding-top:15px">
          <div id="cm-blacklist"></div>
        </div>
      </div>
