               class="px-2 py-1 rounded-md text-[11px] font-medium text-center <%= title === 'Refunds' ? 'text-white bg-white/10' : 'hover:bg-white/5' %> transition-colors" style="<%= title !== 'Refunds' ? 'color:var(--jh-sb-muted)' : '' %>">Refunds</a>
