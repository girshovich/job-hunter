      _schedProviders = _schedProviders.map(p => (
        p.value === value ? { ...p, checked } : p
      ));
    }

    function onSchedProviderToggle(checkbox) {
      setSchedProviderState(checkbox.value, checkbox.checked);
    }

    function onSchedProviderPickerToggle(checkbox) {
      onSchedProviderToggle(checkbox);
      document.getElementById('sched-provider-picker-count').textContent = getSchedProviderSummaryText();
