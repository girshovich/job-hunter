  <div id="jh-company-modal" class="hidden fixed inset-0 z-[60] flex items-end md:items-center justify-center p-0 md:p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="JHCompanyModal.close()"></div>
