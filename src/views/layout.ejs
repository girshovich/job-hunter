        <div class="flex justify-between items-center">
          <span class="text-gray-500">Runs at</span>
          <span id="sched-status-time" class="font-semibold font-mono text-gray-900"></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-500">Timezone</span>
          <span id="sched-status-tz" class="font-medium text-gray-900"></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-500">Search period</span>
          <span id="sched-status-dr" class="font-medium text-gray-900"></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-gray-500">Roles</span>
          <span id="sched-status-roles" class="font-medium text-gray-900"></span>
        </div>
        <div class="flex justify-between items-center gap-6">
          <span class="text-gray-500 shrink-0">Providers</span>
          <span id="sched-status-providers" class="font-medium text-gray-900 text-right"></span>
        </div>
      </div>
      <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-end gap-3">
        <button onclick="closeScheduleStatusModal()"
                class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded-lg transition-colors">
          Close
        </button>
        <button onclick="scheduleStop(); closeScheduleStatusModal();"
                class="inline-flex items-center gap-2 bg-ds-red hover:brightness-95 text-white font-semibold px-5 py-2 rounded-xl text-sm transition-colors shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9 10h6v4H9z"/>
          </svg>
          Stop Schedule
        </button>
      </div>
    </div>
  </div>

  <!-- Run Once Modal -->
  <div id="run-modal" class="hidden fixed inset-0 z-50 flex items-end justify-center p-0 md:items-center md:p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeRunModal()"></div>
    <div class="relative bg-white rounded-t-2xl md:rounded-2xl shadow-2xl w-full max-w-sm h-[calc(100dvh-1rem)] md:h-auto overflow-hidden flex flex-col">
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
        <h2 class="font-semibold text-gray-900">Run Once</h2>
        <button onclick="closeRunModal()" class="text-gray-400 hover:text-gray-600 p-1 rounded-lg hover:bg-gray-100 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="px-6 py-4 space-y-4 flex-1 overflow-y-auto md:max-h-[75vh]">
        <!-- Roles -->
        <div>
          <div class="text-sm font-medium text-gray-700 mb-2">Roles to run</div>
          <div id="run-modal-groups" class="space-y-1">
            <span class="text-sm text-gray-400">Loading…</span>
          </div>
        </div>
        <!-- Providers -->
        <div>
          <div class="text-sm font-medium text-gray-700 mb-2">Job sources</div>
          <div id="run-provider-options" class="space-y-1.5">
            <span class="text-sm text-gray-400">Loading…</span>
          </div>
        </div>
        <!-- Date range -->
        <div>
          <div class="text-sm font-medium text-gray-700 mb-2">Search period</div>
          <div class="flex gap-2 mb-2">
            <button type="button" id="run-dr-24h" onclick="setRunDateRange('24h')"
                    class="run-dr-btn flex-1 py-1.5 px-2 rounded-lg border text-xs md:text-sm font-medium transition-colors">
              Last 24h
            </button>
            <button type="button" id="run-dr-7d" onclick="setRunDateRange('7d')"
                    class="run-dr-btn flex-1 py-1.5 px-2 rounded-lg border text-xs md:text-sm font-medium transition-colors">
              Last 7 days
            </button>
            <button type="button" id="run-dr-month" onclick="setRunDateRange('month')"
                    class="run-dr-btn flex-1 py-1.5 px-2 rounded-lg border text-xs md:text-sm font-medium transition-colors">
              Month
            </button>
          </div>
        </div>
        <p id="run-modal-msg" class="hidden text-xs text-red-600"></p>
      </div>
      <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-end gap-3 flex-shrink-0 bg-white">
        <button type="button" onclick="closeRunModal()"
                class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded-lg transition-colors">
          Cancel
        </button>
        <button id="run-modal-submit" onclick="submitRun()"
                class="inline-flex items-center gap-2 jh-btn-success text-white font-semibold px-5 py-2 rounded-xl text-sm transition-colors shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Run
        </button>
      </div>
    </div>
  </div>

  <!-- Run Once Role Picker (used when a profile has many roles) -->
  <div id="run-role-picker" class="hidden fixed inset-0 z-[60] bg-white md:items-center md:justify-center md:bg-black/40">
    <div class="h-full bg-white flex flex-col md:h-auto md:max-h-[80vh] md:w-full md:max-w-sm md:rounded-2xl md:shadow-2xl md:overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
        <div>
          <h2 class="font-semibold text-gray-900">Select roles</h2>
          <p id="run-role-picker-count" class="text-xs text-gray-500 mt-0.5"></p>
        </div>
        <button type="button" onclick="closeRunRolePicker()" class="text-gray-400 hover:text-gray-600 p-1 rounded-lg hover:bg-gray-100 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="px-6 py-3 border-b border-gray-100 flex items-center gap-2 flex-shrink-0">
        <button type="button" onclick="setAllRunRoles(true)"
                class="flex-1 px-3 py-2 text-sm font-medium text-ds-accent bg-ds-accent-soft hover:bg-ds-accent-border rounded-lg transition-colors">
          Select all
        </button>
        <button type="button" onclick="setAllRunRoles(false)"
                class="flex-1 px-3 py-2 text-sm font-medium text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">
          Clear
        </button>
      </div>
      <div id="run-role-picker-list" class="flex-1 overflow-y-auto px-6 py-3 space-y-1">
      </div>
      <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-end gap-3 flex-shrink-0">
        <button type="button" onclick="closeRunRolePicker()"
                class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded-lg transition-colors">
          Done
        </button>
      </div>
    </div>
  </div>

  <!-- Run Once Provider Picker -->
  <div id="run-provider-picker" class="hidden fixed inset-0 z-[60] bg-white md:items-center md:justify-center md:bg-black/40 md:backdrop-blur-sm">
    <div class="provider-picker-panel h-full bg-white flex flex-col md:h-auto md:max-h-[80vh] md:w-full md:max-w-2xl md:rounded-2xl md:overflow-hidden">
      <div class="px-6 py-4 border-b border-[color:var(--line)] flex items-center justify-between flex-shrink-0">
        <div>
          <h2 class="text-[15px] font-extrabold text-[color:var(--ink)]">Select job sources</h2>
          <p id="run-provider-picker-count" class="text-xs text-[color:var(--faint)] mt-0.5"></p>
        </div>
        <button type="button" onclick="closeRunProviderPicker()" class="text-[color:var(--fainter)] hover:text-[color:var(--muted)] p-1 rounded-lg hover:bg-[#f5f6f8] transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <p class="provider-picker-note flex-shrink-0">Choose job sources. Paid have better coverage. Total cost includes fetching jobs + AI analysis.</p>
      <div class="px-6 py-3 border-b border-[color:var(--line)] flex items-center gap-2 flex-shrink-0">
        <button type="button" onclick="setAllRunProviders(true)"
                class="flex-1 px-3 py-[9px] text-[13px] font-bold text-ds-accent bg-ds-accent-soft hover:bg-ds-accent-border rounded-[10px] transition-colors">
          Select all
        </button>
        <button type="button" onclick="setAllRunProviders(false)"
                class="flex-1 px-3 py-[9px] text-[13px] font-bold text-[color:var(--ink2)] bg-[#eef1f6] hover:bg-[#e6eaf1] rounded-[10px] transition-colors">
          Clear
        </button>
      </div>
      <div id="run-provider-picker-list" class="provider-picker-table flex-1 overflow-y-auto">
      </div>
      <div class="px-6 py-4 border-t border-[color:var(--line)] flex items-center justify-end gap-3 flex-shrink-0">
        <button type="button" onclick="closeRunProviderPicker()"
                class="px-[15px] py-[9px] text-[13px] font-bold text-white bg-ds-accent hover:bg-ds-accent-hover rounded-[10px] transition-colors">
          Done
        </button>
      </div>
    </div>
  </div>

  <script>
    // The shared calendar. The step editor (below) opens it in single-date mode, and the detail
    // pane can appear on any page that renders this layout — so it is included here rather than
    // per page. `window.JHCal = window.JHCal || …` guards the double-include on Matches/All Jobs,
    // which already ship it for their own date-range filter.
<%- include('partials/_date-cal') %>
  </script>

  <script>
    // ---- Global state ----
    let _scheduleActive = <%- typeof scheduleStatus !== 'undefined' ? JSON.stringify(scheduleStatus.active) : 'false' %>;
    let _scheduleData = <%- typeof scheduleStatus !== 'undefined' ? JSON.stringify(scheduleStatus) : 'null' %>;   // latest data from /api/schedule/status
    let _schedDateRange = '24h';
    let _schedFrequency = 'daily';  // 'daily' | 'custom'
    let _schedGroups = [];
    let _schedProviders = [];
    let _runDateRange = '24h';
    let _runGroups = [];
    let _runProviders = [];
    let _runCallback = null;    // set by home.ejs to handle progress display

    const DAY_NAMES = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    const SCHED_PROVIDER_OPTIONS = [
      {
        value: 'harvestapi',
        label: 'LinkedIn: harvestapi',
        pickerLabel: 'LinkedIn: harvestapi',
        costPerThousand: '$1',
        description: 'Costs less if all keywords and locations are in one role; better with UK-based jobs.',
      },
      {
        value: 'valig',
        label: 'LinkedIn: valig',
        pickerLabel: 'LinkedIn: valig',
        costPerThousand: '$0.36',
        description: 'If you want one provider, choose this.',
      },
      {
        value: 'indeed',
        label: 'Indeed: valig',
        pickerLabel: 'Indeed: valig',
        costPerThousand: '$0.09',
        description: 'Less valuable than LinkedIn, but cheaper.',
      },
      {
        value: 'stepstone',
        label: 'StepStone: valig',
        pickerLabel: 'StepStone: valig',
        costPerThousand: '$0.36',
        description: 'Useful for some German jobs only.',
      },
      { value: 'greenhouse', label: 'Greenhouse', pickerLabel: 'Greenhouse', costPerThousand: 'free', description: '' },
      { value: 'ashby', label: 'Ashby', pickerLabel: 'Ashby', costPerThousand: 'free', description: '' },
      { value: 'lever', label: 'Lever', pickerLabel: 'Lever', costPerThousand: 'free', description: '' },
      { value: 'telegram', label: 'Telegram', pickerLabel: 'Telegram', costPerThousand: 'free', description: '' },
    ];
    const DEFAULT_PROVIDER_VALUES = ['valig', 'greenhouse', 'ashby', 'lever', 'telegram'];

    function escHtml(str) {
      return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ---- Schedule helpers ----

    function cronToLabel(expression, timezone) {
      if (!expression) return '';
      const parts = expression.split(' ');
      if (parts.length < 5) return expression;
      const h = String(parts[1]).padStart(2, '0');
      const m = String(parts[0]).padStart(2, '0');
      const tz = (timezone || 'UTC').split('/').pop().replace(/_/g, ' ');
      const dayPart = parts[4];
      const dayLabel = (!dayPart || dayPart === '*') ? '' : ' · ' + dayPart.split(',').map(d => DAY_NAMES[parseInt(d,10)] || d).join(', ');
      return h + ':' + m + ' ' + tz + dayLabel;
    }

    function getFrequencyLabel(expression) {
      if (!expression) return 'Daily';
      const parts = expression.split(' ');
      const dayPart = parts[4] || '*';
      if (dayPart === '*') return 'Daily';
      return dayPart.split(',').map(d => DAY_NAMES[parseInt(d,10)] || d).join(', ');
    }

    function setScheduleUI(active, expression, timezone) {
      _scheduleActive = active;
      // The sidebar's schedule control is a clock with a state light — red off, green on, never
      // animated (D42). The next run time lives in its tooltip and in the modal on Start, not in
      // the nav: a bare "09:00" there reads as a label for whatever sits beside it.
      const schedBtn = document.getElementById('sb-sched-btn');
      if (schedBtn) {
        schedBtn.classList.toggle('live', !!active);
        const when = active && expression ? cronToLabel(expression, timezone) : '';
        schedBtn.title = active
          ? ('Schedule running' + (when ? ' — ' + when : '') + '. Opens Start.')
          : 'No schedule set — opens Start.';
        schedBtn.setAttribute('aria-label', active ? 'Schedule running' : 'No schedule set');
      }

      // Sync home-page Schedule button if present
      const homeBtn = document.getElementById('home-schedule-btn');
      if (homeBtn) {
        const lbl = homeBtn.querySelector('[data-schedule-label]');
        if (active) {
          homeBtn.classList.remove('bg-blue-600', 'hover:bg-blue-700');
          homeBtn.classList.add('jh-btn-success');
          if (lbl) lbl.textContent = 'Schedule ✓';
        } else {
          homeBtn.classList.remove('jh-btn-success');
          homeBtn.classList.add('bg-blue-600', 'hover:bg-blue-700');
          if (lbl) lbl.textContent = 'Schedule';
        }
      }
    }

    // Apply server-side schedule state immediately so the button renders correctly without a fetch round-trip
    if (_scheduleData) setScheduleUI(_scheduleData.active, _scheduleData.expression, _scheduleData.timezone);

    function handleScheduleClick() {
      if (_scheduleActive) {
        openScheduleStatusModal();
      } else {
        openScheduleModal();
      }
    }

    // ---- Schedule Setup Modal ----

    function setSchedDateRange(range) {
      _schedDateRange = range;
      document.querySelectorAll('.sched-dr-btn').forEach(btn => {
        const isActive = btn.id === 'sched-dr-' + range;
        btn.classList.toggle('bg-ds-accent', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('border-ds-accent', isActive);
        btn.classList.toggle('text-gray-600', !isActive);
        btn.classList.toggle('border-gray-300', !isActive);
        btn.classList.toggle('hover:bg-gray-50', !isActive);
      });
    }

    function setSchedFrequency(freq) {
      _schedFrequency = freq;
      document.querySelectorAll('.freq-btn').forEach(btn => {
        const isActive = btn.id === 'freq-' + freq;
        btn.classList.toggle('bg-ds-accent', isActive);
        btn.classList.toggle('text-white', isActive);
        btn.classList.toggle('border-ds-accent', isActive);
        btn.classList.toggle('text-gray-600', !isActive);
        btn.classList.toggle('border-gray-300', !isActive);
        btn.classList.toggle('hover:bg-gray-50', !isActive);
      });
      document.getElementById('sched-freq-days')?.classList.toggle('hidden', freq !== 'custom');
    }

    function renderSchedGroups(groups) {
      const container = document.getElementById('sched-modal-groups');
      _schedGroups = (groups || []).map(g => ({
        ...g,
        is_active: !!g.is_active,
      }));
      if (!groups || groups.length === 0) {
        container.innerHTML = '<span class="text-sm text-gray-400">No roles configured.</span>';
        return;
      }
      renderSchedGroupSummary();
    }

    function renderSchedGroupRow(g, inputClass, onChange) {
      const on = !!g.is_active;
      return `
        <div class="flex items-center justify-between py-2 px-1">
          <span class="text-sm text-gray-800 flex-1 min-w-0 pr-3 truncate">${escHtml(g.group_name || 'Role #' + g.id)}</span>
          <label class="flex items-center cursor-pointer flex-shrink-0">
            <input type="checkbox" class="${inputClass} sr-only" value="${g.id}"
                   ${on ? 'checked' : ''} onchange="${onChange}" />
            <div class="relative w-8 h-4 rounded-full transition-colors ${on ? 'bg-[var(--green)]' : 'bg-gray-300'}">
              <div class="absolute top-0.5 ${on ? 'left-4' : 'left-0.5'} w-3 h-3 bg-white rounded-full shadow transition-all"></div>
            </div>
          </label>
        </div>`;
    }

    function getSchedGroupSummaryText() {
      const selected = _schedGroups.filter(g => g.is_active);
      if (_schedGroups.length === 0) return 'No roles configured';
      return selected.length + ' of ' + _schedGroups.length + ' selected';
    }

    function renderSchedGroupSummary() {
      const container = document.getElementById('sched-modal-groups');
      if (_schedGroups.length <= 5) {
        container.innerHTML = _schedGroups.map(g =>
          renderSchedGroupRow(g, 'sched-group-check', 'onSchedGroupToggle(this)')
        ).join('');
        return;
      }

      const selected = _schedGroups.filter(g => g.is_active);
      const preview = selected.slice(0, 2).map(g => escHtml(g.group_name || 'Role #' + g.id)).join(', ');
      const more = selected.length > 2 ? ' +' + (selected.length - 2) + ' more' : '';
      const previewText = preview ? preview + more : 'No roles selected';

      container.innerHTML = `
        <button type="button" onclick="openSchedRolePicker()"
                class="w-full rounded-xl border border-gray-200 px-4 py-3 text-left hover:bg-gray-50 transition-colors">
          <div class="flex items-center justify-between gap-3">
            <div class="min-w-0">
              <div class="text-sm font-medium text-gray-900">${getSchedGroupSummaryText()}</div>
              <div class="text-xs text-gray-500 truncate mt-0.5">${previewText}</div>
            </div>
            <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </button>`;
    }

    function renderSchedRolePicker() {
      document.getElementById('sched-role-picker-count').textContent = getSchedGroupSummaryText();
      document.getElementById('sched-role-picker-list').innerHTML = _schedGroups.map(g =>
        renderSchedGroupRow(g, 'sched-role-picker-check', 'onSchedRolePickerToggle(this)')
      ).join('');
    }

    function openSchedRolePicker() {
      renderSchedRolePicker();
      document.getElementById('schedule-role-picker').classList.remove('hidden');
      document.getElementById('schedule-role-picker').classList.add('md:flex');
    }

    function closeSchedRolePicker() {
      document.getElementById('schedule-role-picker').classList.add('hidden');
      document.getElementById('schedule-role-picker').classList.remove('md:flex');
      if (_schedGroups.length) renderSchedGroupSummary();
    }

    function setSchedGroupState(id, checked) {
      _schedGroups = _schedGroups.map(g => (
        parseInt(g.id, 10) === parseInt(id, 10) ? { ...g, is_active: checked } : g
      ));
    }

    function onSchedGroupToggle(checkbox) {
      setSchedGroupState(checkbox.value, checkbox.checked);
      const track = checkbox.nextElementSibling;
      const thumb = track.firstElementChild;
      if (checkbox.checked) {
        track.classList.replace('bg-gray-300', 'bg-[var(--green)]');
        thumb.classList.replace('left-0.5', 'left-4');
      } else {
        track.classList.replace('bg-[var(--green)]', 'bg-gray-300');
        thumb.classList.replace('left-4', 'left-0.5');
      }
    }

    function onSchedRolePickerToggle(checkbox) {
      onSchedGroupToggle(checkbox);
      document.getElementById('sched-role-picker-count').textContent = getSchedGroupSummaryText();
    }

    function setAllSchedRoles(checked) {
      _schedGroups = _schedGroups.map(g => ({ ...g, is_active: checked }));
      renderSchedRolePicker();
    }

    function renderSchedProviders(selectedValues) {
      const selected = selectedValues || DEFAULT_PROVIDER_VALUES;
      _schedProviders = SCHED_PROVIDER_OPTIONS.map(p => ({
        ...p,
        checked: selected.includes(p.value),
      }));
      renderSchedProviderSummary();
    }

    function renderSchedProviderRow(provider, inputClass, onChange) {
      return `
        <label class="provider-picker-row">
          <input type="checkbox" class="${inputClass} rounded border-[color:var(--line2)] focus:ring-[var(--accent)]"
                 value="${provider.value}" ${provider.checked ? 'checked' : ''} onchange="${onChange}">
          <span class="provider-picker-source">${escHtml(provider.pickerLabel || provider.label)}</span>
          <span class="provider-picker-cost ${provider.costPerThousand === 'free' ? 'free' : ''}">${escHtml(provider.costPerThousand || '')}</span>
          <span class="provider-picker-desc">${escHtml(provider.description || '')}</span>
        </label>`;
    }

    function getSchedProviderSummaryText() {
      const selected = _schedProviders.filter(p => p.checked);
      return selected.length + ' of ' + _schedProviders.length + ' selected';
    }

    function renderSchedProviderSummary() {
      const container = document.getElementById('sched-provider-options');
      const selected = _schedProviders.filter(p => p.checked);
      const preview = selected.slice(0, 2).map(p => escHtml(p.label)).join(', ');
      const more = selected.length > 2 ? ' +' + (selected.length - 2) + ' more' : '';
      const previewText = preview ? preview + more : 'No providers selected';

      container.innerHTML = `
        <button type="button" onclick="openSchedProviderPicker()"
                class="w-full rounded-xl border border-gray-200 px-4 py-3 text-left hover:bg-gray-50 transition-colors">
          <div class="flex items-center justify-between gap-3">
            <div class="min-w-0">
              <div class="text-sm font-medium text-gray-900">${getSchedProviderSummaryText()}</div>
              <div class="text-xs text-gray-500 truncate mt-0.5">${previewText}</div>
            </div>
            <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </div>
        </button>`;
    }

    function renderSchedProviderPicker() {
      document.getElementById('sched-provider-picker-count').textContent = getSchedProviderSummaryText();
      document.getElementById('sched-provider-picker-list').innerHTML = `
        <div class="provider-picker-head" aria-hidden="true">
          <span></span>
          <span>Source: provider</span>
          <span>Fetch / 1k</span>
          <span>Description</span>
        </div>
        ${_schedProviders.map(p =>
          renderSchedProviderRow(p, 'sched-provider-picker-check', 'onSchedProviderPickerToggle(this)')
        ).join('')}`;
    }

    function openSchedProviderPicker() {
      renderSchedProviderPicker();
      document.getElementById('schedule-provider-picker').classList.remove('hidden');
      document.getElementById('schedule-provider-picker').classList.add('md:flex');
    }

    function closeSchedProviderPicker() {
      document.getElementById('schedule-provider-picker').classList.add('hidden');
      document.getElementById('schedule-provider-picker').classList.remove('md:flex');
      if (_schedProviders.length) renderSchedProviderSummary();
    }

