<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Job Hunter — <%= title %></title>
  <link rel="icon" href="/icon.ico">
  <link rel="stylesheet" href="/css/tailwind.css">
  <style>
    [x-cloak] { display: none !important; }
    :root { --page-max-w: <%= locals.pageMaxWidth || '72rem' %>; }
    .score-badge { font-variant-numeric: tabular-nums; }
    html, body { overflow: hidden; }
    .app-shell { height: 100dvh; min-height: 100%; background: #f9fafb; overflow: hidden; }
    .app-sidebar { width: 14rem; height: 100dvh; overflow: hidden; overscroll-behavior: contain; }
    .app-sidebar nav { overflow-y: visible; }
    .app-main { min-width: 0; height: 100dvh; overflow-y: auto; overflow-x: hidden; }
    .app-content { width: 100%; max-width: var(--page-max-w); min-height: 100%; display: flex; flex-direction: column; }
    .app-page { flex: 1 0 auto; padding: 2rem 1.5rem 2rem; }
    @media (max-width: 767px) { .app-page { padding-bottom: 5rem; } }
    .app-footer { flex-shrink: 0; padding: 0 1.5rem 1.5rem; }
    .mobile-bottom-nav {
      height: calc(4rem + env(safe-area-inset-bottom, 0px));
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .job-list-container {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 0.75rem;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
      overflow-x: auto;
      overflow-y: hidden;
    }
    .job-table {
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
    }
    .job-table-row {
      border-top: 1px solid #f3f4f6;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }
    .job-table-row:hover { background: rgba(239, 246, 255, 0.45); }
    .job-table-cell { padding: 0.875rem 0.75rem; vertical-align: top; min-width: 0; }
    .job-table-fixed { white-space: nowrap; text-align: center; }
    .job-table-cell.job-table-fixed:last-child { padding-left: 0.25rem; padding-right: 0.5rem; }
    .job-table-cell.job-table-fixed:nth-last-child(2) { padding-left: 0.75rem; padding-right: 0.75rem; }
    .job-mobile-list { display: block; }
    .job-mobile-card {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 0.75rem;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
      padding: 1rem;
      cursor: pointer;
    }
    .job-identity-title { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .job-table .job-identity-title { overflow: visible; text-overflow: clip; white-space: normal; line-height: 1.35; }
    .job-mobile-card .job-identity-title { overflow: visible; text-overflow: clip; white-space: normal; line-height: 1.35; }
    .job-identity-meta { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .job-summary-text {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      overflow: hidden;
    }
    .job-location-text {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }
    @media (min-width: 768px) {
      .job-mobile-list { display: none; }
      .job-desktop-table { display: table; }
    }
    @media (max-width: 767px) {
      .job-desktop-table { display: none; }
    }

    /* ── Sidebar/nav shared tokens ──────────────────────────────── */
    :root {
      --jh-sb-bg:     #0C0E12;
      --jh-sb-bg2:    #14171D;
      --jh-sb-border: #1F242C;
      --jh-sb-ink:    #E9ECF1;
      --jh-sb-muted:  #8A91A0;
      --jh-sb-hover:  #1A1E26;
      --jh-sb-active: #232936;
      --jh-sb-blue:   #2F6BFF;
      --jh-sb-blue2:  #2056E8;
      --jh-sb-green:  #1E9E5A;
      --jh-sb-green2: #178049;
    }

    /* Sidebar width override */
    .app-sidebar { width: 264px; }

    /* ── Nav items ──────────────────────────────────────────────── */
    .sb-item {
      display: flex; align-items: center; gap: 11px;
      padding: 9px 10px; border-radius: 8px;
      color: var(--jh-sb-ink); font-size: 13.5px; font-weight: 500;
      background: transparent; border: 0; width: 100%;
      text-align: left; cursor: pointer; text-decoration: none;
    }
    .sb-item .ico { color: var(--jh-sb-muted); display: inline-flex; }
    .sb-item:hover { background: var(--jh-sb-hover); }
    .sb-item.active {
      background: var(--jh-sb-active);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.04);
    }
    .sb-item.active .ico { color: var(--jh-sb-ink); }
    .sb-count {
      margin-left: auto; font-size: 11px;
      color: var(--jh-sb-muted);
      background: rgba(255,255,255,0.04);
      border-radius: 999px; padding: 2px 7px;
    }

    /* ── Scrollable nav middle section ──────────────────────────── */
    .sb-nav-scroll {
      flex: 1; overflow-y: auto; min-height: 0;
      padding: 12px 10px;
      display: flex; flex-direction: column; gap: 2px;
    }
    .sb-nav-scroll::-webkit-scrollbar { width: 0; }

    /* ── Settings sub-nav ───────────────────────────────────────── */
    .sb-subnav {
      display: flex; flex-direction: column; gap: 2px;
      padding: 2px 0 4px 10px; margin-left: 10px;
      border-left: 1px solid var(--jh-sb-border);
    }
    .sb-subitem {
      padding: 7px 10px; font-size: 13px; font-weight: 500;
      color: var(--jh-sb-muted); gap: 10px;
    }
    .sb-subitem:hover { color: var(--jh-sb-ink); background: var(--jh-sb-hover); }
    .sb-subitem.active { background: var(--jh-sb-active); color: var(--jh-sb-ink); }
    .sb-subdot {
      width: 4px; height: 4px; border-radius: 50%;
      background: currentColor; opacity: 0.55; flex-shrink: 0; margin-left: 2px;
    }
    .sb-subitem.active .sb-subdot { opacity: 1; background: #4D87FF; }
    .sb-chev {
      display: inline-flex; align-items: center; margin-left: auto;
      color: var(--jh-sb-muted); transition: transform 0.15s ease;
    }
    .sb-chev.open { transform: rotate(90deg); }

    /* ── Sidebar footer ─────────────────────────────────────────── */
    .sb-footer {
      padding: 12px; border-top: 1px solid var(--jh-sb-border);
      display: flex; flex-direction: column; gap: 10px;
    }
    .sb-run-group { display: flex; flex-direction: column; gap: 6px; }

    /* ── Run buttons ────────────────────────────────────────────── */
    .sb-run {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 12px; border-radius: 9px; border: 0;
      font-size: 13.5px; font-weight: 600; font-family: inherit;
      text-align: left; width: 100%; cursor: pointer;
      white-space: nowrap; color: white;
    }
    .sb-run-primary {
      background: var(--jh-sb-green);
      box-shadow: 0 1px 0 rgba(255,255,255,0.18) inset, 0 1px 2px rgba(30,158,90,0.35);
    }
    .sb-run-primary:hover { background: var(--jh-sb-green2); }
    .sb-run-secondary {
      background: var(--jh-sb-blue);
      box-shadow: 0 1px 0 rgba(255,255,255,0.18) inset, 0 1px 2px rgba(47,107,255,0.4);
    }
    .sb-run-secondary:hover { background: var(--jh-sb-blue2); }
    .sb-run-danger {
      background: #dc2626;
      box-shadow: 0 1px 0 rgba(255,255,255,0.18) inset;
    }
    .sb-run-danger:hover { background: #b91c1c; }

    /* ── Shared success / run button color ─────────────────── */
    .jh-btn-success { background: var(--jh-sb-green); border-color: var(--jh-sb-green); }
    .jh-btn-success:hover { background: var(--jh-sb-green2); border-color: var(--jh-sb-green2); }

    .sb-run-meta {
      margin-left: auto; font-size: 11px; font-weight: 500;
      opacity: 0.85; font-family: monospace;
    }

    /* ── Credits placeholder ────────────────────────────────────── */
    .sb-credits {
      background: linear-gradient(180deg, #1B2230 0%, #161B25 100%);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 10px; padding: 8px 12px;
      display: flex; align-items: center; gap: 10px;
      box-shadow: 0 1px 0 rgba(255,255,255,0.04) inset, 0 4px 14px rgba(0,0,0,0.25);
    }
    .sb-credits-icon { color: white; display: inline-flex; }
    .sb-credits-num {
      font-size: 18px; font-weight: 700;
      letter-spacing: -0.02em; color: var(--jh-sb-ink);
    }
    .sb-credits-sub { font-size: 10.5px; color: var(--jh-sb-muted); flex: 1; }
    .sb-credits-topup {
      display: inline-flex; align-items: center; gap: 4px;
      background: var(--jh-sb-blue); color: white; border: 0;
      font-weight: 600; font-size: 11.5px; font-family: inherit;
      padding: 5px 8px; border-radius: 6px; cursor: pointer; flex-shrink: 0;
      box-shadow: 0 1px 0 rgba(255,255,255,0.16) inset;
    }
    .sb-credits-topup:hover { background: var(--jh-sb-blue2); }

    /* ── Profile row ────────────────────────────────────────────── */
    .sb-profile {
      display: flex; align-items: center; gap: 10px;
      padding: 8px; border-radius: 10px;
      background: transparent; width: 100%;
      color: var(--jh-sb-ink);
    }
    .sb-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: linear-gradient(135deg, #4D87FF, #2F6BFF);
      display: grid; place-items: center;
      color: white; font-weight: 600; font-size: 13px; flex-shrink: 0;
    }
    .sb-profile-meta { display: flex; flex-direction: column; flex: 1; min-width: 0; }
    .sb-profile-name { font-size: 13.5px; font-weight: 600; line-height: 1.2; }
    .sb-profile-email {
      font-size: 11.5px; color: var(--jh-sb-muted);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .sb-role-pill {
      font-size: 9.5px;
      background: rgba(180,114,8,0.18); color: #E6B66B;
      padding: 1px 6px; border-radius: 999px;
      letter-spacing: 0.04em; text-transform: uppercase;
      font-weight: 600; margin-left: 6px; vertical-align: middle;
    }
    .sb-logout-btn {
      width: 28px; height: 28px; border-radius: 6px;
      display: grid; place-items: center;
      color: var(--jh-sb-muted); flex-shrink: 0;
      background: transparent; border: 0; cursor: pointer;
    }
    .sb-logout-btn:hover { background: rgba(255,255,255,0.06); color: var(--jh-sb-ink); }

    /* ── Onboarding widget ──────────────────────────────────────── */
    .sb-onboard {
      background: linear-gradient(180deg, rgba(47,107,255,0.10) 0%, rgba(47,107,255,0.04) 100%);
      border: 1px solid rgba(77,135,255,0.18);
      border-radius: 10px; padding: 10px 10px 6px; margin-bottom: 16px;
      display: flex; flex-direction: column; gap: 6px;
    }
    .sb-onboard-head { display: flex; align-items: center; justify-content: space-between; }
    .sb-onboard-title {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 11px; font-weight: 600; letter-spacing: 0.06em;
      text-transform: uppercase; color: #B6CDFF;
    }
    .sb-onboard-title svg { color: #82A8FF; width: 12px; height: 12px; }
    .sb-onboard-close {
      width: 20px; height: 20px; border-radius: 5px;
      display: grid; place-items: center;
      background: transparent; border: 0;
      color: var(--jh-sb-muted); cursor: pointer;
    }
    .sb-onboard-close:hover { background: rgba(255,255,255,0.06); color: var(--jh-sb-ink); }
    .sb-onboard-meta {
      display: flex; align-items: center; gap: 8px;
      font-size: 10.5px; color: var(--jh-sb-muted);
    }
    .sb-onboard-bar {
      flex: 1; height: 3px;
      background: rgba(255,255,255,0.06); border-radius: 999px; overflow: hidden;
    }
    .sb-onboard-bar-fill {
      display: block; height: 100%;
      background: linear-gradient(90deg, #4D87FF, #2F6BFF); border-radius: 999px;
    }
    .sb-onboard-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
    .sb-onboard-item {
      width: 100%; display: grid;
      grid-template-columns: 16px 1fr 12px;
      align-items: center; gap: 8px; padding: 4px;
      border-radius: 6px; background: transparent; border: 0;
      color: var(--jh-sb-ink); font-size: 12px; font-family: inherit;
      text-align: left; text-decoration: none; cursor: pointer; line-height: 1.2;
    }
    .sb-onboard-item:hover:not(.no-action) { background: rgba(255,255,255,0.04); }
    .sb-onboard-item.no-action { cursor: default; }
    .sb-onboard-item.done { color: var(--jh-sb-muted); }
    .sb-onboard-item.done .sb-onboard-label {
      text-decoration: line-through;
      text-decoration-color: rgba(255,255,255,0.15);
    }
    .sb-onboard-check {
      width: 16px; height: 16px; border-radius: 50%;
      display: grid; place-items: center;
      border: 1px solid rgba(255,255,255,0.18);
      color: var(--jh-sb-muted); font-size: 9.5px; font-weight: 600;
      background: rgba(255,255,255,0.02); flex-shrink: 0;
    }
    .sb-onboard-check.done { background: #1E9E5A; border-color: #1E9E5A; color: white; }
    .sb-onboard-check.done svg { width: 10px; height: 10px; stroke-width: 2.6; }
    .sb-onboard-chev { color: var(--jh-sb-muted); opacity: 0.6; width: 12px; height: 12px; }
    .sb-onboard-item:hover .sb-onboard-chev { opacity: 1; }

    /* ── Throb (one-shot, applied via JS, removed after 2 s) ─────── */
    @keyframes jh-throb {
      0%,100% { transform: scale(1); }
      50%      { transform: scale(1.02); }
    }
    @keyframes jh-throb-green {
      0%,100% { box-shadow: 0 1px 0 rgba(255,255,255,0.18) inset, 0 0 0 0   rgba(30,158,90,0.55); }
      50%      { box-shadow: 0 1px 0 rgba(255,255,255,0.18) inset, 0 0 0 8px rgba(30,158,90,0);    }
    }
    @keyframes jh-throb-blue {
      0%,100% { box-shadow: 0 1px 0 rgba(255,255,255,0.18) inset, 0 0 0 0   rgba(47,107,255,0.55); }
      50%      { box-shadow: 0 1px 0 rgba(255,255,255,0.18) inset, 0 0 0 8px rgba(47,107,255,0);    }
    }
    .jh-throb-run  { animation: jh-throb 1s ease-in-out infinite, jh-throb-green 1s ease-in-out infinite; }
    .jh-throb-sched{ animation: jh-throb 1s ease-in-out infinite, jh-throb-blue  1s ease-in-out infinite; }
  </style>
  <script>
    window.JHUI_TOKENS = <%- JSON.stringify(getClientUiTokens()) %>;
    window.JHUI = {
      formatVerdictLabel(value) {
        const key = String(value || '').trim().toUpperCase();
        return window.JHUI_TOKENS.verdictLabels[key] || (key ? key.replace(/[_-]+/g, ' ').toLowerCase().replace(/\b\w/g, c => c.toUpperCase()) : 'Unknown');
      },
      getVerdictTone(value) {
        return window.JHUI_TOKENS.verdictTones[String(value || '').trim().toUpperCase()] || 'bg-gray-100 text-gray-500';
      },
      isVerdictEditable(value) {
        return window.JHUI_TOKENS.editableVerdicts.includes(String(value || '').trim().toUpperCase());
      },
      formatScore(value) {
        if (value === null || value === undefined || value === '') return '\u2014';
        const num = Number(value);
        return Number.isFinite(num) ? String(Math.round(num)) : '\u2014';
      },
      formatAppliedLabel(value) {
        return 'Applied';
      },
      getAppliedTone(value) {
        return this.formatAppliedLabel(value) === 'Applied'
          && (value === true || value === 1 || value === '1' || value === 'true')
          ? 'jh-btn-success text-white'
          : 'bg-gray-50 text-gray-300 border-gray-200 hover:bg-gray-100 hover:border-gray-300 hover:text-gray-400';
      }
    };
  </script>
</head>
<body class="h-full font-sans antialiased text-gray-900">

  <!-- AppShell -->
  <div class="app-shell flex">

    <!-- SidebarNav (desktop only) -->
    <aside class="app-sidebar hidden md:flex flex-shrink-0 flex-col sticky top-0 h-screen" style="background:var(--jh-sb-bg);color:var(--jh-sb-ink);">

      <!-- Brand row -->
      <div style="display:flex;align-items:center;gap:10px;padding:18px 16px 16px;border-bottom:1px solid var(--jh-sb-border);flex-shrink:0;">
        <div style="width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#4D87FF,#2F6BFF);display:grid;place-items:center;color:white;font-weight:700;font-size:12px;letter-spacing:0.02em;box-shadow:0 1px 0 rgba(255,255,255,0.12) inset,0 2px 6px rgba(47,107,255,0.35);flex-shrink:0;">JH</div>
        <div>
          <div style="font-weight:600;font-size:15px;letter-spacing:-0.01em;color:var(--jh-sb-ink);">Job Hunter</div>
          <div style="font-size:11px;color:var(--jh-sb-muted);margin-top:1px;">Find a matching job</div>
        </div>
      </div>

      <!-- Scrollable nav section -->
      <div class="sb-nav-scroll">

        <!-- Onboarding widget -->
        <div class="sb-onboard" id="sb-onboard-widget">
          <div class="sb-onboard-head">
            <div class="sb-onboard-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"/></svg>
              Onboarding
            </div>
            <button class="sb-onboard-close" onclick="jhDismissOnboarding()" aria-label="Dismiss onboarding">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 6l12 12M18 6l-12 12"/></svg>
            </button>
          </div>
          <div class="sb-onboard-meta">
            <%= onboarding.completedCount %> of 5 done
            <span class="sb-onboard-bar">
              <span class="sb-onboard-bar-fill" style="width:<%= (onboarding.completedCount/5*100) %>%"></span>
            </span>
          </div>
          <ul class="sb-onboard-list">
            <%
              const obSteps = [
                { label: 'Set up your profile',          href: '/settings',          clickFn: null },
                { label: 'Add target roles & criteria',  href: '/settings?tab=roles', clickFn: null },
                { label: 'Buy credits or add API keys',  href: '/settings?tab=ai',   clickFn: null },
                { label: 'Run your first search',        href: null,                  clickFn: 'jhThrobRun()' },
                { label: 'Set a daily schedule',         href: null,                  clickFn: 'jhThrobSchedule()' },
              ];
            %>
            <% obSteps.forEach(function(step, i) { %>
              <% const state = onboarding.states[i]; %>
              <% const hasAction = step.href || step.clickFn; %>
              <% if (step.href) { %>
            <li><a href="<%= step.href %>" class="sb-onboard-item <%= state %>">
              <% } else if (step.clickFn) { %>
            <li><button type="button" class="sb-onboard-item <%= state %>" onclick="<%= step.clickFn %>">
              <% } else { %>
            <li><span class="sb-onboard-item <%= state %> no-action">
              <% } %>
                <span class="sb-onboard-check <%= state === 'done' ? 'done' : '' %>">
                  <% if (state === 'done') { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="m5 12 5 5L20 6"/></svg>
                  <% } else { %>
                    <%= i + 1 %>
                  <% } %>
                </span>
                <span class="sb-onboard-label"><%= step.label %></span>
                <% if (hasAction && state !== 'done') { %>
                  <svg class="sb-onboard-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="m9 6 6 6-6 6"/></svg>
                <% } else { %>
                  <span></span>
                <% } %>
              <% if (step.href) { %></a></li>
              <% } else if (step.clickFn) { %></button></li>
              <% } else { %></span></li>
              <% } %>
            <% }); %>
          </ul>
        </div>

        <!-- Nav items -->
        <a href="/" class="sb-item <%= title === 'Start' ? 'active' : '' %>">
          <span class="ico">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/></svg>
          </span>
          Start
        </a>
        <a href="/jobs" class="sb-item <%= title === 'Matches' ? 'active' : '' %>">
          <span class="ico">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1l8.8 8.8 8.8-8.8a5 5 0 0 0 0-7.1Z"/></svg>
          </span>
          Matches
        </a>
        <a href="/history" class="sb-item <%= title === 'All Jobs' ? 'active' : '' %>">
          <span class="ico">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/></svg>
          </span>
          All Jobs
        </a>
        <a href="/analytics" class="sb-item <%= title === 'Stats' ? 'active' : '' %>">
          <span class="ico">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-8"/><path d="M22 20H2"/></svg>
          </span>
          Stats
        </a>
        <a href="/reports" class="sb-item <%= title === 'Run Logs' ? 'active' : '' %>">
          <span class="ico">
