<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Job Search — <%= title %></title>
  <link rel="icon" href="/icon.ico?v=<%= iconVersion %>">
  <link rel="stylesheet" href="/css/tailwind.css">
  <style>
    [x-cloak] { display: none !important; }
    :root { --page-max-w: <%= locals.pageMaxWidth || '1120px' %>; }
    html, body { overflow: hidden; }
    .app-shell { height: 100dvh; min-height: 100%; background: #fcfcfb; overflow: hidden; }
    .app-sidebar { width: 14rem; height: 100dvh; overflow: hidden; overscroll-behavior: contain; }
    .app-sidebar nav { overflow-y: visible; }
    .app-main { min-width: 0; height: 100dvh; overflow-y: auto; overflow-x: hidden; }
    .app-content { width: 100%; max-width: var(--page-max-w); min-height: 100%; display: flex; flex-direction: column; }
    .app-page { flex: 1 0 auto; padding: 24px 16px 24px; }
    @media (max-width: 767px) { .app-page { padding-bottom: 5rem; } }
    /* Full-bleed pages (two-pane Matches/All Jobs, Run Logs): fill the main area edge-to-edge */
    .app-content.full { max-width: none; }
    .app-page.full { padding: 0; }
    .app-footer { flex-shrink: 0; padding: 0 1.5rem 1.5rem; }
    .mobile-bottom-nav {
      height: calc(4rem + env(safe-area-inset-bottom, 0px));
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .job-list-container {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 0.75rem;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
      overflow-x: auto;
      overflow-y: hidden;
    }
    .job-table {
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
    }
    .job-table-row {
      border-top: 1px solid var(--line);
      cursor: pointer;
      transition: background-color 0.15s ease;
    }
    .job-table-row:hover { background: var(--accent-tint); }
    .job-table-cell { padding: 0.875rem 0.75rem; vertical-align: top; min-width: 0; }
    .job-table-fixed { white-space: nowrap; text-align: center; }
    .job-table-cell.job-table-fixed:last-child { padding-left: 0.25rem; padding-right: 0.5rem; }
    .job-table-cell.job-table-fixed:nth-last-child(2) { padding-left: 0.75rem; padding-right: 0.75rem; }
    .job-mobile-list { display: block; }
    .job-mobile-card {
      background: #fff;
      border: 1px solid var(--line3);
      border-radius: 14px;
      box-shadow: var(--shadow-card);
      padding: 1rem;
      cursor: pointer;
      transition: box-shadow 0.15s ease;
    }
    .job-mobile-card:hover { box-shadow: inset 3px 0 0 var(--accent), 0 1px 2px rgba(15, 23, 42, 0.04); }
    .job-identity-title { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .job-table .job-identity-title { overflow: visible; text-overflow: clip; white-space: normal; line-height: 1.35; }
    .job-mobile-card .job-identity-title { overflow: visible; text-overflow: clip; white-space: normal; line-height: 1.35; }
    .job-identity-meta { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .job-summary-text {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      overflow: hidden;
    }
    .job-location-text {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      overflow: hidden;
    }
    @media (min-width: 768px) {
      .job-mobile-list { display: none; }
      .job-desktop-table { display: table; }
    }
    @media (max-width: 767px) {
      .job-desktop-table { display: none; }
    }

    /* Sidebar width override (DS v2: 236px, light) */
    .app-sidebar { width: 236px; }

    /* ── Nav items ──────────────────────────────────────────────── */
    .sb-item {
      display: flex; align-items: center; gap: 11px;
      padding: 9px 11px; border-radius: 9px;
      color: var(--muted); font-size: 13.5px; font-weight: 600; line-height: 1.2;
      background: transparent; border: 0; width: 100%;
      text-align: left; cursor: pointer; text-decoration: none;
    }
    .sb-item .ico { color: var(--fainter); display: inline-flex; }
    .sb-item .ico svg { stroke-width: 1.8; }
    .sb-item:hover { background: #f5f6f8; color: var(--ink2); }
    .sb-item.active {
      background: var(--accent-soft); color: var(--accent); font-weight: 700;
    }
    .sb-item.active .ico { color: var(--accent); }
    .sb-item.active .ico svg { stroke-width: 1.9; }
    .sb-count {
      margin-left: auto; font-size: 11px; font-weight: 700;
      color: #fff;
      background: var(--accent);
      border-radius: 999px; padding: 1px 8px;
    }

    /* ── Nav middle section ─────────────────────────────────────────
       It does NOT scroll. It used to, behind a 0px scrollbar, which meant that when the column
       overflowed the credits card and the profile row were simply gone with nothing to say so.
       The column has to fit instead, and it yields in a fixed order to make sure it does — see
       `jhFitNav` below (D33, D51). */
    .sb-nav-scroll {
      flex: 1; overflow: hidden; min-height: 0;
      padding: 8px 12px;
      display: flex; flex-direction: column; gap: 2px;
    }

    /* ── Settings sub-nav ───────────────────────────────────────── */
    .sb-subnav {
      display: flex; flex-direction: column; gap: 2px;
      padding: 2px 0 4px 10px; margin-left: 10px;
      border-left: 1px solid var(--line);
    }
    .sb-subitem {
      padding: 7px 10px; font-size: 13px; font-weight: 600; line-height: 1.2;
      color: var(--muted); gap: 10px;
    }
    .sb-subitem:hover { color: var(--ink2); background: #f5f6f8; }
    .sb-subitem.active { background: var(--accent-soft); color: var(--accent); font-weight: 700; }
    .sb-subdot {
      width: 4px; height: 4px; border-radius: 50%;
      background: currentColor; opacity: 0.55; flex-shrink: 0; margin-left: 2px;
    }
    .sb-subitem.active .sb-subdot { opacity: 1; }
    .sb-subitem.admin.active { background: var(--red-soft); color: var(--red-ink); }
    .sb-subitem.admin.active .sb-subdot { opacity: 1; background: var(--red); }
    .sb-admin-divider { height: 1px; background: var(--line); margin: 10px 10px; }
    /* The shortcut counts sit where a role count would: quiet, right-aligned, tabular. */
    .sb-subcount { margin-left: auto; font-size: 11px; font-weight: 700; color: var(--faintest); font-variant-numeric: tabular-nums; }
    .sb-subitem.active .sb-subcount { color: var(--accent); }

    /* ── Footer: two compact rows (D41) ─────────────────────────── */
    .sb-compact {
      padding: 10px 12px; border-top: 1px solid var(--line);
      display: flex; flex-direction: column; gap: 7px; flex-shrink: 0; position: relative;
    }
    .sb-compact-row { display: flex; align-items: center; gap: 7px; }
    .sb-run-c {
      flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; gap: 7px;
      height: 36px; white-space: nowrap; border-radius: 10px; font-family: inherit;
      border: 1px solid var(--green-border); background: var(--green-soft); color: var(--green2);
      font-size: 13px; font-weight: 700; cursor: pointer;
    }
    .sb-run-c:hover { background: #e6f3ec; }
    .sb-run-c:disabled { opacity: .55; cursor: not-allowed; }
    .sb-run-c:disabled:hover { background: var(--green-soft); }
    .sb-run-c svg { flex: none; }
    /* The schedule control is a clock and nothing else; the dot notched into its corner is a
       state light — red off, green on — and it never animates (D42). */
    .sb-sched {
      position: relative; display: inline-grid; place-items: center; width: 36px; height: 36px;
      flex: none; border-radius: 10px; border: 1px solid var(--line2); background: #fff;
      color: var(--muted); text-decoration: none;
    }
    .sb-sched:hover { background: #f5f6f8; color: var(--ink2); }
    .sb-sched.live { border-color: var(--green-border); color: var(--green2); }
    .sb-sched.live:hover { background: var(--green-soft); }
    .sb-sched .lamp {
      position: absolute; top: -3px; right: -3px; width: 10px; height: 10px;
      border-radius: 50%; border: 2px solid #fff; background: var(--red);
    }
    .sb-sched.live .lamp { background: var(--green); }
    .sb-sched.is-locked { opacity: .55; cursor: not-allowed; pointer-events: none; }
    /* The balance and its ＋ are one split pill — a ＋ floating beside it reads as unrelated. */
    .sb-money {
      display: flex; align-items: stretch; height: 34px; flex: 1; min-width: 0;
      border-radius: 9px; border: 1px solid var(--line2); background: #fbfcfe; overflow: hidden;
    }
    .sb-money .val {
      flex: 1; min-width: 0; display: flex; align-items: baseline; gap: 6px; padding: 0 10px;
      background: none; border: 0; color: var(--ink); font-size: 15px; font-weight: 800;
      font-variant-numeric: tabular-nums; text-align: left; letter-spacing: -.01em;
      font-family: inherit; cursor: pointer;
    }
    .sb-money .val:hover { background: #f2f5fa; }
    .sb-money .val em { font-style: normal; font-size: 11px; font-weight: 600; color: var(--faint); white-space: nowrap; }
    .sb-money .add {
      width: 31px; flex: none; display: grid; place-items: center; background: transparent;
      border: 0; border-left: 1px solid var(--line2); color: var(--accent); cursor: pointer;
    }
    .sb-money .add:hover { background: var(--accent-soft); }
    .sb-av-btn {
      width: 34px; height: 34px; flex: none; border-radius: 50%; border: 0; padding: 0;
      background: linear-gradient(135deg, #5b8cff, var(--accent)); color: #fff;
      font-size: 13px; font-weight: 700; font-family: inherit;
      display: grid; place-items: center; position: relative; cursor: pointer;
    }
    .sb-av-btn .adm {
      position: absolute; right: -1px; bottom: -1px; width: 11px; height: 11px;
      border-radius: 50%; background: var(--red); border: 2px solid #fff;
    }
    /* Own-keys profiles: the account takes the row the balance would have had, at the same height. */
    .sb-acct {
      display: flex; align-items: center; gap: 9px; flex: 1; min-width: 0; height: 34px;
      padding: 0 4px 0 0; border: 0; background: none; border-radius: 9px;
      color: var(--ink); text-align: left; font-family: inherit; cursor: pointer;
    }
    .sb-acct:hover { background: #f5f6f8; }
    .sb-av-btn.as-part { pointer-events: none; }
    .sb-acct-meta { display: flex; flex-direction: column; flex: 1; min-width: 0; }
    .sb-acct-email { font-size: 11.5px; font-weight: 700; line-height: 1.25; color: var(--ink2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sb-acct-sub { font-size: 10px; color: var(--faint); font-weight: 600; line-height: 1.2; }
    .sb-acct-chev { color: var(--fainter); flex: none; }

    /* The profile menu (D43) */
    .sb-pop {
      position: absolute; left: 12px; right: 12px; bottom: calc(100% - 4px); z-index: 60;
      background: #fff; border: 1px solid #e4e6ec; border-radius: 12px;
      box-shadow: var(--shadow-dropdown); padding: 6px;
    }
    .sb-pop.hidden { display: none; }
    .sb-pop-mail { padding: 8px 9px 9px; font-size: 12px; font-weight: 700; color: var(--ink2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .sb-pop-sep { height: 1px; background: var(--line); margin: 5px 4px; }
    .sb-pop-row {
      display: flex; align-items: center; gap: 8px; padding: 7px 9px; border-radius: 8px;
      font-size: 12.5px; font-weight: 600; color: var(--ink2); border: 0; background: none;
      width: 100%; text-align: left; text-decoration: none; font-family: inherit; cursor: pointer;
    }
    .sb-pop-row:hover { background: #f5f6f8; }
    /* Admin is a heading here, not a row — it was never a page. */
    .sb-pop-lbl.adm {
      display: flex; align-items: center; gap: 7px; padding: 9px 9px 3px;
      font-size: 10px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
      color: var(--red-ink); opacity: .85;
    }
    .sb-pop-row.adm { padding-left: 26px; position: relative; }
    .sb-pop-row.adm::before {
      content: ''; position: absolute; left: 15px; top: 50%; width: 4px; height: 4px;
      margin-top: -2px; border-radius: 50%; background: var(--red); opacity: .6;
    }
    .sb-pop-row.adm:hover { background: var(--red-soft); color: var(--red-ink); }
    .sb-chev {
      display: inline-flex; align-items: center; margin-left: auto;
      color: var(--fainter); transition: transform 0.15s ease;
    }
    .sb-chev.open { transform: rotate(90deg); }

    /* ── Sidebar footer ─────────────────────────────────────────── */
    .sb-footer {
      padding: 12px; border-top: 1px solid var(--line);
      display: flex; flex-direction: column; gap: 8px;
    }
    .sb-run-group { display: flex; flex-direction: column; gap: 6px; }

    /* ── Run buttons (DS v2 light) ──────────────────────────────── */
    .sb-run {
      display: flex; align-items: center; gap: 9px;
      padding: 10px 13px; border-radius: 10px; border: 0;
      font-size: 13.5px; font-weight: 700; font-family: inherit;
      text-align: left; width: 100%; cursor: pointer;
      white-space: nowrap;
    }
    .sb-run-primary {
      border: 1px solid var(--green-border);
      background: var(--green-soft); color: var(--green2);
    }
    .sb-run-primary:hover { background: #e6f3ec; }
    .sb-run-primary:disabled { opacity: 0.55; cursor: not-allowed; }
    .sb-run-primary:disabled:hover { background: var(--green-soft); }
    .sb-run-secondary {
      background: #eef1f6; color: var(--ink2);
    }
    .sb-run-secondary:hover { background: #e6eaf1; }
    .sb-run-secondary:disabled { opacity: 0.55; cursor: not-allowed; }
    .sb-run-secondary:disabled:hover { background: #eef1f6; }
    .sb-run-danger {
      border: 1px solid var(--red-border);
      background: var(--red-soft); color: var(--red-ink);
    }
    .sb-run-danger:hover { background: #fde7e5; }

    /* ── Shared success / run button color (solid green, on light) ── */
    .jh-btn-success { background: var(--green); border-color: var(--green); }
    .jh-btn-success:hover { background: var(--green2); border-color: var(--green2); }
    .jh-btn-success:disabled { opacity: 0.55; cursor: not-allowed; }

    .sb-run-meta {
      margin-left: auto; font-size: 11px; font-weight: 600;
      opacity: 0.85; font-family: monospace;
    }

    /* ── Credits placeholder ────────────────────────────────────── */
    .sb-credits {
      background: #fbfcfe;
      border: 1px solid var(--line2);
      border-radius: 11px; padding: 9px 11px;
      display: flex; align-items: center; gap: 10px;
      margin-top: 2px;
    }
    .sb-credits-icon { color: var(--accent); display: inline-flex; }
    .sb-credits-vals { display: flex; align-items: baseline; gap: 6px; }
    .sb-credits-num {
      font-size: 16px; font-weight: 800;
      letter-spacing: -0.02em; color: var(--ink);
    }
    .sb-credits-sub { font-size: 10.5px; color: var(--faint); font-weight: 600; white-space: nowrap; }
    .sb-credits-topup {
      margin-left: auto; flex-shrink: 0;
      display: inline-flex; align-items: center; justify-content: center;
      width: 26px; height: 26px; padding: 0;
      background: transparent; color: var(--accent);
      border: 1px solid var(--accent-border);
      border-radius: 7px; cursor: pointer;
    }
    .sb-credits-topup:hover { background: var(--accent-soft); }

    /* ── Profile row ────────────────────────────────────────────── */
    .sb-profile {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 6px; border-radius: 10px;
      background: transparent; width: 100%;
      color: var(--ink);
    }
    .sb-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: linear-gradient(135deg, #5b8cff, var(--accent));
      display: grid; place-items: center;
      color: white; font-weight: 700; font-size: 13px; flex-shrink: 0;
    }
    .sb-profile-meta { display: flex; flex-direction: column; flex: 1; min-width: 0; }
    .sb-profile-name { font-size: 13px; font-weight: 700; line-height: 1.2; }
    .sb-profile-email {
      font-size: 11px; color: var(--faint);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .sb-role-pill {
      display: inline-flex; align-items: center; height: 16px;
      font-size: 9.5px;
      background: #eef2ff; color: var(--accent);
      padding: 0 6px; border-radius: 5px;
      letter-spacing: 0.04em; text-transform: uppercase;
      font-weight: 800; margin-left: 6px; vertical-align: middle;
    }
    .sb-logout-btn {
      width: 30px; height: 30px; border-radius: 8px;
      display: grid; place-items: center;
      color: var(--fainter); flex-shrink: 0;
      background: transparent; border: 0; cursor: pointer;
    }
    .sb-logout-btn:hover { background: #f4f5f7; color: var(--muted); }

    /* ── Onboarding widget ──────────────────────────────────────── */
    .sb-onboard {
      background: var(--accent-soft);
      border: 1px solid var(--accent-border);
      border-radius: 11px; padding: 11px 11px 8px; margin-bottom: 12px;
      display: flex; flex-direction: column; gap: 7px;
    }
    .sb-onboard-head { display: flex; align-items: center; justify-content: space-between; }
    .sb-onboard-title {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 11px; font-weight: 800; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--accent);
    }
    .sb-onboard-title svg { color: var(--accent); width: 12px; height: 12px; }
    .sb-onboard-close {
      width: 20px; height: 20px; border-radius: 5px;
      display: grid; place-items: center;
      background: transparent; border: 0;
      color: var(--faintest); cursor: pointer;
    }
    .sb-onboard-close:hover { background: rgba(0,0,0,0.05); color: var(--muted); }
    .sb-onboard-meta {
      display: flex; align-items: center; gap: 8px;
      font-size: 10.5px; color: var(--faint); font-weight: 700;
    }
    .sb-onboard-bar {
      flex: 1; height: 3px;
      background: #e2e6ee; border-radius: 999px; overflow: hidden;
    }
    .sb-onboard-bar-fill {
      display: block; height: 100%;
      background: var(--accent); border-radius: 999px;
    }
    .sb-onboard-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
    .sb-onboard-item {
      width: 100%; display: grid;
      grid-template-columns: 16px 1fr 12px;
      align-items: center; gap: 8px; padding: 4px;
      border-radius: 6px; background: transparent; border: 0;
      color: var(--ink2); font-size: 12px; font-family: inherit;
      text-align: left; text-decoration: none; cursor: pointer; line-height: 1.2;
    }
    .sb-onboard-item:hover:not(.no-action) { background: rgba(47,107,255,0.06); }
    .sb-onboard-item.no-action { cursor: default; }
    .sb-onboard-item.done { color: var(--fainter); }
    .sb-onboard-item.done .sb-onboard-label {
      text-decoration: line-through;
    }
    .sb-onboard-check {
      width: 16px; height: 16px; border-radius: 50%;
      display: grid; place-items: center;
      border: 1px solid #d6dae2;
      color: var(--faint); font-size: 9.5px; font-weight: 700;
      background: #fff; flex-shrink: 0;
    }
    .sb-onboard-check.done { background: var(--green); border-color: var(--green); color: white; }
    .sb-onboard-check.done svg { width: 10px; height: 10px; stroke-width: 2.6; }
    .sb-onboard-chev { color: var(--faintest); opacity: 0.6; width: 12px; height: 12px; }
    .sb-onboard-item:hover .sb-onboard-chev { opacity: 1; }
    /* Collapsed: the user's own lever, not ours. Nothing is ever clipped (D44). */
    .sb-onboard-acts { display: flex; align-items: center; gap: 2px; }
    .sb-onboard-toggle {
      width: 20px; height: 20px; border-radius: 5px; display: grid; place-items: center;
      background: transparent; border: 0; color: var(--accent); opacity: .8; cursor: pointer;
    }
    .sb-onboard-toggle:hover { background: rgba(67,115,255,.1); }
    .sb-onboard-toggle svg { width: 13px; height: 13px; transition: transform .16s; }
    .sb-onboard .mini-only { display: none; }
    .sb-onboard.mini { padding: 8px 11px; gap: 0; }
    .sb-onboard.mini .sb-onboard-head { gap: 9px; }
    .sb-onboard.mini .mini-only { display: block; }
    .sb-onboard.mini .sb-onboard-bar.mini-only { margin-left: 2px; }
    .sb-onboard.mini .sb-onboard-count {
      font-size: 10.5px; font-weight: 800; color: var(--accent); opacity: .85;
      font-variant-numeric: tabular-nums; flex: none;
    }
    .sb-onboard.mini .sb-onboard-toggle svg { transform: rotate(-90deg); }
    .sb-onboard.mini .sb-onboard-meta,
    .sb-onboard.mini .sb-onboard-list,
    .sb-onboard.mini .sb-fit-note { display: none; }
    .sb-fit-note {
      margin: 4px 0 0; font-size: 10.5px; line-height: 1.35; font-weight: 600;
      color: var(--accent); opacity: .8;
    }
    .sb-fit-note.hidden { display: none; }

    /* ── Status rail (detail pane) — the whole history on one titled line.
       A step is a pill, not a word, so it reads as something you can open (D30). ── */
    .hist { margin-top: 15px; }
    .hist-hd { display: flex; align-items: center; gap: 10px; height: 17px; margin-bottom: 8px; }
    .hist-l { font-size: 11px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); }
    .hist-age { margin-left: auto; font-size: 11px; font-weight: 700; color: var(--faintest); font-variant-numeric: tabular-nums; }
    /* No connectors: a dash is orphaned at the end of a wrapped line, and wrapping is the normal
       desktop behaviour, so a consistent 7px gap carries the sequence instead (D38). */
    .rail { display: flex; align-items: center; flex-wrap: wrap; gap: 7px; }
    .rstep {
      display: inline-flex; align-items: center; gap: 7px; height: 26px; padding: 0 10px;
      border-radius: 8px; border: 1px solid var(--line2); background: #fff; color: var(--muted);
      font-size: 12px; font-weight: 700; font-family: inherit; white-space: nowrap; cursor: pointer;
    }
    .rstep .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; }
    .rstep .d { font-size: 10.5px; font-weight: 700; color: var(--faintest); font-variant-numeric: tabular-nums; }
    .rstep:hover { border-color: #d3d8e2; background: #fafbfc; color: var(--ink2); }
    .rstep.now { border: 0; color: #fff; padding: 0 9px 0 11px; }
    .rstep.now .d { color: rgba(255,255,255,.72); }
    .rstep.now.gold { color: var(--gold-ink); }
    .rstep.now.gold .d { color: rgba(67,41,10,.6); }
    .rstep.is-fixed { color: var(--faint); background: #fafbfc; cursor: default; }
    .rstep.is-fixed:hover { border-color: var(--line2); background: #fafbfc; color: var(--faint); }
    /* The derived current status is a solid chip that simply cannot be opened — its own colour
       wins over the fixed treatment, and it keeps the dotted outline that says "no date". */
    .rstep.now.is-fixed { color: #fff; border: 0; }
    .rstep.now.is-fixed:hover { color: #fff; }
    .rstep.now.gold.is-fixed, .rstep.now.gold.is-fixed:hover { color: var(--gold-ink); }
    .radd {
      display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 8px;
      margin-left: 2px; border: 1px dashed #d3d8e2; background: #fff; color: var(--muted);
      font-size: 15px; font-weight: 700; line-height: 1; font-family: inherit; cursor: pointer;
    }
    .radd:hover { border-color: var(--accent); border-style: solid; color: var(--accent); background: var(--accent-soft); }
    .radd.is-off { color: var(--faintest); border-color: #eceef2; cursor: not-allowed; }
    .radd.is-off:hover { border-color: #eceef2; border-style: dashed; color: var(--faintest); background: #fff; }
    /* The control strip — the three exits. These live HERE, not in jobs.ejs, because the detail
       pane renders on three surfaces and only two of them load that page's stylesheet: on the
       standalone /job/:id the buttons fell back to `display:block` and Tailwind's preflight put
       the icon on its own line. One slot per card, same place, under its own hairline (D19). */
    .ctlstrip { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; padding-top: 8px; border-top: 1px solid var(--line); }
    .exit-btn {
      display: inline-flex; align-items: center; gap: 6px; height: 26px; padding: 0 10px;
      border-radius: 9px; font-size: 11.5px; font-weight: 700; font-family: inherit;
      border: 1px solid var(--line2); background: #fff; color: var(--ink2);
      white-space: nowrap; cursor: pointer; transition: .12s;
    }
    .exit-btn:hover { border-color: var(--accent-border); background: var(--accent-soft); color: var(--accent); }
    .exit-btn.skip:hover { border-color: #dfe3ea; background: #f2f4f7; color: var(--ink2); }
    /* Tailwind's preflight sets `svg { display:block }`, which is what broke the icon onto its own
       line wherever this strip rendered without the list page's CSS. */
    .exit-btn svg { display: inline-block; flex: none; }
    /* The correction sits apart from the two decisions, and reads as a link rather than a button —
       it overrules the AI, it is not a third thing you did (D16). */
    .corrlink {
      display: inline-flex; align-items: center; height: 26px; padding: 0 2px; margin-left: 4px;
      border: 0; background: none; font-size: 12px; font-weight: 700; font-family: inherit;
      color: var(--muted); cursor: pointer; transition: .12s;
      text-decoration: underline; text-decoration-style: dotted; text-underline-offset: 4px;
      text-decoration-color: var(--faintest);
    }
    .corrlink:hover { color: var(--red-ink); text-decoration-color: var(--red); }
    /* On a phone the three exits do not fit a line with their icons. The labels already say what
       each one does — the icons were reinforcement, and reinforcement is the first thing to cut
       when the line is the constraint. */
    @media (max-width: 767px) {
      .exit-btn svg { display: none; }
      .exit-btn { gap: 0; padding: 0 11px; }
    }
    .pane-exits { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 9px; }
    .pane-exits .exit-btn { height: 30px; padding: 0 12px; font-size: 12px; }
    /* On a phone the rail folds — the cap is three, and the chips give up their dates to the
       heading, which is the date anyone actually asks about (D31, MB1). The rail is therefore the
       same height at three, four or nine steps (MB3). */
    .hist-age-mobile { display: none; }
    .rfold { display: none; }
    @media (max-width: 767px) {
      .hist-age-desktop { display: none; }
      .hist-age-mobile { display: inline; }
      .rstep .d { display: none; }
      .rail .rstep.is-folded { display: none; }
      .rail.is-open .rstep.is-folded { display: inline-flex; }
      .rail.is-open .rfold { display: none; }
      .rfold {
        display: inline-flex; align-items: center; height: 22px; padding: 0 10px;
        border-radius: 999px; border: 1px dashed #d3d8e2; background: #fff;
        font-size: 10.5px; font-weight: 800; color: var(--muted);
        font-variant-numeric: tabular-nums; font-family: inherit; cursor: pointer;
      }
      .rfold:hover { border-color: var(--accent-border); color: var(--accent); background: var(--accent-soft); border-style: solid; }
    }

    /* One editor doing all three jobs: change the status, move the date, delete the step (D30). */
    .stepedit { width: 258px; padding: 12px; }
    .stepedit .et { font-size: 10.5px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); margin-bottom: 9px; }
    .stepedit .fr + .fr { margin-top: 9px; }
    .stepedit label { display: block; font-size: 11px; font-weight: 700; color: var(--muted); margin-bottom: 4px; }
    .stepedit select, .stepedit .dateinput {
      width: 100%; border: 1px solid var(--line2); border-radius: 9px; padding: 8px 10px;
      font-size: 12.5px; font-family: inherit; color: var(--ink); background: #fff;
      font-weight: 600; text-align: left; cursor: pointer;
    }
    .stepedit select:focus { outline: 0; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
    .stepedit .dateinput { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .stepedit .dateinput:hover { border-color: var(--accent-border); }
    .stepedit .warn {
      margin-top: 9px; display: grid; grid-template-columns: 14px 1fr; gap: 8px;
      background: var(--amber-soft); border: 1px solid var(--amber-border); border-radius: 9px;
      padding: 8px 9px; font-size: 11.5px; line-height: 1.45; color: var(--amber-ink); font-weight: 600;
    }
    .stepedit .ef { display: flex; align-items: center; gap: 7px; margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line); }
    .stepedit .eb { height: 30px; padding: 0 12px; border-radius: 9px; border: 0; font-size: 12px; font-weight: 700; font-family: inherit; cursor: pointer; }
    .stepedit .eb.del { background: var(--red-soft); color: var(--red-ink); border: 1px solid var(--red-border); }
    .stepedit .eb.ghost { background: transparent; color: var(--muted); margin-left: auto; }
    .stepedit .eb.pri { background: var(--accent); color: #fff; }
    .stepedit .cal-back {
      display: inline-flex; align-items: center; gap: 6px; border: 0; background: none;
      padding: 2px 4px; border-radius: 6px; font-size: 11.5px; font-weight: 700;
      color: var(--muted); font-family: inherit; cursor: pointer;
    }
    .stepedit .cal-back:hover { color: var(--accent); }
    .stepedit .cal-note { font-size: 11px; color: var(--faintest); font-weight: 600; margin-top: 9px; padding-top: 9px; border-top: 1px solid var(--line); }

    /* ── Job source picker table ───────────────────────────────── */
    @media (min-width: 768px) {
      .provider-picker-panel { box-shadow: var(--shadow-modal); }
    }
    .provider-picker-note {
      padding: 12px 24px 2px;
      color: var(--faint);
      font-size: 12.5px;
      line-height: 1.4;
    }
    .provider-picker-table {
      padding: 10px 24px 14px;
    }
    .provider-picker-head,
    .provider-picker-row {
      display: grid;
      grid-template-columns: 34px minmax(142px, 1.05fr) 108px minmax(220px, 1.65fr);
      gap: 14px;
      align-items: center;
    }
    /* DS v2 §6 table header — same treatment as Run Logs / admin tables. */
    .provider-picker-head {
      padding: 8px 10px 9px;
      border-radius: 8px 8px 0 0;
      background: #f9fafb;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.2;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-bottom: 1px solid var(--line);
    }
    .provider-picker-row {
      min-height: 60px;
      padding: 10px;
      border-bottom: 1px solid var(--line3);
      cursor: pointer;
    }
    .provider-picker-row:last-child { border-bottom: 0; }
    .provider-picker-row:hover { background: #f5f6f8; }
    .provider-picker-row input {
      width: 16px;
      height: 16px;
      margin: 0;
      accent-color: var(--accent);
    }
    .provider-picker-source {
      min-width: 0;
      color: var(--ink);
      font-size: 14px;
      line-height: 1.25;
      font-weight: 700;
      overflow-wrap: anywhere;
    }
    .provider-picker-cost {
      display: inline-flex;
      width: 58px;
      height: 23px;
      max-width: 100%;
      border-radius: 7px;
      padding: 0 8px;
      align-items: center;
      justify-content: center;
      background: var(--accent-soft);
      color: var(--accent);
      border: 1px solid var(--accent-border);
      font-size: 12px;
      line-height: 1;
      font-weight: 800;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    .provider-picker-cost.free {
      background: #eef1f6;
      color: var(--ink2);
      border-color: var(--line2);
    }
    .provider-picker-desc {
      min-width: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }
    @media (max-width: 767px) {
      .provider-picker-note {
        padding-left: 16px;
        padding-right: 16px;
      }
      .provider-picker-table {
        padding-left: 16px;
        padding-right: 16px;
      }
      .provider-picker-head { display: none; }
      .provider-picker-row {
        grid-template-columns: 28px minmax(0, 1fr) auto;
        gap: 7px 10px;
        align-items: start;
        min-height: 0;
        padding: 12px 4px;
      }
      .provider-picker-row input { margin-top: 2px; }
      .provider-picker-desc { grid-column: 2 / 4; }
    }

  </style>
  <script>
    window.JHUI_TOKENS = <%- JSON.stringify(getClientUiTokens()) %>;
    window.JHUI = {
      formatVerdictLabel(value) {
        const key = String(value || '').trim().toUpperCase();
        return window.JHUI_TOKENS.verdictLabels[key] || (key ? key.replace(/[_-]+/g, ' ').toLowerCase().replace(/\b\w/g, c => c.toUpperCase()) : 'Unknown');
      },
      getVerdictTone(value) {
        return window.JHUI_TOKENS.verdictTones[String(value || '').trim().toUpperCase()] || 'bg-gray-100 text-gray-500';
      },
      isVerdictEditable(value) {
        return window.JHUI_TOKENS.editableVerdicts.includes(String(value || '').trim().toUpperCase());
      },
      formatScore(value) {
        if (value === null || value === undefined || value === '') return '\u2014';
        const num = Number(value);
        return Number.isFinite(num) ? String(Math.round(num)) : '\u2014';
      },
      formatStatusAge(days, type) {
        if (String(type) === 'rejected') return '';
        const n = Number(days);
        if (!Number.isFinite(n) || n < 0) return '';
        return n === 0 ? 'today' : n + 'd';
      },
      getVerdictChipStyle(value) {
        return window.JHUI_TOKENS.verdictChipStyles[String(value || '').trim().toUpperCase()] || window.JHUI_TOKENS.verdictChipFallback;
      },
      getStatusChipStyle(type) {
        return window.JHUI_TOKENS.statusChipStyles[String(type || 'new')] || window.JHUI_TOKENS.statusChipStyles.new;
      },
      getStatusDot(type) {
        return window.JHUI_TOKENS.statusDots[String(type || 'new')] || window.JHUI_TOKENS.statusDots.new;
      }
    };
  </script>
</head>
<body class="h-full font-sans antialiased text-gray-900">

  <!-- AppShell -->
  <div class="app-shell flex">

    <!-- SidebarNav (desktop only) -->
    <aside class="app-sidebar hidden md:flex flex-shrink-0 flex-col sticky top-0 h-screen" style="background:#fff;color:var(--ink);border-right:1px solid var(--line);">

      <!-- Brand row -->
      <div style="display:flex;align-items:center;padding:16px 18px 6px;flex-shrink:0;">
        <img src="/logo.webp" alt="Job Search" style="width:100%;max-width:200px;height:auto;display:block;" />
      </div>

      <!-- Scrollable nav section -->
      <div class="sb-nav-scroll">

        <!-- Onboarding widget -->
        <div class="sb-onboard" id="sb-onboard-widget">
          <div class="sb-onboard-head">
            <div class="sb-onboard-title">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"/></svg>
              Onboarding
            </div>
            <%# Collapsed, the widget is ONE row — title, bar, 4/5 — never clipped and never
                replaced. These two carry it only in that state (D44). %>
            <span class="sb-onboard-bar mini-only">
              <span class="sb-onboard-bar-fill" style="width:<%= (onboarding.completedCount/5*100) %>%"></span>
            </span>
            <span class="sb-onboard-count mini-only"><%= onboarding.completedCount %>/5</span>
            <span class="sb-onboard-acts">
              <button class="sb-onboard-toggle" onclick="jhToggleOnboarding()" aria-label="Collapse onboarding" title="Collapse">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
              </button>
              <button class="sb-onboard-close" onclick="jhDismissOnboarding()" aria-label="Dismiss onboarding">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 6l12 12M18 6l-12 12"/></svg>
              </button>
            </span>
          </div>
          <div class="sb-onboard-meta">
            <%= onboarding.completedCount %> of 5 done
            <span class="sb-onboard-bar">
              <span class="sb-onboard-bar-fill" style="width:<%= (onboarding.completedCount/5*100) %>%"></span>
            </span>
          </div>
          <ul class="sb-onboard-list">
            <%
              const obSteps = [
                { label: 'Set up your profile',          href: '/settings',          clickFn: null },
                { label: 'Add target roles',             href: '/settings?tab=roles', clickFn: null },
                { label: 'Add or buy API keys',          href: '/settings?tab=ai',   clickFn: null },
                { label: 'Run your first search',        href: null,                  clickFn: 'jhOnboardRun()' },
                { label: 'Set a daily schedule',         href: null,                  clickFn: 'jhOnboardSchedule()' },
              ];
            %>
            <% obSteps.forEach(function(step, i) { %>
              <% const state = onboarding.states[i]; %>
              <% const hasAction = step.href || step.clickFn; %>
              <% if (step.href) { %>
            <li><a href="<%= step.href %>" class="sb-onboard-item <%= state %>">
              <% } else if (step.clickFn) { %>
            <li><button type="button" class="sb-onboard-item <%= state %>" onclick="<%= step.clickFn %>">
              <% } else { %>
            <li><span class="sb-onboard-item <%= state %> no-action">
              <% } %>
                <span class="sb-onboard-check <%= state === 'done' ? 'done' : '' %>">
                  <% if (state === 'done') { %>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="m5 12 5 5L20 6"/></svg>
                  <% } else { %>
                    <%= i + 1 %>
                  <% } %>
                </span>
                <span class="sb-onboard-label"><%= step.label %></span>
                <% if (hasAction) { %>
                  <svg class="sb-onboard-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="m9 6 6 6-6 6"/></svg>
                <% } else { %>
                  <span></span>
                <% } %>
              <% if (step.href) { %></a></li>
              <% } else if (step.clickFn) { %></button></li>
              <% } else { %></span></li>
              <% } %>
            <% }); %>
          </ul>
          <%# Below 660px one of the two blocks has to stay collapsed. Rather than silently undoing
              the user's click, the column says which and why (D51). %>
          <p class="sb-fit-note hidden" id="sb-fit-note">Not enough room. Collapse Settings to keep this open.</p>
        </div>

        <!-- Nav items -->
        <a href="/" class="sb-item <%= title === 'Start' ? 'active' : '' %>">
          <span class="ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/></svg>
          </span>
          Start
        </a>
        <%# Matches is a link, never a group: clicking it shows everything. Its badge keeps counting
            New only — the badge answers "what is waiting for me", not "how many rows are behind
            this link" (D40). %>
        <a href="/jobs" class="sb-item <%= title === 'Matches' && !locals.activeShortcut ? 'active' : (title === 'Matches' && locals.activeShortcut === 'all' ? 'active' : '') %>">
          <span class="ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1l8.8 8.8 8.8-8.8a5 5 0 0 0 0-7.1Z"/></svg>
          </span>
          Matches
          <% const mc = typeof matchesCount === 'undefined' ? 0 : matchesCount; %>
          <span class="sb-count" id="sb-matches-count" <%= mc > 0 ? '' : 'hidden' %>><%= mc %></span>
        </a>
        <%# Three shortcuts, always expanded and never collapsible — these are filters kept in
            view, not a menu. Each is a preset over the ordinary Status filter, so its href carries
            the real status ids its types resolve to (D40, D45). %>
        <div class="sb-subnav">
          <% (locals.shortcuts || []).forEach(function (sc) { %>
          <a href="<%= sc.href %>" class="sb-item sb-subitem <%= title === 'Matches' && locals.activeShortcut === sc.id ? 'active' : '' %>">
            <span class="sb-subdot"></span><%= sc.label %><span class="sb-subcount" data-shortcut="<%= sc.id %>"><%= sc.count %></span>
          </a>
          <% }); %>
        </div>
        <a href="/history" class="sb-item <%= title === 'All Jobs' ? 'active' : '' %>">
          <span class="ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/><path d="M3 13h18"/></svg>
          </span>
          All Jobs
        </a>
        <a href="/analytics" class="sb-item <%= title === 'Stats' ? 'active' : '' %>">
          <span class="ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M4 20V10"/><path d="M10 20V4"/><path d="M16 20v-8"/><path d="M22 20H2"/></svg>
          </span>
          Stats
        </a>
        <a href="/reports" class="sb-item <%= title === 'Run Logs' ? 'active' : '' %>">
          <span class="ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
          </span>
          Run Logs
        </a>

        <!-- Settings expandable submenu -->
        <%
          const isSettings = title === 'Settings';
          const curTab = locals.activeTab || 'profile';
        %>
        <button type="button" class="sb-item" id="sb-settings-btn" onclick="jhToggleSettings()">
          <span class="ico">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1A2 2 0 1 1 4.3 17l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.3-1.8l-.1-.1A2 2 0 1 1 7 4.3l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1A2 2 0 1 1 19.7 7l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>
          </span>
          Settings
          <span class="sb-chev" id="sb-settings-chev">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="m9 6 6 6-6 6"/></svg>
          </span>
        </button>
        <%# Unrolled by default and until the user collapses it: its three tabs are the
            destination, the row above them is not (D46). %>
        <div class="sb-subnav" id="sb-settings-sub">
          <a href="/settings" class="sb-item sb-subitem <%= isSettings && curTab === 'profile' ? 'active' : '' %>">
            <span class="sb-subdot"></span>Profile
          </a>
          <a href="/settings?tab=roles" class="sb-item sb-subitem <%= isSettings && curTab === 'roles' ? 'active' : '' %>">
            <span class="sb-subdot"></span>Roles
          </a>
          <a href="/settings?tab=ai" class="sb-item sb-subitem <%= isSettings && curTab === 'ai' ? 'active' : '' %>">
            <span class="sb-subdot"></span>AI Setup
          </a>
        </div>

        <%# Admin has left the nav for the profile menu (D39). A button, a 21px divider and four
            sub-items — 188px — bought back for the Matches shortcuts. Settings stays, because it
            is the user's own surface where Admin is the operator's. %>
      </div>

      <%# ── Footer: two compact rows (D41) ────────────────────────────────────────────────
          The 219px stack of run buttons, credits card and profile row becomes 96px. Row one runs
          the search; row two is the account. On credits the balance and its `＋` are ONE split
          pill — a `＋` floating beside the balance reads as unrelated to it — and on own API keys,
          which is most profiles, there is no balance at all and that row is the account instead.
          Both states keep the row height, so the footer does not resize when a profile switches. %>
      <div class="sb-compact">
        <div class="sb-compact-row">
          <button id="sidebar-run-btn" onclick="openRunModal()" class="sb-run-c"
                  <% if (locals.canRun === false) { %>disabled title="Add credits or your own API keys in Settings → AI Setup to run."<% } %>>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8L6 20V4Z"/></svg>
            <span id="sidebar-run-label">Run once</span>
          </button>
          <%# The schedule control is a clock and nothing else — a bare "09:00" in a nav reads as a
              label for whatever sits beside it. The dot notched into its corner is a state light:
              --red when no schedule is set, --green when one is running. It does NOT animate;
              motion would claim attention every second for something that changes about once a
              week. Pressing it opens no menu here — it navigates to Start and opens the schedule
              modal there (D42). %>
          <% const _schedOn = !!(locals.scheduleStatus && locals.scheduleStatus.active); %>
          <%# The credits gate holds here too: a profile that cannot pay for a run cannot reach the
              schedule modal, exactly as the old Schedule button was disabled. Same `isPaymentReady`
              rule as `Run once`, so the two can never disagree. %>
          <% const _schedLocked = locals.canRun === false; %>
          <%# Unescaped: these emit whole ATTRIBUTES, and escaping would mangle their quotes. %>
          <a <%- _schedLocked ? '' : 'href="/?schedule=1"' %> id="sb-sched-btn"
             class="sb-sched <%= _schedOn ? 'live' : '' %><%= _schedLocked ? ' is-locked' : '' %>"
             <%- _schedLocked ? 'aria-disabled="true"' : '' %>
             title="<%= _schedLocked ? 'Add credits or your own API keys in Settings → AI Setup to run.' : (_schedOn ? 'Schedule running — opens Start' : 'No schedule set — opens Start') %>"
             aria-label="<%= _schedOn ? 'Schedule running' : 'No schedule set' %>">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <span class="lamp"></span>
          </a>
        </div>

        <div class="sb-compact-row">
          <% if (locals.useJhCredits) { %>
          <span class="sb-money">
            <button type="button" class="val" onclick="jhTopUp()" title="Credits">
              $<%= Number(locals.creditsBalance || 0).toFixed(1) %><em>≈ <%= Math.floor(Math.round(Number(locals.creditsBalance || 0) / 0.2 * 100) / 100) %> runs</em>
            </button>
            <button type="button" class="add" onclick="jhTopUp()" title="Top up" aria-label="Top up">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            </button>
          </span>
          <button type="button" class="sb-av-btn" onclick="jhToggleProfileMenu(event)" title="<%= activeProfile.email %>" aria-label="Account">
            <%= activeProfile.displayName.charAt(0).toUpperCase() %>
            <% if (activeProfile.isAdmin) { %><span class="adm"></span><% } %>
          </button>
          <% } else { %>
          <%# No balance to show, so the row the pill would have taken is the full account row —
              the space is not left empty and nothing below it shifts. %>
          <button type="button" class="sb-acct" onclick="jhToggleProfileMenu(event)" title="<%= activeProfile.email %>">
            <span class="sb-av-btn as-part">
              <%= activeProfile.displayName.charAt(0).toUpperCase() %>
              <% if (activeProfile.isAdmin) { %><span class="adm"></span><% } %>
            </span>
            <span class="sb-acct-meta">
              <span class="sb-acct-email"><%= activeProfile.email %></span>
              <span class="sb-acct-sub">Own API keys</span>
            </span>
            <svg class="sb-acct-chev" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <% } %>
        </div>

        <%# The profile menu (D43). Email at the top — the display name is derived from it, so
            printing both spends a line twice. `Admin` is a HEADING, not a row: it was never a
            page, and drawn as a row it invited a click that did nothing. Its four destinations sit
            under it in the red the admin sub-nav already used. No Top up row: on credits it is the
            `＋` in the pill above, on own keys there is nothing to top up. %>
        <div id="sb-profile-menu" class="sb-pop hidden">
          <div class="sb-pop-mail"><%= activeProfile.email %></div>
          <% if (activeProfile.isAdmin) { %>
          <div class="sb-pop-sep"></div>
          <div class="sb-pop-lbl adm">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z"/></svg>
            Admin
          </div>
          <a href="/admin?tab=general" class="sb-pop-row adm">General</a>
          <a href="/admin?tab=stats" class="sb-pop-row adm">Admin Stats</a>
          <a href="/admin?tab=sources" class="sb-pop-row adm">Sources</a>
          <a href="/admin?tab=locations" class="sb-pop-row adm">Locations</a>
          <% } %>
          <div class="sb-pop-sep"></div>
          <form method="POST" action="/logout" style="display:contents;">
            <button type="submit" class="sb-pop-row">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
              Log out
            </button>
          </form>
        </div>
        <script>
          // Default: land on AI Setup, which opens the top-up form on arrival.
          // The AI tab overrides this to open the form in place.
          function jhTopUp() {
            window.location.href = '/settings?tab=ai&topup=1';
          }
        </script>
      </div>
    </aside>

    <!-- Main content -->
    <main class="app-main flex-1">
      <div class="app-content<%= locals.fullBleed ? ' full' : '' %>">
        <div class="app-page<%= locals.fullBleed ? ' full' : '' %>">
