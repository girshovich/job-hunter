{
  "name": "linkedin-job-hunter",
  "version": "1.0.0",
  "description": "Self-hosted AI-curated LinkedIn job hunter",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i ./src/styles/tailwind.css -o ./src/public/css/tailwind.css --minify",
    "build": "npm run build:css && tsc && rm -rf dist/views dist/public && cp -r src/views dist/views && cp -r src/public dist/public",
    "start": "node dist/index.js",
    "dev": "ts-node --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@types/multer": "^2.1.0",
    "apify-client": "^2.22.1",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-basic-auth": "^1.2.1",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "openai": "^4.52.7",
    "p-limit": "^3.1.0",
    "resend": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/compression": "^1.8.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
